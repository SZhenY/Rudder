<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 installer definition for Rudder (x86_64 and ARM64).

  One source file for both architectures: the build passes the package
  architecture via `wix build -arch` and the variables below with `-d`:
    $(var.Version)            crate version from Cargo.toml
    $(var.CargoTargetBinDir)  e.g. target\x86_64-pc-windows-msvc\release
    $(var.UpgradeCode)        per-architecture upgrade code (see release.yml:
                              x86_64 and ARM64 must not share one, otherwise a
                              cross-architecture upgrade could match)

  History: this file used to be the WiX 3 source driven by `cargo wix`.
  WiX 3 has no ARM64 support, so ARM64 needed a separate copy — instead of
  keeping two syntaxes alive everything moved to the WiX 4 CLI (0.7.x).
  The v0.6.5 migration search below was carried over verbatim.

  Package-wide 64-bitness comes from `-arch`, so the per-component `Win64`
  attributes of the WiX 3 days are gone (WiX 4 derives them from the package).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <Package Name="Rudder"
             Manufacturer="Rudder contributors"
             Version="$(var.Version)"
             UpgradeCode="$(var.UpgradeCode)"
             Scope="perMachine"
             Language="1033"
             Codepage="1252"
             Compressed="yes"
             InstallerVersion="500">

        <!--
          内置组名随系统语言变化（德语是 "Benutzer"），权限里写死 "Users" 会让安装
          在非英文系统上直接失败。这个元素在安装时把本地化组名写进 WIX_ACCOUNT_USERS，
          下面的 PermissionEx 引用它。
        -->
        <util:QueryWindowsWellKnownSIDs/>

        <SummaryInformation Description="Rudder - lightweight Rust + Slint SSH/terminal client"
                            Manufacturer="Rudder contributors"/>

        <!-- Replace an older install in place instead of erroring out. -->
        <MajorUpgrade Schedule="afterInstallInitialize"
                      DowngradeErrorMessage="A newer version of Rudder is already installed. Setup will now exit."/>

        <MediaTemplate EmbedCab="yes"/>

        <Icon Id="ProductICO" SourceFile="assets\rudder.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>

        <!--
          Preserve a custom install location across major upgrades (#293).
          New packages write Software\Rudder\InstallDir below, so that key is the
          authoritative source for every install made since 2026-07-26; the
          Software\meatshell lookup keeps installs created before the rename
          pointing at their old directory, and the component search covers
          v0.6.5-v0.6.7 (which persisted neither value).
          A machine normally has only one of those keys, and one that has been
          upgraded since the rename has both with the same value, so the three
          sources cannot disagree in practice.
          Self-update additionally passes APPLICATIONFOLDER on the msiexec
          command line (see src/app/self_updater.rs) with the directory the
          running copy lives in — two independent sources for the same answer,
          which is what keeps an elevated /qb upgrade out of Program Files.
        -->
        <Property Id="APPLICATIONFOLDER" Secure="yes">
            <RegistrySearch Id="CurrentInstallDirRegistry"
                            Root="HKLM"
                            Key="Software\Rudder"
                            Name="InstallDir"
                            Type="directory"/>
            <RegistrySearch Id="PreviousInstallDirRegistry"
                            Root="HKLM"
                            Key="Software\meatshell"
                            Name="InstallDir"
                            Type="directory"/>
            <ComponentSearch Id="PreviousMainExecutable"
                             Guid="{ECB1F8D7-7CC7-5A8A-A7CC-56A267A502DC}"
                             Type="file">
                <DirectorySearch Id="PreviousMainExecutableDirectory"
                                 AssignToProperty="yes"/>
            </ComponentSearch>
        </Property>

        <StandardDirectory Id="ProgramFiles64Folder">
            <!-- Default path; the InstallDir UI lets the user change it. -->
            <Directory Id="APPLICATIONFOLDER" Name="Rudder">
                <Component Id="MainExecutable"
                           Guid="{ECB1F8D7-7CC7-5A8A-A7CC-56A267A502DC}">
                    <File Id="rudderEXE"
                          Name="rudder.exe"
                          Source="$(var.CargoTargetBinDir)\rudder.exe"
                          KeyPath="yes"/>
                </Component>
                <Component Id="ThirdPartyNotices">
                    <File Id="thirdPartyNoticesFile"
                          Name="THIRD_PARTY_NOTICES.md"
                          Source="THIRD_PARTY_NOTICES.md"
                          KeyPath="yes"/>
                </Component>
                <Component Id="InstallLocationRegistry">
                    <RegistryValue Root="HKLM"
                                   Key="Software\Rudder"
                                   Name="InstallDir"
                                   Type="string"
                                   Value="[APPLICATIONFOLDER]"
                                   KeyPath="yes"/>
                </Component>

                <!--
                  应用把运行时数据写在 exe 旁边：配置在 <安装目录>\config，日志在
                  <安装目录>\log（见 src/config/impls/config.rs 的 resolve_data_dir /
                  log_dir）。Program Files 默认只给普通用户读+执行，建不出这两个目录，
                  应用会退回 %TEMP% —— 重启或清理临时文件后会话、密钥、设置全丢。
                  这里安装时就把它们建好并授权（GenericAll，可继承），让"数据留在安装
                  目录"这条设计在 MSI 下真正成立。
                  只放开这两个子目录，安装根目录保持只读：rudder.exe 不能被普通用户替换。
                  代价与便携版放在可写目录时相同：本机其他账户也能读写这份配置。
                  组名用 [WIX_ACCOUNT_USERS]（见文件开头的 QueryWindowsWellKnownSIDs），
                  不能写死 "Users" —— 非英文系统上该组名是本地化的。
                -->
                <Directory Id="ConfigFolder" Name="config">
                    <Component Id="ConfigFolderAcl"
                               Guid="7E8AF5F2-FA80-4B6E-99B5-61DBA490A286">
                        <CreateFolder>
                            <util:PermissionEx User="[WIX_ACCOUNT_USERS]" GenericAll="yes"/>
                        </CreateFolder>
                    </Component>
                </Directory>
                <Directory Id="LogFolder" Name="log">
                    <Component Id="LogFolderAcl"
                               Guid="111734E2-DD85-4A9A-B7EE-B51B58409681">
                        <CreateFolder>
                            <util:PermissionEx User="[WIX_ACCOUNT_USERS]" GenericAll="yes"/>
                        </CreateFolder>
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Component Id="ApplicationShortcut">
                <Shortcut Id="StartMenuShortcut"
                          Name="Rudder"
                          Description="Lightweight SSH/terminal client"
                          Target="[APPLICATIONFOLDER]rudder.exe"
                          WorkingDirectory="APPLICATIONFOLDER"
                          Icon="ProductICO"/>
                <RemoveFolder Id="CleanUpShortCut" On="uninstall"/>
                <RegistryValue Root="HKCU"
                               Key="Software\Rudder"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes"/>
            </Component>
        </StandardDirectory>

        <StandardDirectory Id="DesktopFolder">
            <Component Id="DesktopShortcut"
                       Guid="{A034B952-E060-47C3-8D04-FCA147FBE3E5}">
                <Shortcut Id="DesktopShortcutLink"
                          Name="Rudder"
                          Description="Lightweight SSH/terminal client"
                          Target="[APPLICATIONFOLDER]rudder.exe"
                          WorkingDirectory="APPLICATIONFOLDER"
                          Icon="ProductICO"/>
                <RegistryValue Root="HKCU"
                               Key="Software\Rudder"
                               Name="desktopShortcut"
                               Type="integer"
                               Value="1"
                               KeyPath="yes"/>
            </Component>
        </StandardDirectory>

        <Feature Id="MainProgram" Title="Rudder" Level="1">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="ThirdPartyNotices"/>
            <ComponentRef Id="InstallLocationRegistry"/>
            <ComponentRef Id="ApplicationShortcut"/>
            <ComponentRef Id="DesktopShortcut"/>
        </Feature>

        <!-- Populate Programs and Features -> InstallLocation as well. -->
        <CustomAction Id="SetARPInstallLocation"
                      Property="ARPINSTALLLOCATION"
                      Value="[APPLICATIONFOLDER]"
                      Execute="immediate"/>
        <InstallExecuteSequence>
            <!-- WiX 4: the condition goes in the attribute, inner text is illegal
                 (WIX0400). -->
            <Custom Action="SetARPInstallLocation" After="CostFinalize" Condition="NOT REMOVE"/>
        </InstallExecuteSequence>

        <!-- "Choose install location" wizard page (needs WixToolset.UI.wixext). -->
        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="APPLICATIONFOLDER"/>
    </Package>
</Wix>
