import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "MeatShell Beta";
    preferred-width: 390px;
    preferred-height: 760px;
    background: #17191f;

    in-out property <string> host: "";
    in-out property <string> port: "22";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> command: "";
    in-out property <string> terminal-output: "MeatShell Android Beta\n";
    in-out property <string> status: "未连接";
    in-out property <bool> connected: false;
    in-out property <bool> host-key-open: false;
    in-out property <string> host-key-message: "";

    callback connect-requested(string, int, string, string);
    callback disconnect-requested();
    callback send-requested(string);
    callback host-key-response(bool);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "MeatShell Android Beta";
            color: #f2f4f8;
            font-size: 22px;
            font-weight: 700;
        }

        Text {
            text: root.status;
            color: root.connected ? #56d6b3 : #b8beca;
            font-size: 13px;
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "主机 / IP";
                text <=> root.host;
                enabled: !root.connected;
            }
            LineEdit {
                width: 78px;
                placeholder-text: "端口";
                text <=> root.port;
                enabled: !root.connected;
            }
        }

        LineEdit {
            placeholder-text: "用户名";
            text <=> root.username;
            enabled: !root.connected;
        }

        LineEdit {
            placeholder-text: "密码（Beta 暂仅支持密码登录）";
            text <=> root.password;
            input-type: InputType.password;
            enabled: !root.connected;
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.connected ? "已连接" : "连接";
                enabled: !root.connected;
                clicked => {
                    root.connect-requested(
                        root.host,
                        root.port.to-float().round(),
                        root.username,
                        root.password
                    );
                }
            }
            Button {
                text: "断开";
                enabled: root.connected;
                clicked => { root.disconnect-requested(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #0c0e12;
            border-radius: 6px;
            clip: true;

            ScrollView {
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, output.preferred-height + 16px);
                output := Text {
                    x: 8px;
                    y: 8px;
                    width: max(1px, parent.visible-width - 16px);
                    text: root.terminal-output;
                    color: #d9dee8;
                    font-family: "monospace";
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "输入命令";
                text <=> root.command;
                enabled: root.connected;
                accepted => {
                    if (root.command != "") {
                        root.send-requested(root.command);
                        root.command = "";
                    }
                }
            }
            Button {
                text: "发送";
                enabled: root.connected && root.command != "";
                clicked => {
                    root.send-requested(root.command);
                    root.command = "";
                }
            }
        }
    }

    if root.host-key-open : Rectangle {
        background: #000000aa;
        Rectangle {
            width: parent.width - 36px;
            height: host-key-content.preferred-height;
            x: 18px;
            y: (parent.height - self.height) / 2;
            background: #252832;
            border-radius: 8px;
            host-key-content := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: "确认服务器密钥";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.host-key-message;
                    color: #d9dee8;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "拒绝"; clicked => { root.host-key-response(false); } }
                    Button { text: "本次信任"; clicked => { root.host-key-response(true); } }
                }
            }
        }
    }
}
