// 设置页的通用控件（叶子层）：只有样式与交互，不含业务状态。
//
// 从 interface_panel.slint 抽出（阶段 A）。全部以 `export component` 暴露，
// 便于后续按页拆分到 ui/settings/pages/*.slint 时跨文件复用。
//
// 约定：@children 只用于"右侧控件槽"，属性均为 `in`，事件一律用 callback 上抛，
// 组件内部不持久化任何状态 —— 状态归 Rust 侧 config，"谁拥有状态谁负责写盘"。

export { NavItem, SectionHeader, SettingRow, ToggleSwitch, SettingSwitch, Stepper } from "chrome/rows.slint";
export { CursorStyleButton, CursorPaletteSwatch, CursorColorInput } from "chrome/cursor.slint";
export { WallpaperSwatch } from "chrome/wallpaper.slint";
