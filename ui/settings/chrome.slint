// 设置页的通用控件（叶子层）：只有样式与交互，不含业务状态。
//
// 从 interface_panel.slint 抽出（阶段 A）。全部以 `export component` 暴露，
// 便于后续按页拆分到 ui/settings/pages/*.slint 时跨文件复用。
//
// 约定：@children 只用于"右侧控件槽"，属性均为 `in`，事件一律用 callback 上抛，
// 组件内部不持久化任何状态 —— 状态归 Rust 侧 config，"谁拥有状态谁负责写盘"。
import { Theme, AnimationSettings } from "../theme.slint";
import { Divider, VDivider } from "../components/surfaces.slint";
import { IconText } from "../components/text.slint";

// One left-nav row (icon + label).
export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    background: transparent;
    states [
        // 选中项用**主题色淡底**（跟随「配色」分区），hover 仍是中性灰：hover 不是选中。
        current when root.active : { background: Theme.accent-tint; }
        hovered when ta.has-hover : { background: Theme.bg-hover; }
    ]
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 9px;
        IconText { text: root.icon;
               color: root.active ? Theme.text-primary : Theme.text-secondary;
               font-size: 15px * Theme.panel-font; vertical-alignment: center; }
        Text { text: root.label;
               color: root.active ? Theme.text-primary : Theme.text-secondary;
               font-size: 13px * Theme.panel-font; vertical-alignment: center; horizontal-stretch: 1; }
    }
}

// Small muted group heading (字体 / 预览 / SFTP …).
export component SectionHeader inherits Text {
    font-size: 11px * Theme.panel-font;
    font-weight: 700;
    color: Theme.text-muted;
    vertical-alignment: center;
}

// A settings row: label (+ optional description) on the left, a control slot on
// the right via @children. Right-aligned and vertically centered.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> show-divider: true;
    VerticalLayout {
        HorizontalLayout {
            spacing: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: root.label; font-size: 13px * Theme.panel-font; color: Theme.text-primary; }
                if root.desc != "" : Text { text: root.desc; font-size: 11px * Theme.panel-font;
                        color: Theme.text-muted; wrap: word-wrap;
                        line-height-factor: 1.3; max-lines: 2; }
            }
            VerticalLayout {
                alignment: center;
                @children
            }
        }
        if root.show-divider : Divider {}
    }
}

/// 「说明 + 开关」的设置行：此前每个设置页都手写一遍
/// `SettingRow { label/desc/show-divider + Switch { checked <=> …; toggled => { … } } }`。
///
/// 组件只是 `SettingRow` 加一个开关（元素落在基类的 `@children` 槽里），
/// 因此 `label` / `desc` / `show-divider` 的用法与以前完全一样。
///
/// 开关由组件自己画（见下面的注释），但**对外语义不变**：`checked` 双向绑定，
/// 点击后把新值通过 `toggled(v)` 转发出来 —— 调用方写法与官方 Switch 时代一致。
export component SettingSwitch inherits SettingRow {
    in-out property <bool> checked;
    callback toggled(bool);

    // ⚠️ 自绘开关（原来是官方 std-widgets 的 `Switch`）。改回来的理由：fluent 风格里
    // `Palette.accent-background` 是**派生属性**（`accentify(#0078D4)`，跟随系统强调色），
    // 官方 Switch 的"开"态因此永远是自己那套蓝，换「配色」时它是设置页里最扎眼的一处死角。
    // 代价：外观与无障碍不再由官方维护 —— 若将来官方开放强调色，可以换回去。
    Rectangle {
        width: 40px;
        height: 22px;
        border-radius: 11px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.border-strong;
        background: root.checked ? Theme.accent : Theme.bg-hover;
        animate background {
            duration: 120ms;
            easing: AnimationSettings.color();
            enabled: AnimationSettings.enabled;
        }

        knob := Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: root.checked ? #ffffff : Theme.text-secondary;
            animate x {
                duration: 120ms;
                easing: AnimationSettings.layout();
                enabled: AnimationSettings.enabled;
            }
        }

        switch-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

// 注：不再自绘 Switch —— 改用官方 std-widgets 的 `Switch`（`checked` 双向绑定 +
// `toggled()` 无参回调）。自绘版存在的理由是"on 显示态 + 父级持有状态"，而官方版
// `checked <=> root.x` 同样满足"状态归 Rust 侧 config"，且外观/无障碍由官方维护。


// [- value +] stepper. Display-only `value`; emits the clamped new value.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);
    width: 112px;
    height: 26px;
    border-radius: 6px;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;
    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: minus-ta.has-hover ? Theme.bg-hover : transparent;
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(max(root.minimum, root.value - root.step)); }
            }
            IconText { text: "\u{E15B}";font-size: 14px * Theme.panel-font;
                   centered: true;
                   color: Theme.text-secondary;}
        }
        VDivider {}
        Text { text: root.value + root.unit; horizontal-stretch: 1;
               font-size: 12px * Theme.panel-font; color: Theme.text-primary;
               horizontal-alignment: center; vertical-alignment: center; }
        VDivider {}
        Rectangle {
            width: 30px;
            background: plus-ta.has-hover ? Theme.bg-hover : transparent;
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(min(root.maximum, root.value + root.step)); }
            }
            IconText { text: "\u{E145}";font-size: 14px * Theme.panel-font;
                   centered: true;
                   color: Theme.text-secondary;}
        }
    }
}

// Compact cursor-shape choice with a live visual sample (#275).
export component CursorStyleButton inherits Rectangle {
    in property <string> label;
    in property <string> cursor-kind;
    in property <bool> selected;
    callback clicked();
    width: 74px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.bg-elevated;
    // 选中态同时改底色与边框色 —— 正是 states 相对三目的优势：一处声明、多属性。
    states [
        selected when root.selected : {
            border-color: Theme.accent;
            background: Theme.accent-tint;
        }
        hovered when cursor-ta.has-hover : { background: Theme.bg-hover; }
    ]
    cursor-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 18px;
                background: Theme.term-bg;
                Rectangle {
                    x: 2px;
                    y: root.cursor-kind == "underline" ? parent.height - 3px : 2px;
                    width: root.cursor-kind == "bar" ? 2px : 10px;
                    height: root.cursor-kind == "underline" ? 2px : 14px;
                    background: Theme.term-fg;
                }
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px * Theme.panel-font;
            vertical-alignment: center;
        }
    }
}

export component CursorPaletteSwatch inherits Rectangle {
    in property <string> hex;
    in property <color> swatch-color;
    in property <bool> selected;
    callback chosen(string);
    width: 26px;
    height: 26px;
    border-radius: 5px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    background: root.swatch-color;
    swatch-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(root.hex); }
    }
}

// 取色控件：左边一个色块按钮、右边 Hex 输入框；点色块打开 **HSV 调色盘**
// （饱和度/明度方块 + 色相条 + 圆形预览 + HEX 输入 + 预设色块）。
//
// 颜色换算全在 Slint 侧：`color.to-hsv()` 给色相（0-360°）与饱和度/明度（0-1），
// 反向用内建的 `hsv(h, s, v)` 构造 —— 只有"提交"才过一次 Rust（`apply-color-rgb`），
// 且**只在松手时提交一次**，免得拖动过程中每帧都去写盘。
//
// 非法 / 不完整的 Hex 仍可编辑，但标红且不应用、不持久化。
export component CursorColorInput inherits Rectangle {
    in-out property <string> value;
    in property <color> preview-color;
    property <bool> valid: true;
    callback apply-color(string) -> bool;
    // 调色盘提交：由 Rust 转成 `#RRGGBB` 并持久化（Slint 侧没有 hex 格式化能力）。
    callback apply-color-rgb(int, int, int) -> bool;

    // 调色盘的实时状态。外部颜色变了（打开面板 / 打字 / 预设 / Rust 回写）就重新同步。
    property <float> hue: 0;
    property <float> sat: 1;
    property <float> val: 1;

    /// 拖动中的实时颜色：不经过 Rust，松手才提交。
    pure function live-color() -> color { return hsv(root.hue, root.sat, root.val); }

    pure function clamp01(v: float) -> float { return max(0.0, min(1.0, v)); }

    /// 方块内的坐标 → 饱和度（横轴）/ 明度（纵轴）。尺寸由调用处传入，免得函数里
    /// 前向引用元素。
    function set-sv(x: length, y: length, w: length, h: length) {
        root.sat = root.clamp01(x / w);
        root.val = root.clamp01(1.0 - y / h);
    }

    /// 色相条位置 → 色相（0-360；上界取 359.9 免得正好回到 0 时指示圈弹到最左）。
    pure function hue-from(x: length, w: length) -> float {
        return max(0.0, min(359.9, (x / w) * 360.0));
    }

    /// 从当前颜色反推 H/S/V。
    function sync-from-color() {
        let c = root.preview-color.to-hsv();
        root.hue = c.hue;
        root.sat = c.saturation;
        root.val = c.value;
    }

    /// 松手提交一次：Rust 负责转 hex、持久化，并把结果回写到 `value` / `preview-color`。
    function commit() {
        let c = root.live-color();
        root.valid = root.apply-color-rgb(c.red, c.green, c.blue);
    }

    init => { root.sync-from-color(); }
    changed preview-color => { root.sync-from-color(); }

    width: 160px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.valid ? Theme.border-subtle : #e05252;
    background: Theme.bg-elevated;
    Rectangle {
        x: 7px;
        y: 6px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: root.preview-color;
        color-button := TouchArea {
            mouse-cursor: pointer;
            clicked => { color-picker.show(); }
        }
    }
    color-input := TextInput {
        input-method-hints: Theme.plain-input-hints;
        x: 34px;
        width: parent.width - 41px;
        height: parent.height;
        text <=> root.value;
        color: Theme.text-primary;
        font-family: Theme.term-font-family;
        font-size: 12px * Theme.panel-font;
        vertical-alignment: center;
        single-line: true;
        changed text => { root.valid = root.apply-color(self.text); }
    }
    color-picker := PopupWindow {
        x: parent.width - self.width;
        y: parent.height + 4px;
        width: 248px;
        height: 400px;
        Rectangle {
            background: Theme.bg-panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.shadow-popup-blur;
            drop-shadow-color: Theme.shadow-popup-color;
            VerticalLayout {
                padding: 10px;
                spacing: 9px;

                // ── 饱和度（横）/ 明度（纵）方块 ──────────────────────────
                // 底色 = 当前色相拉满，再横向叠"白 → 该色相"；纵向叠"透明 → 黑"。
                sv-square := Rectangle {
                    height: 150px;
                    width: 100%;
                    border-radius: 6px;
                    clip: true;
                    background: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1.0, 1.0) 100%);
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(180deg, transparent 0%, #000000 100%);
                    }
                    // 拖动只改本地 H/S/V（不写盘），**松手时**才提交一次。
                    sv-ta := TouchArea {
                        mouse-cursor: pointer;
                        moved => {
                            if (sv-ta.pressed) {
                                root.set-sv(sv-ta.mouse-x, sv-ta.mouse-y, sv-square.width, sv-square.height);
                            }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                root.set-sv(sv-ta.mouse-x, sv-ta.mouse-y, sv-square.width, sv-square.height);
                            }
                            if (ev.kind == PointerEventKind.up) { root.commit(); }
                        }
                    }
                    // 指示圈：位置由 S/V 决定（贴着边缘时不会被裁掉）。
                    Rectangle {
                        x: root.sat * (parent.width - self.width);
                        y: (1.0 - root.val) * (parent.height - self.height);
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: #ffffff;
                        background: transparent;
                        drop-shadow-blur: 3px;
                        drop-shadow-color: #000000a0;
                    }
                }

                // ── 色相条 + 当前颜色预览 ─────────────────────────────────
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    hue-bar := Rectangle {
                        height: 34px;
                        // ⚠️ 布局里**不能**写 `width: 100%`：那表示"占满整个布局宽度"，
                        // 右侧的圆形预览就会被挤出面板（`horizontal-stretch` 才会给它让位）。
                        horizontal-stretch: 1;
                        Rectangle {
                            y: 11px;
                            height: 12px;
                            width: 100%;
                            border-radius: 6px;
                            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.7%, #00ff00 33.3%, #00ffff 50%, #0000ff 66.7%, #ff00ff 83.3%, #ff0000 100%);
                        }
                        hue-ta := TouchArea {
                            mouse-cursor: pointer;
                            moved => {
                                if (hue-ta.pressed) {
                                    root.hue = root.hue-from(hue-ta.mouse-x, hue-ta.width);
                                }
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    root.hue = root.hue-from(hue-ta.mouse-x, hue-ta.width);
                                }
                                if (ev.kind == PointerEventKind.up) { root.commit(); }
                            }
                        }
                        Rectangle {
                            x: (root.hue / 360.0) * (parent.width - self.width);
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: #ffffff;
                            background: transparent;
                            drop-shadow-blur: 3px;
                            drop-shadow-color: #000000a0;
                        }
                    }
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        background: root.live-color();
                    }
                }

                // ── HEX 输入 ─────────────────────────────────────────────
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: "HEX";
                        color: Theme.text-secondary;
                        font-size: 12px * Theme.panel-font;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        // 同上：让输入框吃掉剩余宽度，而不是"占满布局"。
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.valid ? Theme.border-subtle : #e05252;
                        background: Theme.bg-elevated;
                        TextInput {
                            input-method-hints: Theme.plain-input-hints;
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: root.value;
                            color: Theme.text-primary;
                            font-family: Theme.term-font-family;
                            font-size: 12px * Theme.panel-font;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.valid = root.apply-color(self.text); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#D4D4D4"; swatch-color: #D4D4D4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFFFFF"; swatch-color: #FFFFFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF5252"; swatch-color: #FF5252; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF9800"; swatch-color: #FF9800; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFD740"; swatch-color: #FFD740; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#69F0AE"; swatch-color: #69F0AE; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#00E676"; swatch-color: #00E676; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#00E5FF"; swatch-color: #00E5FF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#40C4FF"; swatch-color: #40C4FF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#448AFF"; swatch-color: #448AFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#7C4DFF"; swatch-color: #7C4DFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#E040FB"; swatch-color: #E040FB; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#F48FB1"; swatch-color: #F48FB1; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF8A65"; swatch-color: #FF8A65; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFF176"; swatch-color: #FFF176; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#A5D6A7"; swatch-color: #A5D6A7; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#80CBC4"; swatch-color: #80CBC4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#90CAF9"; swatch-color: #90CAF9; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#B39DDB"; swatch-color: #B39DDB; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#CE93D8"; swatch-color: #CE93D8; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#BCAAA4"; swatch-color: #BCAAA4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#9E9E9E"; swatch-color: #9E9E9E; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#607D8B"; swatch-color: #607D8B; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#2D2D2F"; swatch-color: #2D2D2F; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
            }
        }
    }
}

// A macOS-style wallpaper thumbnail: a rounded, clipped preview (passed via
// @children) with a selection ring + check badge. The label sits below it in
// the page, not inside.
export component WallpaperSwatch inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    width: 120px;
    height: 74px;
    border-radius: 8px;
    border-width: root.selected ? 3px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    clip: true;
    @children
    if root.selected : Rectangle {
        x: parent.width - self.width - 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.accent;
        IconText {
            centered: true;
            text: "\u{E5CA}"; // check
color: white; font-size: 13px * Theme.panel-font;
            width: 100%; height: 100%;

        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
