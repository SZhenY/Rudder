// 设置页：layout
//
// 由 interface_panel.slint 按页拆分而来（阶段 B）。页面只声明自己用到的
// 属性与回调，由 InterfacePanel 在实例化处 `<=>` 双向绑定 / 显式转发 —— 页面内部
// 因此可以保持与改造前逐字一致。

import { SettingSwitch } from "../chrome.slint";
import { SettingsSection } from "../section.slint";
import { ResetBar } from "../reset_bar.slint";

export component LayoutPage inherits VerticalLayout {
    in-out property <bool> show-cmd-bar;
    in-out property <bool> collapse-overview-default;
    in-out property <bool> collapse-sidebar-default;
    in property <bool> lang-en;
    in-out property <bool> quick-commands-as-sidebar;
    callback reset-page(string);
    callback set-show-cmd-bar(bool);
    callback set-collapse-overview-default(bool);
    callback set-collapse-sidebar-default(bool);
    callback set-quick-commands-as-sidebar(bool);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    spacing: 0;
    alignment: start;
    SettingsSection {
        section-id: "layout.sidebars";
        lang-en: root.lang-en;
        title-zh: "侧栏";
        title-en: "SIDEBARS";
        title-height: 24px;
        SettingSwitch {
            label: root.lang-en ? "Collapse the navigation by default" : "默认收起左侧导航";
            checked <=> root.collapse-sidebar-default;
            toggled(v) => { root.set-collapse-sidebar-default(v); }
        }
        SettingSwitch {
            label: root.lang-en ? "Collapse the SFTP panel by default" : "默认收起 SFTP 侧栏";
            desc: root.lang-en
                ? "Takes effect on next launch; handy on low-spec jump hosts."
                : "下次启动生效;低配跳板机上可减少常驻面板开销。";
            checked <=> root.collapse-overview-default;
            toggled(v) => { root.set-collapse-overview-default(v); }
        }
        SettingSwitch {
            label: root.lang-en ? "Quick commands as a sidebar" : "快捷命令作为侧栏";
            desc: root.lang-en
                ? "Show the quick-command panel docked to the right edge of the window."
                : "在窗口右侧显示快捷命令面板。";
            show-divider: false;
            checked <=> root.quick-commands-as-sidebar;
            toggled(v) => { root.set-quick-commands-as-sidebar(v); }
        }
    }
    SettingsSection {
        section-id: "layout.cmd-bar";
        lang-en: root.lang-en;
        title-zh: "命令栏";
        title-en: "COMMAND BAR";
        title-height: 24px;
        // 终端底部那条输入条（快捷命令 + 命令历史）。此前**只有**右上角工具栏那个代码
        // 图标能切换它，设置里没有入口 —— 用户把它关掉后就再也找不回来了。
        //
        // 开关**默认打开**（= 出厂默认命令栏可见）。整条链路都是正向语义
        // `show-cmd-bar`，只有 config 字段仍是反向的 hide_cmd_bar —— 翻转集中在
        // Rust 侧三处（播种 / 持久化回调 / 还原），UI 侧不出现取反。
        SettingSwitch {
            label: root.lang-en ? "Show the command bar" : "显示命令栏";
            desc: root.lang-en
                ? "The strip under the terminal: quick commands and command history. The same switch as the code icon in the top-right toolbar."
                : "终端下方的输入条：快捷命令与命令历史。与右上角工具栏的代码图标是同一个开关（两边状态同步）。";
            show-divider: false;
            checked <=> root.show-cmd-bar;
            toggled(v) => { root.set-show-cmd-bar(v); }
        }

        // 还原本页默认（本页最后一个设置项之后）
    }
    ResetBar {
        page-id: "layout";
        reset-page(p) => { root.reset-page(p); }
    }
}
