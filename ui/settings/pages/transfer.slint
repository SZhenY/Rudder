// 设置页：transfer
//
// 由 interface_panel.slint 按页拆分而来（阶段 B）。页面只声明自己用到的
// 属性与回调，由 InterfacePanel 在实例化处 `<=>` 双向绑定 / 显式转发 —— 页面内部
// 因此可以保持与改造前逐字一致。

import { SettingRow, SettingSwitch } from "../chrome.slint";
import { SettingsSection } from "../section.slint";
import { ResetBar } from "../reset_bar.slint";

export component TransferPage inherits VerticalLayout {
    in-out property <bool> download-always-ask;
    in property <bool> lang-en;
    in-out property <bool> sftp-follow-cd;
    callback reset-page(string);
    callback set-download-always-ask(bool);
    callback set-sftp-follow-cd(bool);

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    spacing: 0;
    alignment: start;
    SettingsSection {
        section-id: "transfer.sftp";
        lang-en: root.lang-en;
        title-zh: "SFTP";
        title-en: "SFTP";
        SettingSwitch {
            label: root.lang-en ? "SFTP follows terminal cd" : "SFTP 跟随 cd 更新";
            desc: root.lang-en
                ? "A cd in the terminal switches the SFTP panel to the same directory."
                : "终端里执行 cd 时,SFTP 面板自动切到相同目录。";
            show-divider: false;

            checked <=> root.sftp-follow-cd;
            toggled(v) => { root.set-sftp-follow-cd(root.sftp-follow-cd); }

        }
    }
    SettingsSection {
        section-id: "transfer.download";
        lang-en: root.lang-en;
        title-zh: "下载";
        title-en: "DOWNLOAD";
        SettingSwitch {
            label: root.lang-en ? "Always ask where to save" : "总是询问保存去何处";
            desc: root.lang-en
                ? "Every download prompts for a location instead of using the preset folder."
                : "每次下载都询问保存位置,而不是直接存到预设下载目录。";
            show-divider: false;

            checked <=> root.download-always-ask;
            toggled(v) => { root.set-download-always-ask(root.download-always-ask); }

        }
    }
            
    // 还原本页默认（本页最后一个设置项之后）
    ResetBar {
        page-id: "transfer";
        reset-page(p) => { root.reset-page(p); }
    }
}
