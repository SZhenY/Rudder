// 设置页：AI（进程内 MCP server）
//
// 这一页只做三件事：开关服务、勾选监听面、逐个授权工具。令牌明文只在用户
// 主动点「显示 / 复制」时由 Rust 填进来（`mcp-token-plain`），平时只有掩码。

import { Theme, AnimationSettings } from "../../theme.slint";
import { SettingsSection } from "../section.slint";
import { SettingRow, SettingSwitch, ToggleSwitch } from "../chrome.slint";
import { GhostButton } from "../../widgets.slint";
import { ResetBar } from "../reset_bar.slint";
import { Divider, GroupGap } from "../../components/surfaces.slint";
import { StateSurface } from "../../components/interactive.slint";
import { IconText } from "../../components/text.slint";
import { ScrollView } from "std-widgets.slint";
import { AuditRow, McpClientRow, McpCloseRow, McpGrantRow, McpIface } from "../types.slint";

export component AiPage inherits VerticalLayout {
    in property <bool> lang-en;

    in-out property <bool> mcp-enabled;
    in-out property <string> mcp-port: "8765";
    in-out property <bool> mcp-port-valid: true;
    in property <string> mcp-status;
    in property <string> mcp-status-error;
    in property <[string]> mcp-urls;
    in-out property <bool> mcp-lan-enabled;
    in property <[McpIface]> mcp-ifaces;
    in property <string> mcp-token-masked;
    in property <string> mcp-token-plain;
    in-out property <bool> mcp-token-visible;
    /// 「重新生成」的两段式确认（与 ResetBar 同一套：第一下上膛，第二下才执行）。
    /// 换令牌会踢掉所有已连的客户端，不该一下点到就生效。
    property <bool> regen-armed: false;
    // 可直接粘贴的客户端配置：明文 / 掩码两份，显示哪份由上面的「显示」开关决定。
    in property <string> mcp-json;
    in property <string> mcp-json-masked;

    callback set-mcp-enabled(bool);
    callback set-mcp-port(string) -> bool;
    callback set-mcp-lan(bool);
    callback toggle-mcp-iface(string);
    callback copy-mcp-token();
    callback regenerate-mcp-token();
    callback copy-mcp-json();

    // 已接入的客户端：每个客户端一行 header + 12 行权限开关（扁平模型）。
    in property <[McpClientRow]> mcp-clients;
    /// 已记住的客户端授权（离线可撤销）。
    in property <[McpGrantRow]> mcp-grants;
    callback toggle-mcp-client-permission(string, string, bool);
    callback disconnect-mcp-client(string);
    callback set-mcp-client-trusted(string /* client-id */, bool);
    callback toggle-mcp-client-expanded(string /* session-id */);
    callback forget-mcp-grant(string /* grant id */);
    callback reset-page(string);

    // 执行通道：开 = run_command 走交互式 PTY（命令与输出显示在终端里）
    in-out property <bool> mcp-pty-commands: false;
    // 审计
    in-out property <bool> mcp-audit-enabled: true;
    in-out property <string> mcp-audit-retention: "14";
    in-out property <bool> mcp-audit-retention-valid: true;
    in property <bool> mcp-audit-degraded;
    in property <[AuditRow]> mcp-recent-calls;
    in property <[McpCloseRow]> mcp-recent-closes;
    callback set-mcp-pty-commands(bool);
    callback set-mcp-audit-enabled(bool);
    callback set-mcp-audit-retention(string) -> bool;
    callback open-mcp-log-dir();

    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    spacing: 0;
    alignment: start;

    SettingsSection {
        section-id: "ai.server";
        lang-en: root.lang-en;
        title-zh: "AI 访问";
        title-en: "AI ACCESS";
        title-height: 24px;

        SettingSwitch {
            label: root.lang-en ? "Enable MCP server" : "启用 MCP 服务";
            desc: root.lang-en
                ? "Lets an AI agent connect over HTTP and drive this running window. Off by default."
                : "允许 AI agent 通过 HTTP 连接并操作这个正在运行的窗口。默认关闭。";
            show-divider: true;
            checked <=> root.mcp-enabled;
            toggled(v) => { root.set-mcp-enabled(v); }
        }

        SettingSwitch {
            label: root.lang-en ? "Run commands in the terminal" : "在终端里执行命令";
            desc: root.lang-en
                ? "On: commands and their output show up in your terminal, and full-screen apps (vim/htop) get a new tab instead. Off: a one-shot exec channel runs them invisibly."
                : "开：命令与输出显示在你的终端里，正在跑 vim/htop 这类全屏程序时会另开一个标签页执行。关：走一次性 exec 通道，不碰终端。";
            show-divider: false;
            checked <=> root.mcp-pty-commands;
            toggled(v) => { root.set-mcp-pty-commands(v); }
        }

        // 端口：`TextInput` 逐键生效（写盘自带防抖）；非法值由 Rust 返回 false，红框提示。
        SettingRow {
            label: root.lang-en ? "Port" : "端口";
            desc: root.lang-en
                ? "Listens on 127.0.0.1 by default. Override to 1024–65535 if 8765 is taken."
                : "默认只监听 127.0.0.1。8765 被占用时可改成 1024–65535。";
            Rectangle {
                width: 110px;
                height: 30px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.mcp-port-valid ? Theme.border-subtle : Theme.danger;
                background: root.mcp-enabled ? Theme.bg-root : Theme.bg-elevated;
                animate background {
                    duration: AnimationSettings.short2();
                    enabled: AnimationSettings.enabled;
                }
                animate border-color {
                    duration: AnimationSettings.short2();
                    easing: AnimationSettings.e-standard-decelerate();
                    enabled: AnimationSettings.enabled;
                }
                input := TextInput {
                    input-method-hints: Theme.plain-input-hints;
                    enabled: root.mcp-enabled;
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    color: root.mcp-enabled ? Theme.text-primary : Theme.text-muted;
                    text <=> root.mcp-port;
                    edited => { root.mcp-port-valid = root.set-mcp-port(root.mcp-port); }
                }
            }
        }

        // 状态：一行文字 + 可粘贴地址。错误用主色红字。
        SettingRow {
            label: root.lang-en ? "Status" : "状态";
            desc: root.mcp-status-error == "" ? "" : root.mcp-status-error;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.mcp-status;
                    color: root.mcp-status-error == "" ? Theme.text-secondary : Theme.danger;
                    font-size: 12px * Theme.panel-font;
                    horizontal-alignment: right;
                }
                for url in root.mcp-urls : Text {
                    text: url;
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    horizontal-alignment: right;
                }
            }
        }
    }


    GroupGap { gap: Theme.gap-sm; }

    SettingsSection {
        section-id: "ai.token";
        lang-en: root.lang-en;
        title-zh: "令牌与客户端配置";
        title-en: "TOKEN & CLIENT CONFIG";
        title-height: 24px;

        SettingRow {
            label: root.lang-en ? "Bearer token" : "Bearer 令牌";
            desc: root.lang-en
                ? "The agent must send this as `Authorization: Bearer <token>`. Stored encrypted. The snippet right below is what you paste into the client."
                : "agent 需要在请求头带 `Authorization: Bearer <令牌>`。令牌加密存储。下面那段就是粘进客户端的配置。";
            // 令牌本体在下面单独占一行：塞进右侧内容槽的话，67 字符的明文
            // （约 440px）会把最小宽度顶到槽外，三个按钮被甩出可视区。
            show-divider: false;
        }

        // 令牌区：通栏两行 —— 令牌一行（等宽、必要时折行），按钮另起一行右对齐。
        VerticalLayout {
            padding-top: 2px;
            padding-bottom: 9px;
            spacing: 8px;

            Text {
                text: root.mcp-token-visible ? root.mcp-token-plain : root.mcp-token-masked;
                color: Theme.text-secondary;
                font-family: Theme.font-mono;
                font-size: 12px * Theme.panel-font;
                // 67 字符没有空格，`word-wrap` 会对超长单词按任意位置断开；
                // `char-wrap` 只有 Qt / 软件渲染器支持，这里不能用。
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                // 服务关着时令牌没有校验对象，四个按钮一律置灰 —— 「复制配置」也不再
                // 例外：配置框本身已经隐藏，复制一份看不见的内容没有意义。
                GhostButton {
                    text: root.mcp-token-visible
                        ? (root.lang-en ? "Hide" : "隐藏")
                        : (root.lang-en ? "Show" : "显示");
                    disabled: !root.mcp-enabled;
                    clicked => { root.mcp-token-visible = !root.mcp-token-visible; }
                }
                GhostButton {
                    text: root.lang-en ? "Copy" : "复制";
                    disabled: !root.mcp-enabled;
                    clicked => { root.copy-mcp-token(); }
                }
                GhostButton {
                    text: root.regen-armed
                        ? (root.lang-en ? "Confirm?" : "确认重新生成？")
                        : (root.lang-en ? "Regenerate" : "重新生成");
                    disabled: !root.mcp-enabled;
                    clicked => {
                        if (root.regen-armed) {
                            root.regen-armed = false;
                            root.regenerate-mcp-token();
                        } else {
                            root.regen-armed = true;
                        }
                    }
                }
            }
        }

        // 令牌区与 mcp.json 行之间的分隔线（原来挂在令牌行底部）。
        Divider {}

        // 可整段粘进客户端（`mcpServers` 结构）的 JSON：省掉手写地址与 Bearer 头，
        // 这两样恰好最容易填错、也最容易过期。
        SettingRow {
            label: "mcp.json";
            desc: root.lang-en
                ? "Paste as-is into your MCP client. Copy always takes the real token; the preview stays masked until you press Show above."
                : "整段粘进客户端的 MCP 配置文件即可连接。「复制配置」始终复制完整令牌；预览框在你点上面的「显示」之前只显示掩码。";
            // 代码框属于这一行，不画分隔线。
            show-divider: false;
            GhostButton {
                text: root.lang-en ? "Copy config" : "复制配置";
                disabled: !root.mcp-enabled;
                clicked => { root.copy-mcp-json(); }
            }
        }

        // 服务关着时没有可粘贴的配置：整块不参与布局（`visible:false` 仍占位）。
        if root.mcp-enabled : VerticalLayout {
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 0;

            Rectangle {
                // 固定高度而不是按内容撑开：`TextInput` 的 preferred-height 在
                // 未约束宽度时不等于换行后的高度，绑上去会算错。224 × 0.8：11 行片段
                // 在默认字号下约占 141–152px，余 11–22px；字号放大时截断而不外溢。
                height: 179px;
                clip: true;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                background: Theme.bg-root;

                TextInput {
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    font-family: Theme.font-mono;
                    font-size: 11px * Theme.panel-font;
                    color: Theme.text-primary;
                    text: root.mcp-token-visible ? root.mcp-json : root.mcp-json-masked;
                }

                // 启用但令牌被外部清空时的兜底：给一句说明，而不是一个空框。
                if root.mcp-json == "" : Text {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    text: root.lang-en
                        ? "Turn the MCP server on first: the snippet appears once a token exists."
                        : "先启用 MCP 服务：生成令牌后这里才会出现配置。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
            }
        }

        // 关服务时只留一句话：代码框整块换掉，不留空框也不留边框。
        if !root.mcp-enabled : VerticalLayout {
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 0;

            Text {
                text: root.lang-en
                    ? "Turn the MCP server on: the paste-ready snippet appears here."
                    : "启用 MCP 服务后这里显示可粘贴的客户端配置。";
                color: Theme.text-muted;
                font-size: 11px * Theme.panel-font;
                wrap: word-wrap;
            }
        }
    }

    GroupGap { gap: Theme.gap-sm; }

    // ── 已接入的客户端 ──────────────────────────────────────────────────
    SettingsSection {
        section-id: "ai.clients";
        lang-en: root.lang-en;
        title-zh: "客户端";
        title-en: "CLIENTS";
        title-height: 24px;

        if root.mcp-clients.length == 0 : Text {
            text: root.lang-en ? "No client connected." : "当前没有客户端连接。";
            color: Theme.text-muted;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            height: 36px;
        }

        // 折叠必须用 `if` 而不是 `visible`：Slint 的 visible:false 只是不绘制，
        // 仍然占据布局空间 —— 12 行权限会留下近 600px 的空白。
        for row in root.mcp-clients : VerticalLayout {
            spacing: 0;

            if row.kind == "header" : StateSurface {
                radius: Theme.radius-sm;
                clicked => { root.toggle-mcp-client-expanded(row.session-id); }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    padding-top: 8px;
                    padding-bottom: 4px;
                    spacing: 8px;

                    IconText {
                        text: row.expanded ? "\u{E5CF}" : "\u{E5CC}";
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        // 名称块吃掉剩余宽度：「断开」才会贴右边缘，长名字也会在这里截断。
                        // 不能给这个 HorizontalLayout 写 alignment —— 主轴对齐一设，
                        // 所有 horizontal-stretch 失效，整块会缩成首选宽度并居中。
                        horizontal-stretch: 1;
                        min-width: 0;
                        spacing: 2px;
                        Text {
                            text: row.client;
                            font-size: 13px * Theme.panel-font;
                            color: Theme.text-primary;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: row.since + " · " + row.status;
                            font-size: 11px * Theme.panel-font;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        // 竖排包一层做交叉轴居中：22px 的开关在横排里会被固定高度钉在顶部，
                        // 与旁边可拉伸的 Text 差约 6px。横排的 alignment 是主轴对齐，管不到这里。
                        VerticalLayout {
                            alignment: center;
                            ToggleSwitch {
                                checked: row.trusted;
                                // 值由模型提供：点击只发意图，别在本地改 checked 把绑定拆掉。
                                mirror: true;
                                // 客户端没上报名字时无法记忆授权，开关置灰（Rust 侧会直接忽略）。
                                interactive: row.client-id != "";
                                toggled(v) => { root.set-mcp-client-trusted(row.client-id, v); }
                            }
                        }
                        Text {
                            text: root.lang-en ? "Trust" : "永久信任";
                            color: Theme.text-muted;
                            font-size: 11px * Theme.panel-font;
                            vertical-alignment: center;
                        }
                    }
                    // 30px 的按钮同样需要竖排包装才能在行内容盒里居中（行 padding 上 8 / 下 4）。
                    VerticalLayout {
                        alignment: center;
                        GhostButton {
                            text: root.lang-en ? "Disconnect" : "断开";
                            clicked => { root.disconnect-mcp-client(row.session-id); }
                        }
                    }
                }
            }

            if row.kind == "permission" && row.expanded : VerticalLayout {
                spacing: 0;

                if row.risk != "" : VerticalLayout {
                    spacing: 2px;
                    padding-top: 8px;
                    padding-bottom: 2px;
                    Text {
                        text: row.risk;
                        font-size: 12px * Theme.panel-font;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    if row.risk-note != "" : Text {
                        text: row.risk-note;
                        font-size: 11px * Theme.panel-font;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }

                if row.group != "" : Text {
                    text: row.group;
                    font-size: 11px * Theme.panel-font;
                    font-weight: 700;
                    color: Theme.text-muted;
                    height: 24px;
                    vertical-alignment: bottom;
                }

                SettingSwitch {
                    label: row.label;
                    desc: row.desc;
                    interactive: root.mcp-enabled;
                    mirror: true;
                    checked: row.enabled;
                    toggled(v) => { root.toggle-mcp-client-permission(row.session-id, row.key, v); }
                }
            }
        }

        // 会话为什么结束 —— 卡片消失时的归因入口，不必再翻审计日志。
        SettingRow {
            label: root.lang-en ? "Recently closed" : "最近断开";
            desc: root.lang-en
                ? "Session endings Rudder observed. \"closed by the client\" and \"idle for 15 minutes\" come from the client or the MCP runtime, not from Rudder."
                : "Rudder 侧观察到的会话结束。「客户端主动关闭」「闲置 15 分钟被回收」来自客户端或 MCP 运行时，不是 Rudder 主动断开。";
            show-divider: false;
            Rectangle {
                width: 100%;
                height: 108px;
                background: Theme.bg-root;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    content-width: self.width;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        if root.mcp-recent-closes.length == 0 : Text {
                            text: root.lang-en ? "No session has ended yet." : "还没有会话结束的记录。";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            height: 20px;
                        }
                        for item in root.mcp-recent-closes : HorizontalLayout {
                            height: 20px;
                            spacing: 8px;
                            Text {
                                text: item.at;
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.session;
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: 62px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.client;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-xs;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: item.reason;
                                color: item.alarm ? Theme.danger : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                // 长 reason（带「接入 N 秒即断开」后缀）要能被压缩，
                                // 否则会把左边的 client 列挤掉、还会被滚动条压住。
                                horizontal-stretch: 1;
                                min-width: 0;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    GroupGap { gap: Theme.gap-sm; }

    // ── 已记住的客户端 ──────────────────────────────────────────────────
    // 记忆授权是持久化的：客户端不在线也要能撤销，否则「永久信任」一旦点错就没救。
    SettingsSection {
        section-id: "ai.grants";
        lang-en: root.lang-en;
        title-zh: "已记住的客户端";
        title-en: "REMEMBERED CLIENTS";
        title-height: 24px;

        if root.mcp-grants.length == 0 : Text {
            text: root.lang-en
                ? "Nothing remembered yet. Allowing a client remembers it for 15 minutes."
                : "暂时没有记住的客户端。允许接入后会记住 15 分钟。";
            color: Theme.text-muted;
            font-size: 11px * Theme.panel-font;
            wrap: word-wrap;
            height: 40px;
            vertical-alignment: center;
        }

        for grant in root.mcp-grants : HorizontalLayout {
            height: 34px;
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0;
                alignment: center;
                spacing: 1px;
                Text {
                    text: grant.client;
                    color: Theme.text-primary;
                    font-size: 12px * Theme.panel-font;
                    overflow: elide;
                }
                Text {
                    text: (grant.device == "" ? "" : grant.device + " · ") + grant.permissions;
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    overflow: elide;
                }
            }

            if grant.trusted : Text {
                text: root.lang-en ? "trusted" : "永久";
                color: Theme.accent;
                font-size: 11px * Theme.panel-font;
                vertical-alignment: center;
            }

            // 30px 的按钮在 34px 行里会被钉在顶部，包一层竖排才能和左侧两行文字对齐。
            VerticalLayout {
                alignment: center;
                GhostButton {
                    text: root.lang-en ? "Forget" : "撤销";
                    clicked => { root.forget-mcp-grant(grant.id); }
                }
            }
        }
    }

    GroupGap { gap: Theme.gap-sm; }

    SettingsSection {
        section-id: "ai.network";
        lang-en: root.lang-en;
        title-zh: "网络（高级）";
        title-en: "NETWORK (ADVANCED)";
        title-height: 24px;

        SettingSwitch {
            label: root.lang-en ? "Also listen on LAN interfaces" : "同时监听局域网网口";
            desc: root.lang-en
                ? "Off = loopback only. Each ticked interface gets its own listener; 0.0.0.0 is never used."
                : "关闭时只监听本机回环。勾选的每个网口各起一个 listener，绝不绑 0.0.0.0。";
            show-divider: root.mcp-enabled && root.mcp-lan-enabled && root.mcp-ifaces.length > 0;
            interactive: root.mcp-enabled;
            checked <=> root.mcp-lan-enabled;
            toggled(v) => { root.set-mcp-lan(v); }
        }

        // 只要配置了局域网就列出网口（关着服务也列，让用户看到勾了哪些），
        // 能不能改由下面的 `interactive` 决定。
        if root.mcp-lan-enabled : VerticalLayout {
            for iface in root.mcp-ifaces : HorizontalLayout {
                height: 30px;
                spacing: 10px;
                Text {
                    text: iface.name + "   " + iface.addr;
                    color: Theme.text-secondary;
                    font-size: 12px * Theme.panel-font;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // 22px 开关在 30px 行里同样贴顶，包一层竖排居中。
                VerticalLayout {
                    alignment: center;
                    ToggleSwitch {
                        mirror: true;
                        checked: iface.enabled;
                        interactive: root.mcp-enabled;
                        toggled(v) => { root.toggle-mcp-iface(iface.name); }
                    }
                }
            }
        }
    }

    GroupGap { gap: Theme.gap-sm; }

    // ── 审计日志 ────────────────────────────────────────────────────────
    SettingsSection {
        section-id: "ai.audit";
        lang-en: root.lang-en;
        title-zh: "审计日志";
        title-en: "AUDIT LOG";
        title-height: 24px;

        SettingSwitch {
            label: root.lang-en ? "Record tool calls" : "记录工具调用";
            desc: root.lang-en
                ? "One NDJSON line per call, rotated daily under log/. Passwords and typed text are never written."
                : "每次调用写一行 NDJSON，按天切分放在 log/ 下。口令与输入正文不会写入。";
            show-divider: true;
            checked <=> root.mcp-audit-enabled;
            toggled(v) => { root.set-mcp-audit-enabled(v); }
        }

        SettingRow {
            label: root.lang-en ? "Keep for" : "保留天数";
            desc: root.lang-en
                ? "0 = keep forever. Older audit-YYYY-MM-DD.ndjson files are removed on day change."
                : "0 = 永久保留。换天时删除超过该天数的 audit-YYYY-MM-DD.ndjson。";
            show-divider: !root.mcp-audit-degraded;
            Rectangle {
                width: 110px;
                height: 30px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.mcp-audit-retention-valid ? Theme.border-subtle : Theme.danger;
                background: root.mcp-audit-enabled ? Theme.bg-root : Theme.bg-elevated;
                animate background {
                    duration: AnimationSettings.short2();
                    enabled: AnimationSettings.enabled;
                }
                animate border-color {
                    duration: AnimationSettings.short2();
                    easing: AnimationSettings.e-standard-decelerate();
                    enabled: AnimationSettings.enabled;
                }
                TextInput {
                    input-method-hints: Theme.plain-input-hints;
                    enabled: root.mcp-audit-enabled;
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    color: root.mcp-audit-enabled ? Theme.text-primary : Theme.text-muted;
                    text <=> root.mcp-audit-retention;
                    edited => {
                        root.mcp-audit-retention-valid = root.set-mcp-audit-retention(root.mcp-audit-retention);
                    }
                }
            }
        }

        if root.mcp-audit-degraded : SettingRow {
            label: root.lang-en ? "Status" : "状态";
            desc: root.lang-en
                ? "Audit is degraded: the log directory is not writable. Tool calls keep working."
                : "审计已降级：日志目录不可写。工具调用不受影响。";
            show-divider: false;
        }

        SettingRow {
            label: root.lang-en ? "Recent calls" : "最近调用";
            desc: "";
            show-divider: true;
            Rectangle {
                width: 100%;
                height: 132px;
                background: Theme.bg-root;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                ScrollView {
                    width: 100%;
                    height: 100%;
                    content-width: self.width;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        if root.mcp-recent-calls.length == 0 : Text {
                            text: root.lang-en ? "No calls yet." : "还没有调用记录。";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            height: 20px;
                        }
                        for call in root.mcp-recent-calls : HorizontalLayout {
                            height: 20px;
                            spacing: 8px;
                            Text {
                                text: call.at;
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: 56px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: call.tool;
                                color: call.ok ? Theme.text-primary : Theme.danger;
                                font-size: Theme.fs-xs;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: call.ok ? (call.ms + " ms") : call.result;
                                color: call.ok ? Theme.text-muted : Theme.danger;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        SettingRow {
            label: root.lang-en ? "Log folder" : "日志目录";
            desc: "";
            show-divider: false;
            GhostButton {
                text: root.lang-en ? "Open" : "打开";
                clicked => { root.open-mcp-log-dir(); }
            }
        }
    }

    // 「还原本页默认」：只重置设置项，不动令牌与已记住的授权（见 Rust 侧 `ai::reset`）。
    ResetBar {
        page-id: "ai";
        reset-page(p) => { root.reset-page(p); }
    }
}
