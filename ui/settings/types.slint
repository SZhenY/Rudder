// 设置页与其他 UI 共享的数据结构（Slint 官方 `struct` + 跨文件 import）。
//
// 从 interface_panel.slint 抽出（阶段 B）：Rust 侧直接把这些结构体填进模型，
// 因此它们属于**跨组件的公共契约**，不该绑在某一个页面文件里。
//
// 注意：改字段名会同时影响 Rust 侧（`include_modules!` 生成的同名类型）。
export struct OutputRuleItem {
    pattern: string,
    regex: bool,
    case-sensitive: bool,
    whole-line: bool,
    color: string,
    enabled: bool,
}

export struct WslProfileInfo {
    id: string,
    name: string,
    distribution: string,
    directory: string,
}

/// 配色方案里的一个预设主题色。
///
/// `color` 是**当前深浅档下已解析好的颜色** —— 深浅两档的可读性要求不同（浅底上要
/// 更深的同色系），色表因此在 Rust 侧按档位取值后送进来；Slint 侧只负责画，不存
/// 第二份色表（否则两处必然漂移）。
export struct AccentPreset {
    /// 稳定的预设 id（存进配置），如 "aurora"。
    id: string,
    /// 已按语言选好的显示名。
    name: string,
    color: color,
}

/// AI 设置页：一个可勾选的局域网网口。
export struct McpIface {
    name: string,
    addr: string,
    enabled: bool,
}

/// AI 设置页：一条审计记录（只含展示所需的最小集）。
export struct AuditRow {
    at: string,
    tool: string,
    result: string,
    ok: bool,
    ms: int,
    client: string,
}

/// 授权确认框里的一行。`risk`/`group` 非空表示该组的第一行。
export struct McpConsentRow {
    key: string,
    label: string,
    desc: string,
    checked: bool,
    allowed: bool,
    risk: string,
    risk-note: string,
    group: string,
}

/// AI 设置页：客户端列表的扁平行。
///
/// `kind == "header"` 是客户端标题（client/since/status + 断开），
/// `kind == "permission"` 是该客户端的一位权限开关（session-id + key）。
export struct McpClientRow {
    kind: string,
    session-id: string,
    client: string,
    since: string,
    status: string,
    key: string,
    label: string,
    desc: string,
    enabled: bool,
    risk: string,
    risk-note: string,
    group: string,
}
