// 设置页与其他 UI 共享的数据结构（Slint 官方 `struct` + 跨文件 import）。
//
// 从 interface_panel.slint 抽出（阶段 B）：Rust 侧直接把这些结构体填进模型，
// 因此它们属于**跨组件的公共契约**，不该绑在某一个页面文件里。
//
// 注意：改字段名会同时影响 Rust 侧（`include_modules!` 生成的同名类型）。
export struct OutputRuleItem {
    pattern: string,
    regex: bool,
    case-sensitive: bool,
    whole-line: bool,
    color: string,
    enabled: bool,
}

export struct WslProfileInfo {
    id: string,
    name: string,
    distribution: string,
    directory: string,
}

/// 配色方案里的一个预设主题色。
///
/// `color` 是**当前深浅档下已解析好的颜色** —— 深浅两档的可读性要求不同（浅底上要
/// 更深的同色系），色表因此在 Rust 侧按档位取值后送进来；Slint 侧只负责画，不存
/// 第二份色表（否则两处必然漂移）。
export struct AccentPreset {
    /// 稳定的预设 id（存进配置），如 "aurora"。
    id: string,
    /// 已按语言选好的显示名。
    name: string,
    color: color,
}

/// AI 设置页：一个可勾选的局域网网口。
export struct McpIface {
    name: string,
    addr: string,
    enabled: bool,
}

/// AI 页「最近断开」的一行。`reason` 已按语言翻译好，`alarm` 决定是否用告警色。
export struct McpCloseRow {
    at: string,
    session: string,
    client: string,
    reason: string,
    alarm: bool,
}

/// AI 页「已记住的客户端」一行。对应一条持久化的记忆授权，**离线也能撤销** ——
/// 之前只能从在线卡片上取消永久信任，客户端不在线就撤不掉。
export struct McpGrantRow {
    /// 记忆主键：`名称 版本@设备`。
    id: string,
    /// 客户端名（去掉 `@设备` 后缀）。
    client: string,
    /// 来源：`local` 或 IP。
    device: string,
    /// 已记住的权限（短名摘要）。
    permissions: string,
    /// 是否永久信任（否则只是 15 分钟窗口内的记忆）。
    trusted: bool,
}

/// AI 设置页：一条审计记录（工具调用）。
export struct AuditRow {
    at: string,
    tool: string,
    result: string,
    ok: bool,
    ms: int,
    client: string,
}

/// 授权确认框里的一行。`risk`/`group` 非空表示该组的第一行。
export struct McpConsentRow {
    key: string,
    label: string,
    desc: string,
    checked: bool,
    risk: string,
    risk-note: string,
    group: string,
    /// 组 id（`routine.view` / `high.terminal` …）：同组每行同值，用于"折叠某一组"。
    section: string,
    /// 该行是不是组首行（只有组首行画组标题、显示组内计数）。
    section-head: bool,
    /// 组内多于 1 位才可折叠；单条组直接平铺在段里，没有标题可点。
    section-collapsible: bool,
    /// 同组每行同值 —— Slint 的 for 平铺渲染无法跨行查找，只能把展开态复制到每一行。
    expanded: bool,
    /// 组内已勾选数（仅组首行有意义）。
    on-count: int,
    /// 组内总位数（仅组首行有意义）。
    total-count: int,
}

/// AI 设置页：客户端列表的扁平行。
///
/// `kind == "header"` 是客户端标题（client/since/status + 断开），
/// `kind == "permission"` 是该客户端的一位权限开关（session-id + key）。
export struct McpClientRow {
    kind: string,
    session-id: string,
    client: string,
    since: string,
    status: string,
    /// 该客户端的记忆标识（`client_name + version`）；空 = 客户端没上报名字，无法记忆。
    client-id: string,
    /// 「永久信任」当前状态，驱动卡片上的开关。
    trusted: bool,
    /// 该客户端卡片的权限明细是否展开（header 与它下面的 12 行同值）。
    /// 模型行数恒定（折叠不改模型），渲染侧用 `if` —— Slint 的 `visible:false` 仍占布局空间。
    expanded: bool,
    key: string,
    label: string,
    desc: string,
    enabled: bool,
    risk: string,
    risk-note: string,
    group: string,
}
