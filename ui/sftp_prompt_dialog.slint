//! SFTP 的**单行输入**弹窗（#69）：重命名 / chmod / 新建目录 / 新建文件共用。
//!
//! 从 `app.slint` 拆出（P4 B 类）：显隐由调用点判断，组件只负责呈现；
//! 关闭弹窗上抛 `close-requested()`（不直接改窗口状态）。

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { LineEdit, Button } from "std-widgets.slint";
import { ModalCard } from "components/surfaces.slint";

export component SftpPromptDialog inherits ModalCard {
    // 显隐由调用点控制：**常驻**，不用 `if` 包着 —— 在事件派发栈上销毁
    // 正在处理事件的子树会闪退（#323/#343）。
    in property <bool> open: false;
    visible: open;
    active: open;          // 关闭时不吞掉整窗点击
    // ── 状态（窗口透传）──────────────────────────────────────────────
    in property <bool> lang-en: false;
    in property <string> sftp-prompt-kind;
    in property <string> sftp-prompt-tab;
    in property <string> sftp-prompt-target;
    in-out property <string> sftp-prompt-value;

    // ── 动作：由调用点转发（实现仍在 Rust / 窗口）────────────────────
    callback close-requested();
    callback sftp-prompt-submit(string /* tab */, string /* kind */, string /* target */, string /* value */);

    card-width: 340px;
    card-height: 178px;
    radius: Theme.radius-md;
    dismissed() => { root.close-requested(); }
    Text {
        text: sftp-prompt-kind == "rename"
            ? @tr("Rename")
            : (sftp-prompt-kind == "chmod"
                ? @tr("Permissions")
                : (sftp-prompt-kind == "mkdir"
                    ? @tr("New folder") : @tr("New file")));
        color: Theme.text-primary;
        font-size: Theme.fs-lg;
        font-weight: 700;
    }
    Text {
        text: sftp-prompt-kind == "chmod"
            ? @tr("Octal mode, e.g. 755")
            : (sftp-prompt-kind == "rename"
                ? @tr("New name") : @tr("Name"));
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
    }
    sp-input := LineEdit {
        text <=> sftp-prompt-value;
        font-family: Theme.ui-font-family; // CJK-capable (#54)
        placeholder-text: sftp-prompt-kind == "chmod" ? "755" : "";
        accepted => {
            if (sftp-prompt-value != "") {
                root.sftp-prompt-submit(
                    sftp-prompt-tab, sftp-prompt-kind,
                    sftp-prompt-target, sftp-prompt-value);
                root.close-requested();
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: lang-en ? "Cancel" : "取消";
            clicked => { root.close-requested(); }
        }
        Button {
            text: lang-en ? "OK" : "确定";
            primary: true;
            enabled: sftp-prompt-value != "";
            clicked => {
                root.sftp-prompt-submit(
                    sftp-prompt-tab, sftp-prompt-kind,
                    sftp-prompt-target, sftp-prompt-value);
                root.close-requested();
            }
        }
    }
}
