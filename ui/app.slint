    }
    // --- Quick-command manage dialog (#55) --------------------------------
    // 已抽成 `ui/quick_cmd_manage.slint`：这里只做显隐判断 + 状态透传 + 动作转发。
    if root.quick-cmd-manage-open : QuickCmdManageDialog {
        quick-commands: root.quick-commands;
        lang-en: root.lang-en;
        qcm-dialog-width: root.qcm-dialog-width;
        qcm-dialog-height: root.qcm-dialog-height;
        avail-width: root.width;
        avail-height: root.height;
        qcm-name <=> root.qcm-name;
        qcm-command <=> root.qcm-command;
        qcm-group <=> root.qcm-group;
        qcm-send-enter <=> root.qcm-send-enter;
        qcm-edit-index <=> root.qcm-edit-index;
        close-requested => { root.quick-cmd-manage-open = false; }
        new-quick-group => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; }
        rename-quick-group(g) => { root.qcg-orig = g; root.qcg-name = g; root.qcg-open = true; }
        add-quick-command(name, command, group, send-enter) => { root.add-quick-command(name, command, group, send-enter); }
        save-quick-command(index, name, command, group, send-enter) => { root.save-quick-command(index, name, command, group, send-enter); }
        delete-quick-command(index) => { root.delete-quick-command(index); }
        edit-quick-command(index) => { root.edit-quick-command(index); }
        duplicate-quick-command(index) => { root.duplicate-quick-command(index); }
        move-quick-command(index, group) => { root.move-quick-command(index, group); }
        reorder-quick-command(index, move-up) => { root.reorder-quick-command(index, move-up); }
        delete-quick-group(name) => { root.delete-quick-group(name); }
    }
    // --- Quick-command group name dialog (#55): new / rename --------------
    // 已抽成 `ui/quick_group_dialog.slint`：显隐判断 + 状态透传 + 动作转发。
    if root.qcg-open : QuickGroupDialog {
        lang-en: root.lang-en;
        qcg-name <=> root.qcg-name;
        qcg-orig : root.qcg-orig;
        close-requested => { root.qcg-open = false; }
