// Embedded cross-platform fonts (compile-time): terminal monospace + UI icons.
import { AnimationSettings } from "theme.slint";
// Embedding means Windows / Linux / macOS all render the same glyphs without
// relying on Consolas / Segoe MDL2 Assets being installed.
//
// "Meatshell Mono" is Cascadia Mono re-named to a unique family (#114): full
//   box-drawing + block-elements + braille (needed by htop/btop graphs). The
//   original "Cascadia Mono" name collides with the system font family, so on a
//   machine without Cascadia installed (e.g. Win11 Home) the OS font matcher
//   substituted a glyph-poor fallback and box/braille rendered as tofu. A unique
//   name (like Material Icons) can't be shadowed, so the embedded font is always
//   used.
// Material Icons: open-source icon font replacing Windows-only Segoe MDL2 Assets.
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
// Large CJK fonts (e.g. Maple Mono, ~20 MB/weight) are intentionally NOT
// embedded — users drop them into the fonts dir (Windows: <exe_dir>/config/fonts;
// macOS/Linux: per-user config dir) and Rust registers them at startup
// (src/fonts.rs), making them selectable in Settings after a restart.

import { Theme } from "theme.slint";
import { GroupGap } from "components/surfaces.slint";
import { Sidebar, DiskInfo } from "sidebar.slint";
import { TabBar, TabInfo } from "tabs.slint";
import { Welcome, SessionInfo } from "welcome.slint";
import { SessionDialog, SessionDraft, PortFwd, TriggerDraft } from "session_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { LabeledInput, PrimaryButton, GhostButton, ToolStrip, IconButton } from "widgets.slint";
import { TerminalView, TermSpan, TermMatch, QuickCmd, QuickDockPanel } from "terminal_view.slint";
import { SftpEntry, SftpTreeNode, TunnelInfo } from "sftp_panel.slint";
import { ProcWindow, ProcRow } from "proc_window.slint";
import { SystemInfoWindow, SysInfoRow, SysMetricRow, SysNetRow } from "system_info_window.slint";
import { InterfacePanel } from "interface_panel.slint";
import { OutputRuleItem, WslProfileInfo } from "settings/types.slint";
// Re-export so `slint::include_modules!` generates the detached Rust window types.
export { ProcWindow, SystemInfoWindow }
import { LineEdit, Button, ScrollView, CheckBox, Palette, ListView } from "std-widgets.slint";
import { Divider, VDivider, FieldLabel } from "components/surfaces.slint";
import { CloseButton } from "components/buttons.slint";
import { ModalCard } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { Label } from "components/text.slint";
import { WindowTitleBar } from "components/window_shell.slint";
import { UpdateBanner } from "update_banner.slint";
import { EditorFindResult, FileEditor } from "file_editor.slint";
import { QuickCmdManageDialog } from "quick_cmd_manage.slint";
import { GroupDialog } from "group_dialog.slint";
import { QuickGroupDialog } from "quick_group_dialog.slint";
import { SftpPromptDialog } from "sftp_prompt_dialog.slint";
import { ConfirmCloseDialog } from "confirm_close_dialog.slint";
import { ChmodDialog } from "chmod_dialog.slint";
import { DownloadManagerPopup, TransferInfo } from "download_manager.slint";
import { SettingsMenuPopup } from "settings_menu.slint";
import { AboutDialog } from "about_dialog.slint";
import { DockSnapOverlay } from "dock_snap_overlay.slint";
import { ConfirmOverlays } from "confirm_overlays.slint";
import { ShortcutsDialog } from "shortcuts_dialog.slint";
import { InterfaceSettingsOverlay } from "interface_settings_overlay.slint";
import { FramelessTitleBar } from "custom_titlebar.slint";
import { TitlebarInsetStrip } from "titlebar_inset_strip.slint";
// EditorFindResult 随编辑器组件搬走了，对外仍是 app.slint 的导出。
export { EditorFindResult }

export { SessionInfo, SessionDraft, TabInfo, SftpEntry, SftpTreeNode, TunnelInfo, QuickCmd, PortFwd, TriggerDraft, WslProfileInfo }
// P5「公共面收敛」第 1 步：把两个全局导出，Rust 才能 `window.global::<Theme>()`
// 直接读写主题 —— 这样 AppWindow 上那 14 条 `<=> Theme.x` 镜像就不必存在了。
export { AnimationSettings, Theme }

// --- TerminalState ---------------------------------------------------------
// Per-terminal view-model exposed to Rust. A TabInfo has the metadata; the
// TerminalState carries the streaming log + status line. Kept as a parallel
// model so opening/closing tabs doesn't churn the log strings.
// One file-transfer record shown in the download manager.
// ProcRow now lives in proc_window.slint (the detachable process window).

export struct TerminalState {
    id: string,
    status: string,
    spans: [TermSpan],     // coloured runs of the visible terminal screen
    cursor-row: int,       // cursor cell on the grid
    cursor-col: int,
    rows-used: int,        // content rows, for viewport sizing
    scroll-max: int,       // scrollback depth (max offset) — terminal scrollbar (#103)
    scroll-offset: int,    // current scrollback offset (0 = live bottom)
    is-alt-screen: bool,
    mouse-tracked: bool,          // remote app wants mouse events (btop/htop/mc)
    find-matches: [TermMatch], // search-highlight rectangles
    selection: [TermMatch],    // drag-selection highlight rectangles
    // Per-session font-size override in px; 0 = follow the global setting.
    // Set by Ctrl+=/-/0 (⌘) zoom; Ctrl+Shift variants clear overrides so the
    // window-wide size applies to every session.
    font-size: float,
    // SFTP panel state
    sftp-path: string,
    sftp-entries: [SftpEntry],
    sftp-status: string,
    sftp-loading: bool,
    sftp-tree-nodes: [SftpTreeNode],
    sftp-selected-count: int,   // checked entries in the SFTP panel (#100)
    sftp-sort-key: string,      // ""|"name"|"size"|"modified" (#248)
    sftp-sort-dir: int,         // 0 default / 1 asc / -1 desc (#248)
    sftp-available: bool,       // false for local/serial/telnet sessions
    tunnels: [TunnelInfo],      // runtime SSH tunnels (#206)
    sftp-collapsed: bool,       // SFTP panel minimised — per session (#v0.5)
    sftp-panel-height: length,  // SFTP panel extent (bottom dock) — per session
    sftp-panel-width: length,   // SFTP panel extent (side dock) — per session
}

// One leaf pane of the split layout (v0.5). Geometry (x/y/w/h) is computed in Rust
// from the split tree; `tabs` is the pane's own tab group and `active-id` the tab
// it currently shows. `reserve-right` keeps room for the top-right toolbar icons on
// whichever pane touches the top-right corner.
export struct PaneInfo {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    active-id: string,
    focused: bool,
    reserve-right: length,
    tabs: [TabInfo],
}

// A draggable splitter between two regions of the split layout (v0.5).
export struct SplitterInfo {
    split-id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    vertical: bool,   // true = vertical handle (drag left/right)
}

// Editor find step result (#287): the byte offsets to select and the total

// A 26×26 top-bar icon button with a hover tooltip (right-aligned so it never
// runs off the window edge). `active` keeps the hover background lit (e.g. while
// its popup is open).
// A Windows-style window-control button (minimize / maximize / close) for the
// custom title bar (#119). `danger` gives the close button its red hover.
// One row in the keyboard-shortcuts dialog: a key chip + a description (#103).

export component AppWindow inherits Window {
    title: "Rudder";
    icon: @image-url("../assets/icon.png");
    // Frameless when we draw our own title bar (#119); Rust sets custom-titlebar
    // true on Windows/Linux. Slint maps no-frame → winit set_decorations(false).
    no-frame: root.custom-titlebar;
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1440px;
    preferred-height: 900px;
    // Always-opaque base; the wallpaper Image (when active) covers it and panels
    // frost over the image. Using window-base (not bg-root) keeps the window
    // itself opaque even though bg-root turns translucent in immersive mode.
    background: Theme.window-base;
    // Rust 从配置解析后写入（`fonts_ui::resolve_ui_font_family`）：空串 = 跟随系统
    // （Slint 用平台默认字体，缺字由 parley 按脚本回退），否则是**单个**家族名。
    // ⚠️ 不要在这里塞逗号分隔的字体栈 —— Slint 的 font-family 不做逗号拆分。
    default-font-family: Theme.ui-font-family;

    // --- Sidebar data ------------------------------------------------------
    in property <string> connection-state: @tr("Not connected");
    in property <string> conn-host;             // clean IP/host for click-to-copy (#192)
    in property <int> conn-state;                       // 0 gray / 1 green / 2 yellow
    in property <string> resource-title: @tr("Local resources");    // @tr("Local resources") | @tr("Server resources")
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    // Dual network panel.  "top" follows the active tab (remote NIC on a
    // session tab, local on the welcome tab); "bot" is always the local machine.
    in property <string> net-top-up;        // ↑ tx rate text
    in property <string> net-top-down;      // ↓ rx rate text
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;      // remote NIC names for the selector
    in property <string> net-selected;      // currently selected NIC
    in property <bool> net-show-selector;   // only on a live session tab
    in property <[DiskInfo]> disks;         // active tab's filesystem usage
    in property <string> app-version;       // from Rust: env!("CARGO_PKG_VERSION")
    callback select-net-iface(string);

    // --- Top-right popups --------------------------------------------------
    in-out property <bool> download-open: false;  // download manager popup
    // True while any transfer is active or preparing; drives the breathing
    // pulse on the Transfers toolbar button (#breathing-light).
    in-out property <bool> has-active-transfers: false;
    in-out property <bool> settings-open: false;  // settings menu popup

    // Immersive custom title bar (#119). Rust sets `custom-titlebar` true on
    // Windows/Linux (frameless); macOS keeps native decorations. The callbacks
    // drive the winit window via Rust.
    // Default true so the window is frameless from creation (no native-bar flash);
    // Rust sets it false on macOS, which keeps native decorations.
    in-out property <bool> custom-titlebar: true;
    // macOS immersive title bar: Rust makes the native bar transparent and lets
    // content render under it, so we reserve this much space at the top for the
    // traffic-light buttons + a clean drag strip (0 elsewhere). See setup_macos_platform.
    property <length> titlebar-inset: root.is-mac ? 28px : 0px;
    in-out property <bool> window-maximized: false;
    callback win-minimize();
    callback win-maximize-toggle();
    callback win-close();
    callback reset-page(string);   // settings: restore page defaults
    callback win-drag();          // start an OS window-move
    callback win-resize(int);     // start an OS resize; arg = direction code
    in-out property <bool> sidebar-collapsed: false; // left panel hidden
    callback set-sidebar-collapsed(bool);       // apply + persist
    // User-draggable size of the resource sidebar. width is used when docked
    // left/right, height when docked top/bottom. Seeded / persisted via the
    // persist-* callbacks (fired on drag end).
    in-out property <length> sidebar-width: 220px;
    in-out property <length> sidebar-height: 240px;
    property <bool> sidebar-dragging;            // splitter being dragged
    callback persist-sidebar-width(float /* logical px */);

    // --- Panel docking (resource sidebar; SFTP follows in a later phase) ----
    // Which window edge the resource panel is docked to: left|right|top|bottom.
    in-out property <string> sidebar-dock: "left";
    property <bool> sidebar-horizontal: root.sidebar-dock == "left" || root.sidebar-dock == "right";
    // Drag-to-dock state: while a panel's header is dragged, a 4-edge snap
    // overlay shows and `dock-target` tracks the edge under the cursor.
    property <bool> panel-dragging;
    property <float> drag-nx;   // cursor x within the dock area, 0..1
    property <float> drag-ny;   // cursor y within the dock area, 0..1
    property <string> dock-target:
        !root.panel-dragging ? ""
        : root.drag-nx < 0.22 ? "left"
        : root.drag-nx > 0.78 ? "right"
        : root.drag-ny < 0.22 ? "top"
        : root.drag-ny > 0.78 ? "bottom"
        : "";
    callback persist-sidebar-dock(string);
    // The top-right toolbar icons float over the tab row; when the sidebar docks
    // top/right it covers that corner, so shift the icons to stay over the tabs.
    //
    // 两个偏移都是"同一侧三个面板各自占掉多少，再相加"：资源侧栏 + 欢迎侧栏 +
    // 快捷面板。此前是两条 14 行、彼此只差一个边缘字符串的三目链；现在把"这个面板
    // 在这条边上占多少"抽成 `side-taken`，两条偏移各自只剩三个调用，逐项与原式等价。
    //
    // 折叠条宽度：侧栏与快捷面板折叠后都只剩 36px 宽的折叠条（见 CollapseButton）。
    pure function side-taken(open: bool, dock: string, edge: string, value: length) -> length {
        return open && dock == edge ? value : 0px;
    }

    /// 同一侧的资源 / 欢迎侧栏是否**已经**折叠成折叠条。
    /// 快捷面板折叠时靠它判断：折叠条已被别的面板占住时不再叠加第二个 36px。
    pure function collapsed-bar-taken(edge: string) -> bool {
        return (root.welcome-as-sidebar && root.welcome-collapsed
                && root.welcome-sidebar-dock == edge)
            || (root.sidebar-collapsed && root.sidebar-dock == edge);
    }

    property <length> toolbar-x-off:
        side-taken(true, root.sidebar-dock, "right",
            root.sidebar-collapsed ? 36px : root.sidebar-width + 4px)
        + side-taken(root.welcome-as-sidebar, root.welcome-sidebar-dock, "right",
            root.welcome-sidebar-taken)
        + side-taken(root.quick-panel-open, root.quick-panel-dock, "right",
            root.quick-panel-collapsed
                ? (collapsed-bar-taken("right") ? 0px : 36px)
                : root.quick-panel-width + 4px);
    property <length> toolbar-y-off:
        side-taken(true, root.sidebar-dock, "top",
            root.sidebar-collapsed ? 36px : root.sidebar-height + 4px)
        + side-taken(root.welcome-as-sidebar, root.welcome-sidebar-dock, "top",
            root.welcome-sidebar-taken)
        + side-taken(root.quick-panel-open, root.quick-panel-dock, "top",
            root.quick-panel-collapsed
                ? (collapsed-bar-taken("top") ? 0px : 36px)
                : root.quick-panel-height + 4px);
    property <length> toolbar-y:
        (root.custom-titlebar ? 43px : 5px + root.titlebar-inset) + root.toolbar-y-off;
    in-out property <bool> about-open: false;     // centered About dialog
    callback open-repo();                          // open the project's GitHub page
    in-out property <bool> shortcuts-open: false; // centered keyboard-shortcuts dialog (#103)
    in property <string> download-dir;      // preset SFTP download folder ("" = ask)
    // Process monitor is now a detachable top-level window (ProcWindow). Rust
    // shows/hides it in response to open-processes(); proc-list/proc-available
    // stay here as the live data source shared with that window (#23).
    callback open-processes();
    in property <bool> proc-available;       // a live remote session is active
    in property <[ProcRow]> proc-list;       // top remote processes by CPU
    callback open-system-info();
    in property <bool> system-info-available; // connected Linux session only (#268)
    in property <[SysMetricRow]> sys-metrics;
    in property <[SysNetRow]> sys-net-rows;
    in property <[SysInfoRow]> sys-overview-rows;
    in property <[SysInfoRow]> sys-cpu-info-rows;
    in property <[SysInfoRow]> sys-gpu-info-rows;
    in property <[SysInfoRow]> sys-cpu-usage-rows;
    in property <[SysInfoRow]> sys-memory-rows;
    in property <[SysInfoRow]> sys-swap-rows;
    in property <[SysInfoRow]> sys-network-rows;
    in property <[SysInfoRow]> sys-filesystem-rows;
    // Command bar (#55): quick commands + history, fed from Rust.
    in property <[QuickCmd]> quick-commands;
    in-out property <bool> quick-commands-as-sidebar: false;
    callback set-quick-commands-as-sidebar(bool);
    in-out property <bool> quick-panel-open: false;
    in-out property <bool> quick-panel-collapsed: false;
    in-out property <length> quick-panel-width: 260px;
    in-out property <length> quick-panel-height: 220px;
    in-out property <string> quick-panel-dock: "right";
    property <string> quick-external-command;
    property <bool> quick-external-send-enter;
    property <int> quick-external-sequence;
    in property <[string]> command-history;          // oldest first (newest last, #113)
    in property <[string]> history-view;             // filtered dropdown, oldest first (newest last, #101)
    callback run-command(string /* tab-id */, string /* cmd */, bool /* to-all */);
    callback copy-text(string);                 // copy a history command (#96)
    callback delete-history(int /* index */);   // remove a history entry (#96)
    callback delete-history-cmd(string /* cmd */);   // remove a history entry by command (#101)
    callback search-history(string /* query */);     // filter the history dropdown (#101)
    in-out property <bool> quick-cmd-manage-open: false;  // manage dialog
    in-out property <length> qcm-dialog-width: 560px;
    in-out property <length> qcm-dialog-height: 560px;
    property <bool> qcm-dialog-resizing;
    property <length> qcm-resize-base-width;
    property <length> qcm-resize-base-height;
    property <length> qcm-resize-grab-x;
    property <length> qcm-resize-grab-y;
    in-out property <string> qcm-name;                // manage form: name field
    in-out property <string> qcm-command;             // manage form: command field
    in-out property <string> qcm-group;               // manage form: group field (#55)
    in-out property <bool> qcm-send-enter: true;      // click sends+executes (B站)
    in-out property <int> qcm-edit-index: -1;         // -1 = add, >=0 = edit that entry (#55)
    callback add-quick-command(string /* name */, string /* command */, string /* group */, bool /* send-enter */);
    callback save-quick-command(int /* index */, string /* name */, string /* command */, string /* group */, bool /* send-enter */);
    callback delete-quick-command(int /* index */);
    callback edit-quick-command(int /* index */);
    callback duplicate-quick-command(int /* index */);
    callback move-quick-command(int /* index */, string /* group */);
    callback reorder-quick-command(int /* index */, bool /* move up */);
    callback toggle-quick-group(string /* group */);  // collapse/expand a group (#55)
    // Quick-command group management (mirror session groups) (#55).
    in-out property <bool> qcg-open: false;           // group name dialog open
    property <string> qcg-name;                       // group dialog: name field
    property <string> qcg-orig;                       // group dialog: "" = new, else rename target
    callback submit-quick-group(string /* orig */, string /* name */);
    callback delete-quick-group(string /* name */);
    in property <[TransferInfo]> transfers; // download/upload records (newest first)
    in property <[string]> about-libs;      // open-source libraries used
    in-out property <bool> lang-en: false;  // current UI language (false = 中文)
    // Two-way binding to Theme.dark — Rust reads/writes this property and
    // Slint propagates it to every widget that references Theme colours.
    // Keep Slint's std-widgets (LineEdit / Button / ComboBox in the dialogs) in
    // step with our theme — otherwise in light mode they keep the platform/dark
    // palette and their text/borders blend into the light dialog background.
    // Palette 是官方控件的**派生气板**：方向只能是「应用状态 → Palette」，
    // 反过来由它驱动本应用主题会把"配置 + 壁纸决定明暗"的真相源搞乱。
    // 官方控件的 `Palette.color-scheme` 需要跟着主题走，而 Slint 里三条路都不通：
    // ① `changed Theme.dark` —— `changed` 只认**本地**属性名；② 全局属性不能在组件体里
    // 直接绑定；③ `private` 属性又不允许挂 `changed`。
    // 解法：用一条**单向派生**的本地属性当触发器（`:` 绑定随 `Theme.dark` 变化，
    // 不是 `<=>` 镜像、Rust 也不会去写它），再在 `changed` 里同步 Palette。
    property <bool> dark-mode-watch: Theme.dark;
    init => { Palette.color-scheme = dark-mode-watch ? ColorScheme.dark : ColorScheme.light; }
    changed dark-mode-watch => { Palette.color-scheme = dark-mode-watch ? ColorScheme.dark : ColorScheme.light; }
    in-out property <int> term-font-index: 0;   // picker selection into term-fonts
    in-out property <string> term-cursor-style: "block";
    in-out property <string> term-cursor-color-hex: Theme.dark ? "#D4D4D4" : "#2D2D2F";
    in-out property <color> term-cursor-color: Theme.term-fg;
    in-out property <bool> output-highlight-enabled: true;
    in-out property <bool> json-format-output: true;
    in-out property <string> scrollback-lines: "5000";
    // 大回滚缓冲区开关（A 方案）：关闭时上限 10 万行，打开后 100 万行。
    in-out property <bool> large-scrollback;
    in-out property <bool> convert-eol: false;
    in-out property <bool> osc52-clipboard: true;
    in-out property <bool> hide-special-partitions: true;
    // 动画开关的双向镜像：Rust 通过它读写 AnimationSettings.enabled，避免把整个
    // 全局暴露到公共 API（easing 类型的属性无法跨公共 API，会产生编译告警）。
    in-out property <string> mount-filter: "";
    in-out property <string> output-highlight-preset: "log";
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    callback set-panel-font(int);                          // apply + persist (percent)
    // Window focused & visible — Rust drives it from winit events; gates the
    // cursor blink so an idle background window stops repainting (#127).
    in-out property <bool> window-focused <=> Theme.window-focused;
    // macOS flag — Rust sets it so shortcuts switch to Cmd (⌘) there (#158).
    in-out property <bool> is-mac <=> Theme.is-mac;
    in property <bool> is-windows: false;
    in-out property <string> renderer-mode: "software";
    callback set-renderer-mode(string);                    // applies next launch (#280)
    // Wallpaper / immersive theming — Rust drives these from the wallpaper module.
    // User-adjustable wallpaper overlay opacity (0.30–1.00), persisted.
    callback persist-wallpaper-overlay(float);
    in property <[string]> term-fonts;             // installed monospace families
    in property <[string]> ui-fonts;              // all families for UI font picker
    in-out property <int> ui-font-index: 0;           // picker selection into ui-fonts
    callback set-ui-font(string);                  // persist UI font choice
    in-out property <bool> interface-open: false;  // Interface settings overlay
    // Interface card position (draggable by its title bar, clamped inside the
    // window so it can't leave the parent); init centered.
    // Centred, snapped to whole logical pixels: a half-pixel origin makes the
    // card's text render on subpixel offsets and look blurry (#v0.5).
    property <length> ifd-w: min(root.width - 56px, max(640px, 720px * Theme.panel-font));
    property <length> ifd-h: min(root.height - 56px, max(420px, 480px * Theme.panel-font));
    property <length> ifd-x: round((root.width - root.ifd-w) / 2 / 1px) * 1px;
    property <length> ifd-y: round((root.height - root.ifd-h) / 2 / 1px) * 1px;
    property <bool> ifd-dragging;
    property <bool> ifd-resizing;
    property <length> ifd-base-x;
    property <length> ifd-base-y;
    property <length> ifd-base-w;
    property <length> ifd-base-h;
    property <length> ifd-grab-x;
    property <length> ifd-grab-y;

    // A drag/resize assignment breaks the initial centering bindings. Recenter
    // every time the modal opens so coordinates from a larger/DPI-different
    // monitor can never leave the settings card outside the current window.
    changed interface-open => {
        if (root.interface-open) {
            root.ifd-dragging = false;
            root.ifd-resizing = false;
            root.ifd-w = clamp(root.ifd-w, 640px, max(640px, root.width - 56px));
            root.ifd-h = clamp(root.ifd-h, 420px, max(420px, root.height - 56px));
            root.ifd-x = round((root.width - root.ifd-w) / 2 / 1px) * 1px;
            root.ifd-y = round((root.height - root.ifd-h) / 2 / 1px) * 1px;
        }
    }
    callback set-term-font(string);                // apply + persist font family
    callback set-term-font-size(int);              // apply + persist font size (px)
    callback set-term-font-bold(bool);             // apply + persist bold terminal text
    callback set-term-cursor-style(string);        // apply + persist cursor shape (#275)
    callback set-term-cursor-color(string) -> bool;// validate + persist cursor colour (#275)
    callback set-output-highlight(bool, string);   // enable + built-in preset
    callback set-json-format-output(bool);         // pretty-print + colour JSON lines (#338)
    callback set-scrollback-lines(string) -> bool;  // persist terminal history lines
    callback set-large-scrollback(bool);            // 大回滚缓冲区开关
    callback set-convert-eol(bool);                 // persist LF→CRLF
    callback set-osc52-clipboard(bool);             // persist OSC 52 toggle
    callback set-hide-special-partitions(bool);      // persist partition hiding
    callback set-animations-enabled(bool);           // persist Interface › Animations
    callback set-mount-filter(string);               // persist mount point filter
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-ui-scale(int);                    // apply + persist UI scale (percent) (#100)
    // Immersive wallpaper (set by Rust). The active id + custom file basename
    // feed the Interface → Wallpaper picker.
    in-out property <string> current-wallpaper: "";
    in-out property <string> custom-wallpaper-name: "";
    callback set-wallpaper(string);                // apply + persist a wallpaper id
    callback pick-wallpaper-file();                // open the OS file dialog (Rust)
    // SFTP follows the terminal's cd; opt out in Interface settings.
    in-out property <bool> sftp-follow-cd: true;
    callback set-sftp-follow-cd(bool);             // apply + persist
    // Hide the quick-command bar under the terminal; toolbar toggle persists it.
    // 终端底部命令栏的可见性。**正向语义**（true = 显示），出厂默认 true。
    // 配置里存的是反向的 hide_cmd_bar，翻转只在 Rust 侧（见 settings/layout.rs）。
    in-out property <bool> show-cmd-bar: true;
    callback set-show-cmd-bar(bool);               // apply + persist
    // Zen (focus) mode: hide the sidebar and tab strip for a distraction-free
    // terminal. Toggled by Ctrl+Alt+Z (⌘⌥Z on macOS) and persisted.
    in-out property <bool> zen-mode: false;
    callback set-zen-mode(bool);                   // apply + persist
    callback toggle-zen-key();
    // Always ask where to save on each download (#87); default off.
    in-out property <bool> download-always-ask: false;
    callback set-download-always-ask(bool);        // apply + persist
    // Collapse-by-default settings + shared SFTP collapse state (#78).
    in-out property <bool> collapse-sidebar-default: false;
    callback set-collapse-sidebar-default(bool);   // apply + persist
    // Render the welcome/session list as a left sidebar instead of a tab (v0.5).
    in-out property <bool> welcome-as-sidebar: false;
    callback set-welcome-as-sidebar(bool);         // apply + persist
    in-out property <bool> update-check-enabled: true;   // startup new-version check (#184)
    callback set-update-check-enabled(bool);       // apply + persist
    // WSL profiles (upstream a64097e): managed in Interface → WSL.
    in property <[WslProfileInfo]> wsl-profiles;
    in-out property <string> wsl-new-directory: "~";
    callback add-wsl-profile(string, string, string);
    callback remove-wsl-profile(string);
    callback pick-wsl-directory();
    // Drag-resizable width of that welcome sidebar (logical px), persisted.
    in-out property <length> welcome-sidebar-width: 240px;
    callback persist-welcome-sidebar-width(float);
    in-out property <string> welcome-sidebar-dock: "left";
    property <bool> welcome-sidebar-horizontal:
        root.welcome-sidebar-dock == "left" || root.welcome-sidebar-dock == "right";
    property <length> welcome-sidebar-taken:
        root.welcome-collapsed ? 36px : root.welcome-sidebar-width;
    callback persist-welcome-sidebar-dock(string);
    // Welcome sidebar collapsed to the edge icon strip (IDEA-style), persisted.
    in-out property <bool> welcome-collapsed: false;
    callback set-welcome-collapsed(bool);          // apply + persist
    in-out property <bool> collapse-sftp-default: false;
    callback set-collapse-sftp-default(bool);      // apply + persist
    in-out property <bool> sftp-collapsed: false;       // (legacy global; per-tab now)
    // Per-session SFTP state: persist the collapse + sizes into that tab's
    // TerminalState so split panes / other tabs keep their own (#v0.5).
    callback set-pane-sftp-collapsed(string /* tab-id */, bool);
    callback set-pane-sftp-height(string /* tab-id */, length);
    callback set-pane-sftp-width(string /* tab-id */, length);
    // Confirm-before-close when there are live session tabs (#88): a stray
    // double-click on the title-bar icon / X shouldn't drop active sessions.
    in-out property <bool> confirm-close-open: false;
    callback confirm-close-yes();                  // quit the app for real
    in-out property <bool> terminal-restore-cover: false;
    // Host-key confirmation (#109-5). Rust opens this when a server presents an
    // unknown / changed host key; the user's answer flows back via the callbacks
    // and Rust closes the dialog.
    in-out property <bool> hostkey-prompt-open: false;
    in-out property <bool> hostkey-changed: false; // true = key differs from stored
    in-out property <string> hostkey-title;
    in-out property <string> hostkey-message;
    in-out property <string> hostkey-detail;       // host:port + type + fingerprint
    in-out property <string> hostkey-confirm-label; // trust-button text (from Rust, bilingual)
    callback hostkey-accept();                     // trust (and remember) the key
    callback hostkey-reject();                      // abort the connection
    // Connect-time credential prompt (#110). Rust opens this when a session is
    // missing its username and/or password; the answer flows back via accept.
    in-out property <bool> cred-prompt-open: false;
    in-out property <string> cred-host;            // host shown in the dialog title
    in-out property <bool> cred-need-user: false;
    in-out property <bool> cred-need-password: false;
    in-out property <string> cred-user;            // username field value
    in-out property <string> cred-password;        // password field value
    in-out property <bool> cred-remember: false;   // persist to the saved session
    callback cred-accept();                        // use the entered credentials
    callback cred-reject();                        // cancel the connection
    // MFA / keyboard-interactive prompt (#86-MFA). Rust opens this when a bastion
    // (e.g. JumpServer with MFA) sends a verification-code challenge mid-login.
    in-out property <bool> mfa-prompt-open: false;
    in-out property <string> mfa-host;             // host shown in the dialog title
    in-out property <string> mfa-prompt;           // the server's prompt text
    in-out property <bool> mfa-echo: false;        // false = hide typed input
    in-out property <string> mfa-answer;           // the entered code
    callback mfa-submit();                         // send the entered answer
    callback mfa-cancel();                         // cancel the connection
    // Group create / rename dialog (#41).
    in-out property <bool> group-dialog-open: false;
    in-out property <string> group-dialog-orig;    // "" = create, else rename
    in-out property <string> group-dialog-name;
    in-out property <string> group-dialog-error;
    callback delete-group(string /* name */);
    callback submit-group(string /* orig */, string /* name */) -> string;
    callback toggle-theme();               // flip dark ↔ light
    // Session sync / broadcast input (#78 pt.4): mirror keystrokes to every
    // online session. Default off (it types into ALL sessions at once).
    in-out property <bool> sync-input: false;
    callback set-sync-input(bool);
    // Mirror SFTP uploads to other sessions while sync-input is on (#sync).
    in-out property <bool> sync-upload-enabled: false;
    callback set-sync-upload-enabled(bool);
    // WebDAV config sync (#185): manual upload/download of portable session JSON.
    in-out property <bool> webdav-enabled: false;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs: false;
    in-out property <string> webdav-status;
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    in-out property <length> sftp-panel-height: 220px; // shared; lets Rust locate the drop zone
    in-out property <length> sftp-panel-width: 380px;  // SFTP extent when docked left/right
    in-out property <string> sftp-dock: "bottom";      // SFTP dock edge, shared across tabs
    callback pick-download-dir();            // open a folder picker
    callback open-download-dir();            // reveal the folder in the OS
    callback clear-transfers();              // wipe the transfer history
    callback cancel-transfer(string);        // cancel an in-progress transfer by id (#100)
    callback set-language(string);           // switch UI language ("zh" / "en")

    // --- Update check (#48) ------------------------------------------------
    // Set by Rust after a background GitHub-releases query; purely informational
    // (the app keeps working on the current version).
    in-out property <bool> update-available: false;
    in property <string> update-version;     // e.g. "v0.3.3"
    callback open-update-url();              // open the release page in a browser
    // In-app self-update (#self-update): 0 idle / 1 downloading / 2 installing /
    // 3 ready-to-restart / 4 failed. `update-progress` is 0.0..=1.0.
    in-out property <int> update-state: 0;
    in property <float> update-progress: 0;
    in property <string> update-status: "";
    callback run-self-update();              // download + install in place
    callback restart-app();                  // re-launch with the new binary
    // Settings → 手动检查更新 button (#self-update): independent of the
    // startup check toggle, result is shown inline in the settings row.
    in property <string> update-check-status: "";
    in property <bool> update-checking: false;
    callback check-update-now();

    // --- Built-in file viewer/editor (#70) --------------------------------
    in-out property <bool> editor-open: false;
    in-out property <string> editor-name;     // file name shown in the title
    in-out property <string> editor-path;     // remote path (used on save)
    in-out property <string> editor-content;  // text, two-way with the input
    in-out property <bool> editor-readonly;   // view = true, edit = false
    in-out property <bool> editor-dirty: false; // edited since load
    // Set when the editor opens; the deferred timer focuses the text on the
    // next tick instead of from `init` (see the timer below, #386).
    property <bool> editor-focus-pending: false;
    in-out property <string> editor-line-numbers; // newline-joined "1..N" from Rust (#81)
    // Find/replace bar (#287). Matching is literal and case-sensitive, which is
    // predictable for configuration/source files.
    in-out property <string> editor-find-query;
    in-out property <string> editor-replace-text;
    in-out property <int> editor-match-count: 0;
    in-out property <int> editor-find-position: -1;
    callback save-file();                     // Ctrl+S / Save button (edit only)
    callback close-editor();                  // X / Esc; uploads if dirty
    callback editor-recount(string);          // rebuild line numbers after an edit
    callback editor-count-matches(string /* content */, string /* query */) -> int;
    callback editor-find-step(string /* content */, string /* query */, int /* current */, bool /* reverse */) -> EditorFindResult;
    callback editor-replace-all(string /* query */, string /* replacement */);
    // Editor card geometry: draggable by its title bar, resizable from the
    // bottom-right grip (same absolute-position pattern as the Interface
    // dialog). Defaults centre the card; user drags/resizes override them.
    property <length> ed-w: 760px;
    property <length> ed-h: 560px;
    property <length> ed-x: (root.width - root.ed-w) / 2;
    property <length> ed-y: (root.height - root.ed-h) / 2;
    property <bool> ed-dragging;
    property <bool> ed-resizing;
    property <length> ed-base-x;
    property <length> ed-base-y;
    property <length> ed-base-w;
    property <length> ed-base-h;
    property <length> ed-grab-x;
    property <length> ed-grab-y;

    // --- Session list ------------------------------------------------------
    in property <[SessionInfo]> sessions;
    in-out property <string> host-search-query;
    callback host-search-changed(string);

    // --- Tabs --------------------------------------------------------------
    in property <[TabInfo]> tabs;
    // --- Split panes (v0.5) — flattened from the Rust split tree -----------
    in property <[PaneInfo]> panes;
    in property <[SplitterInfo]> splitters;
    in-out property <string> active-tab-id: "welcome";
    in property <[TerminalState]> terminals;

    // --- Dialog state ------------------------------------------------------
    in-out property <bool> dialog-open: false;
    in-out property <bool> dialog-editing: false;
    in-out property <string> dialog-id;
    in-out property <string> dialog-name;
    in-out property <string> dialog-host;
    in-out property <string> dialog-port: "22";
    in-out property <string> dialog-user;
    in-out property <string> dialog-auth: "password";
    in-out property <string> dialog-password;
    in-out property <string> dialog-key-path;
    in-out property <string> dialog-key-inline;
    in-out property <bool> dialog-key-inline-mode: false;
    in-out property <string> dialog-proxy-type: "none";  // "none" | "socks5" | "http"
    in-out property <string> dialog-proxy-hostport;
    in-out property <string> dialog-group;
    // Existing group names (from Rust) for the dialog's group dropdown (#179).
