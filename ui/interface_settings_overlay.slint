//! **设置覆盖层**：嵌在主窗口内的模态设置面板（不是独立窗口），可拖动但被夹在窗口内。
//!
//! 从 `app.slint` 拆出（P4 B 类）—— **纯接线**：状态透传 + 动作转发，本身不含业务逻辑。
//! 关闭 / 打开等窗口状态改动一律上抛为回调。

import { AnimationSettings } from "theme.slint";
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { GroupGap } from "components/surfaces.slint";
import { Sidebar, DiskInfo } from "sidebar.slint";
import { TabBar, TabInfo } from "tabs.slint";
import { Welcome, SessionInfo } from "welcome.slint";
import { SessionDialog, SessionDraft, PortFwd, TriggerDraft } from "session_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { LabeledInput, PrimaryButton, GhostButton, ToolStrip, IconButton } from "widgets.slint";
import { TerminalView, TermSpan, TermMatch, QuickCmd, QuickDockPanel } from "terminal_view.slint";
import { SftpEntry, SftpTreeNode, TunnelInfo } from "sftp_panel.slint";
import { ProcWindow, ProcRow } from "proc_window.slint";
import { SystemInfoWindow, SysInfoRow, SysMetricRow, SysNetRow } from "system_info_window.slint";
import { InterfacePanel } from "interface_panel.slint";
import { OutputRuleItem, WslProfileInfo, AccentPreset } from "settings/types.slint";
import { LineEdit, Button, ScrollView, CheckBox, Palette, ListView } from "std-widgets.slint";
import { Divider, VDivider, FieldLabel } from "components/surfaces.slint";
import { CloseButton } from "components/buttons.slint";
import { ModalCard } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { Label } from "components/text.slint";
import { WindowTitleBar } from "components/window_shell.slint";
import { EditorFindResult, FileEditor } from "file_editor.slint";
import { QuickCmdManageDialog } from "quick_cmd_manage.slint";
import { GroupDialog } from "group_dialog.slint";
import { QuickGroupDialog } from "quick_group_dialog.slint";
import { SftpPromptDialog } from "sftp_prompt_dialog.slint";
import { ConfirmCloseDialog } from "confirm_close_dialog.slint";
import { ChmodDialog } from "chmod_dialog.slint";
import { DownloadManagerPopup, TransferInfo } from "download_manager.slint";
import { SettingsMenuPopup } from "settings_menu.slint";
import { AboutDialog } from "about_dialog.slint";
import { DockSnapOverlay } from "dock_snap_overlay.slint";
import { ConfirmOverlays } from "confirm_overlays.slint";
import { ShortcutsDialog } from "shortcuts_dialog.slint";

export component InterfaceSettingsOverlay inherits Rectangle {
    // 显隐由调用点控制：**常驻**，不用 `if` 包着 —— 在事件派发栈上销毁
    // 正在处理事件的子树会闪退（#323/#343）。关闭时不绘制也不参与命中。
    in property <bool> open: false;
    visible: open;
    // ── 状态（窗口透传）──────────────────────────────────────────────
    // 配色：主题（深浅）+ 主题色（由 Rust 播种；预设色已按当前深浅档解析好颜色）。
    in property <string> accent-mode:"system";
    in property <string> accent-choice:"";
    in property <[AccentPreset]> accent-presets;
    in-out property <string> accent-hex:"";
    in property <string> accent-name:"";
    in-out property <bool> collapse-sftp-default:false;
    in-out property <bool> collapse-sidebar-default:false;
    in-out property <bool> convert-eol:false;
    in property <string> current-wallpaper:"";
    in property <string> custom-wallpaper-name:"";
    in property <[string]> wallpaper-labels;
    in-out property <int> wallpaper-index;
    in-out property <bool> download-always-ask:false;
    in-out property <bool> hide-special-partitions:true;
    in-out property <length> ifd-base-h;
    in-out property <length> ifd-base-w;
    in-out property <length> ifd-base-x;
    in-out property <length> ifd-base-y;
    in-out property <bool> ifd-dragging;
    in-out property <length> ifd-grab-x;
    in-out property <length> ifd-grab-y;
    in-out property <length> ifd-h:min(root.height - 56px, max(420px, 480px * Theme.panel-font));
    in-out property <bool> ifd-resizing;
    in-out property <length> ifd-w:min(root.width - 56px, max(640px, 720px * Theme.panel-font));
    in-out property <length> ifd-x:round((root.width - root.ifd-w) / 2 / 1px) * 1px;
    in-out property <length> ifd-y:round((root.height - root.ifd-h) / 2 / 1px) * 1px;
    in property <bool> is-windows:false;
    in-out property <bool> json-format-output:true;
    in property <bool> lang-en:false;
    in-out property <bool> large-scrollback;
    in-out property <string> mount-filter:"";
    in-out property <bool> osc52-clipboard:true;
    in-out property <bool> output-highlight-enabled:true;
    in-out property <string> output-highlight-preset:"log";
    in-out property <string> output-highlight-rule-status;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <bool> quick-commands-as-sidebar:false;
    in-out property <bool> quick-panel-collapsed:false;
    in-out property <bool> quick-panel-open:false;
    in-out property <string> renderer-mode:"software";
    in-out property <string> scrollback-lines:"5000";
    in-out property <bool> sftp-follow-cd:true;
    in-out property <bool> show-cmd-bar:true;
    in-out property <bool> sync-upload-enabled:false;
    in property <color> term-cursor-color:Theme.term-fg;
    in-out property <string> term-cursor-color-hex:Theme.dark ? "#D4D4D4" : "#2D2D2F";
    in-out property <string> term-cursor-style:"block";
    in-out property <int> term-font-index:0;
    in property <[string]> term-fonts;
    in-out property <int> ui-font-index:0;
    in property <[string]> ui-fonts;
    in-out property <bool> update-check-enabled:true;
    in property <string> update-check-status:"";
    in property <bool> update-checking:false;
    in property <string> update-channel: "stable";
    in property <[string]> update-freq-labels;
    in-out property <int> update-freq-index: 0;
    in property <string> update-last-check: "";
    in-out property <bool> webdav-accept-invalid-certs:false;
    in-out property <bool> webdav-enabled:false;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <string> webdav-status;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <bool> welcome-as-sidebar:false;
    in-out property <string> wsl-new-directory:"~";
    in property <[WslProfileInfo]> wsl-profiles;

    // ── 动作（41 个，全部由调用点转发，实现仍在 Rust）────────────
    callback close-requested();
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback add-wsl-profile(string, string, string);
    callback check-update-now();
    callback persist-wallpaper-overlay(float);
    callback pick-wallpaper-file();
    callback pick-wsl-directory();
    callback remove-output-highlight-rule(int);
    callback remove-wsl-profile(string);
    callback reset-page(string);
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback set-animations-enabled(bool);
    callback set-collapse-sftp-default(bool);
    callback set-collapse-sidebar-default(bool);
    callback set-convert-eol(bool);
    callback set-download-always-ask(bool);
    callback set-hide-special-partitions(bool);
    callback set-json-format-output(bool);
    callback set-large-scrollback(bool);
    callback set-mount-filter(string);
    callback set-osc52-clipboard(bool);
    callback set-output-highlight(bool, string);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-panel-font(int);
    callback set-quick-commands-as-sidebar(bool);
    callback set-renderer-mode(string);
    callback set-scrollback-lines(string) -> bool;
    callback set-sftp-follow-cd(bool);
    callback set-show-cmd-bar(bool);
    callback set-sync-upload-enabled(bool);
    callback set-term-cursor-color(string) -> bool;
    callback set-term-cursor-color-rgb(int, int, int) -> bool;
    callback set-term-cursor-style(string);
    callback set-term-font(string);
    callback set-term-font-bold(bool);
    callback set-term-font-size(int);
    callback set-ui-font(string);
    callback upload-ui-font();
    callback set-ui-scale(int);
    callback set-accent(string) -> bool;
    callback set-accent-rgb(int, int, int) -> bool;
    callback set-appearance-mode(string);
    callback set-update-check-enabled(bool);
    callback set-update-channel(string);
    callback set-update-freq(int);
    callback set-wallpaper(string);
    callback set-welcome-as-sidebar(bool);
    callback webdav-download();
    callback webdav-upload();

    width: 100%;
    height: 100%;
    background: #00000080;            // dim backdrop
    // Grab focus and swallow keys so nothing leaks to the terminal beneath;
    // Esc closes the panel (#140-3).
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.close-requested(); }
            accept
        }
        key-released(e) => { accept }
    }
    // Modal: clicking the backdrop does nothing (only the ✕ closes it).
    TouchArea { scroll-event(e) => { accept } }

    Rectangle {
        x: ifd-x;
        y: ifd-y;
        // Bigger base, and scales with the settings font size (#v0.5).
        width: ifd-w;
        height: ifd-h;
        // 20% less transparent than the welcome/resource panels so the dense
        // grey settings labels stay readable at a low overlay (user request).
        background: Theme.bg-panel-strong;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-color: Theme.shadow-dialog-color;
        clip: true;
        TouchArea {}   // swallow inside clicks so they don't hit the backdrop

        VerticalLayout {
            // Title bar — drag to move (clamped inside the window).
            Rectangle {
                height: 44px;
                // Transparent so the card's single frosted layer shows through
                // — no extra stacked opacity, matching the welcome/resource
                // panels and following the wallpaper slider (#new-user-defaults
                // items 6/7). The 1px divider below still separates it.
                background: transparent;
                title-drag := TouchArea {
                    mouse-cursor: move;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            ifd-dragging = true;
                            ifd-base-x = ifd-x;
                            ifd-base-y = ifd-y;
                            ifd-grab-x = self.absolute-position.x + self.mouse-x;
                            ifd-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            ifd-dragging = false;
                        }
                    }
                    moved => {
                        if (ifd-dragging) {
                            ifd-x = clamp(
                                round((ifd-base-x + (self.absolute-position.x + self.mouse-x - ifd-grab-x)) / 1px) * 1px,
                                0px, max(0px, root.width - ifd-w));
                            ifd-y = clamp(
                                round((ifd-base-y + (self.absolute-position.y + self.mouse-y - ifd-grab-y)) / 1px) * 1px,
                                0px, max(0px, root.height - ifd-h));
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    Text {
                        text: lang-en ? "Settings" : "设置";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        CloseButton {
                            size: 24px;
                            glyph-size: 15px;
                            clicked => { root.close-requested(); }
                        }
                    }
                }
            }
            Divider {}

            InterfacePanel {
                vertical-stretch: 1;
                lang-en: lang-en;
                is-windows: is-windows;
                renderer-mode <=> renderer-mode;
                term-fonts: term-fonts;
                term-font-family: Theme.term-font-family;
                term-font-index <=> term-font-index;
                ui-fonts: ui-fonts;
                ui-font-index <=> ui-font-index;
                term-font-size: Theme.term-font-size;
                term-font-bold: Theme.term-font-bold;
                term-cursor-style <=> term-cursor-style;
                term-cursor-color-hex <=> term-cursor-color-hex;
                term-cursor-color: term-cursor-color;
                output-highlight-enabled <=> output-highlight-enabled;
                json-format-output <=> json-format-output;
                scrollback-lines <=> scrollback-lines;
                large-scrollback <=> large-scrollback;
                convert-eol <=> convert-eol;
                osc52-clipboard <=> osc52-clipboard;
                hide-special-partitions <=> hide-special-partitions;
                mount-filter <=> mount-filter;
                output-highlight-preset <=> output-highlight-preset;
                output-highlight-rules: output-highlight-rules;
                output-highlight-rule-status <=> output-highlight-rule-status;
                ui-scale: Theme.ui-scale;
                sftp-follow-cd <=> sftp-follow-cd;
                collapse-sidebar-default <=> collapse-sidebar-default;
                show-cmd-bar <=> show-cmd-bar;
                collapse-sftp-default <=> collapse-sftp-default;
                sync-upload-enabled <=> sync-upload-enabled;
                webdav-enabled <=> webdav-enabled;
                webdav-url <=> webdav-url;
                webdav-username <=> webdav-username;
                webdav-password <=> webdav-password;
                webdav-remote-path <=> webdav-remote-path;
                webdav-accept-invalid-certs <=> webdav-accept-invalid-certs;
                webdav-status <=> webdav-status;
                download-always-ask <=> download-always-ask;
                reset-page(page) => { root.reset-page(page); }
                welcome-as-sidebar <=> welcome-as-sidebar;
                quick-commands-as-sidebar <=> quick-commands-as-sidebar;
                update-check-enabled <=> update-check-enabled;
                update-check-status: update-check-status;
                update-checking: update-checking;
                update-channel: update-channel;
                update-freq-labels: update-freq-labels;
                update-freq-index <=> update-freq-index;
                update-last-check: update-last-check;
                accent-mode: accent-mode;
                accent-choice: accent-choice;
                accent-presets: accent-presets;
                accent-hex <=> accent-hex;
                accent-name: accent-name;
                wallpaper-overlay <=> Theme.panel-alpha;
                current-wallpaper: current-wallpaper;
                custom-wallpaper-name: custom-wallpaper-name;
                wallpaper-labels: wallpaper-labels;
                wallpaper-index <=> wallpaper-index;
                wsl-profiles: wsl-profiles;
                wsl-new-directory <=> wsl-new-directory;
                set-accent(v) => { return root.set-accent(v); }
                set-accent-rgb(a0, a1, a2) => { return root.set-accent-rgb(a0, a1, a2); }
                set-appearance-mode(v) => { root.set-appearance-mode(v); }
                set-wallpaper(v) => { root.set-wallpaper(v); }
                pick-wallpaper-file() => { root.pick-wallpaper-file(); }
                set-term-font(v) => { root.set-term-font(v); }
                set-ui-font(v) => { root.set-ui-font(v); }
                upload-ui-font() => { root.upload-ui-font(); }
                set-term-font-size(v) => { root.set-term-font-size(v); }
                set-term-font-bold(v) => { root.set-term-font-bold(v); }
                set-term-cursor-style(v) => { root.set-term-cursor-style(v); }
                set-term-cursor-color(v) => { root.set-term-cursor-color(v) }
                set-term-cursor-color-rgb(a0, a1, a2) => { return root.set-term-cursor-color-rgb(a0, a1, a2); }
                set-output-highlight(enabled, preset) => {
                    root.set-output-highlight(enabled, preset);
                }
                set-json-format-output(enabled) => { root.set-json-format-output(enabled); }
                set-scrollback-lines(v) => { return root.set-scrollback-lines(v); }
                set-large-scrollback(v) => { root.set-large-scrollback(v); }
                set-convert-eol(v) => { root.set-convert-eol(v); }
                set-osc52-clipboard(v) => { root.set-osc52-clipboard(v); }
                set-hide-special-partitions(v) => { root.set-hide-special-partitions(v); }
                set-animations-enabled(v) => { root.set-animations-enabled(v); }
                set-mount-filter(v) => { root.set-mount-filter(v); }
                add-output-highlight-rule(pattern, regex, case-sensitive, whole-line, color) => {
                    root.add-output-highlight-rule(
                        pattern, regex, case-sensitive, whole-line, color)
                }
                remove-output-highlight-rule(index) => {
                    root.remove-output-highlight-rule(index);
                }
                set-output-highlight-rule-enabled(index, enabled) => {
                    root.set-output-highlight-rule-enabled(index, enabled);
                }
                set-ui-scale(v) => { root.set-ui-scale(v); }
                set-panel-font(v) => { root.set-panel-font(v); }
                set-renderer-mode(v) => { root.set-renderer-mode(v); }
                set-sftp-follow-cd(v) => { root.set-sftp-follow-cd(v); }
                set-collapse-sidebar-default(v) => { root.set-collapse-sidebar-default(v); }
                set-collapse-sftp-default(v) => { root.set-collapse-sftp-default(v); }
                set-sync-upload-enabled(v) => { root.set-sync-upload-enabled(v); }
                save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs) => {
                    root.save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs);
                }
                webdav-upload => { root.webdav-upload(); }
                webdav-download => { root.webdav-download(); }
                set-download-always-ask(v) => { root.set-download-always-ask(v); }
                set-welcome-as-sidebar(v) => { root.set-welcome-as-sidebar(v); }
                set-show-cmd-bar(v) => { root.set-show-cmd-bar(v); }
                set-quick-commands-as-sidebar(v) => {
                    quick-commands-as-sidebar = v;
                    if (!v) {
                        quick-panel-open = false;
                        quick-panel-collapsed = false;
                    }
                    root.set-quick-commands-as-sidebar(v);
                }
                set-update-check-enabled(v) => { root.set-update-check-enabled(v); }
                set-update-channel(w0) => { root.set-update-channel(w0); }
                set-update-freq(w1) => { root.set-update-freq(w1); }
                check-update-now() => { root.check-update-now(); }
                add-wsl-profile(name, distribution, directory) => { root.add-wsl-profile(name, distribution, directory); }
                remove-wsl-profile(id) => { root.remove-wsl-profile(id); }
                pick-wsl-directory => { root.pick-wsl-directory(); }
                persist-wallpaper-overlay(v) => { root.persist-wallpaper-overlay(v); }
            }
        }
        Rectangle {
            x: parent.width - 18px;
            y: parent.height - 18px;
            width: 18px;
            height: 18px;
            background: resize-ta.has-hover || ifd-resizing ? Theme.bg-hover : transparent;
            IconText {
                centered: true;
                text: "\u{E3C2}";
                color: Theme.text-muted;
                font-size: 14px;
            }
            resize-ta := TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        ifd-resizing = true;
                        ifd-base-w = ifd-w;
                        ifd-base-h = ifd-h;
                        ifd-grab-x = self.absolute-position.x + self.mouse-x;
                        ifd-grab-y = self.absolute-position.y + self.mouse-y;
                    } else if (e.kind == PointerEventKind.up) {
                        ifd-resizing = false;
                    }
                }
                moved => {
                    if (ifd-resizing) {
                        ifd-w = clamp(
                            round((ifd-base-w + (self.absolute-position.x + self.mouse-x - ifd-grab-x)) / 1px) * 1px,
                            640px, max(640px, root.width - ifd-x));
                        ifd-h = clamp(
                            round((ifd-base-h + (self.absolute-position.y + self.mouse-y - ifd-grab-y)) / 1px) * 1px,
                            420px, max(420px, root.height - ifd-y));
                    }
                }
            }
        }
    }
}
