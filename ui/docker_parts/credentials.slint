//! Docker 提权凭据弹窗。
//!
//! 每台主机（按已保存会话）可配置一条提权凭据：
//! - `sudo`：密码是**当前 SSH 登录用户**的 sudo 密码，可选目标用户（默认 root）；
//! - `su`：密码是**目标账号本人**的密码。
//!
//! 密码只写不读：已保存时界面显示「留空不修改」，永不回填明文。

import { Theme } from "../theme.slint";
import { LabeledInput } from "../widgets.slint";
import { StateSurface } from "../components/interactive.slint";
import { IconText } from "../components/text.slint";

export component DockerCredentialsDialog inherits Rectangle {
    in property <string> host-label;
    /// "sudo" / "su"；空按 sudo。
    in property <string> mode: "sudo";
    in property <string> target-user;
    in property <bool> has-password: false;
    in property <bool> testing: false;
    in property <string> test-text;
    in property <bool> test-ok: false;

    callback save(string /*mode*/, string /*user*/, string /*password*/);
    callback test(string, string, string);
    callback clear();
    callback dismiss();

    property <string> draft-mode: root.mode == "su" ? "su" : "sudo";
    property <string> draft-user: root.target-user;
    property <string> draft-password: "";
    property <bool> su-mode: root.draft-mode == "su";

    background: #00000066;
    TouchArea { clicked => { root.dismiss(); } }

    card := Rectangle {
        width: 460px * Theme.ui-zoom;
        height: layout.preferred-height + 2px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-subtle;

        // 吃掉卡片空白处的点击，避免穿透到遮罩把弹窗关掉。
        TouchArea { }

        layout := VerticalLayout {
            padding: Theme.sp-20;
            spacing: Theme.sp-10;

            HorizontalLayout {
                spacing: Theme.sp-8;
                Text {
                    text: @tr("Docker credentials");
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 22px * Theme.ui-zoom;
                    height: 22px * Theme.ui-zoom;
                    border-radius: Theme.radius-sm;
                    background: close-hit.has-hover ? Theme.state-hover : transparent;
                    IconText {
                        centered: true;
                        text: "\u{E5CD}";
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                    }
                    close-hit := TouchArea { clicked => { root.dismiss(); } }
                }
            }

            Text {
                text: root.host-label;
                font-size: Theme.fs-xs;
                color: Theme.text-muted;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: Theme.sp-6;
                Text {
                    text: @tr("Elevation");
                    font-size: Theme.fs-xs;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                StateSurface {
                    width: 76px * Theme.ui-zoom;
                    height: 26px * Theme.ui-zoom;
                    selected: root.draft-mode == "sudo";
                    outlined: true;
                    clicked => { root.draft-mode = "sudo"; }
                    Text {
                        text: "sudo";
                        font-size: Theme.fs-xs;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                StateSurface {
                    width: 60px * Theme.ui-zoom;
                    height: 26px * Theme.ui-zoom;
                    selected: root.draft-mode == "su";
                    outlined: true;
                    clicked => { root.draft-mode = "su"; }
                    Text {
                        text: "su";
                        font-size: Theme.fs-xs;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            LabeledInput {
                label: root.su-mode ? @tr("Target account") : @tr("Target user (blank = root)");
                placeholder: root.su-mode ? @tr("Account name") : "root";
                value <=> root.draft-user;
            }

            LabeledInput {
                label: @tr("Password");
                placeholder: root.has-password ? @tr("Saved — leave blank to keep") : "";
                password: true;
                value <=> root.draft-password;
                accepted => { root.save(root.draft-mode, root.draft-user, root.draft-password); }
            }

            Text {
                text: root.su-mode
                    ? @tr("su asks for the target account's own password.")
                    : @tr("sudo asks for the signed-in user's sudo password.");
                font-size: Theme.fs-xs;
                color: Theme.text-muted;
                wrap: word-wrap;
            }

            if root.test-text != "" : Text {
                text: root.test-text;
                font-size: Theme.fs-xs;
                color: root.test-ok ? Theme.success : Theme.danger;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.sp-8;

                StateSurface {
                    width: 76px * Theme.ui-zoom;
                    height: 30px * Theme.ui-zoom;
                    outlined: true;
                    interactive: !root.testing;
                    clicked => { root.clear(); }
                    Text {
                        text: @tr("Clear");
                        font-size: Theme.fs-xs;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                StateSurface {
                    width: 72px * Theme.ui-zoom;
                    height: 30px * Theme.ui-zoom;
                    outlined: true;
                    clicked => { root.dismiss(); }
                    Text {
                        text: @tr("Cancel");
                        font-size: Theme.fs-xs;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                StateSurface {
                    width: 72px * Theme.ui-zoom;
                    height: 30px * Theme.ui-zoom;
                    outlined: true;
                    interactive: !root.testing;
                    clicked => { root.test(root.draft-mode, root.draft-user, root.draft-password); }
                    Text {
                        text: root.testing ? @tr("Testing…") : @tr("Test");
                        font-size: Theme.fs-xs;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                StateSurface {
                    width: 76px * Theme.ui-zoom;
                    height: 30px * Theme.ui-zoom;
                    outlined: true;
                    interactive: !root.testing;
                    clicked => { root.save(root.draft-mode, root.draft-user, root.draft-password); }
                    Text {
                        text: @tr("Save");
                        font-size: Theme.fs-xs;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
