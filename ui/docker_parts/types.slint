//! Docker 页的数据契约（叶子层）。
//!
//! 这里只放 struct，不 import 任何组件 —— `app.slint` 与各子页都从这里取类型，
//! 避免 `app.slint → docker_page → containers → docker_page` 的循环引用。

export struct DockerHostTab {
    key: string,
    label: string,
    connected: bool,
    session_count: int,
    count: int,          // -1 = 尚未加载；0 = 已加载但无容器
    /// 标题显示宽度（ASCII=1、非 ASCII=2），与终端标签同一套三档字号。
    title_len: int,
    /// 代表标签对应的已保存会话 id（凭据弹窗按它定位），空 = 无会话。
    session_id: string,
}

export struct DockerContainer {
    id: string,
    name: string,
    image: string,
    state: string,     // running / exited / paused / created / restarting / dead
    status: string,    // docker 原文，如 "Up 3 hours"
    ports: string,
    created: string,
}

/// 概览页的资源统计；`-1` = 本轮尚未采集（界面显示破折号）。
export struct DockerOverviewStats {
    running: int,
    stopped: int,
    images: int,
    networks: int,
    compose_projects: int,
}

/// 本地镜像列表的一行。
export struct DockerImage {
    id: string,
    /// `repo:tag`，由 Rust 侧拼好。
    name: string,
    tag: string,
    size: string,
    created: string,
    /// 是否有容器（含已停止）引用该镜像，Rust 侧按镜像 ID 比对。
    in_use: bool,
    /// 引用该镜像的容器数，Rust 侧预格式化。
    use_count: string,
}

/// Compose 项目列表的一行。
export struct DockerComposeRow {
    name: string,
    running: bool,
    /// 已格式化的容器数，如 "1"。
    containers_text: string,
    /// compose 文件路径，第二批启停用。
    config: string,
}

/// 网络列表的一行。
export struct DockerNetworkRow {
    name: string,
    driver: string,
    /// 已格式化的关联容器数量。
    count_text: string,
    /// 关联容器名，逗号拼接；为空显示「无」。
    containers: string,
}

/// Docker Hub 搜索结果的一行。
export struct RegistryRepoRow {
    name: string,
    description: string,
    /// 已格式化：1B+ / 120M / 8K。
    pulls: string,
    /// 已格式化的星标数。
    stars_text: string,
    /// Docker 官方镜像标记。
    official: bool,
}
