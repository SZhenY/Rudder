//! Docker 功能页共用的页头：标题 + 搜索 + 刷新 + 主操作。
//!
//! 主操作在第一批统一置灰（后续版本支持），所以 `action-enabled` 默认 false。
//! 三个按钮统一 28px 高、内容居中；宽度跟随文案，英文不会被裁。

import { Theme } from "../theme.slint";
import { IconText } from "../components/text.slint";
import { StateSurface } from "../components/interactive.slint";
import { LineEdit } from "std-widgets.slint";

export component DockerPageHead inherits Rectangle {
    in property <string> title;
    in property <bool> show-search: true;
    in property <string> search-text;
    in property <string> search-placeholder;
    in property <string> action-label;
    in property <bool> action-enabled: false;
    /// 主操作用实心强调色；次要操作（例如「设置」）用描边。
    in property <bool> primary-action: true;

    callback search-edited(string);
    callback refresh();
    callback action();

    private property <bool> tight: root.width < 640px * Theme.ui-zoom;
    height: 32px * Theme.ui-zoom;

    HorizontalLayout {
        spacing: Theme.sp-8;
        // 标题 / 搜索 / 按钮统一按 32px 高对齐。
        cross-axis-alignment: center;

        Text {
            text: root.title;
            font-size: Theme.fs-lg;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }

        // 窄窗也保留搜索：镜像仓库页的搜索是主入口，只收窄不隐藏。
        //
        // ⚠️ 必须包一层固定宽度：std 的 LineEdit 自带 `horizontal-stretch: 1`
        // 和 `min-width: 160px`，直接放进布局会抢走 spacer 分到的空间，
        // 把后面的刷新 / 主按钮挤出可视区。
        if root.show-search : Rectangle {
            width: (root.tight ? 160px : 240px) * Theme.ui-zoom;
            height: 32px * Theme.ui-zoom;
            clip: true;

            LineEdit {
                width: parent.width;
                height: parent.height;
                text: root.search-text;
                font-family: Theme.ui-font-family;
                placeholder-text: root.search-placeholder;
                edited => { root.search-edited(self.text); }
            }
        }

        StateSurface {
            width: (root.tight ? 30px : 66px) * Theme.ui-zoom;
            height: 32px * Theme.ui-zoom;
            radius: Theme.radius-sm;
            outlined: true;
            clicked => { root.refresh(); }
            HorizontalLayout {
                alignment: center;
                spacing: 4px * Theme.ui-zoom;
                IconText {
                    text: "\u{E5D5}";
                    font-size: 15px * Theme.ui-zoom;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                if !root.tight : Text {
                    text: @tr("Refresh");
                    font-size: Theme.fs-sm;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        if root.action-label != "" && root.primary-action : Rectangle {
            width: max(88px * Theme.ui-zoom, action-text.preferred-width + 52px * Theme.ui-zoom);
            height: 32px * Theme.ui-zoom;
            border-radius: Theme.radius-sm;
            background: action-hit.has-hover && root.action-enabled ? Theme.accent-hover : Theme.accent;
            opacity: root.action-enabled ? 1 : 0.45;

            action-hit := TouchArea {
                enabled: root.action-enabled;
                mouse-cursor: pointer;
                clicked => { root.action(); }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 4px * Theme.ui-zoom;
                IconText {
                    text: "\u{E145}";
                    font-size: 16px * Theme.ui-zoom;
                    color: #ffffff;
                    vertical-alignment: center;
                }
                action-text := Text {
                    text: root.action-label;
                    font-size: Theme.fs-sm;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }

        if root.action-label != "" && !root.primary-action : StateSurface {
            width: max(76px * Theme.ui-zoom, action-label-text.preferred-width + 28px * Theme.ui-zoom);
            height: 32px * Theme.ui-zoom;
            radius: Theme.radius-sm;
            outlined: true;
            interactive: root.action-enabled;
            opacity: root.action-enabled ? 1 : 0.55;
            clicked => { root.action(); }
            action-label-text := Text {
                text: root.action-label;
                font-size: Theme.fs-sm;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
