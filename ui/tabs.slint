// 标签**数据类型**（`TabInfo`）。
//
// 终端页重做④：旧外壳的标签条组件（`TabBar` / `SingleTab` / `TabMenuItem`，早就
// 没有任何实例化点）整体删除 —— 分屏标签条现在住 `shell/pane_tabs.slint`。
// 本文件只剩 `TabInfo`：它是窗口级 `panes[].tabs` 的元素类型，也是 SFTP 传输目标
// 列表（`tab-id + title`）的元素类型，外部导入点（`import { TabInfo } from "tabs.slint";`）保持不变。

export struct TabInfo {
    id: string,
    title: string,
    title_len: int,
    kind: string,   // "welcome" | "terminal"
    connected: bool,
}
