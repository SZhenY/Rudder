import { Theme , AnimationSettings } from "theme.slint";
import { IconButton } from "widgets.slint";
import { Divider } from "components/surfaces.slint";

export struct TabInfo {
    id: string,
    title: string,
    title_len: int,
    kind: string,   // "welcome" | "terminal"
    connected: bool,
}

// --- SingleTab -------------------------------------------------------------
component SingleTab inherits Rectangle {
    in property <TabInfo> info;
    in property <bool> active;
    callback selected();
    callback closed();
    // Drag-to-reorder (v0.5): emitted while dragging when the tab should hop one
    // slot left (-1) or right (+1). The model reorders and the tab follows.
    callback reorder(int /* dir */);
    // Right-click (v0.5): request a context menu at the given absolute position.
    callback context-requested(length /* abs-x */, length /* abs-y */);
    // 无障碍（P6）：标签对读屏软件是一个 `tab`，名字就是标题；被选中的那个会被念作
    // 已选中，默认动作（VoiceOver 的"双击"）= 选中它。写法照官方 `TabWidget`。
    in property <int> tab-index: 0;

    accessible-role: tab;
    accessible-label: root.info.title;
    accessible-item-index: root.tab-index;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.selected(); }

    // Where inside the tab the drag began, and whether a drag (vs a click) is in
    // progress. `dragging` suppresses the select-on-release.
    property <length> grab-offset;
    property <bool> pressing;
    out property <bool> dragging;

    height: 30px;
    // 宽度跟着**内容**走：内部 HorizontalLayout 的 preferred-width（圆点 + 标题实测宽
    // + 关闭按钮 + 内外边距），范围用 min/max 夹住。旧写法 `64px + 标题字数 * 7px`
    // 是按"每个字符 7px"估算的 —— 中文、粗体、大写字母一律偏，换字体更完全不跟随。
    min-width: 100px;
    max-width: 320px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    border-width: active ? 2px : 0px;
    border-color: active ? Theme.accent : transparent;
    background: dragging ? Theme.bg-active
        : (active ? Theme.tab-active-bg
        : (touch.has-hover ? Theme.bg-hover : transparent));
    animate background { duration: 120ms;
            easing: AnimationSettings.color;
            enabled: AnimationSettings.enabled;
        }

    // Declared FIRST so the HorizontalLayout's children (close button) are at
    // a higher z-order and receive their own click events.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.grab-offset = self.mouse-x;
                root.pressing = true;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.context-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up) {
                // 拖动过（reorder）就不算点击选中；拖拽分屏已移除，
                // 这里不再发出 drag-dropped。
                if (root.pressing && !root.dragging) {
                    root.selected();
                }
                root.pressing = false;
                root.dragging = false;
            }
        }
        moved => {
            if (root.pressing) {
                // A drag begins once the cursor drifts horizontally OR leaves the
                // tab vertically (so a straight-down drag to split also counts).
                if (abs(self.mouse-x - root.grab-offset) > 5px
                        || self.mouse-y < -6px || self.mouse-y > root.height + 6px) {
                    root.dragging = true;
                }
                // Reorder within the strip only while the cursor stays on the strip
                // row; once it drops into a pane body we hand off to drag-to-split.
                // One slot = the tab's own width + the 2px strip spacing; re-anchor
                // grab-offset after each hop so the drift resets (no oscillation).
                if (self.mouse-y > -10px && self.mouse-y < root.height + 10px) {
                    if (self.mouse-x - root.grab-offset > (root.width + 2px) / 2) {
                        root.reorder(1);
                        root.grab-offset = self.mouse-x - (root.width + 2px);
                    } else if (self.mouse-x - root.grab-offset < -(root.width + 2px) / 2) {
                        root.reorder(-1);
                        root.grab-offset = self.mouse-x + (root.width + 2px);
                    }
                }
            }
        }
        // Double-click intentionally does nothing: renaming lives in the
        // context menu only, and the old duplicate-connection gesture (#340)
        // was removed at the maintainer's request (2026-09-10).
    }

    HorizontalLayout {
        // 不写 width：让布局按内容给出首选宽度，标签的 min/max-width 再夹范围。
        // （旧写法 `parent.width - 28px` 是给关闭按钮预留的绝对定位槽位，
        // 写死 width 也就阻断了 preferred-width 向上传播。）
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        alignment: start;

        // Status indicator
        Rectangle {
            width: 8px; height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: info.kind == "welcome" ? Theme.text-muted
                : (info.connected ? Theme.success : Theme.warning);
        }

        title-text := Text {
            text: info.title;
            // 标题已作为外层 `tab` 的 `accessible-label`，这里不再作为独立节点重复朗读。
            accessible-role: none;
            color: active ? Theme.text-primary : Theme.text-secondary;
            font-size: info.title_len > 24 ? 9px * Theme.ui-scale
                : (info.title_len > 12 ? 10px * Theme.ui-scale : Theme.fs-sm);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // 关闭按钮是布局的最后一格（原先绝对定位在 `parent.width - self.width - 6px`，
        // 于是标签宽度必须额外预留 28px，而宽度又只能靠字数猜）。标题
        // `horizontal-stretch: 1` 会把多余空间吃掉，因此它仍然贴在最右侧。
        if info.kind != "welcome" : IconButton {
            glyph: "×";
            size: 20px;
            y: (parent.height - self.height) / 2;
            // 共享组件的 `accessible-label` 默认取 tooltip，这里没传 tooltip →
            // 显式给名字（英文，与标签右键菜单里的 "Close tab" 一致）。
            accessible-name: "Close tab";
            clicked => { root.closed(); }
        }
    }

}

// --- Tab context-menu item -------------------------------------------------
component TabMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    border-radius: Theme.radius-sm;
    background: enabled && ta.has-hover ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            color: enabled ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- TabBar ----------------------------------------------------------------
export component TabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    in property <bool> show-new-tab: true;
    in property <bool> can-merge-pane: false;
    // Keep this much clear on the right so tabs don't slide under the app's
    // top-right toolbar icons, which are positioned over the tab row (#122).
    in property <length> reserve-right: 0px;
    callback tab-selected(string);
    callback tab-closed(string);
    callback new-tab();
    // Drag-to-reorder: move the tab at `from` one slot in `dir` (#v0.5).
    callback tab-reorder(int /* from */, int /* dir */);
    // Split this pane, peeling `tab-id` into a new pane on `dir` (#v0.5).
    callback tab-split(string /* tab-id */, string /* dir */);
    // Open another connection to the same session as `tab-id` (#v0.5).
    callback tab-duplicate(string /* tab-id */);
    // Rename an open session's tab (display name only).
    callback tab-rename-request(string /* tab-id */);
    callback merge-pane();

    // Right-click context-menu state.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;

    height: 36px;
    background: Theme.bg-panel-alt;

    // True only when the tabs are wider than the available strip width (#122).
    // 判据从 TabBar 自身宽度算（而非 flick.width），避免"显示箭头 → 影响布局 →
    // 又改变判据"的回环。右侧的预留量原本是一个 94px 魔数（旧注释：64 给两个箭头
    // + 30 给"所有标签"按钮），现在按**真实元素**拆开写，改尺寸时会自动跟随。
    property <length> arrows-w: 2 * 26px;          // 两个箭头覆盖层
    property <length> right-chrome-w: 8px + 28px + 4px;  // 分隔 8 + 所有标签按钮 28 + 两个 spacing
    property <bool> tab-overflow:
        strip.preferred-width > root.width - root.reserve-right
            - (2 * 3px) - root.right-chrome-w - root.arrows-w;

    HorizontalLayout {
        padding: 3px;
        // 右侧为窗口右上角的工具栏图标预留（#122）：原来是末尾一个
        // `Rectangle { width: root.reserve-right; }` 占位 —— 删掉它也会连带删掉
        // 它前面那份 spacing(2px)，故一并补回。
        padding-right: 3px + 2px + root.reserve-right;
        spacing: 2px;

        // Horizontally-scrollable strip: when the tabs overflow the available
        // width they stay reachable by the arrows or by dragging / trackpad (#122).
        flick := Flickable {
            horizontal-stretch: 1;
            viewport-height: self.height;
            viewport-width: max(self.width, strip.preferred-width);
            strip := HorizontalLayout {
                spacing: 2px;
                alignment: start;
                for tab[i] in tabs : SingleTab {
                    info: tab;
                    active: tab.id == root.active-id;
                    tab-index: i;
                    selected => { root.tab-selected(tab.id); }
                    closed => { root.tab-closed(tab.id); }
                    reorder(dir) => { root.tab-reorder(i, dir); }
                    context-requested(ax, ay) => {
                        root.menu-target = tab.id;
                        root.menu-x = ax - root.absolute-position.x;
                        root.menu-y = ay - root.absolute-position.y;
                        tab-menu.show();
                    }
                }
                if root.show-new-tab : IconButton {
                    glyph: "+";
                    size: 28px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.new-tab(); }
                }
            }
        }

        // A stable right-edge entry point for finding any open session when
        // the tab strip is crowded (#340). E5C5 is a Material Icons codepoint
        // (view_list) — without the icon font it renders as a tofu box.
        // 8 px separator on the left keeps it from visually merging with the
        // last tab, and the IconButton is centred inside its 28 px box so the
        // glyph itself sits in the middle of the available vertical strip.
        // 分组留白（原为空 `Rectangle` 占位）：标签条与「所有标签」按钮的间隔 2+8+2=12px → 2+8=10px（−2px）
        HorizontalLayout {
            padding-left: Theme.gap-sm;
            all-tabs-btn := IconButton {
                glyph: "\u{E5C5}";
                font-family: "Material Icons";
                size: 28px;
                clicked => { all-tabs-menu.show(); }
            }
        }

    }

    // Scroll arrows are absolute overlays so toggling them can't
    // change the layout that `tab-overflow` reads (avoids a binding loop). Shown
    // only on overflow, masking the edge tab beneath them (#122).
    if root.tab-overflow : Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 26px; height: 26px;
        background: Theme.bg-panel-alt;
        IconButton {
            glyph: "<"; size: 24px;
            clicked => { flick.viewport-x = min(0px, flick.viewport-x + 120px); }
        }
    }
    if root.tab-overflow : Rectangle {
        // 贴在标签条右端、即"所有标签"按钮的左侧（旧写法是 `- 59px` 魔数）。
        // 覆盖层不参与布局，读布局算出的 x 不会造成回环。
        x: all-tabs-btn.x - self.width;
        y: (parent.height - self.height) / 2;
        width: 26px; height: 26px;
        background: Theme.bg-panel-alt;
        IconButton {
            glyph: ">"; size: 24px;
            clicked => {
                flick.viewport-x = max(flick.width - flick.viewport-width, flick.viewport-x - 120px);
            }
        }
    }

    all-tabs-menu := PopupWindow {
        x: max(4px, root.width - root.reserve-right - self.width - 4px);
        y: root.height;
        width: 230px;
        height: min(308px, root.tabs.length * 29px + 8px);
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.shadow-popup-blur;
            drop-shadow-color: Theme.shadow-popup-color;
            clip: true;
            Flickable {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                viewport-width: self.width;
                viewport-height: max(self.height, all-tabs-list.preferred-height);
                all-tabs-list := VerticalLayout {
                    spacing: 1px;
                    for tab in root.tabs : TabMenuItem {
                        label: (tab.id == root.active-id ? "●  " : "    ") + tab.title;
                        clicked => {
                            root.tab-selected(tab.id);
                            all-tabs-menu.close();
                        }
                    }
                }
            }
        }
    }

    // Right-click context menu (v0.5): split this pane by peeling the clicked tab
    // into a new pane. Splitting needs at least two tabs so the source pane survives.
    tab-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 140px;
        height: 7 * 29px + 13px;
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.shadow-popup-blur;
            drop-shadow-color: Theme.shadow-popup-color;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                TabMenuItem {
                    label: @tr("Duplicate connection");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-duplicate(root.menu-target); }
                }
                TabMenuItem {
                    label: @tr("Rename session");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-rename-request(root.menu-target); }
                }
                Divider {}
                TabMenuItem {
                    label: @tr("Split right");
                    enabled: root.tabs.length > 1;
                    clicked => { root.tab-split(root.menu-target, "right"); }
                }
                TabMenuItem {
                    label: @tr("Split down");
                    enabled: root.tabs.length > 1;
                    clicked => { root.tab-split(root.menu-target, "down"); }
                }
                TabMenuItem {
                    label: @tr("Merge panes");
                    enabled: root.can-merge-pane;
                    clicked => { root.merge-pane(); }
                }
                Divider {}
                TabMenuItem {
                    label: @tr("Close tab");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-closed(root.menu-target); }
                }
            }
        }
    }
}
