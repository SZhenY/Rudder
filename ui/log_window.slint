//! 容器日志独立窗口。
//!
//! 固定黑底浅字，**不跟随主题与壁纸**（壁纸开启时应用主色只有 0.26 不透明度，
//! 日志会看不清）。只从主窗口同步 `ui-scale` 与等宽字体，其余尺寸按比例算。

export component DockerLogWindow inherits Window {
    /// 主窗口的界面缩放；只影响尺寸，不影响配色。
    in property <float> ui-scale: 1.0;
    in property <string> term-font: "JetBrains Mono";
    in property <bool> custom-titlebar;
    in property <string> window-title: "Docker logs";
    in property <string> container;
    in property <string> host;
    in property <bool> loading: false;
    in property <bool> truncated: false;
    in property <[string]> lines;
    in-out property <string> status;

    callback request-close();
    callback win-drag();
    callback win-resize-se();
    callback copy-logs();

    title: root.window-title;
    icon: @image-url("../assets/icon.png");
    no-frame: root.custom-titlebar;
    min-width: 460px * root.ui-scale;
    min-height: 280px * root.ui-scale;
    preferred-width: 760px * root.ui-scale;
    preferred-height: 520px * root.ui-scale;
    background: #000000;

    // macOS 原生标题栏：留出交通灯高度（子窗口里 Theme.is-mac 恒 false，
    // 只能用 custom-titlebar 判断，与 proc_window 同一约定）。
    if !root.custom-titlebar : Rectangle {
        height: 25px * root.ui-scale;
        background: transparent;
    }

    VerticalLayout {
        spacing: 0;

        // --- 标题栏（固定深色，不随主题）--------------------------------
        // macOS 也渲染这条：窗口是「全尺寸内容 + 透明标题栏」，原生交通灯浮在上方，
        // 上面已留 25px；复制 / 关闭按钮不能依赖原生标题栏。
        Rectangle {
            height: 34px * root.ui-scale;
            background: #0A0A0A;

            drag-ta := TouchArea {
                mouse-cursor: pointer;
                moved => {
                    if (self.pressed) {
                        root.win-drag();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 12px * root.ui-scale;
                padding-right: 8px * root.ui-scale;
                spacing: 8px * root.ui-scale;

                Rectangle {
                    width: 8px * root.ui-scale;
                    height: 8px * root.ui-scale;
                    border-radius: 2px * root.ui-scale;
                    background: #E6E6E6;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.container != "" ? @tr("Logs") + " · " + root.container : @tr("Logs");
                    color: #E6E6E6;
                    font-size: 13px * root.ui-scale;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.host != "" : Text {
                    text: root.host;
                    color: #8A8A8A;
                    font-size: 11px * root.ui-scale;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 26px * root.ui-scale;
                    height: 24px * root.ui-scale;
                    border-radius: 4px * root.ui-scale;
                    background: copy-ta.has-hover ? #1F1F1F : transparent;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: "\u{29C9}";
                        color: copy-ta.has-hover ? #E6E6E6 : #8A8A8A;
                        font-size: 14px * root.ui-scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    copy-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-logs(); }
                    }
                }
                Rectangle {
                    width: 26px * root.ui-scale;
                    height: 24px * root.ui-scale;
                    border-radius: 4px * root.ui-scale;
                    background: close-ta.has-hover ? #3A1F1F : transparent;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: "✕";
                        color: close-ta.has-hover ? #FF8A8A : #8A8A8A;
                        font-size: 13px * root.ui-scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.request-close(); }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: #1F1F1F; }

        // --- 日志正文 ---------------------------------------------------
        Flickable {
            vertical-stretch: 1;
            min-height: 0px;
            content-width: self.width;
            // Slint #407：`for` 生成的布局必须显式给 content-height，否则不滚动。
            content-height: max(self.height, log-col.preferred-height);

            log-col := VerticalLayout {
                alignment: start;
                padding-left: 12px * root.ui-scale;
                padding-right: 12px * root.ui-scale;
                padding-top: 8px * root.ui-scale;
                padding-bottom: 8px * root.ui-scale;

                for line in root.lines : Text {
                    text: line;
                    font-family: root.term-font;
                    font-size: 12px * root.ui-scale;
                    color: #E6E6E6;
                    wrap: no-wrap;
                }
                if root.lines.length == 0 && !root.loading : Text {
                    text: @tr("No log output");
                    color: #8A8A8A;
                    font-size: 12px * root.ui-scale;
                }
            }
        }

        // --- 底栏：加载中 / 截断提示 / 复制反馈 -------------------------
        if root.loading || root.truncated || root.status != "" : Rectangle {
            height: 24px * root.ui-scale;
            background: #0A0A0A;
            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1px;
                background: #1F1F1F;
            }
            HorizontalLayout {
                padding-left: 12px * root.ui-scale;
                padding-right: 12px * root.ui-scale;
                spacing: 12px * root.ui-scale;
                Text {
                    text: root.status != "" ? root.status
                        : root.loading ? @tr("Loading…")
                        : @tr("Only the last 200 lines are shown");
                    color: root.status != "" ? #7FD1A8 : #8A8A8A;
                    font-size: 11px * root.ui-scale;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    // 复制成功提示 2 秒后自动消失。
    Timer {
        interval: 2s;
        running: root.status != "";
        triggered => { root.status = ""; }
    }
}
