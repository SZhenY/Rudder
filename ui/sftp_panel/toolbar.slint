// SFTP 面板顶栏：三个页签、可编辑路径、复制/上传/下载/删除/刷新与窄模式折叠菜单。
import { Theme, AnimationSettings } from "../theme.slint";
import { SftpMenuItem } from "../sftp_parts.slint";
import { IconText } from "../components/text.slint";

component PanelTab inherits Rectangle {
    in property <string> mode;
    in property <string> panel-mode;
    in property <bool> narrow;
    in property <length> tab-width;
    in property <string> glyph;
    in property <string> label;
    /// 置灰：颜色变淡，但点击仍会上报（父级据此触发重试）。
    in property <bool> disabled: false;
    callback activate();

    width: root.tab-width;
    height: Theme.control-h-xs;
    border-radius: Theme.radius-sm;
    // 选中标记由 `SftpToolbar` 的共享滑块画（与左侧导航同款），这里只留 hover。
    background: tab-ta.has-hover ? Theme.state-hover : transparent;
    animate background {
        duration: AnimationSettings.short2();
        easing: AnimationSettings.e-standard-decelerate();
        enabled: AnimationSettings.enabled;
    }
    tab-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
    Text {
        text: root.narrow ? root.glyph : root.label;
        font-family: root.narrow ? "Material Icons" : Theme.ui-font-family;
        color: root.disabled ? Theme.text-muted
            : root.panel-mode == root.mode ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.fs-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SftpToolbar inherits Rectangle {
    in property <string> current-path: "/";
    in property <bool> narrow-toolbar: false;
    in-out property <string> panel-mode: "overview";
    in property <bool> collapsed: false;
    in property <int> selected-count: 0;
    /// SFTP 启动失败后置灰页签，点击改为重试。
    in property <bool> sftp-disabled: false;
    callback navigate(string);
    callback refresh(string);
    callback upload-clicked(string, bool);
    callback download-selected();
    callback delete-selected();
    callback toggle-collapsed();
    callback retry-sftp();

    // --- 页签几何（唯一来源）---------------------------------------------
    // 宽态 64/48/58、窄态三格等宽 28，间距统一 sp-4。页签宽度、滑块位置、
    // 容器宽度三处都从这两个函数派生，改一处不会再有第二处对不上。
    pure function tab-w(index: int, narrow: bool) -> length {
        return narrow
            ? 28px * Theme.ui-scale
            : (index == 0 ? 64px : index == 1 ? 48px : 58px) * Theme.ui-scale;
    }
    pure function tab-x(index: int, narrow: bool) -> length {
        return narrow
            ? (index == 0 ? 0px : index == 1 ? 32px : 64px) * Theme.ui-scale
            : (index == 0 ? 0px
                : index == 1 ? 64px * Theme.ui-scale + Theme.sp-4
                : 112px * Theme.ui-scale + 2 * Theme.sp-4);
    }
    pure function mode-index(mode: string) -> int {
        return mode == "sftp" ? 1 : (mode == "tunnels" ? 2 : 0);
    }

    /// 页签条总宽：宽态 178px、图标态 92px（3×28 + 2×4）。
    property <length> strip-w:
        root.tab-x(2, root.narrow-toolbar) + root.tab-w(2, root.narrow-toolbar);

    in-out property <length> ind-x:
        root.tab-x(root.mode-index(root.panel-mode), root.narrow-toolbar);
    in-out property <length> ind-w:
        root.tab-w(root.mode-index(root.panel-mode), root.narrow-toolbar);
    /// 本次写入是否允许动画：只有切换页签允许滑动，重排一律瞬时落位。
    property <bool> ind-anim: true;
    /// `narrow-toolbar` / `Theme.ui-scale` 的本地镜像：只为拿 `changed`。
    property <bool> obs-narrow: root.narrow-toolbar;
    property <float> obs-scale: Theme.ui-scale;

    function place(animate: bool) {
        if (!animate) { root.ind-anim = false; }   // 先关动画再写值
        root.ind-x = root.tab-x(root.mode-index(root.panel-mode), root.narrow-toolbar);
        root.ind-w = root.tab-w(root.mode-index(root.panel-mode), root.narrow-toolbar);
        if (!animate) { anim-restore.running = true; }
    }
    changed panel-mode => { root.place(true); }    // 切页签：滑动
    changed obs-narrow => { root.place(false); }   // 跨 480 阈值：重排，不滑
    changed obs-scale => { root.place(false); }    // 缩放：不滑

    // 目录在别处变化（树点击、双击、终端 cd）时同步两个路径输入框（#54）。
    changed current-path => {
        path-input.text = root.current-path;
        compact-path-input.text = root.current-path;
    }
    height: root.narrow-toolbar && root.panel-mode == "sftp" ? Theme.toolbar-h-narrow : Theme.bar-h;
    background: Theme.bg-panel-alt;

    // 瞬时落位后恢复动画：16ms 足够，Slint 在本次回调结束时就决定了要不要动画。
    anim-restore := Timer {
        interval: 16ms;
        running: false;
        triggered => { anim-restore.running = false; root.ind-anim = true; }
    }

    VerticalLayout {
        spacing: Theme.sp-6;

        HorizontalLayout {
        height: Theme.bar-h;
        padding-left: Theme.sp-6;
        padding-right: Theme.sp-6;
        padding-top: Theme.sp-6;
        padding-bottom: Theme.sp-6;
        spacing: Theme.sp-4;

        // 三个页签 + 共享滑动块：位置/宽度按 mode 固定，块在 layout 之外绝对定位。
        Rectangle {
            horizontal-stretch: 0;
            // 宽度跟着几何派生：宽态 178、图标态 92。原来写死 178 在图标态
            // 多占 86px，会把右侧的 ⋮ 和收起按钮挤出面板。
            width: root.strip-w;
            height: Theme.control-h-xs;

            Rectangle {
                x: root.ind-x;
                y: 0;
                width: root.ind-w;
                height: parent.height;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.state-selected-border;
                background: Theme.state-selected;
                // 图标态也常驻：原来 `visible: !narrow` 让窄态既没有高亮也没有滑动感。
                opacity: root.ind-w > 0px ? 1 : 0;
                animate x {
                    duration: AnimationSettings.enter-container();
                    easing: AnimationSettings.s-default();
                    enabled: AnimationSettings.enabled && root.ind-anim;
                }
                animate width {
                    duration: AnimationSettings.enter-container();
                    easing: AnimationSettings.s-default();
                    enabled: AnimationSettings.enabled && root.ind-anim;
                }
                animate opacity {
                    duration: AnimationSettings.short2();
                    easing: AnimationSettings.e-standard-decelerate();
                    enabled: AnimationSettings.enabled;
                }
            }

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                spacing: Theme.sp-4;
        PanelTab {
            mode: "overview";
            panel-mode: root.panel-mode;
            narrow: root.narrow-toolbar;
            tab-width: root.tab-w(0, root.narrow-toolbar);
            glyph: "\u{E871}";
            label: @tr("Overview");
            activate() => { root.panel-mode = "overview"; }
        }
        PanelTab {
            mode: "sftp";
            panel-mode: root.panel-mode;
            narrow: root.narrow-toolbar;
            tab-width: root.tab-w(1, root.narrow-toolbar);
            glyph: "\u{E2C7}";
            label: "SFTP";
            disabled: root.sftp-disabled;
            activate() => {
                if (root.sftp-disabled) { root.retry-sftp(); }
                else { root.panel-mode = "sftp"; }
            }
        }
        PanelTab {
            mode: "tunnels";
            panel-mode: root.panel-mode;
            narrow: root.narrow-toolbar;
            tab-width: root.tab-w(2, root.narrow-toolbar);
            glyph: "\u{E0B6}";
            label: @tr("Tunnels");
            activate() => { root.panel-mode = "tunnels"; }
        }
            }
        }

        // 窄工具栏：状态、SFTP、隧道三个页签在左，操作按钮靠右；路径占第二行。
        if root.narrow-toolbar : Rectangle { horizontal-stretch: 1; }

        // Editable path bar: type or paste a path and press Enter to
        // jump there; copy / paste-jump buttons sit right after it (#54).
        Rectangle {
            visible: root.panel-mode == "sftp" && !root.narrow-toolbar;
            horizontal-stretch: 1;
            height: Theme.control-h-xs;
            border-radius: Theme.radius-sm;
            background: Theme.bg-root;
            border-width: 1px;
            border-color: path-input.has-focus ? Theme.accent : Theme.border-subtle;
            path-input := TextInput {
                input-method-hints: Theme.plain-input-hints;
                x: 6px * Theme.ui-scale;
                width: parent.width - 12px * Theme.ui-scale;
                height: parent.height;
                text: root.current-path;
                color: Theme.text-primary;
                // CJK-capable font so typed Chinese isn't tofu (#54).
                font-family: Theme.ui-font-family;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.navigate(self.text); }
            }
        }

        // Copy the current path to the clipboard.
        // 用 `if` 而不是 `visible`：Slint 里 `visible: false` **不释放布局空间**，
        // 这三个按钮会在窄模式下白占 3×24 + 3×4 = 84px，把最右的收起按钮挤出面板
        // （255px 时第一行最少要 276px）。功能都在 ⋮ 菜单里，销毁无损失。
        if root.panel-mode == "sftp" && !root.narrow-toolbar : Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: copy-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: copy-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: copy-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            copy-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    path-input.select-all();
                    path-input.copy();
                    path-input.clear-selection();
                }
            }
            IconText { text: "\u{E14D}";
                   centered: true;
                   color: Theme.text-secondary; font-size: Theme.fs-sm;
}
        }

        // Paste a path from the clipboard and jump straight to it.
        if root.panel-mode == "sftp" && !root.narrow-toolbar : Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: pj-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: pj-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: pj-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            pj-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    path-input.select-all();
                    path-input.paste();
                    root.navigate(path-input.text);
                }
            }
            IconText { text: "\u{E14F}";
                   centered: true;
                   color: Theme.text-secondary; font-size: Theme.fs-sm;
}
        }

        // Parent navigation stays a fixed toolbar action in the compact
        // layout too: it is the primary way to move around, and burying
        // it in the ⋮ menu forces an extra click on every step up.
        Rectangle {
            visible: root.panel-mode == "sftp";
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: up-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: up-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: up-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            up-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(".."); }
            }
            Text { text: "↑"; color: Theme.text-secondary; font-size: Theme.fs-md;
                   horizontal-alignment: center; vertical-alignment: center; }
        }

        // Upload: a small menu offers file vs folder (#85). The remote
        // SFTP upload handles both — only the local picker differs.
        Rectangle {
            visible: root.panel-mode == "sftp";
            width: root.narrow-toolbar ? 24px * Theme.ui-scale : 52px * Theme.ui-scale; height: Theme.control-h-xs;
            border-radius: Theme.radius-sm;
            background: ul-ta.has-hover ? Theme.accent-hover : Theme.accent;
            animate background {
                duration: ul-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: ul-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            ul-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { ul-menu.show(); }
            }
            Text { text: root.narrow-toolbar ? "↑" : @tr("Upload"); color: #ffffff; font-size: Theme.fs-sm;
                   horizontal-alignment: center; vertical-alignment: center; }
            ul-menu := PopupWindow {
                x: 0; y: parent.height + 2px * Theme.ui-scale;
                width: 124px * Theme.ui-scale;
                height: (2 * 27px * Theme.ui-scale + 8px * Theme.ui-scale) * Theme.ui-scale;
                Rectangle {
                    background: Theme.bg-panel;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: Theme.shadow-popup-blur;
                    drop-shadow-color: Theme.shadow-popup-color;
                    VerticalLayout {
                        padding: Theme.sp-4;
                        spacing: 1px * Theme.ui-scale;
                        SftpMenuItem {
                            label: @tr("Upload file");
                            clicked => { root.upload-clicked(root.current-path, false); }
                        }
                        SftpMenuItem {
                            label: @tr("Upload folder");
                            clicked => { root.upload-clicked(root.current-path, true); }
                        }
                    }
                }
            }
        }

        // Secondary path actions move into an overflow menu in compact
        // mode so they never compete with the path field for width.
        if root.narrow-toolbar && root.panel-mode == "sftp" : Rectangle {
            width: 24px * Theme.ui-scale;
            height: Theme.control-h-xs;
            border-radius: Theme.radius-sm;
            background: compact-more-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: compact-more-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: compact-more-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            compact-more-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { compact-more-menu.show(); }
            }
            IconText {
                centered: true;
                text: "\u{E5D4}";
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
            }
            compact-more-menu := PopupWindow {
                x: parent.width - self.width;
                y: parent.height + 2px * Theme.ui-scale;
                width: 142px * Theme.ui-scale;
                height: (4 * 27px * Theme.ui-scale + 8px * Theme.ui-scale) * Theme.ui-scale;
                Rectangle {
                    background: Theme.bg-panel;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: Theme.shadow-popup-blur;
                    drop-shadow-color: Theme.shadow-popup-color;
                    VerticalLayout {
                        padding: Theme.sp-4;
                        spacing: 1px * Theme.ui-scale;
                        SftpMenuItem {
                            label: @tr("Up one level");
                            clicked => { root.navigate(".."); }
                        }
                        SftpMenuItem {
                            label: @tr("Copy path");
                            clicked => {
                                compact-path-input.select-all();
                                compact-path-input.copy();
                                compact-path-input.clear-selection();
                            }
                        }
                        SftpMenuItem {
                            label: @tr("Paste and go");
                            clicked => {
                                compact-path-input.select-all();
                                compact-path-input.paste();
                                root.navigate(compact-path-input.text);
                            }
                        }
                        SftpMenuItem {
                            label: @tr("Refresh");
                            clicked => { root.refresh(root.current-path); }
                        }
                    }
                }
            }
        }

        // Batch actions on checked entries — only when something's checked (#100).
        if root.panel-mode == "sftp" && root.selected-count > 0 && !root.narrow-toolbar : Text {
            text: "✓" + root.selected-count;
            color: Theme.accent;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        if root.panel-mode == "sftp" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: dls-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: dls-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: dls-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            dls-ta := TouchArea { mouse-cursor: pointer; clicked => { root.download-selected(); } }
            IconText { text: "\u{E2C4}";color: Theme.text-secondary;
                   centered: true;
                   font-size: Theme.fs-md;}
        }
        if root.panel-mode == "sftp" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: dels-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
            animate background {
                duration: dels-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: dels-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            dels-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-selected(); } }
            IconText { text: "\u{E872}";color: Theme.danger;
                   centered: true;
                   font-size: Theme.fs-md;}
        }

        if root.panel-mode == "sftp" && !root.narrow-toolbar : Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: ref-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: ref-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: ref-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            ref-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.refresh(root.current-path); }
            }
            IconText { text: "\u{E5D5}";
                   centered: true;
                   color: Theme.text-secondary; font-size: Theme.fs-sm;
}
        }

        // Minimise / restore the SFTP panel (#41).
        Rectangle {
            width: 24px * Theme.ui-scale; height: 22px * Theme.ui-scale;
            border-radius: Theme.radius-sm;
            background: min-ta.has-hover ? Theme.state-hover : transparent;
            animate background {
                duration: min-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: min-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            min-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-collapsed(); }
            }
            // expand_less (▲, restore) when collapsed, expand_more (▼) otherwise.
            IconText { text: root.collapsed ? "\u{E5CE}" : "\u{E5CF}";
                   centered: true;
                   color: Theme.text-secondary; font-size: Theme.fs-md;
}
        }
        }

        // 窄工具栏下把路径导航挪到第二行，避免把第一行挤变形。
        // 用 layout spacing 留固定间距，不受首行对齐 / 内边距影响。
        HorizontalLayout {
            visible: root.narrow-toolbar && root.panel-mode == "sftp";
            height: self.visible ? Theme.control-h-xs : 0px;
            padding-left: Theme.sp-6;
            padding-right: Theme.sp-6;
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-h-xs;
                border-radius: Theme.radius-sm;
                background: Theme.bg-root;
                border-width: 1px;
                border-color: compact-path-input.has-focus ? Theme.accent : Theme.border-subtle;
                compact-path-input := TextInput {
                    input-method-hints: Theme.plain-input-hints;
                    x: 6px * Theme.ui-scale;
                    width: parent.width - 12px * Theme.ui-scale;
                    height: parent.height;
                    text: root.current-path;
                    color: Theme.text-primary;
                    font-family: Theme.ui-font-family;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => { root.navigate(self.text); }
                }
            }
        }
    }
}
