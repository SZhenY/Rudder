// 运行时隧道表单：-L / -D 选择、目标输入、增删列表。
import { Theme, AnimationSettings } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Divider } from "../components/surfaces.slint";

export struct TunnelInfo {
    id: string,
    name: string,
    kind: string,
    bind: string,
    target: string,
    status: string,
    active: bool,
}

export component TunnelForm inherits Rectangle {
    in-out property <string> tunnel-kind: "local";
    in-out property <string> tunnel-name: "";
    in-out property <string> tunnel-bind: "127.0.0.1";
    in-out property <string> tunnel-bind-port: "1080";
    in-out property <string> tunnel-host: "127.0.0.1";
    in-out property <string> tunnel-host-port: "80";
    in property <[TunnelInfo]> tunnels: [];
    callback tunnel-add(string, string, string, string, string, string);
    callback tunnel-stop(string);
    vertical-stretch: 1;
    clip: true;
    background: transparent;

    ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: self.visible-width;
        content-height: max(self.visible-height, tunnel-body.preferred-height);

        tunnel-body := VerticalLayout {
            padding: 10px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 54px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.tunnel-kind == "local" ? Theme.accent : (tl-ta.has-hover ? Theme.state-hover : Theme.bg-root);
                    animate background {
                        duration: root.tunnel-kind == "local" ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: root.tunnel-kind == "local" ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    tl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "local"; } }
                    Text { text: "-L"; color: root.tunnel-kind == "local" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 54px; height: 24px; border-radius: Theme.radius-sm;
                    background: root.tunnel-kind == "dynamic" ? Theme.accent : (td-ta.has-hover ? Theme.state-hover : Theme.bg-root);
                    animate background {
                        duration: root.tunnel-kind == "dynamic" ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: root.tunnel-kind == "dynamic" ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    td-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "dynamic"; } }
                    Text { text: "-D"; color: root.tunnel-kind == "dynamic" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 72px; height: 24px; border-radius: Theme.radius-sm;
                    background: add-tunnel-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    animate background {
                        duration: add-tunnel-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: add-tunnel-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    add-tunnel-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.tunnel-bind-port != "" && (root.tunnel-kind == "dynamic" || (root.tunnel-host != "" && root.tunnel-host-port != ""))) {
                                root.tunnel-add(root.tunnel-name, root.tunnel-kind, root.tunnel-bind, root.tunnel-bind-port, root.tunnel-host, root.tunnel-host-port);
                            }
                        }
                    }
                    Text { text: @tr("Add"); color: #ffffff; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                    background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                    TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-name; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                    background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                    TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                }
                Rectangle {
                    width: 76px; height: 24px; border-radius: Theme.radius-sm;
                    background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                    TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                }
            }

            if root.tunnel-kind == "local" : HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                    background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                    TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                }
                Rectangle {
                    width: 76px; height: 24px; border-radius: Theme.radius-sm;
                    background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                    TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                }
            }

            Divider {}

            if root.tunnels.length == 0 : Rectangle {
                height: 36px;
                Text { text: @tr("No tunnels"); color: Theme.text-muted; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
            }

            for tun in root.tunnels : Rectangle {
                height: 44px;
                border-radius: Theme.radius-sm;
                background: tunnel-row-ta.has-hover ? Theme.state-hover : Theme.bg-root.with-alpha(0.42);
                animate background {
                    duration: tunnel-row-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                    easing: tunnel-row-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                    enabled: AnimationSettings.enabled;
                }
                tunnel-row-ta := TouchArea {}
                VerticalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: tun.active ? "●" : "○"; color: tun.active ? #28c76f : Theme.text-muted; width: 14px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: tun.kind == "dynamic" ? "-D" : (tun.kind == "remote" ? "-R" : "-L"); color: Theme.text-muted; width: 28px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                        Text { text: tun.name; color: Theme.text-primary; horizontal-stretch: 1; font-size: Theme.fs-sm; overflow: elide; vertical-alignment: center; }
                        Rectangle {
                            width: 48px; height: 22px; border-radius: Theme.radius-sm;
                            background: (tun.active && tun.kind != "remote") ? (stop-ta.has-hover ? Theme.danger.with-alpha(0.24) : transparent) : transparent;
                            animate background {
                                duration: (tun.active && tun.kind != "remote") ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: (tun.active && tun.kind != "remote") ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            stop-ta := TouchArea {
                                mouse-cursor: (tun.active && tun.kind != "remote") ? pointer : default;
                                clicked => { if (tun.active && tun.kind != "remote") { root.tunnel-stop(tun.id); } }
                            }
                            Text { text: @tr("Stop"); color: (tun.active && tun.kind != "remote") ? Theme.danger : Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: tun.bind + (tun.target != "" ? " → " + tun.target : ""); color: Theme.text-secondary; horizontal-stretch: 1; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; }
                        Text { text: tun.status; color: tun.active ? Theme.accent : Theme.text-muted; width: 62px; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
}
