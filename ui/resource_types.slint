//! 资源类**数据类型**：目前只有磁盘用量一行。
//!
//! 旧外壳删除③：`DiskInfo` 原先定义在 `sidebar_blocks.slint`（旧侧栏的区块组件文件，
//! 与旧侧栏一起删除）。它本身是 Rust 侧 `refresh_sidebar` 填 `disks` 属性用的**数据**
//! 类型，与新外壳的后续资源展示也还会用到，所以留在这份幸存文件里。
//! `ui/shell/app_shell.slint` 仍 `export { DiskInfo }`，Rust 的 `crate::ui::DiskInfo` 名字不变。

// One filesystem row for the disk-usage panel.
export struct CoreLoad {
    idx: int,      // 核心编号（分列后行内仍要显示 #0 #1 …）
    load: float,   // 0.0..1.0
}

export struct DiskInfo {
    path: string,
    detail: string,   // "available/total"
    used: string,     // 已用（工具面板四卡底部行左侧）
    total: string,    // 总量（工具面板四卡底部行右侧）
    percent: float,   // used fraction 0.0..1.0
    /// 复选框勾选态（工具面板「磁盘分区」里勾 = 置顶这一条）。
    ///
    /// ⚠ 勾选态放在**行数据**里而不是界面侧的 `[string]` 名单：Slint 的数组没有
    /// `contains`，放名单里就得在表达式里循环查；跟着行走则是一次读取。
    picked: bool,
}
