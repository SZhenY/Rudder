//! 综合页：连接状态 + 主机头卡 + 资源卡 + CPU 趋势 + 磁盘 / 网络。
//!
//! 由 `overview_panel.slint` 的「运行状态」页签挂载。排版按当前分支的 token 与组件
//! 重写；数据全部复用既有链路（本地 `SystemSampler`、远端 `monitor.rs` 的 overview
//! 采集），本文件不引入新的采集逻辑。

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TrendCurve } from "components/trend_curve.slint";
import { OverviewCard } from "components/overview_card.slint";
import { Divider } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { StatRow, NetBlock, DiskBlock, DiskInfo } from "sidebar_blocks.slint";

// 头卡的一行：label 固定宽 + value 占满剩余并省略，保证「一行一个数据」。
component HostRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    height: 18px * Theme.ui-scale;
    spacing: Theme.sp-6;

    Text {
        text: root.label;
        width: 52px * Theme.ui-scale;
        color: Theme.text-muted;
        font-size: Theme.fs-xs;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: Theme.text-secondary;
        font-size: Theme.fs-xs;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component OverviewView inherits Rectangle {
    // 卡片高度常量：后续手动调整改这里即可。
    property <length> cpu-chart-h: 150px * Theme.ui-scale;
    property <length> net-chart-h: 150px * Theme.ui-scale;

    in property <string> connection-state: @tr("Not connected");
    in property <string> conn-host;
    in property <int> conn-state;
    in property <string> resource-title: @tr("Local resources");
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    /// CPU 使用率历史，0..1（Rust 已按固定 0..100 刻度换算）。
    in property <string> cpu-path;
    /// 内存占用历史曲线（0..1）。
    in property <string> mem-path;
    // 主机头卡：远端 overview 的结构化字段。
    in property <string> host-name;
    in property <string> host-ip;
    in property <string> host-os;
    in property <string> host-kernel;
    in property <string> host-uptime;
    in property <string> host-load;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <string> net-top-path;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    /// 首个完整样本是否已到；false 时整页显示「正在获取系统信息…」。
    in property <bool> stats-ready: true;
    // 两张曲线卡各自的时间跨度（0..5 → 15s/1m/5m/30m/1h/6h）；只存运行时，不落盘。
    in-out property <int> cpu-span-index: 1;
    in-out property <int> net-span-index: 1;
    in-out property <int> mem-span-index: 1;
    in property <[string]> span-labels: ["15s", "1m", "5m", "30m", "1h", "6h"];
    callback set-span(int /* 0=cpu 1=net */, int /* 0..5 */);
    in property <[DiskInfo]> disks;
    in property <bool> proc-available;

    callback select-net-iface(string);
    callback show-processes();
    callback copy-host(string);

    background: transparent;

    property <int> load-dots: 0;
    Timer {
        interval: 400ms;
        running: !root.stats-ready;
        triggered => { root.load-dots = Math.mod(root.load-dots + 1, 4); }
    }

    ScrollView {
        visible: root.stats-ready;
        width: 100%;
        height: 100%;
        // 只纵向滚动：横向交给布局自适应，避免 255px 下出现横向滚动条并裁掉右侧。
        content-width: self.visible-width;

        VerticalLayout {
            padding: Theme.sp-8;
            spacing: Theme.sp-6;
            // 富余高度留在卡片列表末尾，不灌进卡片内部。
            alignment: start;

            // --- 主机头卡 -------------------------------------------------
            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: Theme.sp-10;
                    spacing: Theme.sp-3;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Theme.sp-8;
                        IconText {
                            text: "\u{EB8E}";   // terminal
                            color: Theme.accent;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.host-name != "" ? root.host-name : "—";
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    HostRow { label: @tr("Connection"); value: root.connection-state != "" ? root.connection-state : "—"; }
                    HostRow { label: @tr("System"); value: root.host-os != "" ? root.host-os : "—"; }
                    HostRow { label: @tr("Kernel"); value: root.host-kernel != "" ? root.host-kernel : "—"; }
                    HostRow { label: @tr("Uptime"); value: root.host-uptime != "" ? root.host-uptime : "—"; }
                    HostRow { label: @tr("Load"); value: root.host-load != "" ? root.host-load : "—"; }
                }
            }

            // --- 资源（2×2） -----------------------------------------------
            OverviewCard {
                title: @tr("Resources");
                title-icon: "\u{E30C}";

                HorizontalLayout {
                    spacing: Theme.sp-10;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        StatRow {
                            label: "CPU";
                            percent: root.cpu-percent;
                            value: "";
                            bar-color: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        StatRow {
                            label: @tr("Memory");
                            percent: root.mem-percent;
                            value: root.mem-detail;
                            bar-color: Theme.success;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.sp-10;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        StatRow {
                            label: @tr("Swap");
                            percent: root.swap-percent;
                            value: root.swap-detail;
                            bar-color: Theme.warning;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        StatRow {
                            label: @tr("Disk");
                            percent: root.disks.length > 0 ? root.disks[0].percent : 0;
                            value: root.disks.length > 0 ? root.disks[0].detail : "-";
                            bar-color: Theme.accent;
                        }
                    }
                }
            }

            // --- CPU 负载 -------------------------------------------------
            OverviewCard {
                title: @tr("CPU load");
                title-icon: "\u{E30C}";
                value: floor(root.cpu-percent * 100) + "%";
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.cpu-span-index;
                span-changed(v) => { root.set-span(0, v); }

                TrendCurve {
                    chart-height: root.cpu-chart-h;
                    commands: root.cpu-path;
                    tone: Theme.accent;
                    last: clamp(root.cpu-percent, 0.0, 1.0);
                }
            }

            // --- 内存占用 -------------------------------------------------
            OverviewCard {
                title: @tr("Memory usage");
                title-icon: "\u{E30C}";
                value: floor(root.mem-percent * 100) + "%";
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.mem-span-index;
                span-changed(v) => { root.set-span(2, v); }
                show-proc-button: root.proc-available;
                open-proc() => { root.show-processes(); }

                TrendCurve {
                    chart-height: root.cpu-chart-h;
                    commands: root.mem-path;
                    tone: Theme.success;
                    last: clamp(root.mem-percent, 0.0, 1.0);
                }
            }

            // --- 网络 -----------------------------------------------------
            OverviewCard {
                title: @tr("Network");
                title-icon: "\u{E1AF}";
                show-iface-picker: root.net-show-selector;
                iface-labels: root.net-ifaces;
                iface-selected: root.net-selected;
                select-iface(v) => { root.select-net-iface(v); }
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.net-span-index;
                span-changed(v) => { root.set-span(1, v); }

                NetBlock {
                    chart-height: root.net-chart-h;
                    net-top-up: root.net-top-up;
                    net-top-down: root.net-top-down;
                    net-top-path: root.net-top-path;
                }
            }

            // --- 磁盘分区 -------------------------------------------------
            OverviewCard {
                title: @tr("Disk");
                title-icon: "\u{E1DB}";

                DiskBlock {
                    disks: root.disks;
                }
            }

        }
    }

    // 首连加载态：信息未到齐时整页占位，避免头卡/曲线先显示空值再跳变。
    if !root.stats-ready : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        spacing: Theme.sp-10;
        Text {
            text: @tr("Loading system information") + ["", ".", "..", "..."][root.load-dots];
            color: Theme.text-muted;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
        }
    }
}
