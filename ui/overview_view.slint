//! 综合页：主机头卡 + 2×2 资源卡 + CPU / 内存趋势 + 网络 + 磁盘分区。
//!
//! 由 `overview_panel.slint` 的「运行状态」页签挂载。数据全部来自远端 `monitor.rs`
//! 的采样通道，本文件不引入采集逻辑。

import { Theme, AnimationSettings } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TrendCurve } from "components/trend_curve.slint";
import { OverviewCard } from "components/overview_card.slint";
import { IconText } from "components/text.slint";
import { ResourceSnapshot, ResourceTile, NetBlock, DiskBlock, DiskInfo } from "sidebar_blocks.slint";

// 头卡的一行：label 固定宽 + value 占满剩余并省略，保证「一行一个数据」。
component HostRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    /// 值文本颜色；失败态由 Connection 行传 danger，其余沿用次要色。
    in property <brush> tone: Theme.text-secondary;

    height: 18px * Theme.ui-scale;
    spacing: Theme.sp-6;

    Text {
        text: root.label;
        width: 52px * Theme.ui-scale;
        color: Theme.text-muted;
        font-size: Theme.fs-xs;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: root.tone;
        font-size: Theme.fs-xs;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

export component OverviewView inherits Rectangle {
    // 卡片高度常量：后续手动调整改这里即可。
    property <length> cpu-chart-h: 150px * Theme.ui-scale;
    property <length> net-chart-h: 150px * Theme.ui-scale;

    in property <string> connection-state: @tr("Not connected");
    in property <int> conn-state;
    in property <float> cpu-percent;
    in property <float> mem-percent;
    /// 2×2 资源卡的整份快照（CPU / 内存 / 系统盘 / 网络）。
    in property <ResourceSnapshot> resources;
    /// CPU 使用率历史，0..1（Rust 已按固定 0..100 刻度换算）。
    in property <string> cpu-path;
    /// 内存占用历史曲线（0..1）。
    in property <string> mem-path;
    /// 网络上行（tx）曲线。
    in property <string> net-up-path;
    // 主机头卡：远端 overview 的结构化字段。
    in property <string> host-name;
    in property <string> host-os;
    in property <string> host-kernel;
    in property <string> host-uptime;
    in property <string> host-load;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <string> net-top-path;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    /// 首个完整样本是否已到；false 时整页显示「正在获取系统信息…」。
    in property <bool> stats-ready: false;

    // ── 揭示状态机 ────────────────────────────────────────────────────
    // 0 = 加载态；1 = 骨架（壳+标题可见、数值空白）；2 = 数值可见。
    // stats-ready 走上升沿时先骨架再填数，下降沿立即复位。
    property <int> reveal-phase: root.stats-ready ? 2 : 0;
    /// 本次进入是否带动画：复位/直接落位时置 false，同一个 animate 因此零时长落定。
    property <bool> reveal-anim: false;
    /// 已揭示过的主机名：切回同一主机或重连同一主机时直接落位，不重放。
    property <string> revealed-host: "";

    property <float> shell-fade: root.reveal-phase >= 1 ? 1.0 : 0.0;
    property <float> values-fade: root.reveal-phase >= 2 ? 1.0 : 0.0;
    property <float> load-fade: root.reveal-phase == 0 ? 1.0 : 0.0;

    animate shell-fade {
        duration: AnimationSettings.medium2();
        easing: AnimationSettings.e-enter();
        enabled: AnimationSettings.enabled && root.reveal-anim;
    }
    animate values-fade {
        duration: AnimationSettings.short4();
        easing: AnimationSettings.e-enter();
        enabled: AnimationSettings.enabled && root.reveal-anim;
    }
    animate load-fade {
        duration: AnimationSettings.short3();
        easing: AnimationSettings.e-standard-accelerate();
        enabled: AnimationSettings.enabled;
    }
    // 两张曲线卡各自的时间跨度（0..5 → 15s/1m/5m/30m/1h/6h）；只存运行时，不落盘。
    in-out property <int> cpu-span-index: 1;
    in-out property <int> net-span-index: 1;
    in-out property <int> mem-span-index: 1;
    in property <[string]> span-labels: ["15s", "1m", "5m", "30m", "1h", "6h"];
    callback set-span(int /* 0=cpu 1=net */, int /* 0..5 */);
    in property <[DiskInfo]> disks;
    in property <bool> proc-available;

    callback select-net-iface(string);
    callback show-processes();

    background: transparent;

    property <int> load-dots: 0;
    Timer {
        interval: 400ms;
        running: root.reveal-phase == 0;
        triggered => { root.load-dots = Math.mod(root.load-dots + 1, 4); }
    }

    // 骨架 → 数值：300ms 淡入 + 150ms 停顿；关动画时立即推进，倍速时同步缩放。
    Timer {
        interval: AnimationSettings.enabled ? 450ms * AnimationSettings.speed : 1ms;
        running: root.reveal-phase == 1;
        triggered => { root.reveal-phase = 2; }
    }

    // 唯一入口：断开/切到未就绪标签 → 复位；同主机或已揭示过 → 直接落位；否则两段式。
    changed stats-ready => {
        if (!root.stats-ready) {
            root.reveal-anim = false;
            root.reveal-phase = 0;
            root.load-dots = 0;
        } else if (root.host-name == "" || root.host-name == root.revealed-host) {
            root.reveal-anim = false;
            root.reveal-phase = 2;
        } else {
            root.reveal-anim = true;
            root.revealed-host = root.host-name;
            root.reveal-phase = 1;
        }
    }

    ScrollView {
        visible: root.reveal-phase >= 1;
        opacity: root.shell-fade;
        // 只影响渲染、不参与布局：骨架期轻微放大到落位，作为“聚焦”的近似。
        transform-scale-x: root.reveal-phase >= 1 ? 1.0 : 0.98;
        transform-scale-y: root.reveal-phase >= 1 ? 1.0 : 0.98;
        animate transform-scale-x {
            duration: AnimationSettings.medium2();
            easing: AnimationSettings.s-soft();
            enabled: AnimationSettings.enabled && root.reveal-anim;
        }
        animate transform-scale-y {
            duration: AnimationSettings.medium2();
            easing: AnimationSettings.s-soft();
            enabled: AnimationSettings.enabled && root.reveal-anim;
        }
        width: 100%;
        height: 100%;
        // 只纵向滚动：横向交给布局自适应，避免 255px 下出现横向滚动条并裁掉右侧。
        content-width: self.visible-width;

        VerticalLayout {
            padding: Theme.sp-8;
            spacing: Theme.sp-6;
            // 富余高度留在卡片列表末尾，不灌进卡片内部。
            alignment: start;

            // --- 主机头卡 -------------------------------------------------
            Rectangle {
                vertical-stretch: 0;
                border-radius: Theme.radius-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: Theme.sp-10;
                    spacing: Theme.sp-3;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Theme.sp-8;
                        IconText {
                            text: "\u{EB8E}";   // terminal
                            color: Theme.accent;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.host-name != "" ? root.host-name : "—";
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    HostRow {
                        opacity: root.values-fade;
                        label: @tr("Connection");
                        value: root.connection-state != "" ? root.connection-state : "—";
                        tone: root.conn-state == 3 ? Theme.danger : Theme.text-secondary;
                    }
                    HostRow { opacity: root.values-fade; label: @tr("System"); value: root.host-os != "" ? root.host-os : "—"; }
                    HostRow { opacity: root.values-fade; label: @tr("Kernel"); value: root.host-kernel != "" ? root.host-kernel : "—"; }
                    HostRow { opacity: root.values-fade; label: @tr("Uptime"); value: root.host-uptime != "" ? root.host-uptime : "—"; }
                    HostRow { opacity: root.values-fade; label: @tr("Load"); value: root.host-load != "" ? root.host-load : "—"; }
                }
            }

            // --- 资源（2×2） -----------------------------------------------
            // CPU 使用占比 | 内存使用占比
            // 系统盘占比   | 网络上下行
            //
            // 两列等分：宽度按父宽直接算，不依赖内容的首选宽度 —— 否则
            // 「用户/系统」这类长文本会把左列撑得比右列宽。
            Rectangle {
                height: Math.max(cpu-tile.preferred-height, mem-tile.preferred-height);
                opacity: root.values-fade;

                cpu-tile := ResourceTile {
                    x: 0;
                    width: (parent.width - Theme.sp-6) / 2;
                    height: parent.height;
                    title: "CPU";
                    glyph: "\u{E322}";   // memory（芯片）
                    tone: Theme.accent;
                    value: Math.round(root.resources.cpu_percent * 100) + "%";
                    percent: clamp(root.resources.cpu_percent, 0.0, 1.0);
                    foot-left: root.resources.cpu_foot_left;
                    foot-right: root.resources.cpu_foot_right;
                }
                mem-tile := ResourceTile {
                    x: (parent.width + Theme.sp-6) / 2;
                    width: (parent.width - Theme.sp-6) / 2;
                    height: parent.height;
                    title: @tr("Memory");
                    glyph: "\u{E30C}";
                    tone: Theme.success;
                    value: Math.round(root.resources.mem_percent * 100) + "%";
                    percent: clamp(root.resources.mem_percent, 0.0, 1.0);
                    foot-left: root.resources.mem_foot_left;
                    foot-right: root.resources.mem_foot_right;
                }
            }
            Rectangle {
                height: Math.max(disk-tile.preferred-height, net-tile.preferred-height);
                opacity: root.values-fade;

                disk-tile := ResourceTile {
                    x: 0;
                    width: (parent.width - Theme.sp-6) / 2;
                    height: parent.height;
                    title: @tr("Disk");
                    glyph: "\u{E1DB}";
                    tone: Theme.warning;
                    value: Math.round(root.resources.disk_percent * 100) + "%";
                    percent: clamp(root.resources.disk_percent, 0.0, 1.0);
                    foot-left: root.resources.disk_foot_left;
                    foot-right: root.resources.disk_foot_right;
                }
                net-tile := ResourceTile {
                    x: (parent.width + Theme.sp-6) / 2;
                    width: (parent.width - Theme.sp-6) / 2;
                    height: parent.height;
                    title: @tr("Network");
                    glyph: "\u{E63E}";
                    tone: Theme.success;
                    // 网络卡没有百分比与进度条：percent < 0 让速率行取代进度条。
                    percent: -1;
                    net-down: root.resources.net_down;
                    net-up: root.resources.net_up;
                    foot-left: @tr("Default gateway");
                    foot-right: root.resources.net_gateway;
                }
            }

            // --- CPU 负载 -------------------------------------------------
            OverviewCard {
                title: @tr("CPU load");
                title-icon: "\u{E30C}";
                value: root.reveal-phase >= 2 ? floor(root.cpu-percent * 100) + "%" : "";
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.cpu-span-index;
                span-changed(v) => { root.set-span(0, v); }

                TrendCurve {
                    opacity: root.values-fade;
                    chart-height: root.cpu-chart-h;
                    commands: root.cpu-path;
                    tone: Theme.accent;
                    last: clamp(root.cpu-percent, 0.0, 1.0);
                }
            }

            // --- 内存占用 -------------------------------------------------
            OverviewCard {
                title: @tr("Memory usage");
                title-icon: "\u{E30C}";
                value: root.reveal-phase >= 2 ? floor(root.mem-percent * 100) + "%" : "";
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.mem-span-index;
                span-changed(v) => { root.set-span(2, v); }
                show-proc-button: root.proc-available;
                open-proc() => { root.show-processes(); }

                TrendCurve {
                    opacity: root.values-fade;
                    chart-height: root.cpu-chart-h;
                    commands: root.mem-path;
                    tone: Theme.success;
                    last: clamp(root.mem-percent, 0.0, 1.0);
                }
            }

            // --- 网络 -----------------------------------------------------
            OverviewCard {
                title: @tr("Network");
                title-icon: "\u{E1AF}";
                show-iface-picker: root.net-show-selector && root.reveal-phase >= 2;
                iface-labels: root.net-ifaces;
                iface-selected: root.net-selected;
                select-iface(v) => { root.select-net-iface(v); }
                show-span-picker: true;
                span-labels: root.span-labels;
                span-index: root.net-span-index;
                span-changed(v) => { root.set-span(1, v); }

                NetBlock {
                    opacity: root.values-fade;
                    chart-height: root.net-chart-h;
                    net-top-up: root.net-top-up;
                    net-top-down: root.net-top-down;
                    net-top-path: root.net-top-path;
                    net-up-path: root.net-up-path;
                }
            }

            // --- 磁盘分区 -------------------------------------------------
            OverviewCard {
                title: @tr("Disk");
                title-icon: "\u{E1DB}";

                DiskBlock {
                    opacity: root.values-fade;
                    disks: root.disks;
                }
            }

        }
    }

    // 首连加载态：常驻 + 淡出，与骨架交叉过渡，避免“文字瞬间消失 → 空白 → 骨架”。
    VerticalLayout {
        visible: root.load-fade > 0.001;
        opacity: root.load-fade;
        vertical-stretch: 1;
        alignment: center;
        spacing: Theme.sp-10;
        Text {
            text: @tr("Loading system information") + ["", ".", "..", "..."][root.load-dots];
            color: Theme.text-muted;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
        }
    }
}
