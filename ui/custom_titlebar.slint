import { ShortcutsDialog } from "shortcuts_dialog.slint";
import { InterfaceSettingsOverlay } from "interface_settings_overlay.slint";

export component FramelessTitleBar inherits WindowTitleBar {
    // ── 状态（窗口 / 父布局透传）─────────────────────────────────────
    in property <bool> window-maximized:false;

    // ── 动作（由调用点转发，实现仍在 Rust / 窗口）──────────────────
    callback close-requested();
    callback win-close();
    callback win-maximize-toggle();
    callback win-minimize();

        title: "Rudder";
        icon-size: 18px;
        show-min-max: true;
        maximized: window-maximized;
        minimize() => { root.win-minimize(); }
        maximize-toggle() => { root.win-maximize-toggle(); }
        close() => { root.win-close(); }
}
