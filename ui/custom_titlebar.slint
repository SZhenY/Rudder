//! 无边框平台（Windows / Linux）的**自绘标题栏**：图标 + 标题 + 可拖拽中段 + 窗口按钮。
//!
//! 从 `app.slint` 的窗口主体（`VerticalLayout`）拆出（P4 B 类）；纯搬家。

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { WindowTitleBar } from "components/window_shell.slint";

export component FramelessTitleBar inherits WindowTitleBar {
    // ── 状态（窗口 / 父布局透传）─────────────────────────────────────
    in property <bool> window-maximized:false;

    // ── 动作（由调用点转发，实现仍在 Rust / 窗口）──────────────────
    callback close-requested();
    callback win-close();
    callback win-drag();
    callback win-maximize-toggle();
    callback win-minimize();

        title: "Rudder";
        icon-size: 18px;
        show-min-max: true;
        maximized: window-maximized;
        armed-drag: true;      // 拖过 6px 才交给系统，双击最大化才派发得到
        drag() => { root.win-drag(); }
        minimize() => { root.win-minimize(); }
        maximize-toggle() => { root.win-maximize-toggle(); }
        close() => { root.win-close(); }
}
