import { Theme , AnimationSettings } from "theme.slint";
import { FieldLabel } from "components/surfaces.slint";
import { IconText } from "components/text.slint";

// --- IconButton ------------------------------------------------------------
// A small square action button that accepts a single-character glyph (or short text).
// Keeps visual language consistent across the app.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tooltip;
    // Icon font for `glyph` when it is a non-ASCII icon codepoint (e.g. the
    // bundled MaterialIcons-Regular.ttf). Defaults to the UI font; leave empty
    // for plain ASCII glyphs like "+" / "×".
    in property <string> font-family: "";
    in property <length> size: 28px;
    // 图标字号。默认 Theme.fs-md 与旧实现一致；各处按需传 Theme.fs-sm 或 18px。
    in property <length> glyph-size: Theme.fs-md;
    in property <brush> fg: Theme.text-secondary;
    in property <brush> fg-hover: Theme.text-primary;
    // 图标颜色是否随 hover 变深。工具栏按钮传 false —— 它们的图标色本身带状态语义
    // （主题按钮的日/月配色、命令栏按钮的 accent 高亮），不该被 hover 覆盖。
    in property <bool> tint-on-hover: true;
    // 常亮：用于「这个按钮对应的面板正开着」。与 hover 共用同一个底色层。
    in property <bool> active: false;
    // 呼吸脉冲：用于「有进行中的传输」这类需要持续提示的按钮。
    in property <bool> breathe: false;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    background: transparent;
    // hover 是"正交视觉状态"，交给 states 表达（同一组状态被 Text 复用）。
    states [
        // 常亮（"这个面板正开着"）用主题色淡底，与 hover 的中性灰区分开 —— 这样换「配色」
        // 时"哪个按钮开着"也跟着变。
        lit when touch.has-hover || root.active : {
            background: root.active ? Theme.state-selected : Theme.state-hover;
        }
    ]
    animate background {
        duration: (touch.has-hover || root.active) ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
        easing: (touch.has-hover || root.active) ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }

    // 脉冲层（移植自 app.slint 的本地 IconBtn）。⚠️ 必须用 `visible` + `opacity` 翻转，
    // **不能**写成 `if root.breathe { … }`：Slint 的 animate 只在**已存在**元素的属性变化时
    // 触发，`if` 新建的层会带着初始 opacity 出现、永远不动（原注释记录了这一点）。
    breathe-layer := Rectangle {
        x: 0px; y: 0px;
        width: 100%; height: 100%;
        border-radius: Theme.radius-sm;
        background: Theme.accent;
        visible: root.breathe;
        opacity: root.breathe ? 0.55 : 0;
        animate opacity {
            duration: AnimationSettings.ambient();
            iteration-count: -1;
            direction: alternate;
            easing: AnimationSettings.breathing();
            // 失焦时停止呼吸动画。
            enabled: AnimationSettings.enabled && Theme.window-focused;
        }
    }

    Text {
        text: glyph;
        font-family: root.font-family;
        color: root.fg;
        states [
            hovered when touch.has-hover && root.tint-on-hover : { color: root.fg-hover; }
        ]
        font-size: root.glyph-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // tooltip 气泡（移植自 IconBtn）。此前 `tooltip` 是**声明了但从未渲染**的死属性 ——
    // tabs.slint 的 5 个用法都没传它，所以补上渲染对它们零影响。
    if touch.has-hover && root.tooltip != "" : Rectangle {
        y: parent.height + 5px;
        x: parent.width - self.width;   // 右边缘与图标对齐
        width: tip-txt.preferred-width + 16px;
        height: 22px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000070;
        tip-txt := Text {
            text: root.tooltip;
            color: Theme.text-primary;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

// --- PrimaryButton ---------------------------------------------------------
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: Theme.accent;
    // 原为 4 态嵌套三目。**列表靠前者优先**（编译器把 states 逆序折叠成条件，
    // 见 lower_states.rs）：disabled > pressed > hover，与原语义逐字对应。
    states [
        off when disabled : { background: Theme.bg-elevated; }
        pressed when touch.pressed : { background: Theme.accent-pressed; }
        hovered when touch.has-hover : { background: Theme.accent-hover; }
    ]
    animate background {
        duration: (touch.has-hover || touch.pressed) ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
        easing: (touch.has-hover || touch.pressed) ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: disabled ? Theme.text-muted : white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// --- GhostButton -----------------------------------------------------------
export component GhostButton inherits Rectangle {
    in property <string> text;
    /// true = 置灰且不响应点击（用于"上级开关关闭时，下级不可操作"）。
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-subtle;
    background: Theme.bg-panel;
    opacity: root.disabled ? 0.45 : 1;
    states [
        pressed when touch.pressed && !root.disabled : { background: Theme.accent-press; }
        hovered when touch.has-hover && !root.disabled : {
            border-color: Theme.accent-ring;
            background: Theme.bg-hover;
        }
    ]
    animate background, border-color, opacity {
        duration: (touch.has-hover || touch.pressed) ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
        easing: (touch.has-hover || touch.pressed) ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.disabled ? Theme.text-muted : Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// --- LabeledInput ----------------------------------------------------------
export component LabeledInput inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> auto-focus: false;   // grab focus when shown (dialog fields)
    in property <brush> input-background: Theme.bg-root;
    in property <brush> idle-border: Theme.border-subtle;
    callback accepted();   // Enter pressed in the field
    callback canceled();   // Esc pressed in the field (#140-3)
    spacing: 4px;
    property <bool> focus-pending: false;
    public function focus-input() { input.focus(); }

    // A LabeledInput is often created inside a conditional dialog. Focusing its
    // TextInput during `init` asks Slint for IME geometry while the surrounding
    // layout binding is still being evaluated, which trips the runtime's
    // recursion guard. Defer focus until the next event-loop turn, after layout.
    init => { root.focus-pending = root.auto-focus; }
    focus-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            if (root.auto-focus) { input.focus(); }
        }
    }

    FieldLabel { text: label; }

    Rectangle {
        height: 32px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : root.idle-border;
        background: root.input-background;

        input := TextInput {
            input-method-hints: Theme.plain-input-hints;
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.value;
            color: Theme.text-primary;
            // A CJK-capable family — TextInput doesn't glyph-fallback reliably
            // across machines, so typed Chinese (incl. punctuation like 、) can
            // render as tofu without an explicit font (#54).
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            accepted => { root.accepted(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.canceled(); accept }
                else { reject }   // let TextInput handle normal typing
            }
        }

        // Lightweight placeholder — shown when value is empty.
        if value == "" : Text {
            x: 10px;
            y: 0px;
            height: parent.height;
            text: placeholder;
            color: Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }
}

// --- Sparkline -------------------------------------------------------------
// Compact horizontal bar chart used in the stats sidebar.
export component Sparkline inherits Rectangle {
    in property <[float]> values;
    in property <brush> line-color: Theme.accent;

    background: Theme.bg-root;
    border-radius: Theme.radius-sm;
    clip: true;

    for v[i] in values : Rectangle {
        x: i * (parent.width / max(1, values.length));
        y: parent.height - (parent.height * clamp(v, 0.0, 1.0));
        width: (parent.width / max(1, values.length)) - 1px;
        height: parent.height * clamp(v, 0.0, 1.0);
        background: line-color.with-alpha(0.85);
        border-radius: 1px;
    }
}

// --- ToolStrip --------------------------------------------------------------
// 面板收起时贴在右缘的 36px 图标条：显示工具图标，点击重新展开。SFTP 面板与
// 快捷命令面板共用，折叠/展开表现一致。占位槽由宿主预留，图标条不覆盖其它控件。
export component ToolStrip inherits Rectangle {
    in property <string> glyph;       // the panel's tool icon (Material Icons)
    in property <bool> show-second: false;
    in property <string> second-glyph;
    in property <bool> show-third: false;
    in property <string> third-glyph;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback expand();
    callback expand-second();
    callback expand-third();

    background: Theme.bg-panel-alt;
    // Hairline on the inner edge (facing the central content).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.border-subtle;
    }
    // Tool icon, hugging the strip's near corner.
    Rectangle {
        width: 30px;
        height: 30px;
        x: (parent.width - self.width) / 2;
        y: 4px;
        border-radius: Theme.radius-sm;
          background: root.enabled && ta.has-hover ? Theme.state-hover : transparent;
          animate background {
              duration: root.enabled && ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
              easing: root.enabled && ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
              enabled: AnimationSettings.enabled;
          }
          IconText {
              centered: true;
              text: root.glyph;
              font-size: 18px;
              color: !root.enabled ? Theme.text-muted.with-alpha(0.45)
                  : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            width: parent.width;
            height: parent.height;
        }
          ta := TouchArea {
              mouse-cursor: root.enabled ? pointer : default;
              clicked => {
                  if (root.enabled) {
                      root.expand();
                  }
              }
          }
      }
    if root.show-second : Rectangle {
        width: 30px;
        height: 30px;
        x: (parent.width - self.width) / 2;
        y: 38px;
        border-radius: Theme.radius-sm;
        background: ta2.has-hover ? Theme.state-hover : transparent;
        animate background {
            duration: ta2.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
            easing: ta2.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
            enabled: AnimationSettings.enabled;
        }
        IconText {
            centered: true;
            text: root.second-glyph;
            font-size: 18px;
            color: ta2.has-hover ? Theme.text-primary : Theme.text-secondary;
            width: parent.width;
            height: parent.height;
        }
        ta2 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-second(); }
        }
    }
    if root.show-third : Rectangle {
        width: 30px;
        height: 30px;
        x: (parent.width - self.width) / 2;
        y: 72px;
        border-radius: Theme.radius-sm;
        background: ta3.has-hover ? Theme.state-hover : transparent;
        animate background {
            duration: ta3.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
            easing: ta3.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
            enabled: AnimationSettings.enabled;
        }
        IconText {
            centered: true;
            text: root.third-glyph;
            font-size: 18px;
            color: ta3.has-hover ? Theme.text-primary : Theme.text-secondary;
            width: parent.width;
            height: parent.height;
        }
        ta3 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-third(); }
        }
    }
}
