//! 快捷命令**分组命名**弹窗（#55）：`orig` 为空表示新建，否则是重命名目标。
//!
//! 从 `app.slint` 拆出（P4 B 类）：显隐由调用点判断，组件只负责呈现；
//! 关闭弹窗上抛 `close-requested()`（不直接改窗口状态）。

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { LineEdit, Button } from "std-widgets.slint";
import { ModalCard } from "components/surfaces.slint";

export component QuickGroupDialog inherits ModalCard {
    // 显隐由调用点控制：**常驻**，不用 `if` 包着 —— 在事件派发栈上销毁
    // 正在处理事件的子树会闪退（#323/#343）。
    in property <bool> open: false;
    visible: open;
    active: open;          // 关闭时不吞掉整窗点击
    // ── 状态（窗口透传）──────────────────────────────────────────────
    in property <bool> lang-en: false;
    in-out property <string> qcg-name;
    in property <string> qcg-orig;

    // ── 动作：由调用点转发（实现仍在 Rust / 窗口）────────────────────
    callback close-requested();
    callback submit-quick-group(string /* orig */, string /* name */);

    card-width: 340px;
    card-height: 178px;
    radius: Theme.radius-md;
    dismissed() => { root.close-requested(); }
    Text {
        text: qcg-orig == ""
            ? (lang-en ? "New group" : "新建分组")
            : (lang-en ? "Rename group" : "重命名分组");
        color: Theme.text-primary;
        font-size: Theme.fs-lg;
        font-weight: 700;
    }
    Text { text: @tr("Group name"); color: Theme.text-secondary; font-size: Theme.fs-sm; }
    qcg-input := LineEdit {
        text <=> qcg-name;
        font-family: Theme.ui-font-family;
        placeholder-text: @tr("Group name");
        accepted => {
            if (qcg-name != "") {
                root.submit-quick-group(qcg-orig, qcg-name);
                root.close-requested();
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: lang-en ? "Cancel" : "取消";
            clicked => { root.close-requested(); }
        }
        Button {
            text: lang-en ? "OK" : "确定";
            primary: true;
            enabled: qcg-name != "";
            clicked => {
                root.submit-quick-group(qcg-orig, qcg-name);
                root.close-requested();
            }
        }
    }
}
