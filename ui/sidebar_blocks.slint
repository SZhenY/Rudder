//! 侧栏的**区块组件**：状态行、网络图、CPU/内存/交换、网络、磁盘。
//!
//! 从 `sidebar.slint` 拆出（P4）：这些组件都有完整的 `in property` / `callback` 接口，
//! 只通过参数与外界通信，因此是**逐字搬运**（仅把 `component X` 改成 `export component X`
//! 以便被 `sidebar.slint` 导入，并保留 `DiskInfo` 的导出）。
//! `Sidebar` 自身留在原文件，负责把所有区块拼起来。

import { Theme } from "theme.slint";
import { Sparkline } from "widgets.slint";
import { Divider, VDivider } from "components/surfaces.slint";
import { IconText } from "components/text.slint";

// One filesystem row for the disk-usage panel.
export struct DiskInfo {
    path: string,
    detail: string,   // "available/total"
    percent: float,   // used fraction 0.0..1.0
}

// --- StatRow ---------------------------------------------------------------
// A single label / percentage / progress-bar row used for CPU / memory / swap.
export component StatRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> percent; // 0.0 .. 1.0
    in property <string> detail;
    in property <brush> bar-color: Theme.accent;

    spacing: 6px;
    padding-left: 8px;
    padding-right: 8px;
    height: 22px;

    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
        width: 52px;          // fits English "Memory" as well as 中文 "内存"
        vertical-alignment: center;
        overflow: elide;
    }

    // Progress bar — stretches to fill the row, with a floor so it stays usable.
    Rectangle {
        background: Theme.bg-root;
        border-radius: 2px;
        horizontal-stretch: 2;
        min-width: 60px;

        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            // 条宽**不做动画**：它是仪表、不是交互元素 —— 输入是 1 Hz 采样，每秒都会换目标，
            // 任何 `animate` 都会被每秒重新触发；而 Slint 一次重绘 = 重画**整个窗口**（不做
            // 局部重绘），空闲帧率于是被抬到 15 fps。实测同一场景：带 160ms 弹簧 = 15 fps，
            // 去掉动画 = 2 fps（只剩数据本身那一次重绘）。
            // 条宽跟着**取整后的百分比**（右侧数字本来就是整数百分比），跳变只 1 个百分点。
            width: parent.width * clamp(Math.round(percent * 100) / 100, 0.0, 1.0);
            background: bar-color;
            border-radius: 2px;
        }

        Text {
            x: 6px;
            text: Math.round(percent * 100) + "%";
            color: Theme.text-primary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            height: parent.height;
        }
    }

    // Used/total figure, right-aligned; reserve width so it never gets clipped.
    Text {
        text: detail;
        color: Theme.text-muted;
        font-size: Theme.fs-xs;
        horizontal-stretch: 1;
        min-width: 64px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// --- NetGraph --------------------------------------------------------------
// One network throughput graph: a header row (↑ tx / ↓ rx, plus an optional
// NIC selector dropdown) over an auto-scaled sparkline.
export component NetGraph inherits VerticalLayout {
    in property <string> up-text;
    in property <string> down-text;
    in property <[float]> history;
    in property <bool> show-selector: false;
    in property <[string]> ifaces;
    in property <string> selected;
    callback iface-selected(string);

    // Stay at preferred height; without this the inherited VerticalLayout grabs
    // a stretch share of the sidebar and balloons the sparkline into blank space.
    vertical-stretch: 0;
    spacing: 3px;

    HorizontalLayout {
        spacing: 3px;
        IconText {                              // ↑ upload (green)
            text: "\u{E5D8}";
            color: Theme.success;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.up-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        IconText {                              // ↓ download (blue)
            text: "\u{E5DB}";
            color: Theme.accent;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.down-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; } // spacer pushes selector to the right

        if root.show-selector : Rectangle {
            width: 64px;
            height: 18px;
            border-radius: 3px;
            background: sel-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;

            HorizontalLayout {
                padding-left: 5px; padding-right: 4px; spacing: 2px;
                Text {
                    text: root.selected;
                    color: Theme.text-primary;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                IconText {
                    text: "\u{E5CF}";
                    color: Theme.text-muted;
                    font-size: 8px;
                    vertical-alignment: center;
                }
            }

            sel-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }

            popup := PopupWindow {
                x: 0; y: parent.height + 2px;
                width: 96px;
                Rectangle {
                    background: Theme.bg-panel;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: Theme.shadow-menu-blur;
                    drop-shadow-color: Theme.shadow-menu-color;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        for iface in root.ifaces : Rectangle {
                            height: 22px;
                            border-radius: 3px;
                            background: row-ta.has-hover ? Theme.bg-hover : transparent;
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.iface-selected(iface); }
                            }
                            Text {
                                x: 6px;
                                text: iface;
                                color: Theme.text-primary;
                                font-size: Theme.fs-xs;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                    }
                }
            }
        }
    }

    Sparkline {
        height: 48px;
        values: root.history;
        line-color: Theme.accent;
    }
}

// --- Reusable sections -----------------------------------------------------
// Each block is self-contained so the sidebar can lay them out vertically (when
// docked left/right) or horizontally (docked top/bottom) without duplicating
// their internals (#dock).

// Status header — also the drag handle (a grip TouchArea behind the texts) and
// home of the collapse button, so collapsing follows the panel to any edge.
export component StatusBlock inherits Rectangle {
    in property <int> conn-state;
    in property <string> connection-state;
    in property <string> conn-host;        // clean IP/host to copy ("" = not clickable) (#192)
    in property <string> collapse-icon;   // chevron pointing toward the docked edge
    callback dock-drag-move(length, length);
    callback dock-drag-end();
    callback collapse();
    callback copy-host(string);
    property <bool> copied;                // shows a brief "Copied" badge after a click
    TouchArea {
        mouse-cursor: move;
        moved => {
            root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
        }
    }
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 8px; height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.conn-state == 1 ? Theme.success
                          : root.conn-state == 2 ? Theme.warning
                          : Theme.text-muted;
            }
            Text { text: @tr("Status"); color: Theme.text-primary;
                   font-size: Theme.fs-md; font-weight: 600;
                   vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            // Collapse button — sits in front of the drag grip so it takes the click.
            Rectangle {
                width: 18px; height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: cl-ta.has-hover ? Theme.bg-hover : transparent;
                cl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.collapse(); } }
                IconText { text: root.collapse-icon;
                       centered: true;
                       font-size: 14px; color: Theme.text-secondary;
}
            }
        }
        // IP / host line — click to copy (#192). Only interactive when there's a
        // real host (skips the "Not connected" placeholder). Hover gives a hand
        // cursor + subtle highlight; a brief "Copied" badge confirms the copy.
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            ip-wrap := Rectangle {
                width: ip-txt.preferred-width + (root.conn-host != "" ? 10px : 0px);
                height: ip-txt.preferred-height + 4px;
                border-radius: Theme.radius-sm;
                background: (root.conn-host != "" && ip-ta.has-hover) ? Theme.bg-hover : transparent;
                ip-txt := Text {
                    x: root.conn-host != "" ? 5px : 0px;
                    y: (parent.height - self.height) / 2;
                    text: root.connection-state;
                    color: Theme.text-secondary; font-size: Theme.fs-sm;
                }
                ip-ta := TouchArea {
                    enabled: root.conn-host != "";
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy-host(root.conn-host);
                        root.copied = true;
                        copied-timer.running = true;
                    }
                }
            }
            if root.copied : Text {
                text: @tr("Copied");
                color: Theme.success; font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }
    }
    // Auto-hide the "Copied" badge a moment after the click.
    copied-timer := Timer {
        interval: 1400ms;
        running: false;
        triggered => { root.copied = false; self.running = false; }
    }
}

// Resource title + Processes button + CPU/Memory/Swap rows.
export component StatsBlock inherits VerticalLayout {
    in property <string> resource-title;
    in property <bool> system-info-available;
    in property <bool> proc-available;
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    callback show-system-info();
    callback show-processes();
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            height: 20px;
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: root.system-info-available && sys-ta.has-hover ? Theme.bg-hover : transparent;
            sys-ta := TouchArea {
                enabled: root.system-info-available;
                mouse-cursor: root.system-info-available ? pointer : default;
                clicked => { root.show-system-info(); }
            }
            Text {
                x: 4px;
                width: parent.width - 8px;
                text: root.resource-title;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.system-info-available : Rectangle {
            width: 22px; height: 20px;
            border-radius: Theme.radius-sm;
            background: info-ta.has-hover ? Theme.bg-hover : transparent;
            info-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-system-info(); } }
            IconText {
                centered: true;
                text: "\u{E88E}";
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
            }
        }
        if root.proc-available : Rectangle {
            width: 52px; height: 20px;
            border-radius: Theme.radius-sm;
            background: proc-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
            proc-ta := TouchArea { mouse-cursor: pointer; clicked => { root.show-processes(); } }
            Text { text: @tr("Processes"); color: Theme.text-secondary; font-size: Theme.fs-xs;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    StatRow { label: "CPU"; percent: root.cpu-percent; detail: ""; bar-color: Theme.accent; }
    StatRow { label: @tr("Memory"); percent: root.mem-percent; detail: root.mem-detail; bar-color: Theme.success; }
    StatRow { label: @tr("Swap"); percent: root.swap-percent; detail: root.swap-detail; bar-color: Theme.warning; }
}

// Dual network graph (active tab on top, local below).
export component NetBlock inherits VerticalLayout {
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <[float]> net-top-history;
    in property <bool> net-show-selector;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    callback select-net-iface(string);
    spacing: 6px;
    NetGraph {
        up-text: root.net-top-up; down-text: root.net-top-down; history: root.net-top-history;
        show-selector: root.net-show-selector; ifaces: root.net-ifaces; selected: root.net-selected;
        iface-selected(i) => { root.select-net-iface(i); }
    }
    Text { text: @tr("Local"); color: Theme.text-muted; font-size: Theme.fs-xs; }
    NetGraph { up-text: root.net-bot-up; down-text: root.net-bot-down; history: root.net-bot-history; }
}

// Disk-usage list with a hover tooltip, self-contained.
export component DiskBlock inherits Rectangle {
    in property <[DiskInfo]> disks;
    private property <int>    tip-idx: -1;
    private property <string> tip-path: "";
    private property <length> tip-y: tip-idx >= 0
        ? clamp(flick.y + tip-idx * 21px + flick.content-y + 20px, 2px, root.height - 28px) : 0px;
    VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            padding-left: 6px; padding-right: 6px;
            Text { text: @tr("Path"); color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-stretch: 1; }
            Text { text: @tr("Free/Total"); color: Theme.text-muted; font-size: Theme.fs-xs; }
        }
        flick := Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, disk-col.preferred-height);
            disk-col := VerticalLayout {
                alignment: start;
                spacing: 1px;
                for d[i] in root.disks : Rectangle {
                    height: 20px; border-radius: 2px; clip: true;
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: parent.width * clamp(d.percent, 0.0, 1.0);
                        background: d.percent > 0.9 ? Theme.danger.with-alpha(0.32)
                                  : d.percent > 0.75 ? Theme.warning.with-alpha(0.30)
                                  : Theme.accent.with-alpha(0.22);
                    }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 4px;
                        Text { text: d.path; color: Theme.text-secondary; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: d.detail; color: Theme.text-muted; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-alignment: right; }
                    }
                    ta := TouchArea {
                        width: parent.width; height: parent.height; x: 0; y: 0;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-path = d.path; root.tip-idx = i;
                            } else if (root.tip-path == d.path) {
                                root.tip-path = ""; root.tip-idx = -1;
                            }
                        }
                    }
                }
            }
        }
    }
    if tip-path != "" : Rectangle {
        x: 4px; y: tip-y; width: parent.width - 8px; height: 24px; z: 100;
        background: Theme.bg-elevated; border-radius: Theme.radius-sm;
        border-width: 1px; border-color: Theme.border-subtle;
        drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000040;
        Text { x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px;
               text: tip-path; color: Theme.text-primary; font-size: Theme.fs-xs; overflow: elide; }
    }
}

// --- Sidebar ---------------------------------------------------------------
// Left-hand panel showing local machine health, mimicking FinalShell's
// @tr("Status") column but kept minimal for the v0.1 baseline.
