//! 运行状态页的**区块组件**：资源卡、网络图、网络、磁盘。
//!
//! 这些组件都有完整的 `in property` / `callback` 接口，只通过参数与外界通信。
//! 使用方：`overview_view.slint`（运行状态页签）。

import { Theme, AnimationSettings } from "theme.slint";
import { TrendCurve } from "components/trend_curve.slint";
import { IconText } from "components/text.slint";

// One filesystem row for the disk-usage panel.
export struct DiskInfo {
    path: string,
    detail: string,   // "available/total"
    percent: float,   // used fraction 0.0..1.0
}

// --- ResourceSnapshot ------------------------------------------------------
// 2×2 资源卡一次写入的整份快照。字段用下划线（与 TabInfo.title_len 一致）：
// Slint 与 Rust 两侧同名，避免生成名歧义。
export struct ResourceSnapshot {
    cpu_percent: float,
    /// "User: 1.6%"
    cpu_foot_left: string,
    /// "Sys: 5.8%"
    cpu_foot_right: string,
    mem_percent: float,
    /// "1.5 GB"（已用）
    mem_foot_left: string,
    /// "3.8 GB"（总量）
    mem_foot_right: string,
    disk_percent: float,
    /// "3 GB"（已用，系统盘）
    disk_foot_left: string,
    /// "7 GB"（总量，系统盘）
    disk_foot_right: string,
    net_down: string,
    net_up: string,
    net_gateway: string,
}

// --- ResourceTile ----------------------------------------------------------
// 资源卡的统一外壳：图标块 + 标题 + 大号读数，下面是进度条（指标卡）或速率行
// （网络卡），最后是左右两项说明。
export component ResourceTile inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in property <brush> tone: Theme.accent;
    /// 大号读数（"7.4%"）；网络卡留空。
    in property <string> value;
    /// 进度条占比 0..1；< 0 不画（网络卡）。
    in property <float> percent: -1;
    in property <string> foot-left;
    in property <string> foot-right;
    /// 网络卡的速率行；`percent < 0` 时显示。
    in property <string> net-down;
    in property <string> net-up;

    // 条宽的目标值 + "这一次要不要动画"。
    //
    // 输入是 1~2 Hz 采样，条每秒都会换目标；而**任何一帧动画都会让 Slint 重画整个
    // 窗口**（不做局部重绘）。空闲时 CPU 在 1~2% 之间抖，每秒重放动画就等于每秒
    // 重画十几次。所以只有**真正的跳变**（≥10 个百分点）才出动画，小抖动直接跳位。
    property <float> shown: percent;
    property <bool> smooth: false;
    changed percent => {
        root.smooth = Math.abs(percent - root.shown) >= 0.10;
        root.shown = percent;
    }

    vertical-stretch: 0;
    // 两行卡片对齐：内容高度 70px 左右，撑到 84px 让 2×2 四块一致；
    // 字号调大时按内容继续长高，不裁字。
    min-height: 84px * Theme.ui-scale;
    border-radius: Theme.radius-md;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-8;
        spacing: Theme.sp-6;
        alignment: start;

        HorizontalLayout {
            width: 100%;
            spacing: Theme.sp-6;
            Rectangle {
                width: 22px * Theme.ui-scale;
                height: 22px * Theme.ui-scale;
                border-radius: Theme.radius-sm;
                background: root.tone.with-alpha(0.16);
                IconText {
                    width: parent.width;
                    height: parent.height;
                    centered: true;
                    text: root.glyph;
                    color: root.tone;
                    font-size: Theme.fs-sm;
                }
            }
            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.value != "" : Text {
                text: root.value;
                color: root.tone;
                font-size: Theme.fs-xl;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.percent >= 0 : Rectangle {
            height: 6px * Theme.ui-scale;
            // 显式占满卡片宽度：VerticalLayout 的交叉轴不吃 `horizontal-stretch`，
            // 只写 stretch 时轨道会缩到内容宽度并被居中，填出来像「从中间向两边长」。
            width: 100%;
            border-radius: 3px * Theme.ui-scale;
            background: Theme.bg-root;
            clip: true;
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * clamp(root.shown, 0.0, 1.0);
                height: parent.height;
                border-radius: 3px * Theme.ui-scale;
                background: root.tone;
                animate width {
                    duration: AnimationSettings.medium2();
                    easing: AnimationSettings.e-standard-decelerate();
                    enabled: AnimationSettings.enabled && root.smooth;
                }
            }
        }

        // 上行在左、下行在右：与上方网络曲线图的 ↑ / ↓ 顺序一致。
        if root.percent < 0 : HorizontalLayout {
            width: 100%;
            spacing: Theme.sp-4;
            IconText {
                text: "\u{E5D8}";   // arrow_upward
                color: Theme.success;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
            Text {
                text: root.net-up;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                // 窄宽度下压缩并省略；默认 clip 的隐式最小宽度 = 全文宽度，会把数值画到卡外。
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            IconText {
                text: "\u{E5DB}";   // arrow_downward
                color: Theme.accent;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }
            Text {
                text: root.net-down;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            width: 100%;
            Text {
                text: root.foot-left;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.foot-right;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// --- NetGraph --------------------------------------------------------------
// One network throughput graph: a header row (↑ tx / ↓ rx, plus an optional
// NIC selector dropdown) over an auto-scaled sparkline.
export component NetGraph inherits VerticalLayout {
    in property <length> chart-height: 48px * Theme.ui-scale;
    in property <string> up-text;
    in property <string> down-text;
    in property <string> path;
    /// 上行（tx）曲线；`path` 是下行（rx）。
    in property <string> up-path;

    // Stay at preferred height; without this the inherited VerticalLayout grabs
    // a stretch share of the status page and balloons the sparkline into blank space.
    vertical-stretch: 0;
    spacing: Theme.sp-3;

    HorizontalLayout {
        spacing: Theme.sp-3;
        IconText {                              // ↑ upload (green)
            text: "\u{E5D8}";
            color: Theme.success;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.up-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        IconText {                              // ↓ download (blue)
            text: "\u{E5DB}";
            color: Theme.accent;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.down-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; } // spacer pushes selector to the right

    }

    // 上下行两条**对等**的曲线：同一个组件内叠画，刻度线只画一份，
    // 两条都是半透明填充，视觉上就是同一坐标系里的两条函数曲线。
    TrendCurve {
        chart-height: root.chart-height;
        commands: root.path;
        tone: Theme.accent;
        second-commands: root.up-path;
        second-tone: Theme.success;
    }
}

// 当前会话所选网卡的吞吐曲线（上下行同一坐标系）。
export component NetBlock inherits VerticalLayout {
    in property <length> chart-height: 48px * Theme.ui-scale;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <string> net-top-path;
    in property <string> net-up-path;
    vertical-stretch: 0;
    spacing: Theme.sp-6;
    NetGraph {
        chart-height: root.chart-height;
        up-text: root.net-top-up; down-text: root.net-top-down; path: root.net-top-path;
        up-path: root.net-up-path;
    }
}

// Disk-usage list with a hover tooltip, self-contained.
export component DiskBlock inherits Rectangle {
    in property <[DiskInfo]> disks;
    private property <int>    tip-idx: -1;
    private property <string> tip-path: "";
    private property <length> tip-y: tip-idx >= 0
        ? clamp(flick.y + tip-idx * 21px * Theme.ui-scale + flick.content-y + 20px * Theme.ui-scale, 2px * Theme.ui-scale, root.height - 28px * Theme.ui-scale) : 0px;
    VerticalLayout {
        spacing: Theme.sp-3;
        HorizontalLayout {
            padding-left: Theme.sp-6; padding-right: Theme.sp-6;
            Text { text: @tr("Path"); color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-stretch: 1; }
            Text { text: @tr("Free/Total"); color: Theme.text-muted; font-size: Theme.fs-xs; }
        }
        flick := Flickable {
            // 高度跟分区行数走（上限 140px），不吸富余高度。
            vertical-stretch: 0;
            height: min(disk-col.preferred-height, 140px * Theme.ui-scale);
            content-width: self.width;
            content-height: max(self.height, disk-col.preferred-height);
            disk-col := VerticalLayout {
                alignment: start;
                spacing: 1px;
                for d[i] in root.disks : Rectangle {
                    height: 20px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale; clip: true;
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: parent.width * clamp(d.percent, 0.0, 1.0);
                        background: d.percent > 0.9 ? Theme.danger.with-alpha(0.32)
                                  : d.percent > 0.75 ? Theme.warning.with-alpha(0.30)
                                  : Theme.accent.with-alpha(0.22);
                    }
                    HorizontalLayout {
                        padding-left: Theme.sp-6; padding-right: Theme.sp-6; spacing: Theme.sp-4;
                        Text { text: d.path; color: Theme.text-secondary; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: d.detail; color: Theme.text-muted; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-alignment: right; }
                    }
                    ta := TouchArea {
                        width: parent.width; height: parent.height; x: 0; y: 0;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-path = d.path; root.tip-idx = i;
                            } else if (root.tip-path == d.path) {
                                root.tip-path = ""; root.tip-idx = -1;
                            }
                        }
                    }
                }
            }
        }
    }
    if tip-path != "" : Rectangle {
        x: 4px * Theme.ui-scale; y: tip-y; width: parent.width - 8px * Theme.ui-scale; height: 24px * Theme.ui-scale; z: 100;
        background: Theme.bg-elevated; border-radius: Theme.radius-sm;
        border-width: 1px; border-color: Theme.border-subtle;
        drop-shadow-blur: 8px * Theme.ui-scale; drop-shadow-offset-y: 2px * Theme.ui-scale; drop-shadow-color: #00000040;
        Text { x: 8px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: parent.width - 16px * Theme.ui-scale;
               text: tip-path; color: Theme.text-primary; font-size: Theme.fs-xs; overflow: elide; }
    }
}
