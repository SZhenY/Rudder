//! 运行状态页的**区块组件**：状态行、网络图、CPU/内存/交换、网络、磁盘。
//!
//! 这些组件都有完整的 `in property` / `callback` 接口，只通过参数与外界通信。
//! 使用方：`resource_view.slint`（运行状态页）与 `overview_panel.slint` 的页签面板。

import { Theme, AnimationSettings } from "theme.slint";
import { TrendCurve } from "components/trend_curve.slint";
import { IconText } from "components/text.slint";

// One filesystem row for the disk-usage panel.
export struct DiskInfo {
    path: string,
    detail: string,   // "available/total"
    percent: float,   // used fraction 0.0..1.0
}

// --- StatRow ---------------------------------------------------------------
// A single label / percentage / progress-bar row used for CPU / memory / swap.
export component StatRow inherits HorizontalLayout {
    in property <string> label;
    in property <float> percent; // 0.0 .. 1.0
    in property <string> detail;
    /// 条内文字：CPU 传百分比、内存/交换/磁盘传 used/total；空则回退百分比。
    in property <string> value;
    in property <brush> bar-color: Theme.accent;

    // 条宽的目标值 + "这一次要不要动画"。
    //
    // 输入是 1 Hz 采样，条每秒都会换目标；而**任何一帧动画都会让 Slint 重画整个窗口**
    // （不做局部重绘）。空闲时 CPU 在 1~2% 之间抖，每秒重放动画就等于每秒重画十几次
    // （实测空闲帧率 15 fps ✗）。所以只有**真正的跳变**（≥10 个百分点）才出动画，
    // 小抖动直接跳到位 —— 空闲帧率因此回到 1 fps。
    property <float> shown: percent;
    property <bool> smooth: false;
    changed percent => {
        root.smooth = Math.abs(percent - root.shown) >= 0.10;
        root.shown = percent;
    }

    spacing: Theme.sp-6;
    padding-left: Theme.sp-8;
    padding-right: Theme.sp-8;
    height: max(22px * Theme.ui-scale, Theme.fs-sm + 8px * Theme.ui-scale);

    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.fs-sm;
        width: 40px * Theme.ui-scale;          // fits English "Memory" as well as 中文 "内存"
        vertical-alignment: center;
        overflow: elide;
    }

    // Progress bar — stretches to fill the row, with a floor so it stays usable.
    Rectangle {
        background: Theme.bg-root;
        border-radius: 2px * Theme.ui-scale;
        horizontal-stretch: 2;
        min-width: 28px * Theme.ui-scale;
        // 2×2 布局下行宽只有 ~100px，条内文字必须裁在自己的矩形里，
        // 否则 `7.2G/7.8G` 会画到行外被硬裁成半截。
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            // 条宽跟着**取整后的百分比**（右侧数字本来就是整数百分比），跳变只有 1 个百分点。
            // 动画只在 `root.smooth`（变化 ≥10 个百分点）时生效，见上面 `changed percent`。
            width: parent.width * clamp(Math.round(shown * 100) / 100, 0.0, 1.0);
            background: bar-color;
            border-radius: 2px * Theme.ui-scale;
            animate width {
                duration: AnimationSettings.medium2();
                easing: AnimationSettings.e-standard-decelerate();
                enabled: AnimationSettings.enabled && root.smooth;
            }
        }

        Text {
            x: 6px * Theme.ui-scale;
            width: parent.width - 10px;
            text: root.value != "" ? root.value : Math.round(percent * 100) + "%";
            color: Theme.text-primary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
            height: parent.height;
            overflow: elide;
        }
    }

}

// --- NetGraph --------------------------------------------------------------
// One network throughput graph: a header row (↑ tx / ↓ rx, plus an optional
// NIC selector dropdown) over an auto-scaled sparkline.
export component NetGraph inherits VerticalLayout {
    in property <length> chart-height: 48px * Theme.ui-scale;
    in property <string> up-text;
    in property <string> down-text;
    in property <string> path;
    /// 上行（tx）曲线；`path` 是下行（rx）。
    in property <string> up-path;

    // Stay at preferred height; without this the inherited VerticalLayout grabs
    // a stretch share of the status page and balloons the sparkline into blank space.
    vertical-stretch: 0;
    spacing: Theme.sp-3;

    HorizontalLayout {
        spacing: Theme.sp-3;
        IconText {                              // ↑ upload (green)
            text: "\u{E5D8}";
            color: Theme.success;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.up-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        IconText {                              // ↓ download (blue)
            text: "\u{E5DB}";
            color: Theme.accent;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.down-text;
            color: Theme.text-secondary;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; } // spacer pushes selector to the right

    }

    // 上下行两条**对等**的曲线：同一个组件内叠画，刻度线只画一份，
    // 两条都是半透明填充，视觉上就是同一坐标系里的两条函数曲线。
    TrendCurve {
        chart-height: root.chart-height;
        commands: root.path;
        tone: Theme.accent;
        second-commands: root.up-path;
        second-tone: Theme.success;
    }
}

// --- Reusable sections -----------------------------------------------------
// 每个区块自包含，运行状态页把它们竖排铺开，不需要为不同布局重复实现。

// 状态区块：连接状态点 + 标题 + 可点击复制的主机地址。
export component StatusBlock inherits Rectangle {
    in property <int> conn-state;
    in property <string> connection-state;
    in property <string> conn-host;        // clean IP/host to copy ("" = not clickable) (#192)
    callback copy-host(string);
    property <bool> copied;                // shows a brief "Copied" badge after a click
    VerticalLayout {
        spacing: Theme.sp-4;
        HorizontalLayout {
            spacing: Theme.sp-6;
            Rectangle {
                width: 8px * Theme.ui-scale; height: 8px * Theme.ui-scale;
                y: (parent.height - self.height) / 2;
                border-radius: 4px * Theme.ui-scale;
                background: root.conn-state == 1 ? Theme.success
                          : root.conn-state == 2 ? Theme.warning
                          : Theme.text-muted;
            }
            Text { text: @tr("Status"); color: Theme.text-primary;
                   font-size: Theme.fs-md; font-weight: 600;
                   vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        // IP / host line — click to copy (#192). Only interactive when there's a
        // real host (skips the "Not connected" placeholder). Hover gives a hand
        // cursor + subtle highlight; a brief "Copied" badge confirms the copy.
        HorizontalLayout {
            spacing: Theme.sp-6;
            alignment: start;
            Rectangle {
                width: ip-txt.preferred-width + (root.conn-host != "" ? 10px * Theme.ui-scale : 0px);
                height: ip-txt.preferred-height + 4px * Theme.ui-scale;
                border-radius: Theme.radius-sm;
                background: (root.conn-host != "" && ip-ta.has-hover) ? Theme.state-hover : transparent;
                animate background {
                    duration: (root.conn-host != "" && ip-ta.has-hover) ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                    easing: (root.conn-host != "" && ip-ta.has-hover) ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                    enabled: AnimationSettings.enabled;
                }
                ip-txt := Text {
                    x: root.conn-host != "" ? 5px * Theme.ui-scale : 0px;
                    y: (parent.height - self.height) / 2;
                    text: root.connection-state;
                    color: Theme.text-secondary; font-size: Theme.fs-sm;
                }
                ip-ta := TouchArea {
                    enabled: root.conn-host != "";
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy-host(root.conn-host);
                        root.copied = true;
                        copied-timer.running = true;
                    }
                }
            }
            if root.copied : Text {
                text: @tr("Copied");
                color: Theme.success; font-size: Theme.fs-sm;
                vertical-alignment: center;
            }
        }
    }
    // Auto-hide the "Copied" badge a moment after the click.
    copied-timer := Timer {
        interval: 1400ms;
        running: false;
        triggered => { root.copied = false; self.running = false; }
    }
}

// Dual network graph (active tab on top, local below).
export component NetBlock inherits VerticalLayout {
    in property <length> chart-height: 48px * Theme.ui-scale;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <string> net-top-path;
    in property <string> net-up-path;
    vertical-stretch: 0;
    spacing: Theme.sp-6;
    NetGraph {
        chart-height: root.chart-height;
        up-text: root.net-top-up; down-text: root.net-top-down; path: root.net-top-path;
        up-path: root.net-up-path;
    }
}

// Disk-usage list with a hover tooltip, self-contained.
export component DiskBlock inherits Rectangle {
    in property <[DiskInfo]> disks;
    private property <int>    tip-idx: -1;
    private property <string> tip-path: "";
    private property <length> tip-y: tip-idx >= 0
        ? clamp(flick.y + tip-idx * 21px * Theme.ui-scale + flick.content-y + 20px * Theme.ui-scale, 2px * Theme.ui-scale, root.height - 28px * Theme.ui-scale) : 0px;
    VerticalLayout {
        spacing: Theme.sp-3;
        HorizontalLayout {
            padding-left: Theme.sp-6; padding-right: Theme.sp-6;
            Text { text: @tr("Path"); color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-stretch: 1; }
            Text { text: @tr("Free/Total"); color: Theme.text-muted; font-size: Theme.fs-xs; }
        }
        flick := Flickable {
            // 高度跟分区行数走（上限 140px），不吸富余高度。
            vertical-stretch: 0;
            height: min(disk-col.preferred-height, 140px * Theme.ui-scale);
            content-width: self.width;
            content-height: max(self.height, disk-col.preferred-height);
            disk-col := VerticalLayout {
                alignment: start;
                spacing: 1px;
                for d[i] in root.disks : Rectangle {
                    height: 20px * Theme.ui-scale; border-radius: 2px * Theme.ui-scale; clip: true;
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: parent.width * clamp(d.percent, 0.0, 1.0);
                        background: d.percent > 0.9 ? Theme.danger.with-alpha(0.32)
                                  : d.percent > 0.75 ? Theme.warning.with-alpha(0.30)
                                  : Theme.accent.with-alpha(0.22);
                    }
                    HorizontalLayout {
                        padding-left: Theme.sp-6; padding-right: Theme.sp-6; spacing: Theme.sp-4;
                        Text { text: d.path; color: Theme.text-secondary; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Text { text: d.detail; color: Theme.text-muted; font-size: Theme.fs-xs;
                               vertical-alignment: center; horizontal-alignment: right; }
                    }
                    ta := TouchArea {
                        width: parent.width; height: parent.height; x: 0; y: 0;
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-path = d.path; root.tip-idx = i;
                            } else if (root.tip-path == d.path) {
                                root.tip-path = ""; root.tip-idx = -1;
                            }
                        }
                    }
                }
            }
        }
    }
    if tip-path != "" : Rectangle {
        x: 4px * Theme.ui-scale; y: tip-y; width: parent.width - 8px * Theme.ui-scale; height: 24px * Theme.ui-scale; z: 100;
        background: Theme.bg-elevated; border-radius: Theme.radius-sm;
        border-width: 1px; border-color: Theme.border-subtle;
        drop-shadow-blur: 8px * Theme.ui-scale; drop-shadow-offset-y: 2px * Theme.ui-scale; drop-shadow-color: #00000040;
        Text { x: 8px * Theme.ui-scale; y: (parent.height - self.height) / 2; width: parent.width - 16px * Theme.ui-scale;
               text: tip-path; color: Theme.text-primary; font-size: Theme.fs-xs; overflow: elide; }
    }
}
