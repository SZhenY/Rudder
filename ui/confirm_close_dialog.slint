//! **关闭前的确认**弹窗（#88）：有活动会话时先问一句再退出。
//!
//! 从 `app.slint` 拆出（P4 B 类）：显隐由调用点判断；关闭弹窗上抛
//! `close-requested()`；根元素原先用 `parent.width/height` 定位，组件内拿不到
//! `parent`，改为显式传入 `avail-width` / `avail-height`。

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton } from "widgets.slint";

import { DialogActions } from "components/dialog_actions.slint";

export component ConfirmCloseDialog inherits Rectangle {
    // 显隐由调用点控制：**常驻**，不用 `if` 包着 —— 在事件派发栈上销毁
    // 正在处理事件的子树会闪退（#323/#343）。关闭时不绘制也不参与命中。
    in property <bool> open: false;
    visible: open;
    // ── 状态（窗口透传）──────────────────────────────────────────────
    in property <bool> lang-en: false;
    in property <length> avail-width: 100000px;
    in property <length> avail-height: 100000px;

    // ── 动作：由调用点转发（实现仍在 Rust / 窗口）────────────────────
    callback close-requested();
    callback confirm-close-yes();

    width: avail-width;
    height: avail-height;
    background: #00000088;
    TouchArea { clicked => { root.close-requested(); } }
    // Grab the keyboard so the terminal beneath stops receiving input, and
    // make the dialog operable without the mouse: Enter/Space close, Esc
    // cancels (so X → Space closes, X → Esc backs out) (#140-3).
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close-requested();
                accept
            } else if (e.text == Key.Return || e.text == " ") {
                root.confirm-close-yes();
                accept
            } else {
                accept   // modal: swallow everything else
            }
        }
    }

    Rectangle {
        x: (avail-width - self.width) / 2;
        y: (avail-height - self.height) / 2;
        width: 340px;
        height: 168px;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-color: Theme.shadow-dialog-color;
        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text {
                text: lang-en ? "Close Rudder?" : "确定关闭 Rudder?";
                color: Theme.text-primary; font-size: Theme.fs-lg; font-weight: 700;
            }
            Text {
                text: lang-en
                    ? "There are active sessions. Closing will disconnect them."
                    : "当前有活动会话,关闭将断开它们。";
                color: Theme.text-secondary; font-size: Theme.fs-sm; wrap: word-wrap;
                line-height-factor: 1.3;
            }
            Rectangle { vertical-stretch: 1; }
            DialogActions {
                cancel-text: lang-en ? "Cancel" : "取消";
                ok-text: lang-en ? "Close" : "关闭";
                cancelled => { root.close-requested(); }
                confirmed => { root.confirm-close-yes(); }
            }
        }
    }
}
