//! 欢迎页的**会话行**与 `SessionInfo` 结构体。
//!
//! 从 `welcome.slint` 拆出（P4）：`SessionRow` 自带完整接口（`session` / `compact`
//! + 9 个 callback），逐字搬运；`SessionInfo` 随行搬走并在原文件转出口。
import { Theme, AnimationSettings } from "theme.slint";
import { PrimaryButton, GhostButton, IconButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { Divider } from "components/surfaces.slint";
import { IconText } from "components/text.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    group: string,        // folder/group name ("" = ungrouped)
    group-header: string, // set on the first row of each group → render a header
    collapsed: bool,      // group is collapsed → this session row is hidden
    builtin: bool,        // built-in local shell, not a saved server session
}

// --- SessionRow ------------------------------------------------------------
export component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> compact;
    callback connect();
    callback edit();
    callback duplicate();
    callback move-to-group(string);
    callback remove();
    // Drag-to-reorder: direction -1 = up, 1 = down. Emitted once per row-hop.
    callback reorder(int);
    // Drag lifecycle, owned by the Welcome list: start publishes the dragged
    // id, move streams the pointer-follow offset, end persists the order.
    callback drag-start();
    callback drag-move(length);
    callback drag-end();
    // Full session list — group-header is non-empty once per group, so the
    // "move to group" submenu can iterate it to list each group exactly once.
    in property <[SessionInfo]> all-sessions;
    // Drag is only allowed outside search (visible indices would not match
    // stored order) and never on built-in system rows.
    in property <bool> reorder-enabled: false;
    // Shared list-level drag state (see Welcome): which session is being
    // dragged and its offset. The lifted card follows the dragged session's
    // DATA, not the component holding the pointer grab — rows swap contents
    // under the grab on every hop.
    in property <bool> drag-target: false;
    in property <length> drag-dy: 0px;
    property <bool> system-row: root.session.builtin;
    // Local gesture state: this instance received the press and drives the
    // drag (it keeps the pointer grab across in-place model updates).
    property <bool> pressing: false;
    property <bool> grab-dragging: false;
    property <length> grab-y;

    height: root.compact ? 44px : 36px;

    // Remember where the right-click landed so the popup can appear there.
    property <length> ctx-x;
    property <length> ctx-y;

    touch := TouchArea {
        mouse-cursor: root.grab-dragging ? move : pointer;
        // Connect is handled in pointer-event below so a finished drag never
        // counts as a click.
        pointer-event(e) => {
            // Built-in PowerShell/CMD/WSL rows have no edit/move/delete actions.
            // All menu items are conditional on !system-row, so opening the
            // popup for them only produces an empty rectangle (#336).
            if (!root.system-row
                    && e.kind == PointerEventKind.down
                    && e.button == PointerEventButton.right) {
                ctx-x = self.mouse-x;
                ctx-y = self.mouse-y;
                ctx-menu.show();
            } else if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.pressing = true;
                    // Reset any stale drag (e.g. released outside the row).
                    root.grab-dragging = false;
                    root.grab-y = self.mouse-y;
                } else if (e.kind == PointerEventKind.up) {
                    // `pressing` proves this instance received the down: the
                    // row under a released pointer must not treat it as a
                    // click when the grab landed elsewhere after hops.
                    if (root.pressing && !root.grab-dragging) {
                        root.connect();
                    }
                    if (root.grab-dragging) {
                        root.drag-end();
                    }
                    root.pressing = false;
                    root.grab-dragging = false;
                }
            }
        }
        moved => {
            if (!root.pressing) { return; }
            if (!root.grab-dragging) {
                // A few pixels of vertical drift start a reorder drag; below
                // that the press still resolves to a connect click.
                if (root.reorder-enabled && abs(touch.mouse-y - root.grab-y) > 5px) {
                    root.grab-dragging = true;
                    root.grab-y = touch.mouse-y;
                    root.drag-start();
                }
            } else {
                // Swap at the neighbour's midpoint, then shift the anchor by a
                // full slot (row + 2px spacing) — NOT back to the cursor — so
                // overshoot carries over and the drag stays glued to the
                // pointer across consecutive hops.
                if (touch.mouse-y - root.grab-y > (root.height + 2px) / 2) {
                    root.grab-y = root.grab-y + root.height + 2px;
                    root.reorder(1);
                } else if (root.grab-y - touch.mouse-y > (root.height + 2px) / 2) {
                    root.grab-y = root.grab-y - root.height - 2px;
                    root.reorder(-1);
                }
                // Stream the pointer-follow offset to the list, which applies
                // it to whichever row currently renders the dragged session.
                // No animation — animating a pointer-following value always
                // lags the cursor.
                root.drag-move(clamp(touch.mouse-y - root.grab-y,
                    -root.height, root.height));
            }
        }
    }

    // Right-click context menu -----------------------------------------------
    ctx-menu := PopupWindow {
        x: ctx-x;
        y: ctx-y;
        width: 140px;
        // Height follows the content so a variable number of "move to" rows fit.
        height: menu-vl.preferred-height;

        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.shadow-menu-blur;
            drop-shadow-color: Theme.shadow-menu-color;

            menu-vl := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Edit
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: edit-ta.has-hover ? Theme.bg-hover : transparent;
                    edit-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        IconText { text: "\u{E3C9}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                // Duplicate — clone this session as a starting point (#41).
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: dup-ta.has-hover ? Theme.bg-hover : transparent;
                    dup-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.duplicate(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        IconText { text: "\u{E14D}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                // Delete (red tint)
                if !root.system-row : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: del-ta.has-hover ? #cc333320 : transparent;
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.remove(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        IconText { text: "\u{E872}";color: #cc3333; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }

                if !root.system-row : Divider {}

                // "Move to" hint — labels the group list below so the user knows
                // these entries move the session into that folder.
                if !root.system-row : HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 2px;
                    spacing: 6px;
                    IconText { text: "\u{E2C7}";color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; }
                    Text { text: @tr("Move to"); color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; }
                }

                // Move to another group (#41). group-header is non-empty once
                // per group (incl. empty folders), so iterating the full list
                // yields each group once; the current group is skipped.
                for s[i] in root.all-sessions : Rectangle {
                    visible: !root.system-row && s.group-header != ""
                        && s.group-header != "system" && s.group-header != root.session.group;
                    height: self.visible ? 28px : 0px;
                    border-radius: Theme.radius-sm;
                    background: mv-ta.has-hover ? Theme.bg-hover : transparent;
                    mv-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.move-to-group(s.group-header); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        IconText { text: "\u{E2C7}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                        Text { text: s.group-header; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }
        }
    }

    // Row content — wrapped in a card so the dragged row can lift (shadow +
    // pointer-following offset) while the grabbing TouchArea keeps its grab.
    card := Rectangle {
        width: parent.width;
        height: parent.height;
        y: root.drag-target ? root.drag-dy : 0px;
        border-radius: Theme.radius-sm;
        background: root.drag-target ? Theme.bg-elevated
            : (touch.has-hover ? Theme.bg-hover : transparent);
        drop-shadow-blur: root.drag-target ? 14px : 0px;
        drop-shadow-color: root.drag-target ? #00000060 : transparent;
        animate background { duration: 120ms;
            easing: AnimationSettings.color();
            enabled: AnimationSettings.enabled;
        }
        animate drop-shadow-blur { duration: 120ms;
            easing: AnimationSettings.color();
            enabled: AnimationSettings.enabled;
        }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: root.compact ? 8px : 12px;

        Rectangle {
            width: 18px; height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            IconText {
                centered: true;
                text: root.system-row ? "\u{E30A}" : "\u{E875}";   // terminal / server
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
            }
        }

        // Compact (sidebar) mode: two-line row so user@host:port stays visible
        // instead of being clipped by the fixed-width columns (#339).
        if root.compact : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: session.name;
                color: Theme.text-primary;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
            Text {
                text: session.builtin ? session.host
                    : (session.user != "" ? session.user + "@" : "")
                        + (session.port > 0 ? session.host + ":" + session.port : session.host);
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
        if !root.compact : Text {
            text: session.name;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.port > 0 ? session.host + ":" + session.port : session.host;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            width: 180px;
            overflow: elide;
        }
        if !root.compact : Text {
            text: session.user;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    } // card
}
