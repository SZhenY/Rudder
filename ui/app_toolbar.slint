    // 右上角工具条：命令栏 / 输入同步 / 主题 / 快捷命令侧栏 / 传输 / AI 徽标 / 设置。
    // 右边界 = `root.width - root.toolbar-x-off`（右侧面板展开时整体左移）。
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";

export component AppToolbar inherits HorizontalLayout {
    in-out property <bool> show-cmd-bar: false;
    in-out property <bool> sync-input: false;
    in-out property <bool> quick-commands-as-sidebar: false;
    in-out property <bool> download-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> mcp-clients-open: false;
    in-out property <bool> has-active-transfers: false;
    in-out property <bool> lang-en: false;
    in property <int> mcp-client-count: 0;
    in property <bool> in-dock-page: false;

    callback set-show-cmd-bar(bool);
    callback set-sync-input(bool);
    callback toggle-theme();
    callback toggle-quick-sidebar();
        // ⚠️ 关键是**右边界** = `root.width - root.toolbar-x-off`（右侧面板展开时整体左移）。
        // 这里踩过坑：写成 `x: root.toolbar-x-off; width: root.width - root.toolbar-x-off`
        // 会让右边界落到 `x + width == root.width`，于是图标**溢出到右侧状态栏里**。
        // 左边界无关紧要（内容右对齐、盒子无背景、不拦截点击），取 0 即可。
        height: 26px;
        alignment: end;                            // 靠右
        spacing: 4px;
        padding-right: 8px;
        // Docker / 笔记页整页接管内容区，工具栏跟着收起 —— 否则会浮在占位页上
        // 且仍可点。zen-mode 保持既有行为（仍显示）。
        visible: !root.in-dock-page;

        IconButton {
            size: 26px;
            font-family: "Material Icons";
            tint-on-hover: false;
            glyph: "\u{E86F}";   // Material "code" — command bar
            fg: root.show-cmd-bar ? Theme.accent : Theme.text-secondary;
            active: root.show-cmd-bar;
            tooltip: root.lang-en
                ? (root.show-cmd-bar ? "Hide command bar" : "Show command bar")
                : (root.show-cmd-bar ? "隐藏命令栏" : "显示命令栏");
            clicked => { root.show-cmd-bar = !root.show-cmd-bar; root.set-show-cmd-bar(root.show-cmd-bar); }
        }
        IconButton {
            size: 26px;
            font-family: "Material Icons";
            tint-on-hover: false;
            glyph: "\u{E627}";
            fg: root.sync-input ? Theme.accent : Theme.text-secondary;
            active: root.sync-input;
            tooltip: root.lang-en
                ? (root.sync-input ? "Sync input: ON" : "Sync input")
                : (root.sync-input ? "会话同步：开" : "会话同步");
            clicked => { root.sync-input = !root.sync-input; root.set-sync-input(root.sync-input); }
        }
        IconButton {
            size: 26px;
            font-family: "Material Icons";
            tint-on-hover: false;
            glyph: Theme.dark ? "\u{E518}" : "\u{E51C}";
            fg: Theme.dark ? #f5c542 : #5856d6;
            tooltip: root.lang-en ? "Toggle theme" : "切换主题";
            clicked => { root.toggle-theme(); }
        }
        IconButton {
            size: 26px;
            font-family: "Material Icons";
            tint-on-hover: false;
            glyph: "\u{E25D}";   // quick commands
            fg: root.quick-commands-as-sidebar ? Theme.accent : Theme.text-secondary;
            active: root.quick-commands-as-sidebar;
            tooltip: root.lang-en
                ? (root.quick-commands-as-sidebar ? "Hide quick-command sidebar" : "Show quick-command sidebar")
                : (root.quick-commands-as-sidebar ? "隐藏快捷命令侧栏" : "显示快捷命令侧栏");
            clicked => { root.toggle-quick-sidebar(); }
        }
        IconButton {
            size: 26px;
            font-family: "Material Icons";
            tint-on-hover: false;
            glyph: "\u{E5D5}";   // swap_vert — transfer manager (up/down)
            tooltip: root.lang-en ? "Transfers manager" : "传输管理";
            active: root.download-open;
            // Breathe while any transfer is running (driven from Rust).
            breathe: root.has-active-transfers;
            clicked => { root.download-open = !root.download-open; root.settings-open = false; root.mcp-clients-open = false; }
        }
        // AI 接入徽标：设置之外唯一能感知"有 agent 连着"的地方。
        // 包一层做交叉轴居中：26px 的行里放 20px 徽标，不包就贴顶 6px。
        // 包装层 stretch 默认 0、首选宽 40px，右侧齿轮与 8px 边距都不受影响。
        if root.mcp-client-count > 0 : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: Theme.state-selected;
                border-width: 1px;
                border-color: Theme.state-selected-border;
                Text {
                    text: "AI " + root.mcp-client-count;
                    color: Theme.accent;
                    font-size: Theme.fs-xs;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // 点开客户端浮层（不是设置菜单）：这里是"谁连着"的最短路径。
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.mcp-clients-open = !root.mcp-clients-open;
                        root.settings-open = false;
                        root.download-open = false;
                    }
                }
            }
        }
}
