// 终端底部命令栏：快捷命令 chips、命令输入框、历史下拉与右键菜单。
// 弹层的开合、光标索引与「发送到所有会话」由 TerminalView 与这里双向共享。
import { Theme } from "../theme.slint";
import { AnimationSettings } from "../theme.slint";
import { Divider } from "../components/surfaces.slint";
import { IconText } from "../components/text.slint";
import { Label } from "../components/text.slint";
import { QuickCmd } from "../terminal_parts.slint";

export component CommandBar inherits Rectangle {
    // --- 数据 -------------------------------------------------------------
    in property <bool> cmd-bar-hidden: false;
    in property <[QuickCmd]> quick-commands;
    in property <[string]> command-history;
    in property <[string]> history-view;
    in property <[string]> history-preview;
    in property <bool> quick-sidebar-enabled: false;
    in property <bool> quick-panel-docked: false;
    // --- 弹层与输入状态（与 TerminalView 的键盘处理共享）-------------------
    in-out property <bool> quick-open: false;
    in-out property <bool> history-open: false;
    in-out property <bool> history-autocomplete: false;
    in-out property <int> history-cursor: -1;
    in-out property <int> history-selected: 0;
    in-out property <bool> focus-pending: false;
    in-out property <bool> send-to-all: false;
    // 历史搜索框的延迟聚焦标志，只有本组件读写。
    property <bool> history-search-focus-pending: false;
    // --- 事件 -------------------------------------------------------------
    callback run-command(string, bool);
    callback manage-quick-commands();
    callback toggle-quick-group(string);
    callback edit-quick-command(int);
    callback duplicate-quick-command(int);
    callback delete-quick-command(int);
    callback move-quick-command(int, string);
    callback new-quick-group();
    callback rename-quick-group(string);
    callback delete-quick-group(string);
    callback copy-text(string);
    callback delete-history-cmd(string);
    callback search-history(string);
    callback cycle-tab(bool);
    // 发送后要把焦点交还终端（`ime-input` 在 TerminalView 里）。
    callback focus-terminal();

    // 外部（TerminalView 的 quick-external-sequence）直接填充并聚焦输入框。
    public function fill-input(text: string) {
        cmd-input.text = text;
        cmd-input.focus();
    }

    visible: !root.cmd-bar-hidden;
    height: root.cmd-bar-hidden ? 0px : 34px;
    background: Theme.bg-panel-alt;
    border-width: 0;

    // Outside-click backdrop: covers the terminal above so clicking
    // anywhere out of an open popup dismisses it.
    if root.quick-open || root.history-open : TouchArea {
        x: 0; y: -2000px; width: parent.width; height: 2000px;
        clicked => { root.quick-open = false; root.history-open = false; }
    }

    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        padding-top: 4px; padding-bottom: 4px;
        spacing: 6px;

        // Quick-command toggle. Once the right-hand sidebar is enabled,
        // the sidebar/icon strip becomes its only entry point (#215).
        if !root.quick-panel-docked : Rectangle {
            width: qc-row.preferred-width + 16px;
            border-radius: Theme.radius-sm;
            background: qc-ta.has-hover || root.quick-open ? Theme.state-hover : Theme.bg-elevated;
            animate background {
                duration: qc-ta.has-hover || root.quick-open ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: qc-ta.has-hover || root.quick-open ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            qc-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.history-open = false; root.quick-open = !root.quick-open; }
            }
            qc-row := HorizontalLayout {
                width: parent.width; height: parent.height;
                alignment: center;
                spacing: 3px;
                Text { text: @tr("Quick"); color: Theme.text-secondary; font-size: Theme.fs-sm;
                       vertical-alignment: center; }
                IconText { text: "\u{E5CE}";color: Theme.text-muted;
                       font-size: Theme.fs-sm; vertical-alignment: center; }
            }
        }

        // Command input.
        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: cmd-input.has-focus ? Theme.accent : Theme.border-subtle;
            background: Theme.bg-root;
            cmd-input := TextInput {
                input-method-hints: Theme.plain-input-hints;
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                color: Theme.text-primary;
                font-family: Theme.ui-font-family;
                font-size: Theme.fs-md;
                vertical-alignment: center;
                // Preserve pasted newlines. A single-line input rewrites
                // them as spaces and corrupts heredoc terminators before
                // run-command receives the text (#319).
                single-line: false;
                // Enter sends; ↑/↓ recall history.
                accepted => {
                    root.run-command(self.text, root.send-to-all);
                    self.text = "";
                    root.history-open = false;
                    root.history-cursor = -1;
                    root.focus-pending = true;
                }
                edited => {
                    root.history-cursor = -1;
                    root.quick-open = false;
                    root.history-autocomplete = self.text != "";
                    root.search-history(self.text);
                    root.history-open = root.history-autocomplete;
                }
                key-pressed(e) => {
                    if (e.text == Key.Return && !e.modifiers.shift) {
                        root.run-command(self.text, root.send-to-all);
                        self.text = "";
                        root.history-open = false;
                        root.history-cursor = -1;
                        root.focus-pending = true;
                        accept
                    // ⌘R / Ctrl+R opens the searchable history dropdown and
                    // focuses its search box — full keyboard history recall
                    // (#140). Esc closes it / returns to terminal. (The
                    // Ctrl+A/E/K/U line-editing below stays on Ctrl — those
                    // are the standard readline bindings on macOS too.)
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                            && (e.text == Key.Tab || e.text == Key.Backtab)) {
                        root.cycle-tab(e.modifiers.shift || e.text == Key.Backtab);
                        accept
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                            && (e.text == "r" || e.text == "R" || e.text == "\u{0012}")) {
                        root.history-autocomplete = false;
                        root.history-open = true;
                        accept
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                            && (e.text == "a" || e.text == "A" || e.text == "\u{0001}")) {
                        // Select all: a multi-line TextInput has no
                        // built-in select-all, so the shortcut used to
                        // do nothing at all (#416).
                        self.select-all();
                        accept
                    } else if (e.text == Key.Escape) {
                        if (root.history-open) { root.history-open = false; }
                        else { root.focus-terminal(); }   // back to the terminal
                        accept
                    } else if (e.text == Key.UpArrow) {
                        if (root.history-autocomplete && root.history-view.length > 0) {
                            root.history-selected = root.history-selected <= 0
                                ? root.history-view.length - 1
                                : root.history-selected - 1;
                        } else {
                            // Model is oldest→newest (#113): first ↑ jumps
                            // to newest, then steps toward older entries.
                            if (root.command-history.length > 0) {
                                root.history-cursor = root.history-cursor == -1
                                    ? root.command-history.length - 1
                                    : max(root.history-cursor - 1, 0);
                                self.text = root.command-history[root.history-cursor];
                            }
                        }
                        accept
                    } else if (e.text == Key.DownArrow) {
                        if (root.history-autocomplete && root.history-view.length > 0) {
                            root.history-selected = root.history-selected >= root.history-view.length - 1
                                ? 0 : root.history-selected + 1;
                        } else {
                            // ↓ steps toward newer; past newest → live input.
                            if (root.history-cursor != -1) {
                                if (root.history-cursor < root.command-history.length - 1) {
                                    root.history-cursor += 1;
                                    self.text = root.command-history[root.history-cursor];
                                } else {
                                    root.history-cursor = -1;
                                    self.text = "";
                                }
                            }
                        }
                        accept
                    } else if (e.text == Key.Tab && root.history-autocomplete) {
                        if (root.history-view.length > 0
                                && root.history-selected < root.history-view.length) {
                            self.text = root.history-view[root.history-selected];
                            self.set-selection-offsets(1000000, 1000000);
                        }
                        root.history-open = false;
                        accept
                    // --- readline line-editing keys (#103) ---
                    // Ctrl+A → start of line.
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="a" || e.text == "A" || e.text == "\u{0001}")) {
                        self.set-selection-offsets(0, 0);
                        accept
                    // Ctrl+E → end of line.
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="e" || e.text == "E" || e.text == "\u{0005}")) {
                        self.set-selection-offsets(1000000, 1000000);
                        accept
                    // Ctrl+K → kill from cursor to end (deletes + clipboard).
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="k" || e.text == "K" || e.text == "\u{000B}")) {
                        self.set-selection-offsets(self.cursor-position_byte-offset, 1000000);
                        self.cut();
                        accept
                    // Ctrl+U → kill from start to cursor.
                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="u" || e.text == "U" || e.text == "\u{0015}")) {
                        self.set-selection-offsets(0, self.cursor-position_byte-offset);
                        self.cut();
                        accept
                    } else {
                        reject
                    }
                }
            }
            if cmd-input.text == "" : Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: @tr("Type a command, Enter to send");
                color: Theme.text-muted;
                font-size: Theme.fs-md;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }

        // History toggle.
        Rectangle {
            width: 28px;
            border-radius: Theme.radius-sm;
            background: hist-ta.has-hover || root.history-open ? Theme.state-hover : Theme.bg-elevated;
            animate background {
                duration: hist-ta.has-hover || root.history-open ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: hist-ta.has-hover || root.history-open ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            hist-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.quick-open = false;
                    root.history-autocomplete = false;
                    root.history-open = !root.history-open;
                }
            }
            IconText { text: "\u{E5CE}";color: Theme.text-secondary;
                   centered: true;
                   font-size: Theme.fs-md;}
        }

        // Send-to-all toggle.
        Rectangle {
            width: all-row.preferred-width + 14px;
            border-radius: Theme.radius-sm;
            background: root.send-to-all ? Theme.accent
                      : all-ta.has-hover ? Theme.state-hover : Theme.bg-elevated;
            all-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.send-to-all = !root.send-to-all; }
            }
            all-row := HorizontalLayout {
                width: parent.width; height: parent.height;
                alignment: center;
                Text { text: @tr("All sessions"); font-size: Theme.fs-sm; vertical-alignment: center;
                       color: root.send-to-all ? #ffffff : Theme.text-secondary; }
            }
        }

        // Send button.
        Rectangle {
            width: send-row.preferred-width + 18px;
            border-radius: Theme.radius-sm;
            background: send-ta.has-hover ? Theme.accent-hover : Theme.accent;
            animate background {
                duration: send-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: send-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            send-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.run-command(cmd-input.text, root.send-to-all);
                    cmd-input.text = "";
                    root.history-cursor = -1;
                    root.focus-pending = true;
                }
            }
            send-row := HorizontalLayout {
                width: parent.width; height: parent.height;
                alignment: center;
                Text { text: @tr("Send"); color: #ffffff; font-size: Theme.fs-sm;
                       vertical-alignment: center; }
            }
        }
    }

    // --- Quick-command popup (opens upward) --------------------------
    if root.quick-open : Rectangle {
        x: 8px;
        width: 420px;
        height: min(320px, qc-col.preferred-height + 8px);
        y: -self.height - 2px;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-float-blur;
        drop-shadow-color: Theme.shadow-float-color;
        TouchArea {}  // swallow clicks
        Flickable {
            content-width: self.width;
            content-height: max(self.height, qc-col.preferred-height);
            qc-col := VerticalLayout {
                padding: 4px;
                alignment: start;
                if root.quick-commands.length == 0 : Text {
                    text: @tr("No quick commands yet");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    height: 32px; vertical-alignment: center;
                }
                for q in root.quick-commands : VerticalLayout {
                    // Group header on the first row of each group (#55) —
                    // click to collapse/expand the whole group.
                    if q.group-header != "" : Rectangle {
                        height: 24px;
                        property <length> gmx;
                        property <length> gmy;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-quick-group(q.group); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    gmx = self.mouse-x; gmy = self.mouse-y; qpop-grp-menu.show();
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 4px; padding-top: 4px; spacing: 4px;
                            IconText {
                                text: q.collapsed ? "\u{E5CC}" : "\u{E5CF}"; // chevron ▶/▼
                                color: Theme.text-muted; font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                            IconText {
                                text: "\u{E2C7}"; // folder
                                color: Theme.text-muted; font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                            Text {
                                text: q.group; color: Theme.text-muted; font-size: Theme.fs-xs;
                                font-weight: 700; vertical-alignment: center;
                                horizontal-stretch: 1; horizontal-alignment: left;
                            }
                        }
                        qpop-grp-menu := PopupWindow {
                            x: gmx; y: gmy; width: 150px;
                            height: (q.orig-index == -1 ? 3 : 2) * 30px + 9px;
                            Rectangle {
                                background: Theme.bg-panel; border-radius: Theme.radius-sm;
                                border-width: 1px; border-color: Theme.border-strong;
                                drop-shadow-blur: Theme.shadow-menu-blur; drop-shadow-color: Theme.shadow-menu-color;
                                VerticalLayout {
                                    padding: 4px; spacing: 1px;
                                    Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                        background: pg-ren-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pg-ren-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pg-ren-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pg-ren-ta := TouchArea { mouse-cursor: pointer; clicked => { root.rename-quick-group(q.group); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E3C9}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Rename group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    if q.orig-index == -1 : Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                        background: pg-del-ta.has-hover ? #cc333320 : transparent;
                                        animate background {
                                            duration: pg-del-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pg-del-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pg-del-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-quick-group(q.group); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E872}";color: #cc3333; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Delete group"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                        background: pg-new-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pg-new-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pg-new-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pg-new-ta := TouchArea { mouse-cursor: pointer; clicked => { root.new-quick-group(); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E2CC}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                }
                            }
                        }
                    }
                    if !q.collapsed && q.orig-index >= 0 : Rectangle {
                        height: 30px;
                        border-radius: Theme.radius-sm;
                        background: q-item-ta.has-hover ? Theme.state-hover : transparent;
                        animate background {
                            duration: q-item-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                            easing: q-item-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                            enabled: AnimationSettings.enabled;
                        }
                        property <length> ctx-x;
                        property <length> ctx-y;
                        q-item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (q.send-enter) {
                                    // Send + execute (trailing Return).
                                    root.run-command(q.command, root.send-to-all);
                                    root.focus-pending = true;
                                } else {
                                    // Only fill the input box so it can be
                                    // tweaked before sending (B站 suggestion).
                                    cmd-input.text = q.command;
                                    cmd-input.focus();
                                }
                                root.quick-open = false;
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    ctx-x = self.mouse-x; ctx-y = self.mouse-y; qpop-ctx-menu.show();
                                }
                            }
                        }
                        // Name + command on one line; each elides so a long
                        // entry never overflows the popup (#55).
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 10px;
                            Text { text: q.name; color: Theme.text-primary; font-size: Theme.fs-sm;
                                   vertical-alignment: center; overflow: elide;
                                   horizontal-stretch: 1; }
                            Label { text: q.command-preview; color: Theme.text-muted; font-size: Theme.fs-xs;
                                   vertical-alignment: center; overflow: elide;
                                   horizontal-alignment: right; horizontal-stretch: 1;
}
                        }
                        qpop-ctx-menu := PopupWindow {
                            x: ctx-x; y: ctx-y; width: 160px;
                            height: qpop-ctx-vl.preferred-height;
                            Rectangle {
                                background: Theme.bg-panel; border-radius: Theme.radius-sm;
                                border-width: 1px; border-color: Theme.border-strong;
                                drop-shadow-blur: Theme.shadow-menu-blur; drop-shadow-color: Theme.shadow-menu-color;
                                qpop-ctx-vl := VerticalLayout {
                                    padding: 4px; spacing: 1px;
                                    Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                        background: pi-edit-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pi-edit-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pi-edit-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pi-edit-ta := TouchArea { mouse-cursor: pointer; clicked => { root.quick-open = false; root.edit-quick-command(q.orig-index); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E3C9}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                        background: pi-dup-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pi-dup-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pi-dup-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pi-dup-ta := TouchArea { mouse-cursor: pointer; clicked => { root.duplicate-quick-command(q.orig-index); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E14D}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                        background: pi-del-ta.has-hover ? #cc333320 : transparent;
                                        animate background {
                                            duration: pi-del-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pi-del-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pi-del-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-quick-command(q.orig-index); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E872}";color: #cc3333; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    Divider {}
                                    HorizontalLayout { padding-left: 10px; padding-top: 2px; spacing: 6px;
                                        IconText { text: "\u{E2C7}";color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; }
                                        Text { text: @tr("Move to"); color: Theme.text-muted; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; } }
                                    if q.group != "default" : Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                        background: pi-md-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pi-md-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pi-md-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pi-md-ta := TouchArea { mouse-cursor: pointer; clicked => { root.move-quick-command(q.orig-index, "default"); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E2C7}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: @tr("Default"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                    for s in root.quick-commands : Rectangle {
                                        visible: s.group-header != "" && s.group != "default" && s.group != q.group;
                                        height: self.visible ? 28px : 0px;
                                        border-radius: Theme.radius-sm;
                                        background: pi-mv-ta.has-hover ? Theme.state-hover : transparent;
                                        animate background {
                                            duration: pi-mv-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                            easing: pi-mv-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                            enabled: AnimationSettings.enabled;
                                        }
                                        pi-mv-ta := TouchArea { mouse-cursor: pointer; clicked => { root.move-quick-command(q.orig-index, s.group); } }
                                        HorizontalLayout { padding-left: 10px; spacing: 8px;
                                            IconText { text: "\u{E2C7}";color: Theme.text-secondary; font-size: Theme.fs-sm; vertical-alignment: center; }
                                            Text { text: s.group; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } } }
                                }
                            }
                        }
                    }
                }
                // Manage entry.
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 2px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-sm;
                            background: mng-ta.has-hover ? Theme.state-hover : transparent;
                            animate background {
                                duration: mng-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: mng-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            mng-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.quick-open = false; root.manage-quick-commands(); }
                            }
                            Text { text: @tr("Manage…"); color: Theme.accent; font-size: Theme.fs-sm;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if root.quick-sidebar-enabled : Rectangle {
                            width: 34px;
                            border-radius: Theme.radius-sm;
                            background: quick-grip.has-hover ? Theme.state-hover : transparent;
                            animate background {
                                duration: quick-grip.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: quick-grip.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            quick-grip := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.quick-open = false; }
                            }
                            IconText {
                                centered: true;
                                text: "\u{E25D}";
                                color: Theme.text-secondary; font-size: Theme.fs-md;

                            }
                        }
                    }
                }
            }
        }
    }

    // --- History popup (opens upward) -------------------------------
    if root.history-open : Rectangle {
        x: parent.width - 308px;
        width: 300px;
        height: root.history-autocomplete
            ? min(180px, max(36px, h-col.preferred-height + 8px))
            : min(296px, 46px + max(28px, min(228px, h-col.preferred-height + 8px)));
        y: -self.height - 2px;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-float-blur;
        drop-shadow-color: Theme.shadow-float-color;
        TouchArea {}
        VerticalLayout {
            padding: 4px;
            spacing: 4px;
            // History list fills the popup; the search box is pinned at the
            // bottom (next to the command input) so it stays in a fixed,
            // easy-to-find spot no matter how tall the list is (#131).
            Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, h-col.preferred-height);
            h-col := VerticalLayout {
                padding: 4px;
                alignment: start;
                if root.history-view.length == 0 : Text {
                    text: root.command-history.length == 0 ? @tr("No history yet") : @tr("No match");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    height: 32px; vertical-alignment: center;
                }
                for h[idx] in root.history-view : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: idx == root.history-selected ? Theme.state-selected
                              : (h-item-ta.has-hover ? Theme.state-hover : transparent);
                    // Row body click recalls the command into the input box.
                    h-item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            cmd-input.text = h;
                            root.history-open = false;
                            cmd-input.focus();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 4px; spacing: 1px;
                        Label {
                            // 多行历史条目只显示压缩后的单行预览（固定 28px 行高，
                            // 直接渲染多行会溢出到相邻行）；`h` 仍是原始字符串，
                            // 回填 / ▶ / 复制都继续用它（上游 9725617）。
                            text: idx < root.history-preview.length ? root.history-preview[idx] : h;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        // Run (▶) — execute immediately, on this tab.
                        Rectangle {
                            width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: hrun.has-hover ? Theme.accent.with-alpha(0.25) : transparent;
                            animate background {
                                duration: hrun.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: hrun.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            hrun := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.run-command(h, root.send-to-all);
                                    root.history-open = false;
                                    root.focus-pending = true;
                                }
                            }
                            IconText { text: "\u{E037}";
                                   centered: true;
                                   color: Theme.accent; font-size: Theme.fs-md;
}
                        }
                        // Copy (⧉) — to clipboard, keep the popup open.
                        Rectangle {
                            width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: hcopy.has-hover ? Theme.bg-elevated : transparent;
                            animate background {
                                duration: hcopy.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: hcopy.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            hcopy := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.copy-text(h); }
                            }
                            IconText { text: "\u{E14D}";
                                   centered: true;
                                   color: Theme.text-secondary; font-size: Theme.fs-sm;
}
                        }
                        // Delete (×) — remove this entry.
                        Rectangle {
                            width: 24px; y: (parent.height - self.height) / 2; height: 24px;
                            border-radius: Theme.radius-sm;
                            background: hdel.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                            animate background {
                                duration: hdel.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: hdel.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            hdel := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.delete-history-cmd(h); }
                            }
                            IconText { text: "\u{E872}";
                                   centered: true;
                                   color: Theme.danger; font-size: Theme.fs-sm;
}
                        }
                    }
                }
            }
            }
            // Search box (#101) pinned at the bottom, right above the
            // command input, so it stays in a fixed, easy-to-find spot no
            // matter how tall the list is — like FinalShell (#131).
            if !root.history-autocomplete : Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: Theme.bg-root;
                border-width: 1px;
                border-color: hist-search.has-focus ? Theme.accent : Theme.border-subtle;
                // Defer focus to the next event-loop tick (see init below).
                Timer {
                    interval: 0ms;
                    running: root.history-search-focus-pending;
                    triggered => {
                        root.history-search-focus-pending = false;
                        if (root.history-open) { hist-search.focus(); }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 4px;
                    IconText { text: "\u{E8B6}";
                           color: Theme.text-muted; font-size: Theme.fs-sm;
                           vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        hist-search := TextInput {
                            input-method-hints: Theme.plain-input-hints;
                            width: 100%; height: 100%;
                            vertical-alignment: center;
                            color: Theme.text-primary;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-sm;
                            single-line: true;
                            // Auto-focus so Ctrl+R lands you typing (#140).
                            // Defer to the next event-loop tick: focusing
                            // synchronously while the popup's first layout
                            // pass is still running re-enters the Windows
                            // IME/accessibility plumbing and reads the
                            // half-built layout, panicking with "Recursion
                            // detected" (#349 / #343).
                            init => { root.history-search-focus-pending = true; }
                            edited => { root.search-history(self.text); root.history-selected = 0; }
                            // ↑/↓ move the selection, Enter runs it, Esc
                            // closes and returns focus to the terminal (#140).
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.history-open = false;
                                    root.focus-terminal();
                                    accept
                                } else if (e.text == Key.UpArrow) {
                                    if (root.history-view.length > 0) {
                                        root.history-selected = root.history-selected <= 0
                                            ? root.history-view.length - 1
                                            : root.history-selected - 1;
                                    }
                                    accept
                                } else if (e.text == Key.DownArrow) {
                                    if (root.history-view.length > 0) {
                                        root.history-selected = root.history-selected >= root.history-view.length - 1
                                            ? 0
                                            : root.history-selected + 1;
                                    }
                                    accept
                                } else if (e.text == Key.Return) {
                                    if (root.history-view.length > 0
                                            && root.history-selected < root.history-view.length) {
                                        root.run-command(root.history-view[root.history-selected], root.send-to-all);
                                        root.history-open = false;
                                        root.focus-pending = true;
                                    }
                                    accept
                                } else {
                                    reject   // let typing filter the list
                                }
                            }
                        }
                        if hist-search.text == "" : Text {
                            text: @tr("Search history");
                            color: Theme.text-muted; font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
