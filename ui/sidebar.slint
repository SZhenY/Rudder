// 资源 / 状态侧栏。
//
// A 路线改造：外层接口（属性与回调）**一个都没动**，所以 sidebar_body.slint、
// app.slint 与 Rust 侧都不用改。里面去掉了两块停靠包袱：
//   * 面板空白处"拖动换停靠位置"的 TouchArea —— 新设计没有停靠了
//   * 停靠 top/bottom 时的横向排版变体 —— 同上（lay-horizontal 属性保留，暂不使用）
// 并加上新设计的标签条：综合 / 资源 / 网络 / 磁盘 / 进程。

import { Theme } from "theme.slint";
import { Divider } from "components/surfaces.slint";
import {
    DiskBlock,
    DiskInfo,
    NetBlock,
    StatsBlock,
    StatusBlock,
} from "sidebar_blocks.slint";

export { DiskInfo }

export component Sidebar inherits Rectangle {
    in property <string> connection-state: @tr("Not connected");
    in property <bool> system-info-available; // connected Linux session only (#268)
    in property <string> conn-host;                  // clean IP/host to copy (#192)
    in property <int> conn-state;                    // 0 gray / 1 green / 2 yellow
    in property <string> resource-title: @tr("Local resources");
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    in property <[DiskInfo]> disks;
    in property <bool> proc-available;   // a live remote session → show the process button
    in property <string> app-version;

    callback select-net-iface(string);
    callback show-system-info();         // open the system-information window
    callback show-processes();           // open the process monitor popup (#23)
    callback copy-host(string);          // copy the connection IP/host to clipboard (#192)
    callback toggle-collapse();
    // 旧停靠遗留：新设计不再拖动换边，这些回调与下面两个属性在收尾时一起删。
    callback dock-drag-move(length /* abs-x */, length /* abs-y */);
    callback dock-drag-end();
    in property <bool> lay-horizontal;
    in property <string> dock-edge;

    // 0 综合 · 1 资源 · 2 网络 · 3 磁盘 · 4 进程
    in-out property <int> tab: 0;

    // 尺寸由实例化处给出（app.slint 用 parent.width/height）—— 不要在这里写死，
    // 那会是一条永远被覆盖的死绑定。
    background: Theme.bg-panel;
    border-width: 0;

    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        background: Theme.bg-panel;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-subtle;
        clip: true;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // ── 标签条 ──
            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                for t in [
                    { id: 0, label: "综合" },
                    { id: 1, label: "资源" },
                    { id: 2, label: "网络" },
                    { id: 3, label: "磁盘" },
                    { id: 4, label: "进程" },
                ] : Rectangle {
                    height: 26px;
                    width: 52px;
                    border-radius: 6px;
                    background: root.tab == t.id ? Theme.rail-item-active
                        : (tab-ta.has-hover ? Theme.rail-item-hover : transparent);

                    Text {
                        text: t.label;
                        font-size: 11px;
                        color: root.tab == t.id ? Theme.rail-fg-active : Theme.rail-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    tab-ta := TouchArea {
                        clicked => {
                            root.tab = t.id;
                        }
                    }
                }
            }

            Divider {}

            if root.tab == 0 : StatusBlock {
                conn-state: root.conn-state;
                connection-state: root.connection-state;
                conn-host: root.conn-host;
                collapse() => { root.toggle-collapse(); }
                copy-host(h) => { root.copy-host(h); }
            }

            if root.tab == 0 || root.tab == 1 : StatsBlock {
                resource-title: root.resource-title;
                system-info-available: root.system-info-available;
                proc-available: root.proc-available;
                cpu-percent: root.cpu-percent; mem-percent: root.mem-percent; swap-percent: root.swap-percent;
                mem-detail: root.mem-detail; swap-detail: root.swap-detail;
                show-system-info() => { root.show-system-info(); }
                show-processes() => { root.show-processes(); }
            }

            if root.tab == 0 : Divider {}

            if root.tab == 0 || root.tab == 2 : NetBlock {
                net-top-up: root.net-top-up; net-top-down: root.net-top-down; net-top-history: root.net-top-history;
                net-show-selector: root.net-show-selector; net-ifaces: root.net-ifaces; net-selected: root.net-selected;
                net-bot-up: root.net-bot-up; net-bot-down: root.net-bot-down; net-bot-history: root.net-bot-history;
                select-net-iface(i) => { root.select-net-iface(i); }
            }

            if root.tab == 0 : Divider {}

            if root.tab == 0 || root.tab == 3 : DiskBlock {
                vertical-stretch: 1;
                disks: root.disks;
            }

            // 进程：进程表格现在还是独立弹窗（proc_window.slint），这里先给入口，
            // 等把那张表抽成组件再直接嵌进来。
            if root.tab == 4 : VerticalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 120px;
                    height: 32px;
                    border-radius: 8px;
                    background: proc-ta.has-hover ? Theme.rail-item-active : Theme.rail-item-hover;

                    Text {
                        text: "打开进程管理";
                        font-size: 12px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    proc-ta := TouchArea {
                        clicked => {
                            root.show-processes();
                        }
                    }
                }

                Text {
                    text: "（进程表格还在独立窗口里，下一步抽成组件嵌到这里）";
                    font-size: 11px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "Rudder v" + root.app-version;
                color: Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: center;
            }
        }
    }
}
