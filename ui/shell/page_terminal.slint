// 终端页「无会话」空状态（居中一张卡片：标题 + 副标题 + 能力徽标 + 三张子卡）。
//
// 结构：居中一张带边框的卡片 —— 标题 + 副标题；三张子卡（本地终端 /
// 远程·串口）各带**动作按钮**；下方「最近连接」行（图标 + 名称 +
// user@host + →）。会话态（真正的终端画面）嵌现有终端核心，另行接线。

import { Theme } from "../theme.slint";
import { SessionInfo } from "../session_types.slint";

component MiniBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    background: root.primary
        ? Theme.accent
        : (ta.has-hover ? Theme.sur-3 : Theme.sur-2);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 11px * Theme.ui-scale;
            color: root.primary ? #ffffff : Theme.fg-1;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 右上角的能力徽标（本地与远程支持 / 多标签与分屏）。
component Chip inherits Rectangle {
    in property <string> text;

    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 10px * Theme.ui-scale;
            color: Theme.fg-3;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
    }
}

component SubCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    horizontal-stretch: 1;

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-1;

    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 13px * Theme.ui-scale;
            font-weight: 600;
            color: Theme.fg-1;
            overflow: elide;
        }
        Text {
            text: root.desc;
            font-size: 11px * Theme.ui-scale;
            color: Theme.fg-3;
            wrap: word-wrap;
            min-height: 30px;
        }
        // 按钮区由实例化的地方填充
        @children
    }
}

export component PageTerminal inherits Rectangle {
    in property <bool> lang-en: false;
    in property <[SessionInfo]> sessions;
    /// 还没有任何真实会话（只有欢迎标签）→ 标题用「创建你的第一个…」；
    /// 否则用「新建…」。用户点了 `+` 之后再说「第一个」就不对了。
    in property <bool> first-run: true;
    // 本地终端：直接起本地默认 shell 的会话（本地 shell 不再做成主机卡片，
  // 入口只有这里 —— 终端-无会话.png）。
    callback new-local-session();
    // 串口 / 自定义：这些要选参数，仍然走「新建主机」对话框。
    callback connect-session(string /* id；空串 = 去主机管理页新建 */);
    /// 打开「新建主机」对话框（要填地址 / 密钥那种），与「串口」同一条路径。
    /// 去主机管理页挑一台**已保存**的主机（那边列表更全，也能改端口 / 密钥）。
    callback browse-hosts();
    /// 串口这类要挑参数的入口（终端舞台内部那张卡片在用）。
    callback custom-session();
    callback pick-host();

    // 底色由外层页面容器提供（`Theme.bg-root` 磨砂，见 app_shell）：这里透明，
    // 否则两层磨砂叠加，本页会比别的页面更暗。
    background: transparent;

  // 居中的一张卡片（不铺满、四周留白）
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: min(parent.width - 48px, 620px);
                height: card.preferred-height; // 由内容决定
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.sur-1;

                card := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;

  // ── 标题 + 副标题 + 能力徽标（右上角两枚）──────
                    HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            alignment: start;

                            Text {
                                text: root.first-run
                                    ? (root.lang-en
                                        ? "Create your first terminal session"
                                        : "创建你的第一个终端会话")
                                    : (root.lang-en
                                        ? "New terminal session"
                                        : "新建终端会话");
                                font-size: 16px * Theme.ui-scale;
                                font-weight: 700;
                                color: Theme.fg-1;
                            }
                            Text {
                                text: root.lang-en ? "Local, SSH and serial — sessions persist" : "支持本地、SSH 与串口，会话可持久保存";
                                font-size: 11px * Theme.ui-scale;
                                color: Theme.fg-3;
                            }
                        }

                        // 窄窗时收起徽标，别把标题挤没了
                        if card.width > 520px : HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            Chip { text: root.lang-en ? "Local & remote" : "本地与远程支持"; }
                            Chip { text: root.lang-en ? "Tabs & splits" : "多标签与分屏"; }
                        }
                    }

                    // ── 三张子卡 ────────────────────────────────
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: stretch;

                        SubCard {
                            title: root.lang-en ? "Local Terminal (default)" : "本地终端（默认）";
                            desc: root.lang-en ? "Uses the default shell from settings" : "使用设置中的默认 shell（未设置则用系统自动选择）";

                            MiniBtn {
                                text: root.lang-en ? "New Local Terminal" : "新建本地终端";
                                primary: true;
                                clicked => {
                                    root.new-local-session();
                                }
                            }
                        }
                        SubCard {
                            title: root.lang-en ? "Remote / Serial" : "远程/串口会话";
                            desc: root.lang-en
                                ? "Connect a saved host, or add a new one"
                                : "连接已保存的主机，或新建一台";

                            HorizontalLayout {
                                spacing: 6px;

                                MiniBtn {
                                    text: root.lang-en ? "Saved Hosts"
                                        : "选择主机";
                                    primary: true;
                                    clicked => {
                                        // 挑一台**已保存**的主机连上（主机管理页那边
                                        // 列表更全，还能改端口 / 密钥）。
                                        root.browse-hosts();
                                    }
                                }
                                MiniBtn {
                                    text: root.lang-en ? "New Host"
                                        : "创建会话";
                                    clicked => {
                                        // 新建一台（SSH / 串口 / 远程）并连接。
                                        root.pick-host();
                                    }
                                }
                            }
                        }
                    }

                    // ── 最近连接 ────────────────────────────────
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "\u{E8B5}"; // schedule
                            font-family: "Material Icons";
                            font-size: 13px * Theme.ui-scale;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lang-en ? "Recent Connections" : "最近连接";
                            font-size: 12px * Theme.ui-scale;
                            color: Theme.fg-2;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.sessions.length > 0 : Text {
                            text: "\{root.sessions.length}";
                            font-size: 10px * Theme.ui-scale;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                        }
                    }

                    if root.sessions.length == 0 : Text {
                        text: root.lang-en ? "No history yet — pick a way above to start" : "还没有连接记录 —— 上面挑一种方式开始";
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.fg-3;
                    }

                    if root.sessions.length > 0 : VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for s in root.sessions : Rectangle {
                            height: 42px;
                            border-radius: 8px;
                            // 描边 + 悬浮高亮，和上面的子卡同一套语言。此前只有
                            // 填充色，行与行糊在一起看不出边界。
                            border-width: 1px;
                            border-color: row-ta.has-hover
                                ? Theme.accent.with-alpha(0.35) : Theme.line;
                            background: row-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                            // 行 TouchArea 先声明（画在下层），行内没有别的可点件，
                            // 这里先声明纯粹是保持"整行可点"的既有语义。
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.connect-session(s.id);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;
                                // ⚠ 必须显式跨轴居中：26px 的图标方块放在 42px 的行里，
                                // 跨轴对齐默认 `auto` → `stretch` → **贴顶**（用户报"图标
                                // 没有上下居中"）。
                                cross-axis-alignment: center;

                                // 终端图标（方块底）
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 7px;
                                    background: Theme.sur-3;

                                    Text {
                                        text: "\u{EB8E}"; // terminal
                                        font-family: "Material Icons";
                                        font-size: 14px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                        // ⚠ 必须撑满方块：Text 在普通 Rectangle 里（非布局）
                                        // 尺寸就是文字本身，不写宽高时下面的 center
                                        // **没有参照物**（自己居中自己），字会按左上角画。
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: s.name;
                                        font-size: 12px * Theme.ui-scale;
                                        color: Theme.fg-1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: s.user != ""
                                            ? "\{s.user}@\{s.host}"
                                            : s.host;
                                        font-size: 10px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                        overflow: elide;
                                    }
                                }
                                // 上次使用时间（`last-used`：ISO 时间戳或 "never"）
                                if s.last-used != "" && s.last-used != "never" : Text {
                                    text: s.last-used;
                                    font-size: 10px * Theme.ui-scale;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
