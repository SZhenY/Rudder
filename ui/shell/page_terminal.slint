// 终端页「无会话」空状态（按 ex/终端-无会话.png 逐项对齐）。
//
// 参考图结构：居中一张带边框的卡片 —— 标题 + 副标题；三张子卡（本地终端 /
// 选择本地壳 / 远程·串口）各带**动作按钮**；下方「最近连接」行（图标 + 名称 +
// user@host + →）。会话态（真正的终端画面）嵌现有终端核心，另行接线。

import { Theme } from "../theme.slint";
import { SessionInfo } from "../welcome_rows.slint";

component MiniBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    height: 26px;
    border-radius: 6px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    background: root.primary
        ? Theme.accent
        : (ta.has-hover ? Theme.sur-3 : Theme.sur-2);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 11px;
            color: root.primary ? #ffffff : Theme.fg-1;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SubCard inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    horizontal-stretch: 1;

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-1;

    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Theme.fg-1;
        }
        Text {
            text: root.desc;
            font-size: 11px;
            color: Theme.fg-3;
            wrap: word-wrap;
            min-height: 30px;
        }
        // 按钮区由实例化的地方填充
        @children
    }
}

export component PageTerminal inherits Rectangle {
    in property <bool> lang-en: false;
    in property <[SessionInfo]> sessions;
    callback new-local-session();
    callback connect-session(string /* id；空串 = 去主机管理页新建 */);

    background: Theme.bg-root;

    // 居中的一张卡片（参考图：不铺满、四周留白）
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: min(parent.width - 48px, 620px);
                height: card.preferred-height; // 由内容决定
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.sur-1;

                card := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;

                    // ── 标题 + 副标题 ─────────────────────────────
                    VerticalLayout {
                        spacing: 3px;
                        alignment: start;

                        Text {
                            text: root.lang-en ? "Create your first terminal session" : "创建你的第一个终端会话";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.fg-1;
                        }
                        Text {
                            text: root.lang-en ? "Local, SSH and serial — sessions persist" : "支持本地、SSH 与串口，会话可持久保存";
                            font-size: 11px;
                            color: Theme.fg-3;
                        }
                    }

                    // ── 三张子卡 ────────────────────────────────
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: stretch;

                        SubCard {
                            title: root.lang-en ? "Local Terminal (default)" : "本地终端（默认）";
                            desc: root.lang-en ? "Uses the default shell from settings" : "使用设置中的默认 shell（未设置则用系统自动选择）";

                            MiniBtn {
                                text: root.lang-en ? "New Local Terminal" : "新建本地终端";
                                primary: true;
                                clicked => {
                                    root.new-local-session();
                                }
                            }
                        }
                        SubCard {
                            title: root.lang-en ? "Pick a Local Shell" : "选择本地壳";
                            desc: root.lang-en ? "Start a session from common shells" : "从常用列表中选择并立即启动一个会话";

                            HorizontalLayout {
                                spacing: 6px;

                                MiniBtn {
                                    text: "/bin/zsh";
                                    clicked => {
                                        root.new-local-session();
                                    }
                                }
                                MiniBtn {
                                    text: "/bin/bash";
                                    clicked => {
                                        root.new-local-session();
                                    }
                                }
                            }
                        }
                        SubCard {
                            title: root.lang-en ? "Remote / Serial" : "远程/串口会话";
                            desc: root.lang-en ? "Pick a host to create an SSH or serial session" : "从主机列表中选择目标机，快速创建 SSH 或串口";

                            HorizontalLayout {
                                spacing: 6px;

                                MiniBtn {
                                    text: root.lang-en ? "Pick Host & Create" : "选择主机并创建会话";
                                    primary: true;
                                    clicked => {
                                        root.connect-session("");
                                    }
                                }
                                MiniBtn {
                                    text: root.lang-en ? "Serial" : "串口";
                                    clicked => {
                                        root.new-local-session();
                                    }
                                }
                            }
                        }
                    }

                    // ── 最近连接 ────────────────────────────────
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "\u{E8B6}"; // schedule/search-ish clock
                            font-family: "Material Icons";
                            font-size: 13px;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lang-en ? "Recent Connections" : "最近连接";
                            font-size: 12px;
                            color: Theme.fg-2;
                            vertical-alignment: center;
                        }
                    }

                    if root.sessions.length == 0 : Text {
                        text: root.lang-en ? "No history yet — pick a way above to start" : "还没有连接记录 —— 上面挑一种方式开始";
                        font-size: 11px;
                        color: Theme.fg-3;
                    }

                    if root.sessions.length > 0 : VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for s in root.sessions : Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: row-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                Text {
                                    width: 16px;
                                    text: "\u{EB8E}"; // terminal
                                    font-family: "Material Icons";
                                    font-size: 13px;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: s.name;
                                        font-size: 12px;
                                        color: Theme.fg-1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: s.user != ""
                                            ? "\{s.user}@\{s.host}"
                                            : s.host;
                                        font-size: 10px;
                                        color: Theme.fg-3;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: "\u{E5CC}"; // chevron_right
                                    font-family: "Material Icons";
                                    font-size: 15px;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                }
                            }

                            row-ta := TouchArea {
                                clicked => {
                                    root.connect-session(s.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
