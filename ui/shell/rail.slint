// 左侧栏（新界面）。固定宽度、可收起：
//   展开 180px（图标 + 文字）· 收起 64px（只留图标，且顶部只留展开按钮）
//
// 收起态刻意只放一个按钮：早先收起时"搜索 + 折叠"两个按钮挤在一起，44px 的宽度
// 直接把折叠按钮裁掉了，收起之后就再也展不开 —— 现在收起态只剩展开按钮。

import { Theme } from "../theme.slint";

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked();

    height: 44px;
    border-radius: 8px;
    background: root.active
        ? Theme.rail-item-active
        : (ta.has-hover ? Theme.rail-item-hover : transparent);

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 16px;
        padding-right: root.collapsed ? 0px : 12px;
        spacing: 14px;
        alignment: root.collapsed ? center : start;

        Text {
            width: 24px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 22px;
            color: root.active ? Theme.rail-fg-active : Theme.rail-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.collapsed : Text {
            text: root.label;
            font-size: 13px;
            color: root.active ? Theme.rail-fg-active : Theme.rail-fg;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Rail inherits Rectangle {
    // 0 主机 · 1 终端 · 2 指令集 · 3 Docker · 4 设置
    in-out property <int> current-page: 1;
    in-out property <bool> collapsed: false;
    callback page-changed(int);
    callback search-requested();

    width: root.collapsed ? 64px : 180px;
    background: Theme.rail-bg;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        // 顶部：收起态只留展开按钮；展开态是「搜索 + 折叠」——两者**各有自己的热区**，
        // 否则整行被搜索的 TouchArea 吃掉，折叠按钮点了只会触发搜索。
        if !root.collapsed : HorizontalLayout {
            height: 40px;
            spacing: 4px;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                background: search-ta.has-hover ? Theme.rail-item-hover : transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: "\u{E8B6}"; // search
                        font-family: "Material Icons";
                        font-size: 18px;
                        color: Theme.rail-fg;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "搜索";
                        font-size: 12px;
                        color: Theme.rail-fg;
                        vertical-alignment: center;
                    }
                }

                search-ta := TouchArea {
                    clicked => {
                        root.search-requested();
                    }
                }
            }

            Rectangle {
                width: 32px;
                border-radius: 8px;
                background: collapse-ta.has-hover ? Theme.rail-item-hover : transparent;

                Text {
                    text: "\u{E5CB}"; // chevron_left
                    font-family: "Material Icons";
                    font-size: 20px;
                    color: Theme.rail-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                collapse-ta := TouchArea {
                    clicked => {
                        root.collapsed = true;
                    }
                }
            }
        }

        if root.collapsed : Rectangle {
            height: 40px;
            border-radius: 8px;
            background: expand-ta.has-hover ? Theme.rail-item-hover : transparent;

            Text {
                text: "\u{E5CC}"; // chevron_right
                font-family: "Material Icons";
                font-size: 20px;
                color: Theme.rail-fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expand-ta := TouchArea {
                clicked => {
                    root.collapsed = false;
                }
            }
        }

        RailButton {
            glyph: "\u{E875}"; // dns
            label: "主机";
            active: root.current-page == 0;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(0);
            }
        }
        RailButton {
            glyph: "\u{EB8E}"; // terminal
            label: "终端";
            active: root.current-page == 1;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(1);
            }
        }
        RailButton {
            glyph: "\u{E86F}"; // code
            label: "指令集";
            active: root.current-page == 2;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(2);
            }
        }
        RailButton {
            glyph: "\u{E30C}"; // computer
            label: "Docker";
            active: root.current-page == 3;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(3);
            }
        }

        // 占位：把「设置」顶到底部
        Rectangle {
            vertical-stretch: 1;
        }

        RailButton {
            glyph: "\u{E8B8}"; // settings
            label: "设置";
            active: root.current-page == 4;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(4);
            }
        }
    }
}
