// 左侧栏（按参考设计：iShell Pro 那套）。
//
// 展开 180px（图标 + 文字）· 收起 56px（只留图标，顶部只留展开按钮）。
// 选中项做成"加粗填充药丸"（accent 淡底 + 主色文字），与参考图一致；
// 图标用项目里既有的 Material Icons 字体。

import { Theme } from "../theme.slint";

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked();

    height: 38px;
    border-radius: Theme.r-md;
    background: root.active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.sur-3 : transparent);

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : Theme.sp-3;
        padding-right: root.collapsed ? 0px : Theme.sp-2;
        spacing: Theme.sp-3;
        alignment: root.collapsed ? center : start;

        Text {
            width: 20px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: root.active ? Theme.accent : Theme.fg-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.collapsed : Text {
            text: root.label;
            font-size: 13px;
            color: root.active ? Theme.accent : Theme.fg-1;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Rail inherits Rectangle {
    // 0 主机 · 1 终端 · 2 指令集 · 3 Docker · 4 设置
    in-out property <int> current-page: 1;
    in-out property <bool> collapsed: false;
    callback page-changed(int);
    callback search-requested();

    width: root.collapsed ? 56px : 180px;
    background: Theme.sur-1;

    VerticalLayout {
        padding: Theme.sp-2;
        spacing: Theme.sp-1;
        alignment: start;

        // 顶部：展开态是「搜索框 + 折叠」；收起态只留展开按钮（否则窄宽度下会被裁掉）
        if !root.collapsed : HorizontalLayout {
            height: 34px;
            spacing: Theme.sp-1;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.r-md;
                background: Theme.sur-3;

                HorizontalLayout {
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-2;
                    alignment: center;

                    Text {
                        width: 16px;
                        text: "\u{E8B6}"; // search
                        font-family: "Material Icons";
                        font-size: 15px;
                        color: Theme.fg-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 18px;

                        Text {
                            visible: search-input.text == "";
                            width: 100%;
                            height: 100%;
                            text: "搜索主机、设置…";
                            font-size: 12px;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            font-size: 12px;
                            color: Theme.fg-1;
                            single-line: true;
                            accepted => {
                                root.search-requested();
                            }
                        }
                    }
                }

                search-ta := TouchArea {
                    clicked => {
                        root.search-requested();
                    }
                }
            }

            Rectangle {
                width: 26px;
                border-radius: Theme.r-md;
                background: collapse-ta.has-hover ? Theme.sur-3 : transparent;

                Text {
                    text: "\u{E5CB}"; // chevron_left
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                collapse-ta := TouchArea {
                    clicked => {
                        root.collapsed = true;
                    }
                }
            }
        }

        if root.collapsed : Rectangle {
            height: 34px;
            border-radius: Theme.r-md;
            background: expand-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E5CC}"; // chevron_right
                font-family: "Material Icons";
                font-size: 18px;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expand-ta := TouchArea {
                clicked => {
                    root.collapsed = false;
                }
            }
        }

        RailButton {
            glyph: "\u{E875}"; // dns
            label: "主机";
            active: root.current-page == 0;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(0);
            }
        }
        RailButton {
            glyph: "\u{EB8E}"; // terminal
            label: "终端";
            active: root.current-page == 1;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(1);
            }
        }
        RailButton {
            glyph: "\u{E86F}"; // code
            label: "指令集";
            active: root.current-page == 2;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(2);
            }
        }
        RailButton {
            glyph: "\u{E30C}"; // computer
            label: "Docker";
            active: root.current-page == 3;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(3);
            }
        }

        // 占位：把「设置」顶到底部
        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        RailButton {
            glyph: "\u{E8B8}"; // settings
            label: "设置";
            active: root.current-page == 4;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(4);
            }
        }
    }
}
