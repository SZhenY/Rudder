// 左侧栏（按界面稿的版式：大图标 + 选中药丸 + 底部设置入口）。
//
// 展开 180px（图标 + 文字）· 收起 56px（只留图标，顶部只留展开按钮）。
// 选中项做成"加粗填充药丸"（accent 淡底 + 主色文字），与整体设计一致；
// 图标用项目里既有的 Material Icons 字体。

import { Theme, AnimationSettings } from "../theme.slint";

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    // 行宽由 Rail 显式传入（跟着侧栏宽度动画走）。**不能靠布局分配** ——
    // 父级宽度动画期间布局重算滞后，高亮会等侧栏折完才开始收缩。
    in property <length> row-w: 164px;
    callback clicked();

    height: 38px;
    // 收起时把超宽内容（标签）裁掉，而不是让它压扁
    clip: true;

    // 交互态底色：画成**显式宽度**的子元素（width 绑 `row-w`），与侧栏动画同轴。
    // 交互态三件套：hover = 主题色细环 @40%（中性底不变）；按下 = 主题色 @12%
    // 确认底；选中 = accent 淡底药丸（accent-soft）+ 主色文字，环让位给选中底。
    Rectangle {
        x: 0;
        y: 0;
        width: root.row-w;
        height: parent.height;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: !root.active && ta.has-hover ? Theme.accent-ring : transparent;
        background: root.active
            ? Theme.accent-soft
            : (ta.pressed ? Theme.accent-press
            : (ta.has-hover ? Theme.sur-3 : transparent));
        animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
        animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    }

    HorizontalLayout {
        // ⚠ 收起时**不要**切换 alignment / padding：它们在宽度动画启动的同一帧就
        // 跳变 —— 图标先"瞬移"到中心、再随侧栏宽度收缩漂移，两段位移叠在一起就是
        // 用户看到的"弹一下"。现在图标位置只由侧栏宽度动画驱动（alignment 恒为
        // start、padding 恒定），收起后图标自然落在窄栏中间（40px 行宽 - 20px 图标）。
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-2;
        spacing: Theme.sp-3;
        alignment: start;

        Text {
            width: 20px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 18px * Theme.ui-scale;
            color: root.active ? Theme.accent : Theme.fg-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // 标签：不再用 `if !collapsed` 销毁 —— 瞬间消失就是"闪一下"。
        // `horizontal-stretch: 0` 让它保持完整字形、**不被侧栏收缩压扁**（压扁
        // 的观感很糟）；收起时由父级 `clip` 裁掉，并淡出。opacity 为 0 后仍不占
        // 布局空间（stretch:0），所以不必再 `visible` 切换。
        Text {
            horizontal-stretch: 0;
            text: root.label;
            font-size: 13px * Theme.ui-scale;
            color: root.active ? Theme.accent : Theme.fg-1;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            opacity: root.collapsed ? 0 : 1;
            animate opacity {
                duration: AnimationSettings.short2();
                easing: AnimationSettings.e-standard-accelerate();
                enabled: AnimationSettings.enabled;
            }
        }

  // 选中项右侧的小圆点（同样不销毁：淡出而非瞬间消失）
        Rectangle {
            horizontal-stretch: 0;
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.accent;
            opacity: (root.collapsed || !root.active) ? 0 : 1;
            y: (parent.height - self.height) / 2;
            animate opacity {
                duration: AnimationSettings.short2();
                easing: AnimationSettings.e-standard-accelerate();
                enabled: AnimationSettings.enabled;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Rail inherits Rectangle {
    // 0 主机 · 1 终端 · 2 指令集 · 3 Docker · 4 设置 · 5 笔记随笔 · 6 AI 助手
    in-out property <int> current-page: 0;
    in-out property <bool> collapsed: false;
    // 顶部给系统红绿灯让位的高度（macOS 无边框窗口下由外层传入 titlebar-inset）
    in property <length> top-inset: 0px;
    in property <bool> lang-en: false;
    callback page-changed(int);
    callback search-requested();

    // 行宽：显式跟随侧栏宽度（= 宽度减去左右 padding）。**不能依赖布局分配** ——
    // 父级宽度动画期间布局会滞后，导致"侧栏先折叠、选中高亮才慢慢收缩"。
    property <length> rail-w: root.width;
    property <length> row-w: root.width - Theme.sp-2 * 2;

    width: root.collapsed ? 56px : 180px;
    // 非对称 + 弹簧：展开 300ms 弹簧落位（新内容有时间呈现），
    // 收起 200ms 加速让位。此前只动了工具条偏移量，侧栏本身纹丝不动。
    animate width {
        duration: root.collapsed ? AnimationSettings.exit-container() : AnimationSettings.enter-container();
        easing: root.collapsed ? AnimationSettings.e-exit() : AnimationSettings.s-soft();
        enabled: AnimationSettings.enabled;
    }
    // L1 层：比二级侧栏（sur-1 = wp-base）更沉一档（深色壁纸 −8%），两级侧栏由此区分。
    background: Theme.rail-bg;
    // 宽度动画期间把超出窄栏的行内容裁掉（与 RailButton 内的标签退场同步）
    clip: true;

    VerticalLayout {
        // ⚠ 普通（Rectangle）父级里的 Layout 按**首选尺寸**布局，必须显式铺满 ——
        // 否则它不跟随侧栏动画中的宽度，选中项高亮会等动画结束才骤然缩窄。
        width: 100%;
        height: 100%;
        padding-top: root.top-inset + Theme.sp-2;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        padding-bottom: Theme.sp-2;
        spacing: Theme.sp-1;
        alignment: start;

        // 顶部：展开态是「搜索框 + 折叠」；收起态只留展开按钮（否则窄宽度下会被裁掉）
        if !root.collapsed : HorizontalLayout {
            height: 34px;
            spacing: Theme.sp-1;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-md;
                background: Theme.sur-3;

                HorizontalLayout {
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-2;
                    alignment: center;

                    Text {
                        width: 16px;
                        text: "\u{E8B6}"; // search
                        font-family: "Material Icons";
                        font-size: 15px * Theme.ui-scale;
                        color: Theme.fg-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 18px;

                        Text {
                            visible: search-input.text == "";
                            width: 100%;
                            height: 100%;
                            text: root.lang-en ? "Search hosts, settings…" : "搜索主机、设置…";
                            font-size: 12px * Theme.ui-scale;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            font-size: 12px * Theme.ui-scale;
                            color: Theme.fg-1;
                            single-line: true;
                            accepted => {
                                root.search-requested();
                            }
                        }
                    }
                }

                search-ta := TouchArea {
                    clicked => {
                        root.search-requested();
                    }
                }
            }

            Rectangle {
                width: 26px;
                border-radius: Theme.radius-md;
                background: collapse-ta.has-hover ? Theme.sur-3 : transparent;

                Text {
                    text: "\u{E5CB}"; // chevron_left
                    font-family: "Material Icons";
                    font-size: 18px * Theme.ui-scale;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                collapse-ta := TouchArea {
                    clicked => {
                        root.collapsed = true;
                    }
                }
            }
        }

        if root.collapsed : Rectangle {
            // 不设 width：VerticalLayout 会分配满行宽（56 − 8 − 8 = 40px），
            // 与下方页面按钮同宽 → 折叠/收起按钮与其它按钮横向对齐。
            height: 34px;
            border-radius: Theme.radius-md;
            background: expand-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E5CC}"; // chevron_right
                font-family: "Material Icons";
                font-size: 18px * Theme.ui-scale;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expand-ta := TouchArea {
                clicked => {
                    root.collapsed = false;
                }
            }
        }

        RailButton {
            row-w: root.row-w;
            glyph: "\u{E875}"; // dns
            label: root.lang-en ? "Hosts" : "主机";
            active: root.current-page == 0;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(0);
            }
        }
        RailButton {
            row-w: root.row-w;
            glyph: "\u{EB8E}"; // terminal
            label: root.lang-en ? "Terminal" : "终端";
            active: root.current-page == 1;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(1);
            }
        }
        RailButton {
            row-w: root.row-w;
            glyph: "\u{E86F}"; // code
            label: root.lang-en ? "Snippets" : "指令集";
            active: root.current-page == 2;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(2);
            }
        }
        RailButton {
            row-w: root.row-w;
            glyph: "\u{E30C}"; // computer
            label: "Docker";
            active: root.current-page == 3;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(3);
            }
        }
        RailButton {
            row-w: root.row-w;
            glyph: "\u{E873}"; // description
            label: root.lang-en ? "Notes" : "笔记随笔";
            active: root.current-page == 5;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(5);
            }
        }
        RailButton {
            row-w: root.row-w;
            glyph: "\u{E65F}"; // auto_awesome
            label: root.lang-en ? "AI Assistant" : "AI 助手";
            active: root.current-page == 6;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(6);
            }
        }

        // 占位：把「设置」顶到底部
        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        RailButton {
            row-w: root.row-w;
            glyph: "\u{E8B8}"; // settings
            label: root.lang-en ? "Settings" : "设置";
            active: root.current-page == 4;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(4);
            }
        }

        // 底部原有一块「用户卡片」（头像首字母 + 登录名 + 本地账户）—— 按需求删除：
        // 不显示任何用户相关的东西（Rust 侧也不再从环境取登录名）。
    }
}
