// 左侧栏（按参考设计：iShell Pro 那套）。
//
// 展开 180px（图标 + 文字）· 收起 56px（只留图标，顶部只留展开按钮）。
// 选中项做成"加粗填充药丸"（accent 淡底 + 主色文字），与参考图一致；
// 图标用项目里既有的 Material Icons 字体。

import { Theme } from "../theme.slint";

component RailButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked();

    height: 38px;
    border-radius: Theme.radius-md;
    background: root.active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.sur-3 : transparent);

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : Theme.sp-3;
        padding-right: root.collapsed ? 0px : Theme.sp-2;
        spacing: Theme.sp-3;
        alignment: root.collapsed ? center : start;

        Text {
            width: 20px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: root.active ? Theme.accent : Theme.fg-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !root.collapsed : Text {
            text: root.label;
            font-size: 13px;
            color: root.active ? Theme.accent : Theme.fg-1;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        // 参考图：选中项右侧的小圆点
        if !root.collapsed && root.active : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.accent;
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Rail inherits Rectangle {
    // 0 主机 · 1 终端 · 2 指令集 · 3 Docker · 4 设置 · 5 笔记随笔 · 6 AI 助手
    in-out property <int> current-page: 1;
    in-out property <bool> collapsed: false;
    // 顶部给系统红绿灯让位的高度（macOS 无边框窗口下由外层传入 titlebar-inset）
    in property <length> top-inset: 0px;
    // 底部用户卡片显示的登录名（Rust 从环境取）
    in property <string> user-name: "";
    // 头像圆点里的首字母（Slint 字符串没有 substring，由 Rust 算好传入）
    in property <string> user-initial: "";
    in property <bool> lang-en: false;
    callback page-changed(int);
    callback search-requested();

    width: root.collapsed ? 56px : 180px;
    background: Theme.sur-1;

    VerticalLayout {
        padding-top: root.top-inset + Theme.sp-2;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        padding-bottom: Theme.sp-2;
        spacing: Theme.sp-1;
        alignment: start;

        // 顶部：展开态是「搜索框 + 折叠」；收起态只留展开按钮（否则窄宽度下会被裁掉）
        if !root.collapsed : HorizontalLayout {
            height: 34px;
            spacing: Theme.sp-1;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-md;
                background: Theme.sur-3;

                HorizontalLayout {
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-2;
                    alignment: center;

                    Text {
                        width: 16px;
                        text: "\u{E8B6}"; // search
                        font-family: "Material Icons";
                        font-size: 15px;
                        color: Theme.fg-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 18px;

                        Text {
                            visible: search-input.text == "";
                            width: 100%;
                            height: 100%;
                            text: root.lang-en ? "Search hosts, settings…" : "搜索主机、设置…";
                            font-size: 12px;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            font-size: 12px;
                            color: Theme.fg-1;
                            single-line: true;
                            accepted => {
                                root.search-requested();
                            }
                        }
                    }
                }

                search-ta := TouchArea {
                    clicked => {
                        root.search-requested();
                    }
                }
            }

            Rectangle {
                width: 26px;
                border-radius: Theme.radius-md;
                background: collapse-ta.has-hover ? Theme.sur-3 : transparent;

                Text {
                    text: "\u{E5CB}"; // chevron_left
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                collapse-ta := TouchArea {
                    clicked => {
                        root.collapsed = true;
                    }
                }
            }
        }

        if root.collapsed : Rectangle {
            height: 34px;
            border-radius: Theme.radius-md;
            background: expand-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E5CC}"; // chevron_right
                font-family: "Material Icons";
                font-size: 18px;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            expand-ta := TouchArea {
                clicked => {
                    root.collapsed = false;
                }
            }
        }

        RailButton {
            glyph: "\u{E875}"; // dns
            label: root.lang-en ? "Hosts" : "主机";
            active: root.current-page == 0;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(0);
            }
        }
        RailButton {
            glyph: "\u{EB8E}"; // terminal
            label: root.lang-en ? "Terminal" : "终端";
            active: root.current-page == 1;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(1);
            }
        }
        RailButton {
            glyph: "\u{E86F}"; // code
            label: root.lang-en ? "Snippets" : "指令集";
            active: root.current-page == 2;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(2);
            }
        }
        RailButton {
            glyph: "\u{E30C}"; // computer
            label: "Docker";
            active: root.current-page == 3;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(3);
            }
        }
        RailButton {
            glyph: "\u{E873}"; // description
            label: root.lang-en ? "Notes" : "笔记随笔";
            active: root.current-page == 5;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(5);
            }
        }
        RailButton {
            glyph: "\u{E65F}"; // auto_awesome
            label: root.lang-en ? "AI Assistant" : "AI 助手";
            active: root.current-page == 6;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(6);
            }
        }

        // 占位：把「设置」顶到底部
        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        RailButton {
            glyph: "\u{E8B8}"; // settings
            label: root.lang-en ? "Settings" : "设置";
            active: root.current-page == 4;
            collapsed: root.collapsed;
            clicked => {
                root.page-changed(4);
            }
        }

        // 用户卡片（参考图底部）：头像圆点取登录名首字母 + 名称 + 「本地账户」。
        if !root.collapsed : HorizontalLayout {
            height: 40px;
            spacing: Theme.sp-2;
            padding-left: Theme.sp-2;
            alignment: start;

            Rectangle {
                y: (parent.height - 28px) / 2;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: Theme.accent-soft;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.user-initial == "" ? "?" : root.user-initial;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.user-name == "" ? (root.lang-en ? "Local user" : "本地用户") : root.user-name;
                    font-size: 12px;
                    color: Theme.fg-1;
                    overflow: elide;
                }
                Text {
                    text: root.lang-en ? "Local account" : "本地账户";
                    font-size: 10px;
                    color: Theme.fg-3;
                }
            }
        }
    }
}
