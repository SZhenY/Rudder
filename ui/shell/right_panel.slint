// 右侧工具面板（参考 ex/终端，会话中.png 的右侧栏；AI 按需求暂不做）。
//
// v1 接线范围：
// * 传输 —— transfers 模型（AppWindow 级 ✓ 真数据）+ 活动指示
// * 隧道 / 文件 —— 隧道与 SFTP 树目前挂在 TerminalView 的 per-tab 状态上，
//   迁移需要把那批绑定搬到 AppWindow 级，下一轮做（不放假列表）。

import { Theme } from "../theme.slint";
import { TransferInfo } from "../download_manager.slint";

component PanelTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    background: transparent;

    VerticalLayout {
        alignment: center;

        Text {
            text: root.label;
            font-size: 12px;
            color: root.active ? Theme.fg-1 : Theme.fg-3;
            font-weight: root.active ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            height: 2px;
            width: 20px;
            x: (parent.width - self.width) / 2;
            background: root.active ? Theme.accent : transparent;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.sur-3;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;

        animate x {
            duration: 120ms;
        }
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export component RightPanel inherits Rectangle {
    in property <bool> lang-en: false;
    in property <[TransferInfo]> transfers;
    in property <bool> transfers-active: false;
    in property <bool> sftp-follow-cd;
    in property <bool> always-ask;
    callback set-flag-follow-cd(bool);
    callback set-flag-always-ask(bool);
    callback close-panel();

    property <int> current-tab: 0; // 0 传输 · 1 文件（隧道功能暂缓，见下）

    width: 240px;
    background: Theme.sur-1;

    VerticalLayout {
        // 顶部：标签 + 关闭
        HorizontalLayout {
            height: 34px;
            padding-left: 8px;
            padding-right: 4px;

            PanelTab {
                label: root.lang-en ? "Transfers" : "传输";
                active: root.current-tab == 0;
                clicked => {
                    root.current-tab = 0;
                }
            }
            PanelTab {
                label: root.lang-en ? "Files" : "文件";
                active: root.current-tab == 1;
                clicked => {
                    root.current-tab = 2;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 22px;
                height: 22px;
                y: 6px;
                border-radius: 5px;
                background: ct-ta.has-hover ? Theme.sur-3 : transparent;

                Text {
                    text: "\u{E5CD}";
                    font-family: "Material Icons";
                    font-size: 13px;
                    color: Theme.fg-3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ct-ta := TouchArea {
                    clicked => {
                        root.close-panel();
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── 传输（真数据）──
        if root.current-tab == 0 : VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "\u{E2C6}";
                    font-family: "Material Icons";
                    font-size: 13px;
                    color: root.transfers-active ? Theme.accent : Theme.fg-3;
                    vertical-alignment: center;
                }
                Text {
                    text: root.lang-en
                        ? "Transfers · \{root.transfers.length}"
                        : "传输记录 · \{root.transfers.length}";
                    font-size: 12px;
                    color: Theme.fg-2;
                    vertical-alignment: center;
                }
            }

            if root.transfers.length == 0 : Text {
                text: root.lang-en ? "No transfers yet" : "暂无传输记录";
                font-size: 11px;
                color: Theme.fg-3;
            }

            for t in root.transfers : Rectangle {
                height: 40px;
                border-radius: 6px;
                background: Theme.sur-2;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: t.is-upload ? "\u{E5DB}" : "\u{E5D8}";
                        font-family: "Material Icons";
                        font-size: 13px;
                        color: t.state == 0 ? Theme.accent : Theme.fg-3;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: t.name;
                            font-size: 11px;
                            color: Theme.fg-1;
                            overflow: elide;
                        }
                        Text {
                            text: t.detail;
                            font-size: 10px;
                            color: Theme.fg-3;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.sur-3;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * t.percent;
                                height: parent.width > 0 ? 3px : 0px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                        }
                    }
                }
            }
        }

        // ── 文件（按 ex/设置-终端-SFTP 文件.png 的区块规划）──
        // 注：隧道相关功能按需求暂缓（2026-09 记录），per-tab 状态搬家后另行评估。
        if root.current-tab == 1 : VerticalLayout {
            padding: 12px;
            spacing: 4px;
            alignment: start;

            Text {
                text: root.lang-en ? "Files" : "文件";
                font-size: 14px;
                font-weight: 700;
                color: Theme.fg-1;
            }

            // 目录自动同步 = sftp-follow-cd（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Auto-sync directory" : "SFTP 目录自动同步";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Panel follows terminal cd" : "启用后，打开 SFTP 面板时将自动同步当前工作目录";
                        font-size: 10px;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.sftp-follow-cd;
                        toggled => {
                            root.set-flag-follow-cd(!root.sftp-follow-cd);
                        }
                    }
                }
            }

            // 下载前始终询问 = download-always-ask（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Always ask where to save" : "下载前始终询问位置";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Ask for a destination on every download" : "每次下载都选择目标目录";
                        font-size: 10px;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.always-ask;
                        toggled => {
                            root.set-flag-always-ask(!root.always-ask);
                        }
                    }
                }
            }

            // 其余区块（传输模式/批量限制/文件关联）：回调待核实，迁移中
            Text {
                text: root.lang-en
                    ? "Transfer mode / batch limits / file associations — migrate with the per-tab state move."
                    : "传输模式 / 批量编辑限制 / 文件关联 —— 随 per-tab 状态搬家接入。";
                font-size: 11px;
                color: Theme.fg-3;
                wrap: word-wrap;
            }
        }
    }
}
