// 右侧「工具」面板（参考 ex/终端-会话并分屏.png 的右侧栏；AI 按需求暂不做）。
//
// v3 骨架（终端页设计 B 步）：
//   * 面板头：工具标题 + 折叠（收成 22px 窄条，参考「收起 SFTP 侧边栏」那张）+ 关闭
//   * 资源卡片：CPU / 内存 / 磁盘 / 网络 —— 真数据（`sidebar.rs::refresh_sidebar` 每秒写
//     cpu-percent / mem-percent / mem-detail / disks / net-top-*），2×2 铺开
//   * 内容：传输（transfers 模型）+ 文件（活动标签的 SFTP 列表，`active-sftp-*` 镜像）
//   * footer：打开文件视图的圆按钮 + PATH / DIR / FILE / TOTAL 徽标
//     （计数与总大小由 Rust `refresh_active_term` 数出来，Slint 没有 reduce/filter）
//
// 参考图里有、项目**没有功能**因而先不做（2026-09 记录）：录制、运行期 UTF-8 选择器、
// 显卡标签（无 GPU 采集）、AI 面板；隧道数据已提升到 `active-tunnels` 但 UI 按需求暂缓。
// 「传输模式 / 批量编辑限制 / 文件关联」是旧 SFTP 面板的设置项，不在这里放空控件。
//
// C 步计划（后续）：内容标签扩成 综合 / 处理器 / 内存 / 磁盘 / 网络，接 CPU 趋势、
// 磁盘分区、网络端口；D 步把文件视图升级成「工具条 + 面包屑 + 表格（名称/大小/时间）」。
import { Theme } from "../theme.slint";
import { TransferInfo } from "../download_manager.slint";
import { DiskInfo } from "../resource_types.slint";
import { Sparkline } from "../widgets.slint";
import { SysNetRow } from "../system_info_window.slint";
// 条目类型住在 `ui/sftp_types.slint`（第④步从 `sftp_panel.slint` 搬出），新外壳不依赖
// 那个等着删除的旧面板组件文件。
import { SftpCrumb, SftpEntry, TunnelInfo } from "../sftp_types.slint";

component PanelTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    background: transparent;

    VerticalLayout {
        alignment: center;

        Text {
            text: root.label;
            font-size: 12px;
            color: root.active ? Theme.fg-1 : Theme.fg-3;
            font-weight: root.active ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            height: 2px;
            width: 20px;
            x: (parent.width - self.width) / 2;
            background: root.active ? Theme.accent : transparent;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.sur-3;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;

        animate x {
            duration: 120ms;
        }
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();

    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: (root.enabled && ta.has-hover) ? Theme.sur-3 : transparent;

    Text {
        text: root.glyph;
        font-family: "Material Icons";
        font-size: 12px;
        color: root.enabled ? Theme.fg-3 : Theme.fg-3.with-alpha(0.35);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 资源卡片：标签 + 数值 +（可选）进度条 / 补充行。参考图右侧栏顶部那四张卡。
component ResCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> percent: 0;
    in property <string> hint;          // 9px 补充行（内存详情 / 网络上传速率…）
    in property <bool> show-bar: true;

    horizontal-stretch: 1;
    // 固定高度：同一行的两张卡（一个有 hint 一个没有）才不会一高一矮。
    height: 46px;
    border-radius: 6px;
    background: Theme.sur-2;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        alignment: center;

        HorizontalLayout {
            spacing: 4px;

            Text {
                text: root.label;
                font-size: 10px;
                color: Theme.fg-3;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.value;
                font-size: 11px;
                font-weight: 600;
                color: Theme.fg-1;
                vertical-alignment: center;
            }
        }

        if root.show-bar : Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Theme.sur-3;

            Rectangle {
                width: parent.width * root.percent;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: 9px;
            color: Theme.fg-3;
            overflow: elide;
        }
    }
}

// 分段小标题（工具面板：CPU 趋势 / 磁盘分区 / 网络端口 等）。
component SectionTitle inherits Text {
    font-size: 10px;
    color: Theme.fg-3;
}

// 一行指标：名称 + 数值 + 细进度条（内存 / 交换 / 磁盘分区共用）。
component MetricRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> percent: 0;

    height: 26px;

    VerticalLayout {
        spacing: 3px;
        alignment: center;

        HorizontalLayout {
            spacing: 4px;

            Text {
                text: root.label;
                font-size: 10px;
                color: Theme.fg-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.value;
                font-size: 10px;
                color: Theme.fg-3;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 3px;
            border-radius: 1.5px;
            background: Theme.sur-3;

            Rectangle {
                width: parent.width * root.percent;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }
    }
}

// 网卡一行：名字 + ↓ 下行 + ↑ 上行（箭头用项目里已验证的 Material 码位）。
component NetIfaceRow inherits Rectangle {
    in property <string> name;
    in property <string> down;
    in property <string> up;

    height: 22px;

    HorizontalLayout {
        spacing: 4px;

        Text {
            text: root.name;
            font-size: 10px;
            color: Theme.fg-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "\u{E5DB}";   // arrow_downward
            font-family: "Material Icons";
            font-size: 10px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.down;
            font-size: 9px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: "\u{E5D8}";   // arrow_upward
            font-family: "Material Icons";
            font-size: 10px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.up;
            font-size: 9px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
    }
}

// 空数据提示（不放假数字：没样本就说没样本）。
component EmptyHint inherits Text {
    in property <bool> lang-en: false;
    text: root.lang-en ? "No data yet" : "暂无数据";
    font-size: 10px;
    color: Theme.fg-3;
}

// footer 的小徽标：标签 + 值（参考图右下 PATH / DIR / FILE / TOTAL）。
component StatChip inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 8px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-size: 9px;
            color: Theme.fg-2;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component RightPanel inherits Rectangle {
    in property <bool> lang-en: false;
    in property <[TransferInfo]> transfers;
    in property <bool> transfers-active: false;
    in property <bool> sftp-follow-cd;
    in property <bool> always-ask;
    callback set-flag-follow-cd(bool);
    callback set-flag-always-ask(bool);
    callback close-panel();
    // 资源卡片（真数据：Rust `refresh_sidebar` 每秒写窗口属性，这里只负责摆）
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <string> mem-detail;
    in property <float> swap-percent;
    in property <string> swap-detail;
    in property <[DiskInfo]> disks;
    in property <string> net-up;
    in property <string> net-down;
    // 历史曲线（0..1 归一化）：CPU 趋势、当前会话网卡、本机网卡
    in property <[float]> cpu-history;
    in property <[float]> net-history;
    in property <[float]> net-history-bot;
    // 逐网卡速率（远端 = 会话自己的网卡表，本机 = 一行本地总速率）
    in property <[SysNetRow]> net-rows;
    // 折叠成 22px 窄条（参考图「收起 SFTP 侧边栏」）：状态在窗口级，终端舞台按它让位。
    in-out property <bool> collapsed: false;
    // footer 徽标（Rust 数出来的当前目录统计）
    in property <int> sftp-dir-count;
    in property <int> sftp-file-count;
    in property <string> sftp-total;
    // 面包屑（Rust 按 `/` 切好）与列头排序方向
    in property <[SftpCrumb]> sftp-crumbs;
    in property <string> sftp-sort-key;
    in property <int> sftp-sort-dir;
    // 活动标签的隧道 / SFTP —— 窗口级镜像（见 shell/app_shell.slint 的属性声明处）。
    in property <[TunnelInfo]> tunnels;
    in property <string> sftp-path;
    in property <[SftpEntry]> sftp-entries;
    in property <string> sftp-status;
    in property <bool> sftp-loading: false;
    in property <bool> sftp-available: false;
    // 面板挂在窗口级，回调不带 tab-id；实例化处补 `active-tab-id` 走既有链路。
    callback sftp-navigate(string /* path；".." = 上级目录 */);
    callback sftp-refresh(string /* path */);
    callback sftp-download(string /* path */);
    callback sftp-upload(string /* dir */, bool /* folder */);
    callback sftp-new-folder(string /* dir */);
    callback sftp-sort-request(string /* key */);
    // 搜索框：查询串住在窗口级（Rust 侧按它过滤列表），改动即时通知。
    in-out property <string> search;
    callback search-changed(string);

    property <int> current-tab: 0; // 0 综合 · 1 CPU · 2 内存 · 3 磁盘 · 4 网络 · 5 传输 · 6 文件
    property <string> file-path-label: !root.sftp-available
        ? (root.lang-en ? "SFTP unavailable for this session" : "此会话不支持 SFTP")
        : (root.sftp-path == "" ? "/" : root.sftp-path);
    // 列头的排序方向后缀（key + dir 都是 Rust 从活动行镜像过来的真状态）。
    property <string> sort-suffix-name:
        root.sftp-sort-key == "name" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "name" && root.sftp-sort-dir < 0 ? " ↓" : "";
    property <string> sort-suffix-size:
        root.sftp-sort-key == "size" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "size" && root.sftp-sort-dir < 0 ? " ↓" : "";
    property <string> sort-suffix-modified:
        root.sftp-sort-key == "modified" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "modified" && root.sftp-sort-dir < 0 ? " ↓" : "";
    // 0 不可用 · 1 加载中（还没有内容）· 2 空目录 · 3 列表
    property <int> file-view: !root.sftp-available ? 0
        : (root.sftp-loading && root.sftp-entries.length == 0 ? 1
        : (root.sftp-entries.length == 0 ? 2 : 3));

    // 展开 240px / 收起 22px 窄条（参考图「收起 SFTP 侧边栏」）
    width: root.collapsed ? 22px : 240px;
    background: Theme.sur-1;
    clip: true;

    // ── 收起态：一条窄条 + 一个展开按钮（图标与标签条的「工具」同一个）──────
    if root.collapsed : Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - 20px) / 2;
            border-radius: 5px;
            background: ex-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E8B3}";
                font-family: "Material Icons";
                font-size: 12px;
                color: Theme.fg-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ex-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.collapsed = false;
                }
            }
        }
    }

    if !root.collapsed : VerticalLayout {
        // ── 面板头：工具 + 收起 + 关闭 ──────────────────────────────────
        // 上下 padding 各 6px：行内高度正好 20px，固定 20px 的按钮因此在行内居中
        // （HorizontalLayout 的交叉轴默认是拉伸，靠子项自身高度定死才不跑偏）。
        HorizontalLayout {
            height: 32px;
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;

            Text {
                text: "\u{E8B3}";
                font-family: "Material Icons";
                font-size: 13px;
                color: Theme.fg-2;
                vertical-alignment: center;
            }
            Text {
                text: root.lang-en ? "Tools" : "工具";
                font-size: 12px;
                font-weight: 600;
                color: Theme.fg-1;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconBtn {
                glyph: "\u{E5CC}";   // chevron_right：向窗口右缘收起
                clicked => {
                    root.collapsed = true;
                }
            }
            IconBtn {
                glyph: "\u{E5CD}";   // 关闭面板（舞台随之收回这块宽度）
                clicked => {
                    root.close-panel();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── 资源卡片 2×2（真数据，1 Hz）─────────────────────────────────
        // C 步会在下面接 CPU 趋势 / 磁盘分区 / 网络端口，并把这里收进「综合」标签。
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 4px;
            spacing: 4px;

            ResCard {
                label: "CPU";
                value: "\{round(root.cpu-percent * 100)}%";
                percent: root.cpu-percent;
            }
            ResCard {
                label: root.lang-en ? "MEM" : "内存";
                value: "\{round(root.mem-percent * 100)}%";
                percent: root.mem-percent;
                hint: root.mem-detail;
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 8px;
            spacing: 4px;

            ResCard {
                label: root.lang-en ? "DISK" : "磁盘";
                value: root.disks.length > 0 ? "\{round(root.disks[0].percent * 100)}%" : "—";
                percent: root.disks.length > 0 ? root.disks[0].percent : 0;
                hint: root.disks.length > 0 ? root.disks[0].detail : "";
            }
            // 网络卡不画进度条：上下行速率就是它的数值与补充行（参考图 ↓ 在上、↑ 在下）。
            ResCard {
                label: root.lang-en ? "NET" : "网络";
                value: root.net-down;
                hint: "\{root.net-up}";
                show-bar: false;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── 内容标签：5 个监控视图 + 传输 / 文件（全部真数据）────────────
        // 参考图的标签是 综合 / 处理器 / 显卡 / 内存 / 磁盘 / 网络；显卡项目没有采集，
        // 不做（见文件头）。英文态用短标签，7 个才排得下 240px。
        HorizontalLayout {
            height: 30px;
            padding-left: 4px;
            padding-right: 4px;

            PanelTab {
                label: root.lang-en ? "Sum" : "综合";
                active: root.current-tab == 0;
                clicked => {
                    root.current-tab = 0;
                }
            }
            PanelTab {
                label: "CPU";
                active: root.current-tab == 1;
                clicked => {
                    root.current-tab = 1;
                }
            }
            PanelTab {
                label: root.lang-en ? "Mem" : "内存";
                active: root.current-tab == 2;
                clicked => {
                    root.current-tab = 2;
                }
            }
            PanelTab {
                label: root.lang-en ? "Disk" : "磁盘";
                active: root.current-tab == 3;
                clicked => {
                    root.current-tab = 3;
                }
            }
            PanelTab {
                label: root.lang-en ? "Net" : "网络";
                active: root.current-tab == 4;
                clicked => {
                    root.current-tab = 4;
                }
            }
            PanelTab {
                label: root.lang-en ? "Xfers" : "传输";
                active: root.current-tab == 5;
                clicked => {
                    root.current-tab = 5;
                }
            }
            PanelTab {
                label: root.lang-en ? "Files" : "文件";
                active: root.current-tab == 6;
                clicked => {
                    root.current-tab = 6;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── 综合：CPU 趋势 + 磁盘分区 + 网络端口（卡片在上方常驻，不重复）──
        if root.current-tab == 0 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "CPU load trend" : "CPU 负载趋势"; }
                if root.cpu-history.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.cpu-history.length > 0 : Sparkline {
                    values: root.cpu-history;
                    height: 44px;
                }

                SectionTitle { text: root.lang-en ? "Disk partitions" : "磁盘分区"; }
                if root.disks.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for d in root.disks : MetricRow {
                    label: d.path;
                    value: d.detail;
                    percent: d.percent;
                }

                SectionTitle { text: root.lang-en ? "Network interfaces" : "网络端口"; }
                if root.net-rows.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for n in root.net-rows : NetIfaceRow {
                    name: n.name;
                    down: n.down;
                    up: n.up;
                }
            }
        }

        // ── 处理器：CPU 数值 + 趋势（放大版）────────────────────────────
        if root.current-tab == 1 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                MetricRow {
                    label: "CPU";
                    value: "\{round(root.cpu-percent * 100)}%";
                    percent: root.cpu-percent;
                }
                SectionTitle { text: root.lang-en ? "CPU load trend" : "CPU 负载趋势"; }
                if root.cpu-history.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.cpu-history.length > 0 : Sparkline {
                    values: root.cpu-history;
                    height: 88px;
                }
            }
        }

        // ── 内存：内存 + 交换（真数据；参考图里的「用户 / 系统」拆分项目没有）──
        if root.current-tab == 2 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Memory" : "内存"; }
                MetricRow {
                    label: root.lang-en ? "MEM" : "内存";
                    value: root.mem-detail;
                    percent: root.mem-percent;
                }
                SectionTitle { text: root.lang-en ? "Swap" : "交换"; }
                MetricRow {
                    label: root.lang-en ? "Swap" : "交换";
                    value: root.swap-detail;
                    percent: root.swap-percent;
                }
            }
        }

        // ── 磁盘：全部分区 ─────────────────────────────────────────────
        if root.current-tab == 3 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Disk partitions" : "磁盘分区"; }
                if root.disks.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for d in root.disks : MetricRow {
                    label: d.path;
                    value: d.detail;
                    percent: d.percent;
                }
            }
        }

        // ── 网络：端口表 + 上下行趋势 ───────────────────────────────────
        if root.current-tab == 4 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Interfaces" : "网络端口"; }
                if root.net-rows.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for n in root.net-rows : NetIfaceRow {
                    name: n.name;
                    down: n.down;
                    up: n.up;
                }

                SectionTitle { text: root.lang-en ? "Session NIC" : "会话网卡"; }
                if root.net-history.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.net-history.length > 0 : Sparkline {
                    values: root.net-history;
                    height: 40px;
                }

                SectionTitle { text: root.lang-en ? "Local NIC" : "本机网卡"; }
                if root.net-history-bot.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.net-history-bot.length > 0 : Sparkline {
                    values: root.net-history-bot;
                    height: 40px;
                }
            }
        }

        // ── 传输（真数据；条目多时由内部滚动承担）───────────────────────
        if root.current-tab == 5 : VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "\u{E2C6}";
                    font-family: "Material Icons";
                    font-size: 13px;
                    color: root.transfers-active ? Theme.accent : Theme.fg-3;
                    vertical-alignment: center;
                }
                Text {
                    text: root.lang-en
                        ? "Transfers · \{root.transfers.length}"
                        : "传输记录 · \{root.transfers.length}";
                    font-size: 12px;
                    color: Theme.fg-2;
                    vertical-alignment: center;
                }
            }

            if root.transfers.length == 0 : Text {
                text: root.lang-en ? "No transfers yet" : "暂无传输记录";
                font-size: 11px;
                color: Theme.fg-3;
            }

            for t in root.transfers : Rectangle {
                height: 40px;
                border-radius: 6px;
                background: Theme.sur-2;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: t.is-upload ? "\u{E5DB}" : "\u{E5D8}";
                        font-family: "Material Icons";
                        font-size: 13px;
                        color: t.state == 0 ? Theme.accent : Theme.fg-3;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: t.name;
                            font-size: 11px;
                            color: Theme.fg-1;
                            overflow: elide;
                        }
                        Text {
                            text: t.detail;
                            font-size: 10px;
                            color: Theme.fg-3;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.sur-3;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * t.percent;
                                height: parent.width > 0 ? 3px : 0px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                        }
                    }
                }
            }
        }

        // ── 文件（活动标签的 SFTP 列表 —— per-tab 状态搬家①后接真数据）──
        // 隧道数据已提升到 `active-tunnels`，但隧道 UI 按需求暂缓（见文件头）。
        // 注意：这个 VerticalLayout **不写** `alignment: start` —— Slint 里
        // alignment != stretch 时 stretch 因子会被忽略（子项一律用 preferred 高度），
        // 下面的列表区就撑不开了。默认 stretch + 单个 `vertical-stretch: 1` 的
        // 列表容器 = 上面的行保持原高、剩余高度全给列表（同 page_hosts 的写法）。
        if root.current-tab == 6 : VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 6px;

            // ── 工具条：面包屑（根 / … / 末两段可点）+ 刷新 / 上传 / 新建目录 ──
            // 中间层用「…」省略（crumbs 由 Rust 切好；长度 >3 时只显示首段与末两段）。
            HorizontalLayout {
                spacing: 2px;
                height: 22px;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    alignment: start;

                    for c[i] in root.sftp-crumbs : HorizontalLayout {
                        spacing: 1px;
                        alignment: start;

                        // 中间层省略号：点它 = 上一级（参考图里的「…」就是上级入口）。
                        // 放在 i==1 这个槽位，省得在静态元素与 for 之间插队。
                        HorizontalLayout {
                            visible: root.sftp-crumbs.length > 3 && i == 1;
                            spacing: 1px;
                            alignment: start;

                            Text {
                                text: "…";
                                font-size: 10px;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            up-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sftp-navigate("..");
                                }
                            }
                        }

                        // 面包屑本身：根段用文件夹图标代替「/」（省宽度，也更像参考图）；
                        // 长度 > 3 时只留首段与末两段。
                        HorizontalLayout {
                            visible: root.sftp-crumbs.length <= 3 || i == 0
                                || i >= root.sftp-crumbs.length - 2;
                            spacing: 1px;
                            alignment: start;

                            Text {
                                text: i == 0 ? "\u{E2C7}" : "/" + c.name;
                                font-family: i == 0 ? "Material Icons" : Theme.ui-font-family;
                                font-size: 10px;
                                color: i == root.sftp-crumbs.length - 1 ? Theme.fg-1 : Theme.fg-3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            ct-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sftp-navigate(c.path);
                                }
                            }
                        }
                    }
                }
                IconBtn {
                    glyph: "\u{E5D5}";   // refresh
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-refresh(root.sftp-path);
                    }
                }
                IconBtn {
                    glyph: "\u{E5D8}";   // 上传：把本地文件放进当前目录
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-upload(root.sftp-path, false);
                    }
                }
                IconBtn {
                    glyph: "\u{E145}";   // 新建目录
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-new-folder(root.sftp-path);
                    }
                }
            }

            // ── 搜索行（过滤在 Rust 侧做：Slint 的字符串没有 contains）────────
            Rectangle {
                height: 22px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.sur-2;

                Text {
                    x: 6px;
                    y: 0;
                    text: "\u{E8B6}";   // search
                    font-family: "Material Icons";
                    font-size: 11px;
                    color: Theme.fg-3;
                    height: parent.height;
                    vertical-alignment: center;
                }
                // 占位提示用一层 Text（TextInput 没有 placeholder 属性，同 rail 的搜索框）
                Text {
                    x: 22px;
                    width: parent.width - 28px;
                    height: parent.height;
                    visible: search-input.text == "";
                    text: root.lang-en ? "Search" : "搜索";
                    font-size: 10px;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                search-input := TextInput {
                    x: 22px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text <=> root.search;
                    single-line: true;
                    font-size: 10px;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                    edited => {
                        root.search-changed(root.search);
                    }
                }
            }

            // ── 列头：名称 / 大小 / 时间（点名称或大小排序，方向来自 Rust 镜像）──
            HorizontalLayout {
                height: 18px;
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Name" : "名称") + root.sort-suffix-name;
                        font-size: 9px;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                    }
                    ht-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("name");
                        }
                    }
                }
                Rectangle {
                    width: 54px;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Size" : "大小") + root.sort-suffix-size;
                        font-size: 9px;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: parent.width;
                    }
                    st-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("size");
                        }
                    }
                }
                Rectangle {
                    width: 50px;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Time" : "时间") + root.sort-suffix-modified;
                        font-size: 9px;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: parent.width;
                    }
                    mt-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("modified");
                        }
                    }
                }
            }

            // ── 两个开关（真回调；设置页也有同样两项，这里留个就近入口）──────
            HorizontalLayout {
                height: 22px;
                spacing: 6px;

                Text {
                    text: root.lang-en ? "Auto-sync" : "目录自动同步";
                    font-size: 9px;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    on: root.sftp-follow-cd;
                    toggled => {
                        root.set-flag-follow-cd(!root.sftp-follow-cd);
                    }
                }
                Text {
                    text: root.lang-en ? "Ask to save" : "下载前询问";
                    font-size: 9px;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    on: root.always-ask;
                    toggled => {
                        root.set-flag-always-ask(!root.always-ask);
                    }
                }
            }

            // 目录自动同步 = sftp-follow-cd（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Auto-sync directory" : "SFTP 目录自动同步";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Panel follows terminal cd" : "启用后，打开 SFTP 面板时将自动同步当前工作目录";
                        font-size: 10px;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.sftp-follow-cd;
                        toggled => {
                            root.set-flag-follow-cd(!root.sftp-follow-cd);
                        }
                    }
                }
            }

            // 下载前始终询问 = download-always-ask（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Always ask where to save" : "下载前始终询问位置";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Ask for a destination on every download" : "每次下载都选择目标目录";
                        font-size: 10px;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.always-ask;
                        toggled => {
                            root.set-flag-always-ask(!root.always-ask);
                        }
                    }
                }
            }

            // 列表区：独吞剩余高度（加载 / 空态 / 列表三种内容共用同一个容器，
            // 这样上面的行不会被拉伸，见本标签开头的 alignment 注记）。
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // 加载中（还没有内容可显示时）
                if root.file-view == 1 : Text {
                    text: root.lang-en ? "Loading directory…" : "正在加载目录…";
                    width: parent.width;
                    height: parent.height;
                    font-size: 11px;
                    color: Theme.fg-3;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                // 空目录 / 还没同步过（cd 跟随关闭时点右上刷新）
                if root.file-view == 2 : Text {
                    text: root.lang-en
                        ? "Empty — or press refresh to load the current directory."
                        : "目录为空 —— 也可能是还没同步，点右上角刷新。";
                    width: parent.width;
                    height: parent.height;
                    font-size: 11px;
                    color: Theme.fg-3;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                // 条目列表：目录点进入，文件点下载（走既有 SFTP 回调）
                if root.file-view == 3 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 1px;
                        alignment: start;

                        for e in root.sftp-entries : Rectangle {
                            height: 24px;
                            border-radius: 5px;
                            background: e-ta.has-hover ? Theme.sur-3 : transparent;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 4px;

                                Text {
                                    text: e.is-dir ? "\u{E2C7}" : "\u{E24D}"; // folder / insert_drive_file
                                    font-family: "Material Icons";
                                    font-size: 12px;
                                    color: e.is-dir ? Theme.accent : Theme.fg-3;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: e.name;
                                    font-size: 10px;
                                    color: Theme.fg-1;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                // 与列头对齐的两列（大小 / 时间）；目录两列都留空
                                Text {
                                    text: e.is-dir ? "" : e.size;
                                    width: 54px;
                                    font-size: 9px;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                                Text {
                                    text: e.is-dir ? "" : e.modified;
                                    width: 50px;
                                    font-size: 9px;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                            }

                            e-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (e.is-dir) {
                                        root.sftp-navigate(e.full-path);
                                    } else {
                                        root.sftp-download(e.full-path);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 状态行（"SFTP 连接中…" / 出错原因 / 传输提示）
            if root.sftp-status != "" : Text {
                text: root.sftp-status;
                font-size: 10px;
                color: Theme.fg-3;
                overflow: elide;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── footer：打开文件视图的圆按钮 + PATH / DIR / FILE / TOTAL ────
        // 参考图里那个圆按钮就是"展开 SFTP 文件目录"的入口；计数由 Rust 数好传进来。
        HorizontalLayout {
            height: 26px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;

            Rectangle {
                width: 20px;
                height: 20px;
                y: 3px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line-strong;
                background: fv-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                Text {
                    text: "\u{E2C7}";   // folder：切到文件视图
                    font-family: "Material Icons";
                    font-size: 11px;
                    color: root.current-tab == 6 ? Theme.accent : Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                fv-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.current-tab = 6;
                    }
                }
            }
            StatChip {
                label: "PATH";
                value: root.file-path-label;
                horizontal-stretch: 1;
            }
            StatChip {
                label: "DIR";
                value: "\{root.sftp-dir-count}";
            }
            StatChip {
                label: "FILE";
                value: "\{root.sftp-file-count}";
            }
            StatChip {
                label: "TOTAL";
                value: root.sftp-total;
            }
        }
    }
}
