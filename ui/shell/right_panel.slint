// 右侧「工具」面板（形态取自分屏会话的右侧栏；AI 按需求暂不做）。
//
// v3 骨架（终端页设计 B 步）：
//   * 面板头：工具标题 + 折叠（收成 22px 窄条，「收起 SFTP 侧边栏」那张）+ 关闭
//   * 资源卡片：CPU / 内存 / 磁盘 / 网络 —— 真数据（`sidebar.rs::refresh_sidebar` 每秒写
//     cpu-percent / mem-percent / mem-detail / disks / net-top-*），2×2 铺开
//   * 内容：传输（transfers 模型）+ 文件（活动标签的 SFTP 列表，`active-sftp-*` 镜像）
//   * footer：打开文件视图的圆按钮 + PATH / DIR / FILE / TOTAL 徽标
//     （计数与总大小由 Rust `refresh_active_term` 数出来，Slint 没有 reduce/filter）
//
// 有设计但项目**没有功能**因而先不做（2026-09 记录）：录制、运行期 UTF-8 选择器、
// 显卡标签（无 GPU 采集）、AI 面板；隧道数据已提升到 `active-tunnels` 但 UI 按需求暂缓。
// 「传输模式 / 批量编辑限制 / 文件关联」是旧 SFTP 面板的设置项，不在这里放空控件。
//
// C 步计划（后续）：内容标签扩成 综合 / 处理器 / 内存 / 磁盘 / 网络，接 CPU 趋势、
// 磁盘分区、网络端口；D 步把文件视图升级成「工具条 + 面包屑 + 表格（名称/大小/时间）」。
import { AnimationSettings, Theme } from "../theme.slint";
import { TransferInfo } from "../download_manager.slint";
import { DiskInfo, CoreLoad } from "../resource_types.slint";
import { ProcRow } from "../proc_window.slint";
// Sparkline（旧组件，widgets.slint）本文件已不再使用 —— 趋势改用同文件里的 LineChart。
import { SysNetRow } from "../system_info_window.slint";
// 条目类型住在 `ui/sftp_types.slint`（第④步从 `sftp_panel.slint` 搬出），新外壳不依赖
// 那个等着删除的旧面板组件文件。
import { SftpCrumb, SftpEntry, TunnelInfo } from "../sftp_types.slint";

// 内容标签（样式）：小图标 + 文案；激活态是一枚圆角胶囊（sur-3 底 + 主题色
// 图标 + 加粗白字），未激活透明、悬停淡底。等分宽度（horizontal-stretch）—— 7 个
// 标签在窄面板里也排得开，不会挤成一串。
component PanelTab inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.sur-3 : (ta.has-hover ? Theme.sur-2 : transparent);

    HorizontalLayout {
        alignment: center;
        spacing: 3px;

        if root.icon != "" : Text {
            text: root.icon;
            font-family: "Material Icons";
            font-size: 12px * Theme.ui-scale;
            color: root.active ? Theme.accent : Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 11px * Theme.ui-scale;
            color: root.active ? Theme.fg-1 : Theme.fg-3;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 折线趋势（里的曲线）：**一条 Path 画完整条线**，比"每个采样点一根柱子"
// 便宜得多（一个绘制项 vs 几十个），也符合设计观感 —— 线 + 浅色面积填充 +
// 0 值基线。
//
// ⚠ 两个关键点：
// 1) `width` / `height` 显式置 0：Path 在宽高非 0 时会把整条路径**缩放**到该边界里
//    （"the entire shape is fit into these bounds"），0 值附近的曲线就会被放大成
//    一堆山峰 —— 置 0 后用像素坐标原样绘制。
// 2) 坐标全部按像素算：x = i / (n-1) × 本组件宽度，y = chart-h × (1 - v)。
component LineChart inherits Rectangle {
    in property <[float]> values;
    in property <length> chart-h: 44px;
    in property <color> line-color: Theme.accent;
    // 展示窗口：0 = 全部；>0 = 只画**最后 N 个采样**（1/5/15 分钟 = 60/300/900，
    // 历史环现在是 900 个点，窗口切换靠它，不需要重建模型）。
    in property <int> window: 0;
    // ── 悬停交互（默认关；只有需要「绝对时刻」的图才开，见 TrendCard 透传）────
    in property <bool> interactive: false;
    // 与 `values` **等长**的采样时刻：本地时间「当天秒数」(0..86399)。
    // Rust 侧（chrono）已把时区解析完 —— Slint 没有时区支持，存 Unix 秒只能显示 UTC。
    in property <[int]> times: [];
    in property <string> value-suffix: "%";

    // MouseArea 写入的鼠标横坐标（-1 = 不在图内）。
    //
    // ⚠ 走 property 中转而不是让气泡直接绑 `ta.mouse-x`：`TouchArea` 必须在**最上层**
    // 才能收到 hover（否则被下面的气泡挡住鼠标），而气泡又要读 hover 状态 ——
    // 直接绑定会形成"气泡依赖 TouchArea 的 id" + "TouchArea 在气泡之后"的循环依赖。
    // 解耦成 `hover-px`（TouchArea 单向写入 → 气泡单向读取）就没有环。
    property <length> hover-px: -1px;
    // 悬停落在哪个**绘图点**。用绘图点（而不是样本）索引，与曲线同源 —— 曲线就是
    // 由 `vx(k)` / `values[idx(k)]` 画的，所以游标与线天然像素对齐。
    property <int> hover-k: root.hover-px < 0 || root.width <= 0 ? -1
        : Math.clamp(Math.round(root.hover-px / root.width * (root.npts * 1.0 - 1.0)),
                     0.0, root.npts * 1.0 - 1.0);
    // 展开写死的采样点数（见下面 Path 里的说明）
    property <int> npts: 61;
    // 不变量：QuadraticTo 段数 == npts - 2，索引 k = 1..npts-2。改 npts 必须
    // 同步重生成那些展开写死的段，否则会出现两种坏结果：
    //   ① 重复索引 → 曲线自我重绘成锯齿（曾发生过：改 30→60 时旧的段没删）；
    //   ② mx(npts-1) 越界 → 读 vx(npts)=101.67，超出隐形锚点钉住的 0..100 包围盒。
    // 第 k 个绘图点取哪个样本（数据长度可变 → 均匀取样）
    pure function wlen() -> int {
        return root.window > 0 ? min(root.window, root.values.length) : root.values.length;
    }
    pure function idx(k: int) -> int {
        // 第 k 个绘图点落在「最后 wlen() 个采样」里：offset = length - wlen()
        return min(root.values.length - 1,
                   max(0, root.values.length - root.wlen()
                          + round(k * max(1, root.wlen() - 1) * 1.0 / (root.npts - 1))));
    }
    pure function vx(k: int) -> float {
        return k * 100.0 / (root.npts - 1);
    }
    pure function vy(v: float) -> float {
        return 100.0 * (1.0 - clamp(v, 0.0, 1.0));
    }
    // 当前值：窗口内最后一个样本（画"现在"游标用）。纯函数、无副作用。
    pure function last-v() -> float {
        return root.values.length > 0
            ? clamp(root.values[root.values.length - 1], 0.0, 1.0) : 0.0;
    }

    // 中点：平滑曲线的节点取相邻采样点的中点，数据点只做控制点 ——
    // 直连数据点的折线太生硬（用户反馈），这样曲率柔和也不会过冲。
    pure function mx(k: int) -> float {
        return (root.vx(k) + root.vx(k + 1)) / 2;
    }
    pure function my(k: int) -> float {
        return (root.vy(root.values[root.idx(k)]) + root.vy(root.values[root.idx(k + 1)])) / 2;
    }
    // ── 悬停读数（idx 越界/缓冲未填满时给占位符，绝不显示错的数）──────────────
    //
    // ⚠ 这个 Slint 版本**不支持 `var` 局部变量**（`var` 会被当成 property 名，
    // 解析器接着期待 `=>`）也不支持 `if` 表达式 —— 所以一律用「小纯函数 + 三元」
    // 写。副作用是 `idx(k)` 会被重复求值，纯函数无副作用故无代价。
    pure function hok(k: int) -> bool {
        return root.idx(k) >= 0 && root.idx(k) < root.values.length;
    }
    pure function hval(k: int) -> float {
        return root.hok(k) ? root.values[root.idx(k)] : 0.0;
    }
    // `round` 返回 float；直接拼进 string 会带小数尾巴，故先 `int()`。
    pure function hpct(k: int) -> string {
        return root.hok(k)
            ? Math.round(root.values[root.idx(k)] * 100.0) + root.value-suffix : "--";
    }
    // 该绘图点的采样时刻（秒-of-day）；-1 = 无效或环形缓冲尚未真正采到（预填 0）。
    pure function hsec(k: int) -> int {
        return root.idx(k) < 0 || root.idx(k) >= root.times.length ? -1
            : root.times[root.idx(k)];
    }
    pure function pad2(v: float) -> string {
        return (v < 10.0 ? "0" : "") + Math.round(v);
    }
    pure function htime(k: int) -> string {
        // ⚠ 取模必须用 `Math.mod(x, y)` —— Slint 里的 `%` 是"百分号单位"（100%）
        // 而不是取模运算符。`int(...)` 是为了截断成整数（`/` 的返回类型随版本
        // 而异，显式转换最稳）。
        return root.hsec(k) <= 0 ? "--:--:--"
            : root.pad2(root.hsec(k) / 3600.0) + ":"
              + root.pad2(Math.mod(root.hsec(k) / 60.0, 60.0)) + ":"
              + root.pad2(Math.mod(root.hsec(k) * 1.0, 60.0));
    }

    // 高度**定值**（chart-h + 1px 的刻度线），不随面板富余空间伸缩。
    //
    // ⚠ 曾经是 `vertical-stretch: 1`（综合页里随趋势卡拉伸、填满底部空白）——
    // 那样图高就取决于这台主机**其它内容**的多少（磁盘分区 / 网络端口行数）：
    // 分区少的机器图能吃到几十像素富余，分区多的机器（NAS 常见）内容几乎占满、
    // 图被压回最小高度。同一张图在不同主机上高矮不一，曲线的斜率观感也对不上。
    // 改成定值后所有主机一致；富余空间变成面板底部的留白，内容超长时由
    // Flickable 滚动（而不是把图压瘪）。
    min-height: root.chart-h + 1px;
    vertical-stretch: 0;
    background: transparent;

    // ── 刻度线：数据现在是**绝对 0–100%**，所以这些线是真的读数辅助 ──────────
    // （此前 CPU 数据被 normalize 除以窗口峰值，量程是假的，刻度线形同虚设。）
    // 25% / 75% 用更淡的一档，50% 稍显 —— 层次不喧宾夺主。
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.line;
    }
    Rectangle {
        x: 0;
        y: parent.height / 2;
        width: parent.width;
        height: 1px;
        background: Theme.line.with-alpha(0.5);
    }
    Rectangle {
        x: 0;
        y: parent.height / 4;
        width: parent.width;
        height: 1px;
        background: Theme.line.with-alpha(0.26);
    }
    Rectangle {
        x: 0;
        y: parent.height * 3 / 4;
        width: parent.width;
        height: 1px;
        background: Theme.line.with-alpha(0.26);
    }

    // ── 「现在」游标：末端竖线 + 圆点 ────────────────────────────────────
    // 绝对量程下读者需要一眼看到"当前值落在哪" —— 圆点高度即当前百分比，可直接
    // 对照上面的刻度线读数。曲线用 `last-v()` 取窗口内最后一个样本。
    if root.values.length > 0 : Rectangle {
        x: parent.width - 3px;
        y: parent.height * (1 - root.last-v()) - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: root.line-color;
    }

    // ⚠ Path **不支持** `for`（Slint #754："Path elements are not supported with
    // `for`-`in` syntax, yet"），所以下面 61 个采样点是**展开写死**的（脚本生成，
    // 别手改）：第 k 个点取 `idx(k)` 处的数据 —— 数据长度可变，这里均匀取样，
    // 于是同一个组件能吃任意长度的历史序列。
    // 曲线走**中点二次贝塞尔**：节点取相邻采样点的中点、数据点只做控制点 ——
    // 直连数据点的折线太生硬（用户反馈），这样曲率柔和且不过冲。
    if root.values.length > 0 : Path {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        // ⚠ fit 默认是 `contain`：**等比**缩放到边界内并居中 —— 一张 430×44 的卡片里，
        // 100×100 的路径会被缩成中间一小团（截图里"折线没对齐 X/Y"就是这个）。
        // 图表要 `fill`：非等比拉伸，横向铺满 + 纵向按比例尺填满（纵轴范围由上面两个
        // 隐形锚点钉住，所以拉伸不会失真）。
        fit: fill;
        stroke: root.line-color;
        stroke-width: 1.5px;
  // 设计是"线 + 浅色面积"：末尾收口到基线后再闭合成多边形。
        fill: root.line-color.with-alpha(0.16);

        // 两个**看不见的锚点**把包围盒钉死在 0..100 × 0..100：Path 会把整条路径
        // 缩放着填进自己的宽高边界，没有锚点时"0 值附近"的曲线会被放大成山峰。
        // 锚点只有 0.01 单位长（不到一个像素），画不出来。
        MoveTo { x: 0.0; y: 0.0; }
        LineTo { x: 0.01; y: 0.0; }
        MoveTo { x: root.mx(0); y: root.my(0); }
        QuadraticTo {
            control-x: root.vx(1);
            control-y: root.vy(root.values[root.idx(1)]);
            x: root.mx(1);
            y: root.my(1);
        }
        QuadraticTo {
            control-x: root.vx(2);
            control-y: root.vy(root.values[root.idx(2)]);
            x: root.mx(2);
            y: root.my(2);
        }
        QuadraticTo {
            control-x: root.vx(3);
            control-y: root.vy(root.values[root.idx(3)]);
            x: root.mx(3);
            y: root.my(3);
        }
        QuadraticTo {
            control-x: root.vx(4);
            control-y: root.vy(root.values[root.idx(4)]);
            x: root.mx(4);
            y: root.my(4);
        }
        QuadraticTo {
            control-x: root.vx(5);
            control-y: root.vy(root.values[root.idx(5)]);
            x: root.mx(5);
            y: root.my(5);
        }
        QuadraticTo {
            control-x: root.vx(6);
            control-y: root.vy(root.values[root.idx(6)]);
            x: root.mx(6);
            y: root.my(6);
        }
        QuadraticTo {
            control-x: root.vx(7);
            control-y: root.vy(root.values[root.idx(7)]);
            x: root.mx(7);
            y: root.my(7);
        }
        QuadraticTo {
            control-x: root.vx(8);
            control-y: root.vy(root.values[root.idx(8)]);
            x: root.mx(8);
            y: root.my(8);
        }
        QuadraticTo {
            control-x: root.vx(9);
            control-y: root.vy(root.values[root.idx(9)]);
            x: root.mx(9);
            y: root.my(9);
        }
        QuadraticTo {
            control-x: root.vx(10);
            control-y: root.vy(root.values[root.idx(10)]);
            x: root.mx(10);
            y: root.my(10);
        }
        QuadraticTo {
            control-x: root.vx(11);
            control-y: root.vy(root.values[root.idx(11)]);
            x: root.mx(11);
            y: root.my(11);
        }
        QuadraticTo {
            control-x: root.vx(12);
            control-y: root.vy(root.values[root.idx(12)]);
            x: root.mx(12);
            y: root.my(12);
        }
        QuadraticTo {
            control-x: root.vx(13);
            control-y: root.vy(root.values[root.idx(13)]);
            x: root.mx(13);
            y: root.my(13);
        }
        QuadraticTo {
            control-x: root.vx(14);
            control-y: root.vy(root.values[root.idx(14)]);
            x: root.mx(14);
            y: root.my(14);
        }
        QuadraticTo {
            control-x: root.vx(15);
            control-y: root.vy(root.values[root.idx(15)]);
            x: root.mx(15);
            y: root.my(15);
        }
        QuadraticTo {
            control-x: root.vx(16);
            control-y: root.vy(root.values[root.idx(16)]);
            x: root.mx(16);
            y: root.my(16);
        }
        QuadraticTo {
            control-x: root.vx(17);
            control-y: root.vy(root.values[root.idx(17)]);
            x: root.mx(17);
            y: root.my(17);
        }
        QuadraticTo {
            control-x: root.vx(18);
            control-y: root.vy(root.values[root.idx(18)]);
            x: root.mx(18);
            y: root.my(18);
        }
        QuadraticTo {
            control-x: root.vx(19);
            control-y: root.vy(root.values[root.idx(19)]);
            x: root.mx(19);
            y: root.my(19);
        }
        QuadraticTo {
            control-x: root.vx(20);
            control-y: root.vy(root.values[root.idx(20)]);
            x: root.mx(20);
            y: root.my(20);
        }
        QuadraticTo {
            control-x: root.vx(21);
            control-y: root.vy(root.values[root.idx(21)]);
            x: root.mx(21);
            y: root.my(21);
        }
        QuadraticTo {
            control-x: root.vx(22);
            control-y: root.vy(root.values[root.idx(22)]);
            x: root.mx(22);
            y: root.my(22);
        }
        QuadraticTo {
            control-x: root.vx(23);
            control-y: root.vy(root.values[root.idx(23)]);
            x: root.mx(23);
            y: root.my(23);
        }
        QuadraticTo {
            control-x: root.vx(24);
            control-y: root.vy(root.values[root.idx(24)]);
            x: root.mx(24);
            y: root.my(24);
        }
        QuadraticTo {
            control-x: root.vx(25);
            control-y: root.vy(root.values[root.idx(25)]);
            x: root.mx(25);
            y: root.my(25);
        }
        QuadraticTo {
            control-x: root.vx(26);
            control-y: root.vy(root.values[root.idx(26)]);
            x: root.mx(26);
            y: root.my(26);
        }
        QuadraticTo {
            control-x: root.vx(27);
            control-y: root.vy(root.values[root.idx(27)]);
            x: root.mx(27);
            y: root.my(27);
        }
        QuadraticTo {
            control-x: root.vx(28);
            control-y: root.vy(root.values[root.idx(28)]);
            x: root.mx(28);
            y: root.my(28);
        }
        QuadraticTo {
            control-x: root.vx(29);
            control-y: root.vy(root.values[root.idx(29)]);
            x: root.mx(29);
            y: root.my(29);
        }
        QuadraticTo {
            control-x: root.vx(30);
            control-y: root.vy(root.values[root.idx(30)]);
            x: root.mx(30);
            y: root.my(30);
        }
        QuadraticTo {
            control-x: root.vx(31);
            control-y: root.vy(root.values[root.idx(31)]);
            x: root.mx(31);
            y: root.my(31);
        }
        QuadraticTo {
            control-x: root.vx(32);
            control-y: root.vy(root.values[root.idx(32)]);
            x: root.mx(32);
            y: root.my(32);
        }
        QuadraticTo {
            control-x: root.vx(33);
            control-y: root.vy(root.values[root.idx(33)]);
            x: root.mx(33);
            y: root.my(33);
        }
        QuadraticTo {
            control-x: root.vx(34);
            control-y: root.vy(root.values[root.idx(34)]);
            x: root.mx(34);
            y: root.my(34);
        }
        QuadraticTo {
            control-x: root.vx(35);
            control-y: root.vy(root.values[root.idx(35)]);
            x: root.mx(35);
            y: root.my(35);
        }
        QuadraticTo {
            control-x: root.vx(36);
            control-y: root.vy(root.values[root.idx(36)]);
            x: root.mx(36);
            y: root.my(36);
        }
        QuadraticTo {
            control-x: root.vx(37);
            control-y: root.vy(root.values[root.idx(37)]);
            x: root.mx(37);
            y: root.my(37);
        }
        QuadraticTo {
            control-x: root.vx(38);
            control-y: root.vy(root.values[root.idx(38)]);
            x: root.mx(38);
            y: root.my(38);
        }
        QuadraticTo {
            control-x: root.vx(39);
            control-y: root.vy(root.values[root.idx(39)]);
            x: root.mx(39);
            y: root.my(39);
        }
        QuadraticTo {
            control-x: root.vx(40);
            control-y: root.vy(root.values[root.idx(40)]);
            x: root.mx(40);
            y: root.my(40);
        }
        QuadraticTo {
            control-x: root.vx(41);
            control-y: root.vy(root.values[root.idx(41)]);
            x: root.mx(41);
            y: root.my(41);
        }
        QuadraticTo {
            control-x: root.vx(42);
            control-y: root.vy(root.values[root.idx(42)]);
            x: root.mx(42);
            y: root.my(42);
        }
        QuadraticTo {
            control-x: root.vx(43);
            control-y: root.vy(root.values[root.idx(43)]);
            x: root.mx(43);
            y: root.my(43);
        }
        QuadraticTo {
            control-x: root.vx(44);
            control-y: root.vy(root.values[root.idx(44)]);
            x: root.mx(44);
            y: root.my(44);
        }
        QuadraticTo {
            control-x: root.vx(45);
            control-y: root.vy(root.values[root.idx(45)]);
            x: root.mx(45);
            y: root.my(45);
        }
        QuadraticTo {
            control-x: root.vx(46);
            control-y: root.vy(root.values[root.idx(46)]);
            x: root.mx(46);
            y: root.my(46);
        }
        QuadraticTo {
            control-x: root.vx(47);
            control-y: root.vy(root.values[root.idx(47)]);
            x: root.mx(47);
            y: root.my(47);
        }
        QuadraticTo {
            control-x: root.vx(48);
            control-y: root.vy(root.values[root.idx(48)]);
            x: root.mx(48);
            y: root.my(48);
        }
        QuadraticTo {
            control-x: root.vx(49);
            control-y: root.vy(root.values[root.idx(49)]);
            x: root.mx(49);
            y: root.my(49);
        }
        QuadraticTo {
            control-x: root.vx(50);
            control-y: root.vy(root.values[root.idx(50)]);
            x: root.mx(50);
            y: root.my(50);
        }
        QuadraticTo {
            control-x: root.vx(51);
            control-y: root.vy(root.values[root.idx(51)]);
            x: root.mx(51);
            y: root.my(51);
        }
        QuadraticTo {
            control-x: root.vx(52);
            control-y: root.vy(root.values[root.idx(52)]);
            x: root.mx(52);
            y: root.my(52);
        }
        QuadraticTo {
            control-x: root.vx(53);
            control-y: root.vy(root.values[root.idx(53)]);
            x: root.mx(53);
            y: root.my(53);
        }
        QuadraticTo {
            control-x: root.vx(54);
            control-y: root.vy(root.values[root.idx(54)]);
            x: root.mx(54);
            y: root.my(54);
        }
        QuadraticTo {
            control-x: root.vx(55);
            control-y: root.vy(root.values[root.idx(55)]);
            x: root.mx(55);
            y: root.my(55);
        }
        QuadraticTo {
            control-x: root.vx(56);
            control-y: root.vy(root.values[root.idx(56)]);
            x: root.mx(56);
            y: root.my(56);
        }
        QuadraticTo {
            control-x: root.vx(57);
            control-y: root.vy(root.values[root.idx(57)]);
            x: root.mx(57);
            y: root.my(57);
        }
        QuadraticTo {
            control-x: root.vx(58);
            control-y: root.vy(root.values[root.idx(58)]);
            x: root.mx(58);
            y: root.my(58);
        }
        QuadraticTo {
            control-x: root.vx(59);
            control-y: root.vy(root.values[root.idx(59)]);
            x: root.mx(59);
            y: root.my(59);
        }
        // 收口到**最后一个采样点**。用 npts 推导而不是写死数字：写死过一次
        // （npts 从 32 改到 61 后忘了同步），曲线末端会悄悄跳回中间某个样本。
        LineTo {
            x: root.vx(root.npts - 1);
            y: root.vy(root.values[root.idx(root.npts - 1)]);
        }
        // 收口到基线（让 fill 成为面积图）
        LineTo { x: 100.0; y: 100.0; }
        LineTo { x: 0.0; y: 100.0; }
        // 第二个隐形锚点：把包围盒的右下角钉住
        MoveTo { x: 99.99; y: 100.0; }
        LineTo { x: 100.0; y: 100.0; }
    }

    // ── 悬停游标 + 气泡 ─────────────────────────────────────────────
    // 刻意**不用 `if` 包裹**：销毁/重建没有过渡，鼠标扫过一格时气泡会闪。
    // 常驻 + opacity 淡入淡出才连贯（`hover-k` 只在 -1 ↔ >=0 之间切换时才启动
    // 动画，图内移动不会重启动画）。
    Rectangle {
        // 垂直游标线。不用虚线 —— femtovg 虚线要额外 dash 数组，而 34px 高的图里
        // 虚线与实线几乎看不出区别。
        x: root.hover-k >= 0 ? root.vx(root.hover-k) / 100 * root.width : 0;
        width: 1px;
        height: root.height;
        background: root.line-color.with-alpha(0.35);
        opacity: root.hover-k >= 0 ? 1 : 0;
        animate opacity {
            duration: AnimationSettings.short2();
            easing: AnimationSettings.e-standard-accelerate();
            enabled: AnimationSettings.enabled;
        }
    }
    // 数据点圆点：线色填充 + 卡片底色描边（压在任何背景/曲线上都看得见）
    Rectangle {
        x: root.hover-k >= 0
            ? root.vx(root.hover-k) / 100 * root.width - self.width / 2 : 0;
        y: root.hover-k >= 0
            ? root.vy(root.hval(root.hover-k)) / 100 * root.height - self.height / 2 : 0;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.line-color;
        border-width: 2px;
        border-color: Theme.sur-2;
        opacity: root.hover-k >= 0 ? 1 : 0;
        animate opacity {
            duration: AnimationSettings.short2();
            easing: AnimationSettings.e-standard-accelerate();
            enabled: AnimationSettings.enabled;
        }
    }
    // 气泡：**吸附到数据点**，不跟随鼠标 —— 60 个点挤在约 200px 宽的卡里、每点
    // 才 3.3px，跟鼠标会与曲线错位半三个点，百分比对不上"那根线的那个位置"。
    // 水平按左右半区翻转并夹在图内；垂直优先放点上方，放不下翻到下方。
    Rectangle {
        x: max(0, min(root.width - self.width,
            root.hover-k >= 0
                ? root.vx(root.hover-k) / 100 * root.width
                  + (root.vx(root.hover-k) > 50 ? -self.width - 10px : 10px) : 0));
        y: root.hover-k >= 0
            ? (root.vy(root.hval(root.hover-k)) / 100 * root.height - self.height - 8px < 0
                ? root.vy(root.hval(root.hover-k)) / 100 * root.height + 8px
                : root.vy(root.hval(root.hover-k)) / 100 * root.height - self.height - 8px) : 0;
        // 宽度**固定**：跟着文本宽度走的话，"5%" → "100%" 会让气泡每拍抖一下。
        // 超长时 elide 兜底（`ui-scale` 同比例放大，所以任何缩放下都够宽）。
        width: 112px * Theme.ui-scale;
        height: 20px * Theme.ui-scale;
        border-radius: Theme.radius-md;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: root.line-color.with-alpha(0.35);
        opacity: root.hover-k >= 0 ? 1 : 0;
        animate opacity {
            duration: AnimationSettings.short2();
            easing: AnimationSettings.e-standard-accelerate();
            enabled: AnimationSettings.enabled;
        }
        tip := Text {
            width: 100%;
            height: 100%;
            text: root.hover-k >= 0
                ? root.htime(root.hover-k) + "   " + root.hpct(root.hover-k) : "";
            font-size: 10px * Theme.ui-scale;
            color: Theme.fg-1;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // 指针捕获：**必须最后声明**（= 最上层）才能收到 hover，也保证气泡不会挡住
    // 鼠标。用 `if` 包裹：非交互的图（网络趋势）连它都不创建。
    //
    // ⚠ 用内置 `TouchArea` 而不是 `MouseArea` —— 后者在 Slint 1.18 **已被移除**
    //（编译器报 Unknown element）。`TouchArea` 同样提供 `has-hover` + `mouse-x`。
    if root.interactive : TouchArea {
        // ⚠ `changed x => {}` 而不是 `x => {}` —— 后者只对 **callback** 有效，
        // 而 `mouse-x` / `has-hover` 是 `out property`（编译器会明确报
        // "'mouse-x' is not a callback"）。
        changed mouse-x => {
            if self.has-hover { root.hover-px = self.mouse-x; }
        }
        changed has-hover => {
            if !self.has-hover { root.hover-px = -1px; }
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.sur-3;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;

        // 开关滑块：小控件的空间位移用**回弹弹簧**（M3 Expressive：短距离运动留回弹）
        animate x {
            duration: AnimationSettings.medium1();
            easing: AnimationSettings.s-bouncy();
            enabled: AnimationSettings.enabled;
        }
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();

    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: (root.enabled && ta.has-hover) ? Theme.sur-3 : transparent;

    Text {
        text: root.glyph;
        font-family: "Material Icons";
        font-size: 12px * Theme.ui-scale;
        color: root.enabled ? Theme.fg-3 : Theme.fg-3.with-alpha(0.35);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 资源卡片（综合页的四张）：三行紧凑布局 ——
//   ① 图标（主色）+ 标签（白）+ 数值（右对齐、主色大字）
//   ② 进度条（主色）
//   ③ 补充行（小灰字，没有就不画）
// 高度随内容（不同 DPI / 字号下都不会挤）；宽度由调用方平分。
// 面板头部的页签（「工具 | AI」）：激活态是一条主题色下划线。
component PanelHeadTab inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    width: t.preferred-width + 16px;
    background: ta.has-hover ? Theme.sur-3 : transparent;

    t := Text {
        text: root.label;
        font-size: 13px * Theme.ui-scale;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.fg-1 : Theme.fg-3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // 下划线指示条
    Rectangle {
        y: parent.height - 2px;
        x: (parent.width - self.width) / 2;
        width: t.preferred-width;
        height: 2px;
        border-radius: 1px;
        background: root.active ? Theme.accent : transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 1/5/15 分钟窗口切换（的 segmented control）：激活项 = 圆角胶囊 + 主题色。
component WindowSwitch inherits HorizontalLayout {
    in-out property <int> value: 60;
    in property <bool> lang-en: false;

    property <[int]> options: [60, 300, 900];

    for wv in root.options : Rectangle {
        property <bool> on: root.value == wv;
        width: wlab.preferred-width + 12px;
        height: 18px;
        border-radius: 9px;
        background: wv-ta.has-hover && !on ? Theme.sur-3 : (on ? Theme.accent.with-alpha(0.22) : transparent);

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;

            wlab := Text {
                text: (wv == 60 ? "1" : (wv == 300 ? "5" : "15")) + (root.lang-en ? "min" : "分钟");
                font-size: 9px * Theme.ui-scale;
                font-weight: on ? 700 : 500;
                color: on ? Theme.accent : Theme.fg-3;
                vertical-alignment: center;
            }
        }
        wv-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.value = wv; }
        }
    }
}

// 资源卡（的三段式，四张卡**同构** —— 统一排版）：
//   第一行：图标 + 标签 …… 大数值（同色）
//   中间槽：固定高 14px —— 有 bar 画 bar，否则放 ↓/↑ 一对（网络卡），都没有就留白
//   底部行：左……右两段说明（内存 已用/总量、磁盘 已用/总量、CPU 负载均值）
// 中间槽与底部行**永远渲染**（空串占位）：一行四张卡的三段才能水平对齐。
component ResCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> percent: 0;
    in property <string> hint;          // 兼容旧用法：单条补充行（落到底部行左侧）
    in property <bool> show-bar: true;
    in property <string> icon: "";      // Material Icons 码位
  // 卡片主色：图标 / 数值 / 进度条同色（CPU 青、内存 紫、磁盘 黄、网络 绿）
    in property <color> tone: Theme.accent;
    // 中间槽的左右两段（网络卡：↓ 上行 / ↑ 下行）
    in property <string> mid-left: "";
    in property <string> mid-right: "";
    // 底部行的左右两段
    in property <string> foot-left: "";
    in property <string> foot-right: "";

    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: Theme.sur-2;
    clip: true;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 7px;
        // ⚠ 这里**不要**写 alignment —— 它管的是交叉轴（水平）对齐，一写 `center`
        // 子元素就只占首选宽度并居中（进度条会缩成中间一小段）。

        HorizontalLayout {
            spacing: 6px;

            if root.icon != "" : Text {
                text: root.icon;
                font-family: "Material Icons";
                font-size: 15px * Theme.ui-scale;
                color: root.tone;
                vertical-alignment: center;
            }
            Text {
                text: root.label;
                font-size: 12px * Theme.ui-scale;
                color: Theme.fg-1;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.value;
                font-size: 17px * Theme.ui-scale;
                font-weight: 700;
                color: root.tone;
                vertical-alignment: center;
            }
        }

        // 中间槽：固定高 —— 四卡对齐的锚点
        Rectangle {
            height: 14px;

            if root.show-bar : Rectangle {
                y: (parent.height - 4px) / 2;
                height: 4px;
                width: parent.width;
                border-radius: 2px;
                background: Theme.sur-3;

                // ⚠ `x: 0; y: 0;` **必须写**：Slint 里带显式 width 的子 Rectangle 不写 x
                // 时会水平居中。少了这两个坐标，占比条就从中间往两边长。
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * clamp(root.percent, 0.0, 1.0);
                    height: parent.height;
                    border-radius: 2px;
                    background: root.tone;
                }
            }
            if !root.show-bar && (root.mid-left != "" || root.mid-right != "") : HorizontalLayout {
                Text {
                    text: root.mid-left;
                    font-size: 13px * Theme.ui-scale;
                    font-weight: 600;
                    color: root.tone;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.mid-right;
                    font-size: 13px * Theme.ui-scale;
                    font-weight: 600;
                    color: root.tone;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        // 底部行：永远渲染（空串占位），四卡等高
        HorizontalLayout {
            Text {
                text: root.foot-left == "" ? root.hint : root.foot-left;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-3;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.foot-right;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-3;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }
}

// 分段小标题（工具面板：CPU 趋势 / 磁盘分区 / 网络端口 等）—— 设计是"小图标 + 白色标题"。
component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> icon: "";

    spacing: 6px;

    if root.icon != "" : Text {
        text: root.icon;
        font-family: "Material Icons";
        font-size: 13px * Theme.ui-scale;
        color: Theme.fg-3;
        vertical-alignment: center;
    }
    Text {
        text: root.text;
        font-size: 12px * Theme.ui-scale;
        color: Theme.fg-1;
        vertical-alignment: center;
        horizontal-alignment: left;
        horizontal-stretch: 1;
    }
}

// 一行指标：名称 + 数值 + 细进度条（内存 / 交换 / 磁盘分区共用）。
component MetricRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <float> percent: 0;

    // 高度随内容（同上）
    VerticalLayout {
        spacing: 4px;
        // （同上：不写 alignment，进度条才铺满整行）

        HorizontalLayout {
            spacing: 4px;

            Text {
                text: root.label;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.value;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-3;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.sur-3;

            // （同上：x/y 必须显式写，否则填充会居中）
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * clamp(root.percent, 0.0, 1.0);
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }
}

// 网卡一行：名字 + ↓ 下行 + ↑ 上行（箭头用项目里已验证的 Material 码位）。
component NetIfaceRow inherits Rectangle {
    in property <string> name;
    in property <string> down;
    in property <string> up;

    height: 24px;

    HorizontalLayout {
        spacing: 4px;

        Text {
            text: root.name;
            font-size: 10px * Theme.ui-scale;
            color: Theme.fg-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
  // 下行绿色、上行红色（箭头与数值同色）
        Text {
            text: "\u{E5DB}";   // arrow_downward
            font-family: "Material Icons";
            font-size: 10px * Theme.ui-scale;
            color: Theme.ok;
            vertical-alignment: center;
        }
        Text {
            text: root.down;
            font-size: 9px * Theme.ui-scale;
            color: Theme.ok;
            vertical-alignment: center;
        }
        Text {
            text: "\u{E5D8}";   // arrow_upward
            font-family: "Material Icons";
            font-size: 10px * Theme.ui-scale;
            color: Theme.danger;
            vertical-alignment: center;
        }
        Text {
            text: root.up;
            font-size: 9px * Theme.ui-scale;
            color: Theme.danger;
            vertical-alignment: center;
        }
    }
}

// 空数据提示（不放假数字：没样本就说没样本）。
// 弹层里的复选框：14px 方框，勾上时画一个对勾。纯视觉，状态由调用方给。
component CheckMark inherits Rectangle {
    in property <bool> on: false;
    /// **部分选中**（复选框组的第三态）：勾了一些但没全选 → 画一条横线而不是对勾。
    /// 「全部」那一项靠它表达"选中了一部分"：只显示未勾选会让人以为筛选没生效
    /// （用户反馈"操作不符合直觉"）。优先级低于 `on`。
    in property <bool> partial: false;
    width: 14px;
    height: 14px;
    // ⚠ 用到本组件的每个弹层行都**必须**在 CheckMark 上写
    // `cross-axis-self-alignment: center;`（逐项属性，只能写在布局的直接子元素上，
    // 组件内部写会报 "used outside of a ...Layout"）。14px 的方框放在 28px 的行里，
    // 跨轴默认 `auto` → `stretch` → 贴顶，复选框就与右侧文字对不齐。
    border-radius: 3px;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line-strong;
    background: root.on || root.partial
        ? Theme.accent.with-alpha(0.18) : transparent;
    // 半选横线：绝对定位在 14px 盒子正中（CheckMark 不是布局，靠 x/y 居中）。
    Rectangle {
        visible: root.partial && !root.on;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 8px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
    Text {
        text: "\u{E5CA}";   // check
        font-family: "Material Icons";
        font-size: 10px * Theme.ui-scale;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.on ? 1 : 0;
    }
}

component EmptyHint inherits Text {
    in property <bool> lang-en: false;
    /// 非空则覆盖默认文案（"筛空"和"没数据"是两件事，不能共用一句话）。
    in property <string> alt-text: "";
    text: root.alt-text != "" ? root.alt-text
        : (root.lang-en ? "No data yet" : "暂无数据");
    font-size: 10px * Theme.ui-scale;
    color: Theme.fg-3;
}

// footer 的小徽标：标签 + 值（右下 PATH / DIR / FILE / TOTAL）。
component StatChip inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 20px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 3px;
        alignment: center;

        Text {
            text: root.label;
            font-size: 8px * Theme.ui-scale;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-size: 9px * Theme.ui-scale;
            color: Theme.fg-2;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// 趋势卡（综合页 / CPU 页共用）：sur-2 圆角卡 = 标题行（图标 + 标题 + 可选当前值 +
// 1/5/15 分钟窗口切换）+ 面积折线 + 时间轴。图高 = chart-h **定值**：不要让折线
// 随卡片拉伸（综合页曾经这么干来"填满底部"，结果图高跟着各主机的磁盘分区 /
// 网络端口行数走，同一张图在不同主机上高矮不一 —— 用户截图对比）。
component TrendCard inherits Rectangle {
    in property <string> title;
    // ⚠ 别用 E9E2（monitoring）—— 那是 Material **Symbols** 的码位，经典
    // Material Icons 字体里没有这个字形 → 渲染成豆腐块（用户截图）。
    in property <string> title-icon: "\u{E30C}";   // computer
    in property <bool> lang-en: false;
    in property <[float]> values;
    in-out property <int> window: 60;
    in property <length> chart-h: 34px;            // 图的高度（**定值**，不随卡片拉伸）
    in property <string> value: "";                 // 标题行右侧当前值（如 2%）
    in property <color> tone: Theme.accent;         // 线色
    // 悬停读数（默认关）：开启后 LineChart 画游标线 + 数据点 + 气泡。
    // 只在需要「绝对时刻」的图上开（目前只有 CPU 负载趋势）。
    in property <bool> interactive: false;
    in property <[int]> times: [];        // 与 values 等长的采样时刻（本地秒-of-day）

    border-radius: Theme.radius-md;
    background: Theme.sur-2;

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;

            Text {
                text: root.title-icon;
                font-family: "Material Icons";
                font-size: 13px * Theme.ui-scale;
                color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                font-size: 12px * Theme.ui-scale;
                color: Theme.fg-1;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.value != "" : Text {
                text: root.value;
                font-size: 10px * Theme.ui-scale;
                font-weight: 600;
                color: Theme.fg-2;
                vertical-alignment: center;
            }
            WindowSwitch { value <=> root.window; lang-en: root.lang-en; }
        }
        if root.values.length == 0 : EmptyHint { lang-en: root.lang-en; }
        if root.values.length > 0 : LineChart {
            values: root.values;
            window: root.window;
            chart-h: root.chart-h;
            line-color: root.tone;
            interactive: root.interactive;
            times: root.times;
        }
        // 时间轴：历史是 1 Hz 采样，展示窗口就是秒数（左端 = N 秒前）
        if root.values.length > 0 : HorizontalLayout {
            Text {
                text: "-\{root.window > 0 ? min(root.window, root.values.length) : root.values.length}s";
                font-size: 9px * Theme.ui-scale;
                color: Theme.fg-3;
                horizontal-stretch: 1;
            }
            Text {
                text: root.lang-en ? "now" : "现在";
                font-size: 9px * Theme.ui-scale;
                color: Theme.fg-3;
            }
        }
    }
}


// ── 工具页共用的细滚动条 ────────────────────────────────────────────────
//
// ⚠ `Flickable` 只负责滚、**不画滚动条**。内容超出面板时用户根本看不出下面还有
// 东西 —— 分区多的机器（如 ARM NAS）实际上已经静默截掉一截了。
//
// 这里按 Flickable 的 `content-y` / `content-height` 画一条 4px 细滑块：
//   · 内容不超长 → 整条淡出（不占位、也不抢点击）；
//   · 滑块长度 = 可视/内容 的比例，位置 = 已滚比例，内容变化自动跟随；
//   · 不画轨道 —— 深色面板里一条常驻轨道太抢眼（macOS overlay 风格也是这样）。
//
// 只做**指示**，不接拖动：滚轮 / 触控板已经能滚，加拖动要自己算指针增量，
// 收益不大而边界情况多（拖到两端、内容变化时的夹取）。
component PanelScrollBar inherits Rectangle {
    in property <length> view-h: 0px;      // 可视高度（= Flickable 高度）
    in property <length> content-h: 0px;   // 内容总高（未设时由 Flickable 自动推导）
    in property <length> offset-y: 0px;    // 已滚距离（Flickable 的 content-y，通常为负）

    property <bool> needed: root.content-h > root.view-h + 1px;
    property <length> track-len: root.height;
    // 滑块最短 28px：内容很长时滑块不至于细到看不见、也还好点。
    property <length> thumb-len: root.content-h <= 0px ? 0px
        : max(28px, root.track-len * root.view-h / root.content-h);
    property <length> thumb-y: !root.needed ? 0px
        : max(0px, min(root.track-len - root.thumb-len,
            (root.track-len - root.thumb-len) * (-root.offset-y)
                / (root.content-h - root.view-h)));

    width: 4px;
    background: transparent;

    Rectangle {
        x: 0;
        y: root.thumb-y;
        width: parent.width;
        height: root.thumb-len;
        border-radius: 2px;
        background: Theme.fg-3.with-alpha(0.45);
        opacity: root.needed ? 1 : 0;
        animate opacity {
            duration: AnimationSettings.short2();
            easing: AnimationSettings.e-standard-accelerate();
            enabled: AnimationSettings.enabled;
        }
    }
}


export component RightPanel inherits Rectangle {
    /// 筛选弹层内容四周的内边距。
    ///
    /// ⚠ 这条是"弹层圆角不被悬停高亮盖成直角"的**唯一解**：高亮项是**不透明**的
    /// Rectangle，而 `clip: true` 在这个渲染器上对圆角不可靠 —— 所以只能靠**留白**
    /// 让高亮项压根不碰到圆角那一圈（旧代码没有它，磁盘/网络两个筛选菜单的顶/底
    /// 圆角都会被高亮盖成直角，边缘能看见方形色块）。
    private property <length> POPUP_PAD: 4px;
    /// 弹层内高亮项自己的圆角：小于弹层圆角，看起来是"内容块"而不是贴边的方条。
    private property <length> POPUP_ITEM_RADIUS: 6px;
    in property <bool> lang-en: false;
    // 服务器信息头卡的四个字段（Rust 按标签从 overview 里挑好）
    in property <string> panel-host;
    in property <string> panel-ip;
    in property <string> panel-os;
    in property <string> panel-uptime;
    in property <string> panel-load-1m;
    // 监控数据是否就绪（远端要等 overview 异步采回来）—— 未就绪时「工具」内容
  // 先不画，显示「等待监控数据…」加载态。
    in property <bool> panel-ready: false;
    // 内存 已用 / 总量（四卡底部行拆分显示）
    in property <string> mem-used;
    in property <string> mem-total;
    in property <string> net-selected;
    // CPU 明细（0..1）/ 每核占用 / 温度 / 进程 CPU 排行（CPU 页）
    in property <float> cpu-user: 0;
    in property <float> cpu-system: 0;
    in property <float> cpu-iowait: 0;
    in property <string> cpu-temp;
    in property <[float]> core-cpus;
    // 每核占用按奇偶分好的两列（CoreLoad.idx = 真实核心编号）
    in property <[CoreLoad]> cores-left;
    in property <[CoreLoad]> cores-right;
    in property <[ProcRow]> proc-top;
    property <int> head-tab: 0;
    /// 勾选的网卡 / 挂载点（Rust 镜像；只用于「已选 N」文案与「全部」项的勾选态，
    /// 逐行勾选态在 `SysNetRow.picked` / `DiskInfo.picked`）。
    ///
    /// 勾选 = **筛选**（只显示勾选的行；「全部」= 全显示，取消「全部」= 一行不剩）。
    /// 过滤由 Rust 侧不把行放进模型实现 —— 界面层用 `visible` 隐藏不行：Slint 里
    /// 布局子项 `visible: false` **仍然占位**，列表会留下一堆空格（用户反馈"太难看"）。
    /// 弹层遍历的是 `all-disks` / `all-ifs`（**未筛选**的完整列表），所以筛空之后
    /// 依然能重新勾选。
    in property <[string]> net-picked: [];
    in property <[string]> disk-picked: [];
    /// 「全部」那个复选框的勾选态（`net-picked` 为空时分不出"全选"和"全不选"）。
    in-out property <bool> net-picked-all: true;
    in-out property <bool> disk-picked-all: true;
    /// 勾选 / 取消勾选（复选框）。弹层**不自动关闭** —— 多选要在同一个弹层里连点。
    callback toggle-net-pick(string);
    callback toggle-disk-pick(string);
    // 按钮文案：0 = 全部，1 = 就那个名字，≥2 = 已选 N
    pure function net-pick-label() -> string {
        // 三态：全选 / 全不选 / 部分。名单为空时靠 `net-picked-all` 区分前两者 ——
        // 早先一律当"全部"，于是"取消全选"之后按钮文案毫无变化。
        if (root.net-picked-all && root.net-picked.length == 0) {
            return root.lang-en ? "All" : "全部网口";
        }
        if (root.net-picked.length == 0) {
            return root.lang-en ? "None" : "未选";
        }
        // ⚠ Slint 的字符串插值必须写成 `\{expr}`（**一个**反斜杠 + 花括号），项目里
        // 到处都是这个写法。写成 `\\{expr}` 会变成"转义反斜杠 + 字面花括号"，写成
        // 零反斜杠的 `{expr}` 则整段是字面量 —— 两种都会让按钮显示出无关参数。
        return root.net-picked.length == 1 ? root.net-picked[0]
            : "\{root.net-picked.length} " + (root.lang-en ? "picked" : "已选");
    }
    pure function disk-pick-label() -> string {
        if (root.disk-picked-all && root.disk-picked.length == 0) {
            return root.lang-en ? "All" : "全部磁盘";
        }
        if (root.disk-picked.length == 0) {
            return root.lang-en ? "None" : "未选";
        }
        // 插值必须是 `\{...}`，见 net-pick-label 的注释。
        return root.disk-picked.length == 1 ? root.disk-picked[0]
            : "\{root.disk-picked.length} " + (root.lang-en ? "picked" : "已选");
    }
    // 负载历史的展示窗口（秒）：1/5/15 分钟 = 60/300/900；综合页与 CPU 页各自记忆
    property <int> cpu-window: 60;
    pure function net-popup-h() -> length {
        // +8px：弹层内容上下各 4px 内边距（POPUP_PAD）—— 高亮项不贴边，圆角才露得出来。
        // ⚠ 必须用 `all-ifs`（弹层真正遍历的那份**完整**列表），不能用筛选后的
        // `net-rows`：否则取消全选后高度塌成只剩「全部」一行、其它选项被裁掉
        // 点不到（用户反馈"只能再次点击全选才能选择其他选项"），而且每次勾选都会
        // 让菜单长度跳一下。行数多时靠内部 Flickable 滚动。
        return min(280px, 28px * (root.all-ifs.length + 1) + POPUP_PAD * 2);
    }
    // ── 磁盘分区筛选（照网络端口那套：标题行右侧一个下拉按钮 + 弹层）──────────
    // ── 磁盘分区筛选（勾选置顶，见 disk-picked）───────────────────────────
    pure function disk-popup-h() -> length {
        // 「全部磁盘」占一行；+ 上下内边距。同 net-popup-h：按 `all-disks`
        // （完整列表）算，高度才恒定。
        return min(280px, 28px * (root.all-disks.length + 1) + POPUP_PAD * 2);
    }
    // 所有内容页（Flickable 内容列）的统一内边距 —— 单一处管理，改这里全页生效。
    // 5px = 顶部切换条的按钮边距（两边对齐；用户定值）。
    property <length> content-pad: 5px;
    in property <[TransferInfo]> transfers;
    in property <bool> transfers-active: false;
    in property <bool> sftp-follow-cd;
    in property <bool> always-ask;
    callback set-flag-follow-cd(bool);
    callback set-flag-always-ask(bool);
    callback close-panel();
    // 资源卡片（真数据：Rust `refresh_sidebar` 每秒写窗口属性，这里只负责摆）
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <string> mem-detail;
    in property <float> swap-percent;
    in property <string> swap-detail;
    in property <[DiskInfo]> disks;
    /// 弹层的完整选择列表（未置顶）—— 与展示用的 `disks` 分开。
    in property <[DiskInfo]> all-disks;
    in property <string> net-up;
    in property <string> net-down;
    // 历史曲线（0..1 归一化）：CPU 趋势、当前会话网卡、本机网卡
    in property <[float]> cpu-history;
    // 与 cpu-history 等长的采样时刻（本地「当天秒数」），供悬停气泡显示绝对时钟。
    in property <[int]> cpu-history-times;
    in property <[float]> net-history;
    in property <[float]> net-history-bot;
    // 逐网卡速率（远端 = 会话自己的网卡表，本机 = 一行本地总速率）
    in property <[SysNetRow]> net-rows;
    /// 弹层的完整网卡选择列表（未置顶）。
    in property <[SysNetRow]> all-ifs;
  // 折叠成 22px 窄条（「收起 SFTP 侧边栏」）：状态在窗口级，终端舞台按它让位。
    in-out property <bool> collapsed: false;
    // 展开基准宽度（= 窗口级 `panel-user-w`，用户拖拽出来的会话内记忆值）。
    // 面板本体**恒为这个宽度**、不再在 22↔340 之间变化 —— 宽度动画会把内容逐帧
    // 挤压重排，观感很糟。折叠改为整体**位移滑出**（见 app_shell 的 `panel-x`）。
    in property <length> expanded-w: 340px;
    // footer 徽标（Rust 数出来的当前目录统计）
    in property <int> sftp-dir-count;
    in property <int> sftp-file-count;
    in property <string> sftp-total;
    // 面包屑（Rust 按 `/` 切好）与列头排序方向
    in property <[SftpCrumb]> sftp-crumbs;
    in property <string> sftp-sort-key;
    in property <int> sftp-sort-dir;
    // 活动标签的隧道 / SFTP —— 窗口级镜像（见 shell/app_shell.slint 的属性声明处）。
    in property <[TunnelInfo]> tunnels;
    in property <string> sftp-path;
    in property <[SftpEntry]> sftp-entries;
    in property <string> sftp-status;
    in property <bool> sftp-loading: false;
    in property <bool> sftp-available: false;
    // 面板挂在窗口级，回调不带 tab-id；实例化处补 `active-tab-id` 走既有链路。
    callback sftp-navigate(string /* path；".." = 上级目录 */);
    callback sftp-refresh(string /* path */);
    callback sftp-download(string /* path */);
    callback sftp-upload(string /* dir */, bool /* folder */);
    callback sftp-new-folder(string /* dir */);
    callback sftp-sort-request(string /* key */);
    // 搜索框：查询串住在窗口级（Rust 侧按它过滤列表），改动即时通知。
    in-out property <string> search;
    callback search-changed(string);

    property <int> current-tab: 0; // 0 综合 · 1 CPU · 2 内存 · 3 磁盘 · 4 网络 · 5 传输 · 6 文件
    // CPU 负载趋势图的高度：综合页与 CPU 页**同一个值**（用户要求两页一致）。
    //
    // ⚠ 抽成单一常量而不是两边各写一个数字 —— 分开写迟早会悄悄跑偏，然后又变成
    // "同一张图在不同地方高矮不一"。网络那两张趋势图是 40px，量级不同，不共用。
    //
    // ⚠ 写成「120px 封顶 + 面板高度比例兜底」而不是写死 120px：
    // 窗口的**逻辑**高度会随分辨率 / 缩放变化（高 DPI 下逻辑像素变少），而面板
    // 高度 = 窗口高 − 顶部 − 底部。写死 120px 的话，在小窗口或高缩放档里这张图
    // 会占掉面板大半、其余内容全靠滚动；大屏上又显得偏小。
    // 现在：常规尺寸仍取 120px（观感不变），面板偏矮时按比例收到最低 72px。
    //
    // ⚠ 比例基准必须是 `root.height`（面板自身高度，app_shell 里显式给的：
    // `height: root.height - root.shell-top - 28px`，**与内容无关**）—— 不能用
    // Flickable 的高度，它会被内容顶动，而图表本身就是内容的一部分，会成环。
    property <length> cpu-trend-h: min(120px, max(72px, root.height * 0.22));
    property <string> file-path-label: !root.sftp-available
        ? (root.lang-en ? "SFTP unavailable for this session" : "此会话不支持 SFTP")
        : (root.sftp-path == "" ? "/" : root.sftp-path);
    // 列头的排序方向后缀（key + dir 都是 Rust 从活动行镜像过来的真状态）。
    property <string> sort-suffix-name:
        root.sftp-sort-key == "name" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "name" && root.sftp-sort-dir < 0 ? " ↓" : "";
    property <string> sort-suffix-size:
        root.sftp-sort-key == "size" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "size" && root.sftp-sort-dir < 0 ? " ↓" : "";
    property <string> sort-suffix-modified:
        root.sftp-sort-key == "modified" && root.sftp-sort-dir > 0 ? " ↑"
        : root.sftp-sort-key == "modified" && root.sftp-sort-dir < 0 ? " ↓" : "";
    // 0 不可用 · 1 加载中（还没有内容）· 2 空目录 · 3 列表
    property <int> file-view: !root.sftp-available ? 0
        : (root.sftp-loading && root.sftp-entries.length == 0 ? 1
        : (root.sftp-entries.length == 0 ? 2 : 3));

  // 展开 340px / 收起 22px 窄条（「收起 SFTP 侧边栏」）。
    // 240px 那版 7 个标签挤在一起、指标卡里的详情文字也被压到换行（用户截图），
  // 设计的面板本身就很宽 —— 加宽到 340px（app_shell 的 panel-w 同步）。
    // 恒为展开宽度：位移滑出时面板整体平移，内容不会被挤变形。
    width: root.expanded-w;

    // 与终端同一块"磨砂玻璃"：都用 `term-bg` —— 它跟着「外观 ▸ 遮罩」的
    // 壁纸遮罩透明度（0–70%）一起变，面板与终端因此始终同色同透，没有生硬的
    // 分隔线；卡片靠 sur-2 自己浮出来。
    // 注：透明磨砂需要**有壁纸**才看得出效果（没有壁纸时 `frost()` 返回纯色）。
    background: Theme.term-bg;
    clip: true;

    // ── 收起态的 22px 把手 ──────────────────────────────────────────
    // ⚠ 不能画在面板里：面板收起时整体滑出窗口，画在这里会跟着一起跑掉。
    // 它已移到 app_shell（固定贴在窗口右缘，见「右侧面板收起后的 22px 把手」）。

    // 内容**始终存在**（不再用 `if !collapsed` 销毁）：销毁就没有退出动画，收起会
    // 变成瞬间消失。收起时它随面板本体一起滑出窗口右缘。
    VerticalLayout {
        // ⚠ 必须显式铺满：本组件根是普通 Rectangle（不是布局），按 Slint 规则
        // 里面的 Layout 会按**首选尺寸**布局 —— 不铺满时首帧先给一个窄宽度、
        // 下一帧才补满，打开瞬间就是"两侧向中间收缩一下再展开"。
        width: 100%;
        height: 100%;
        // ── 面板头：工具 + 收起 + 关闭 ──────────────────────────────────
        // 上下 padding 各 6px：行内高度正好 20px，固定 20px 的按钮因此在行内居中
        // （HorizontalLayout 的交叉轴默认是拉伸，靠子项自身高度定死才不跑偏）。
        HorizontalLayout {
            // 与终端标签条同高（40px）：两条"页签行"在同一水平线上，顶部才连得起来
            height: 40px;
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;

            PanelHeadTab {
                label: root.lang-en ? "Tools" : "工具";
                active: root.head-tab == 0;
                clicked => { root.head-tab = 0; }
            }
  // AI 只是占位（有这一项，项目还没接模型）—— 点开只有一张说明卡。
            PanelHeadTab {
                label: "AI";
                active: root.head-tab == 1;
                clicked => { root.head-tab = 1; }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
            IconBtn {
                glyph: "\u{E5CC}";   // chevron_right：向窗口右缘收起
                clicked => {
                    root.collapsed = true;
                }
            }
            IconBtn {
                glyph: "\u{E5CD}";   // 关闭面板（舞台随之收回这块宽度）
                clicked => {
                    root.close-panel();
                }
            }
        }

        // ── 内容标签：5 个监控视图 + 传输 / 文件（全部真数据）────────────
  // 设计的标签是 综合 / 处理器 / 显卡 / 内存 / 磁盘 / 网络；显卡项目没有采集，
        // 不做（见文件头）。每个标签 图标 + 文案、等分宽度（见 PanelTab）。
        if root.head-tab == 0 && root.panel-ready : HorizontalLayout {
            // 标签条高度随内容、不参与拉伸（多出来的高度只给下面的内容区）
            // （用 if 而不是 visible —— visible 的元素在布局里占位。）
            vertical-stretch: 0;
            height: 32px;
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 3px;

            PanelTab {
                label: root.lang-en ? "Sum" : "综合";
                icon: "\u{E1C3}";   // table/rows
                active: root.current-tab == 0;
                clicked => {
                    root.current-tab = 0;
                }
            }
            PanelTab {
                label: "CPU";
                icon: "\u{E30C}";   // computer
                active: root.current-tab == 1;
                clicked => {
                    root.current-tab = 1;
                }
            }
            PanelTab {
                label: root.lang-en ? "Mem" : "内存";
                icon: "\u{E322}";   // memory
                active: root.current-tab == 2;
                clicked => {
                    root.current-tab = 2;
                }
            }
            PanelTab {
                label: root.lang-en ? "Disk" : "磁盘";
                icon: "\u{E1DB}";   // storage
                active: root.current-tab == 3;
                clicked => {
                    root.current-tab = 3;
                }
            }
            PanelTab {
                label: root.lang-en ? "Net" : "网络";
                icon: "\u{E1AF}";   // network_check
                active: root.current-tab == 4;
                clicked => {
                    root.current-tab = 4;
                }
            }
            PanelTab {
                label: root.lang-en ? "Xfers" : "传输";
                icon: "\u{E5D8}";   // arrow_upward（上传/下载一对，这里取一个）
                active: root.current-tab == 5;
                clicked => {
                    root.current-tab = 5;
                }
            }
            PanelTab {
                label: root.lang-en ? "Files" : "文件";
                icon: "\u{E2C7}";   // folder
                active: root.current-tab == 6;
                clicked => {
                    root.current-tab = 6;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── 综合：CPU 趋势 + 磁盘分区 + 网络端口（卡片在上方常驻，不重复）──
  // ── AI 占位卡（头部有这一项；项目还没接模型，不放假功能）──
        if root.head-tab == 1 : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                padding: 16px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.sur-3;

                    Text {
                        text: "AI";
                        font-size: 14px * Theme.ui-scale;
                        font-weight: 700;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.lang-en ? "AI assistant" : "AI 助手";
                    font-size: 13px * Theme.ui-scale;
                    font-weight: 600;
                    color: Theme.fg-1;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.lang-en
                        ? "Coming soon — no model is wired up in this build."
                        : "即将上线 —— 本版本尚未接入模型。";
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }


  // ── 加载态：会话刚连上、overview 还没采回来时，「工具」
        // 内容先不画 —— 数据到齐（panel-ready）再一次性亮出来，避免看到一堆
        // 0% / 空卡片的中间态。
        if root.head-tab == 0 && !root.panel-ready : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text {
                    // 转圈加载：sync 双箭头圆环，360° 无限旋转
                    text: "\u{E627}";
                    font-family: "Material Icons";
                    font-size: 32px * Theme.ui-scale;
                    color: Theme.fg-3;
                    horizontal-alignment: center;
                    transform-rotation: 360deg;
                    animate transform-rotation {
                        duration: AnimationSettings.ambient();
                        iteration-count: -1;
                        enabled: AnimationSettings.enabled;
                    }
                }
                Text {
                    text: root.lang-en ? "Waiting for monitoring data..." : "等待监控数据…";
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    horizontal-alignment: center;
                    // 呼吸：透明度 1.2s 往返
                    // 呼吸：透明度往返（常驻循环，受「界面动画」开关门控）
                    animate opacity {
                        duration: AnimationSettings.ambient();
                        iteration-count: -1;
                        direction: alternate;
                        easing: AnimationSettings.breathing();
                        enabled: AnimationSettings.enabled;
                    }
                }
            }
        }


if root.head-tab == 0 && root.current-tab == 0 && root.panel-ready : Rectangle {
            vertical-stretch: 1;
            flick0 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                // 内容列随 Flickable 撑满/滚动。各卡片都是自然高度（`vertical-stretch: 0`）：
                // ⚠ 不要把富余高度交给 CPU 趋势卡（曾经这么做来"填满底部"）—— 那会让
                // 图高取决于这台主机其它内容的多少（磁盘分区 / 网络端口行数），同一张图
                // 在不同主机上高矮不一。宁可底部留白，图高必须一致。
                x: 0;
                y: 0;
                padding: root.content-pad;
                spacing: 6px;


        // 头卡：综合页内容的一部分 —— 跟趋势卡等同列同边距、随页面滚动。
            if root.panel-host != "" : Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.sur-2;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "\u{EB8E}";   // terminal
                        font-family: "Material Icons";
                        font-size: 14px * Theme.ui-scale;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.panel-host;          // 主机名称
                        font-size: 13px * Theme.ui-scale;
                        font-weight: 600;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        max-width: 150px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.sur-3;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;

                            Text {
                                text: root.panel-ip;
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-2;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    if root.panel-os != "" : Text {
                        text: "操作系统：\{root.panel-os}";
                        font-size: 10px * Theme.ui-scale;
                        color: Theme.fg-3;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.panel-uptime != "" : Text {
                        text: root.panel-uptime;
                        font-size: 10px * Theme.ui-scale;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 四卡：综合页内容的一部分（宽度 = 内容卡宽的一半，见各行内公式）。
        // C 步会在下面接 CPU 趋势 / 磁盘分区 / 网络端口，并把这里收进「综合」标签。
        // ⚠ 用 if 而不是 visible：visible 的元素在布局里占位（其它标签页顶部留白）。
        if root.head-tab == 0 && root.current-tab == 0 && root.panel-ready : HorizontalLayout {
            // 行高度随内容、**不允许拉伸**：面板里多出来的高度归下面的内容区
            //（否则这两行会平分剩余空间，卡片被摊成一大块 —— 用户截图）。
            vertical-stretch: 0;
            spacing: 4px;

            ResCard {
                // 四张卡宽度**平分**（以后工具面板能拖拽拉伸，必须跟着等分）：
                // 行内 padding 8+8 + 卡片间距 4 = 20px 要扣掉。
                width: (root.width - 24px) / 2;

                label: "CPU";
  icon: "\u{E322}";  // memory-chip：设计的 CPU 图标
                tone: Theme.accent;
                value: "\{round(root.cpu-percent * 100)}%";
                percent: root.cpu-percent;
                foot-left: root.panel-load-1m == "" ? "" : (root.lang-en ? "load \{root.panel-load-1m}" : "负载 \{root.panel-load-1m}");
            }
            ResCard {
                // 四张卡宽度**平分**（以后工具面板能拖拽拉伸，必须跟着等分）：
                // 行内 padding 8+8 + 卡片间距 4 = 20px 要扣掉。
                width: (root.width - 24px) / 2;

                label: root.lang-en ? "MEM" : "内存";
  icon: "\u{E1DB}";  // storage：设计的层叠图标
                tone: Theme.success;
                value: "\{round(root.mem-percent * 100)}%";
                percent: root.mem-percent;
                foot-left: root.mem-used;
                foot-right: root.mem-total;
            }
        }
        // ⚠ 用 if 而不是 visible：visible 的元素在布局里占位（其它标签页顶部留白）。
        if root.head-tab == 0 && root.current-tab == 0 && root.panel-ready : HorizontalLayout {
            // 行高度随内容、**不允许拉伸**：面板里多出来的高度归下面的内容区
            //（否则这两行会平分剩余空间，卡片被摊成一大块 —— 用户截图）。
            vertical-stretch: 0;
            spacing: 4px;

            ResCard {
                // 四张卡宽度**平分**（以后工具面板能拖拽拉伸，必须跟着等分）：
                // 行内 padding 8+8 + 卡片间距 4 = 20px 要扣掉。
                width: (root.width - 24px) / 2;

                label: root.lang-en ? "DISK" : "磁盘";
  icon: "\u{E875}";  // dns：设计的磁盘盒子
                tone: Theme.warning;
                value: root.disks.length > 0 ? "\{round(root.disks[0].percent * 100)}%" : "—";
                percent: root.disks.length > 0 ? root.disks[0].percent : 0;
                foot-left: root.disks.length > 0 ? root.disks[0].used : "";
                foot-right: root.disks.length > 0 ? root.disks[0].total : "";
            }
  // 网络卡：没有进度条 —— 中间槽放 ↓/↑ 一对速率，底部行放当前网卡。
            ResCard {
                // 四张卡宽度**平分**（以后工具面板能拖拽拉伸，必须跟着等分）：
                // 行内 padding 8+8 + 卡片间距 4 = 20px 要扣掉。
                width: (root.width - 24px) / 2;

                label: root.lang-en ? "NET" : "网络";
                icon: "\u{E63E}";   // wifi
                tone: Theme.ok;
                show-bar: false;
                mid-left: "↓ \{root.net-down}";
                mid-right: "↑ \{root.net-up}";
                foot-left: root.net-selected;
            }
        }


  // 综合页的每个区块都是一张卡（标题 + 内容），不再是裸标题。
                TrendCard {
                    // 图高**定值**（与 CPU 页同一个 cpu-trend-h），不吸收面板富余 —— 否则图高跟着这台主机的
                    // 磁盘分区 / 网络端口行数走（分区少的机器图很高、多的被压到最小），
                    // 同一条曲线在不同主机上斜率观感都不一样。富余变成底部留白。
                    vertical-stretch: 0;
                    title: root.lang-en ? "CPU load trend" : "CPU 负载趋势";
                    lang-en: root.lang-en;
                    values: root.cpu-history;
                    // 悬停读数：游标 + 数据点 + 气泡（绝对时刻 + 该点负载）
                    interactive: true;
                    times: root.cpu-history-times;
                    window <=> root.cpu-window;
                    value: "\{round(root.cpu-percent * 100)}%";
                    chart-h: root.cpu-trend-h;
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    vertical-stretch: 0;
                    background: Theme.sur-2;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "\u{E1DB}";   // storage
                                font-family: "Material Icons";
                                font-size: 13px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.lang-en ? "Disk partitions" : "磁盘分区";
                                font-size: 12px * Theme.ui-scale;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                            }

                            // 挂载点筛选按钮（照网络端口那套：点开一个下拉列表）
                            disk-btn := Rectangle {
                                // ⚠ 宽度**不能**写成 `dsk-btn.preferred-width + 16px`：那是按钮宽度反过来依赖
                                // 自己内部 Text 的 preferred-width，而这个 Text 在横向布局里会被 clamp 到
                                // "剩余可用宽度" —— 于是形成自指循环：文案越短宽度越窄，而那点余量（16px）
                                // 根本放不下"左内边距 6 + 间距 2 + 箭头 10 + 右内边距 3"，箭头被挤到边缘
                                // 甚至溢出按钮（用户截图：筛成 `/` 时箭头炸出来）。
                                //
                                // 改成**固定宽度 + 文字 stretch + elide**：宽度与文案无关、恒定不跳
                                // （长度不跳也是用户明确要求的直觉），超长的挂载点名直接省略。
                                width: 96px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: dsk-ta.has-hover ? Theme.sur-3 : Theme.sur-2;
                                clip: true;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 4px;
                                    spacing: 2px;
                                    dsk-btn := Text {
                                        text: root.disk-pick-label();
                                        font-size: 10px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                        // 吃掉按钮剩余宽度；超长（长挂载点名）省略，不挤箭头。
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "\u{E5CE}";
                                        font-family: "Material Icons";
                                        font-size: 10px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                        vertical-alignment: center;
                                    }
                                }
                                dsk-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        // 位置由弹层自己算（卡片内相对坐标，见 disk-popup）。
                                        // ⚠ 别再用 `absolute-position`：那是**窗口**坐标，而
                                        // PopupWindow 的 x/y 走**父元素**坐标，混用会双重偏移
                                        // （曾把弹层甩到面板左下角）。
                                        disk-popup.show();
                                    }
                                }
                            }
                        }
                        if root.disks.length == 0 : EmptyHint {
                            lang-en: root.lang-en;
                            alt-text: root.all-disks.length == 0 ? ""
                                : (root.lang-en ? "Nothing selected" : "未选择任何项");
                        }
                        for d in root.disks : MetricRow {
                            label: d.path;
                            value: d.detail;
                            percent: d.percent;
                        }

                        // 挂载点筛选弹层
                    }

                    disk-popup := PopupWindow {
                        // 右对齐到卡片内容右缘（卡片 padding 8px）。
                        // 落在标题行下方一点。
                        x: parent.width - 198px;
                        y: 30px;
                        Rectangle {
                            width: 190px;
                            height: root.disk-popup-h();
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.sur-1;
                            VerticalLayout {
                                spacing: 0;
                                alignment: start;
                                // 见 net-popup 的注释：内边距是"圆角不被高亮盖成
                                // 直角"的唯一解。
                                padding: root.POPUP_PAD;
                                Rectangle {
                                    height: 28px;
                                    border-radius: root.POPUP_ITEM_RADIUS;
                                    background: root.disk-picked-all ? Theme.rail-item-active
                                        : (dall-ta.has-hover ? Theme.rail-item-hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 8px;
                                        dall-box := CheckMark {
                                            // 14px 方框在 28px 行里默认贴顶 → 显式垂直居中
                                            cross-axis-self-alignment: center;
                                            on: root.disk-picked-all;
                                            // 部分选中：勾了一些但没全选（复选框组第三态）。
                                            partial: !root.disk-picked-all
                                                && root.disk-picked.length > 0
                                                && root.disk-picked.length < root.all-disks.length;
                                        }
                                        Text {
                                            text: root.lang-en ? "All disks" : "全部磁盘";
                                            font-size: 11px * Theme.ui-scale;
                                            color: root.disk-picked-all ? Theme.accent : Theme.fg-1;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    dall-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-disk-pick(""); }
                                    }
                                }
                                Flickable {
                                    VerticalLayout {
                                        height: self.preferred-height;
                                        for d in root.all-disks : Rectangle {
                                            height: 28px;
                                            border-radius: root.POPUP_ITEM_RADIUS;
                                            background: d.picked ? Theme.rail-item-active
                                                : (drow-ta.has-hover ? Theme.rail-item-hover : transparent);
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 8px;
                                                drow-box := CheckMark {
                                                    // 14px 方框在 28px 行里默认贴顶 → 显式垂直居中
                                                    cross-axis-self-alignment: center;
                                                    on: d.picked;
                                                }
                                                Text {
                                                    text: d.path;
                                                    font-size: 11px * Theme.ui-scale;
                                                    color: d.picked ? Theme.accent : Theme.fg-1;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            drow-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.toggle-disk-pick(d.path); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    vertical-stretch: 0;
                    background: Theme.sur-2;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "\u{E1AF}";   // network_check
                                font-family: "Material Icons";
                                font-size: 13px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.lang-en ? "Network interfaces" : "网络端口";
                                font-size: 12px * Theme.ui-scale;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                horizontal-stretch: 1;
                            }
                            net-btn := Rectangle {
                                // ⚠ 宽度**不能**写成 `nic-btn.preferred-width + 16px`：那是按钮宽度反过来依赖
                                // 自己内部 Text 的 preferred-width，而这个 Text 在横向布局里会被 clamp 到
                                // "剩余可用宽度" —— 于是形成自指循环：文案越短宽度越窄，而那点余量（16px）
                                // 根本放不下"左内边距 6 + 间距 2 + 箭头 10 + 右内边距 3"，箭头被挤到边缘
                                // 甚至溢出按钮（用户截图：筛成 `/` 时箭头炸出来）。
                                //
                                // 改成**固定宽度 + 文字 stretch + elide**：宽度与文案无关、恒定不跳
                                // （长度不跳也是用户明确要求的直觉），超长的挂载点名直接省略。
                                width: 96px;
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: nic-ta.has-hover ? Theme.sur-3 : Theme.sur-2;
                                clip: true;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 4px;
                                    spacing: 2px;
                                    nic-btn := Text {
                                        text: root.net-pick-label();
                                        font-size: 10px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                        // 吃掉按钮剩余宽度；超长（长挂载点名）省略，不挤箭头。
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "\u{E5CE}";
                                        font-family: "Material Icons";
                                        font-size: 10px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                        vertical-alignment: center;
                                    }
                                }
                                nic-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        // 位置由弹层自己算（卡片内相对坐标，朝上弹）。
                                        net-popup.show();
                                    }
                                }
                            }
                        }
                        if root.net-rows.length == 0 : EmptyHint {
                            lang-en: root.lang-en;
                            alt-text: root.all-ifs.length == 0 ? ""
                                : (root.lang-en ? "Nothing selected" : "未选择任何项");
                        }
                        // 不按勾选过滤（`visible` 过滤在布局里仍占位 → 留空隙）：
                        // 勾选的行由 Rust 置顶，其余照常显示。
                        for n in root.net-rows : NetIfaceRow {
                            name: n.name;
                            down: n.down;
                            up: n.up;
                        }

                    }

                    net-popup := PopupWindow {
                        // 右对齐到卡片内容右缘（卡片 padding 8px）。
                        // ⚠ 弹层声明在卡片内容布局**之外**，所以 y 为负 = 弹到卡片
                        // 上方（这张卡贴着面板底部，往下弹会出界）。
                        x: parent.width - 198px;
                        y: -(root.net-popup-h() + 6px);
                        Rectangle {
                            width: 190px;
                            height: root.net-popup-h();
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.sur-1;
                            VerticalLayout {
                                spacing: 0;
                                alignment: start;
                                // ⚠ 上下左右都留内边距：不留的话「全部网口」那一项
                                // 会**贴住弹层顶边**，悬停时它不透明的方形底色直接盖住
                                // 圆角 → 弹层顶部看起来是直角（用户反馈）。
                                // `clip: true` 对圆角不可靠，只能靠留白。
                                padding: root.POPUP_PAD;
                                Rectangle {
                                    height: 28px;
                                    border-radius: root.POPUP_ITEM_RADIUS;
                                    background: root.net-picked-all ? Theme.rail-item-active
                                        : (nall-ta.has-hover ? Theme.rail-item-hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 8px;
                                        nall-box := CheckMark {
                                            // 14px 方框在 28px 行里默认贴顶 → 显式垂直居中
                                            cross-axis-self-alignment: center;
                                            on: root.net-picked-all;
                                            // 部分选中：勾了一些但没全选（复选框组第三态）。
                                            partial: !root.net-picked-all
                                                && root.net-picked.length > 0
                                                && root.net-picked.length < root.all-ifs.length;
                                        }
                                        Text {
                                            text: root.lang-en ? "All interfaces" : "全部网口";
                                            font-size: 11px * Theme.ui-scale;
                                            color: root.net-picked-all ? Theme.accent : Theme.fg-1;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    nall-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-net-pick(""); }
                                    }
                                }
                                Flickable {
                                VerticalLayout {
                                    height: self.preferred-height;
                                for n in root.all-ifs : Rectangle {
                                    height: 28px;
                                    border-radius: root.POPUP_ITEM_RADIUS;
                                    background: n.picked ? Theme.rail-item-active
                                        : (nrow-ta.has-hover ? Theme.rail-item-hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 8px;
                                        nrow-box := CheckMark {
                                            // 14px 方框在 28px 行里默认贴顶 → 显式垂直居中
                                            cross-axis-self-alignment: center;
                                            on: n.picked;
                                        }
                                        Text {
                                            text: n.name;
                                            font-size: 11px * Theme.ui-scale;
                                            color: n.picked ? Theme.accent : Theme.fg-1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    nrow-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        // 不关弹层：多选要能连点好几项
                                        clicked => { root.toggle-net-pick(n.name); }
                                    }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick0.height;
                content-h: flick0.content-height;
                offset-y: flick0.content-y;
            }
        }

        // ── 处理器：CPU 数值 + 趋势（放大版）────────────────────────────
if root.head-tab == 0 && root.current-tab == 1 && root.panel-ready : Rectangle {
            vertical-stretch: 1;
            flick1 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                // 内容列随 Flickable 撑满/滚动：各卡用 vertical-stretch 定角色 ——
                // 占比卡 / 核心详情 / 趋势卡 0（自然高度），进程排行 1（吸收剩余
                // 高度，底部不再留白 —— 用户截图）；行数超出时列表内部滚动。
                x: 0;
                y: 0;
                padding: root.content-pad;
                spacing: 6px;

  // （终端-工具-处理器）：**有占比条的卡在左两列**（总负载/用户态 +
                // 内核态/IO 等待，2×2），**只有数字的卡在右一列**（负载均值/温度，竖排）。
                // 六张卡同宽 w=(root.width-44)/3：左区=2w+4、右列=w，正好铺满一行。
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 4px;

                    // 左 2/3：占比卡 2×2
                    VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 4px;

                            ResCard {
                                width: (root.width - 28px) / 3;
                                label: root.lang-en ? "Total load" : "总负载";
                                icon: "\u{E30C}";   // computer
                                tone: Theme.accent;
                                value: "\{round(root.cpu-percent * 100)}%";
                                percent: root.cpu-percent;
                            }
                            ResCard {
                                width: (root.width - 28px) / 3;
                                label: root.lang-en ? "User" : "用户态";
                                icon: "\u{E7FD}";   // person
                                tone: Theme.accent;
                                value: "\{round(root.cpu-user * 1000) / 10}%";
                                percent: root.cpu-user;
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;

                            ResCard {
                                width: (root.width - 28px) / 3;
                                label: root.lang-en ? "System" : "内核态";
                                icon: "\u{E8B8}";   // settings
                                tone: Theme.success;
                                value: "\{round(root.cpu-system * 1000) / 10}%";
                                percent: root.cpu-system;
                            }
                            ResCard {
                                width: (root.width - 28px) / 3;
                                label: root.lang-en ? "IO wait" : "IO 等待";
                                icon: "\u{E8B5}";   // schedule
                                tone: Theme.warning;
                                value: "\{round(root.cpu-iowait * 1000) / 10}%";
                                percent: root.cpu-iowait;
                            }
                        }
                    }
                    // 右 1/3：数字卡竖排（负载均值 / 温度）
                    VerticalLayout {
                        spacing: 4px;

                        ResCard {
                            width: (root.width - 28px) / 3;
                            label: root.lang-en ? "Load avg" : "负载均值";
                            icon: "\u{E8B5}";   // schedule
                            tone: Theme.ok;
                            value: root.panel-load-1m == "" ? "—" : root.panel-load-1m;
                            show-bar: false;
                        }
                        ResCard {
                            width: (root.width - 28px) / 3;
                            label: root.lang-en ? "Temp" : "温度";
                            icon: "\u{E1FF}";   // device_thermostat
                            tone: Theme.danger;
                            value: (root.cpu-temp == "" || root.cpu-temp == "-") ? "N/A" : root.cpu-temp;
                            show-bar: false;
                        }
                    }
                }

                // 核心详情：每核一条占用条（差分自 /proc/stat 的 cpuN 行，2s 一拍）
                Rectangle {
                    vertical-stretch: 0;
                    border-radius: Theme.radius-md;
                    background: Theme.sur-2;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "\u{E30D}";   // developer_board
                                font-family: "Material Icons";
                                font-size: 13px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.lang-en ? "Core details" : "核心详情";
                                font-size: 12px * Theme.ui-scale;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "\{root.core-cpus.length} " + (root.lang-en ? "cores" : "核");
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                        }
                        if root.core-cpus.length == 0 : Text {
                            text: root.lang-en ? "Sampling..." : "采样中…";
                            font-size: 10px * Theme.ui-scale;
                            color: Theme.fg-3;
                        }
                        // 两列排布：偶数核在左列、奇数核在右列 —— 超多核（32/64 核）
                        // 只占一半行数，卡片不会被拖得过长（用户要求考虑多核排版）。
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;

                                for c in root.cores-left : HorizontalLayout {
                                    height: 15px;

                                    Text {
                                        text: "#" + c.idx;
                                        width: 24px;
                                        font-size: 9px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 15px;

                                        Rectangle {
                                            y: (parent.height - 4px) / 2;
                                            x: 0;
                                            width: parent.width;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: Theme.sur-3;

                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * clamp(c.load, 0.0, 1.0);
                                                height: parent.height;
                                                border-radius: 2px;
                                                background: c.load > 0.85 ? Theme.danger : Theme.success;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "\{round(c.load * 1000) / 10}%";
                                        width: 36px;
                                        font-size: 9px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;

                                for c in root.cores-right : HorizontalLayout {
                                    height: 15px;

                                    Text {
                                        text: "#" + c.idx;
                                        width: 24px;
                                        font-size: 9px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 15px;

                                        Rectangle {
                                            y: (parent.height - 4px) / 2;
                                            x: 0;
                                            width: parent.width;
                                            height: 4px;
                                            border-radius: 2px;
                                            background: Theme.sur-3;

                                            Rectangle {
                                                x: 0;
                                                y: 0;
                                                width: parent.width * clamp(c.load, 0.0, 1.0);
                                                height: parent.height;
                                                border-radius: 2px;
                                                background: c.load > 0.85 ? Theme.danger : Theme.success;
                                            }
                                        }
                                    }
                                    Text {
                                        text: "\{round(c.load * 1000) / 10}%";
                                        width: 36px;
                                        font-size: 9px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 负载历史：综合页同款 TrendCard（本页内容长，图高固定、整页滚动）
                TrendCard {
                    title: root.lang-en ? "Load history" : "负载历史";
                    lang-en: root.lang-en;
                    values: root.cpu-history;
                    // 悬停读数：游标 + 数据点 + 气泡（绝对时刻 + 该点负载）
                    interactive: true;
                    times: root.cpu-history-times;
                    window <=> root.cpu-window;
                    chart-h: root.cpu-trend-h;
                }

                // 进程 CPU 占用排行：PROC_CMD 已 --sort=-pcpu，取前 20 行，2s 一拍。
                // vertical-stretch: 1 吸收页面剩余高度（底部空白 —— 用户截图）；
                // 行列表套自己的 Flickable，行数超出可视高度时鼠标滚轮内滚动。
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-md;
                    background: Theme.sur-2;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "\u{E242}";   // format_list_numbered
                                font-family: "Material Icons";
                                font-size: 13px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.lang-en ? "Top processes (CPU)" : "进程 CPU 占用排行";
                                font-size: 12px * Theme.ui-scale;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.lang-en ? "auto 2s" : "2 秒自动刷新";
                                font-size: 9px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            Text { text: "PID"; width: 40px; font-size: 9px * Theme.ui-scale; color: Theme.fg-3; vertical-alignment: center; }
                            Text { text: root.lang-en ? "USER" : "用户"; width: 56px; font-size: 9px * Theme.ui-scale; color: Theme.fg-3; overflow: elide; vertical-alignment: center; }
                            Text { text: root.lang-en ? "COMMAND" : "命令行"; horizontal-stretch: 1; font-size: 9px * Theme.ui-scale; color: Theme.fg-3; overflow: elide; vertical-alignment: center; }
                            Text { text: "CPU%"; width: 42px; font-size: 9px * Theme.ui-scale; color: Theme.fg-3; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: "MEM%"; width: 42px; font-size: 9px * Theme.ui-scale; color: Theme.fg-3; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Flickable {
                            vertical-stretch: 1;

                            VerticalLayout {
                                height: self.preferred-height;
                                spacing: 3px;

                        if root.proc-top.length == 0 : Text {
                            text: root.lang-en ? "No process data" : "暂无进程数据";
                            font-size: 10px * Theme.ui-scale;
                            color: Theme.fg-3;
                        }
                        for pr in root.proc-top : HorizontalLayout {
                            height: 17px;

                            Text { text: pr.pid; width: 40px; font-size: 10px * Theme.ui-scale; color: Theme.fg-2; vertical-alignment: center; }
                            Text { text: pr.user; width: 56px; font-size: 10px * Theme.ui-scale; color: Theme.fg-3; overflow: elide; vertical-alignment: center; }
                            Text { text: pr.command; horizontal-stretch: 1; font-size: 10px * Theme.ui-scale; color: Theme.fg-2; overflow: elide; vertical-alignment: center; }
                            Text { text: pr.cpu + "%"; width: 42px; font-size: 10px * Theme.ui-scale; font-weight: 600; color: Theme.fg-1; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: pr.mem + "%"; width: 42px; font-size: 10px * Theme.ui-scale; color: Theme.fg-3; horizontal-alignment: right; vertical-alignment: center; }
                        }
                                }
                            }
                    }
                }
            }
        }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick1.height;
                content-h: flick1.content-height;
                offset-y: flick1.content-y;
            }
        }

  // ── 内存：内存 + 交换──
if root.head-tab == 0 && root.current-tab == 2 && root.panel-ready : Rectangle {
            vertical-stretch: 1;
            flick2 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）
                // 默认按父级 100% 高布局，内容会被"摊开"到整个面板高度 —— 卡片被
                // 拉伸、标题行跑到正中。钉住首选高度后按自然高度从上往下排。
                height: self.preferred-height;
                x: 0;
                y: 0;
                padding: root.content-pad;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Memory" : "内存"; }
                MetricRow {
                    label: root.lang-en ? "MEM" : "内存";
                    value: root.mem-detail;
                    percent: root.mem-percent;
                }
                SectionTitle { text: root.lang-en ? "Swap" : "交换"; }
                MetricRow {
                    label: root.lang-en ? "Swap" : "交换";
                    value: root.swap-detail;
                    percent: root.swap-percent;
                }
            }
        }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick2.height;
                content-h: flick2.content-height;
                offset-y: flick2.content-y;
            }
        }

        // ── 磁盘：全部分区 ─────────────────────────────────────────────
if root.head-tab == 0 && root.current-tab == 3 && root.panel-ready : Rectangle {
            vertical-stretch: 1;
            flick3 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）
                // 默认按父级 100% 高布局，内容会被"摊开"到整个面板高度 —— 卡片被
                // 拉伸、标题行跑到正中。钉住首选高度后按自然高度从上往下排。
                height: self.preferred-height;
                x: 0;
                y: 0;
                padding: root.content-pad;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Disk partitions" : "磁盘分区"; }
                if root.disks.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for d in root.disks : MetricRow {
                    label: d.path;
                    value: d.detail;
                    percent: d.percent;
                }
            }
        }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick3.height;
                content-h: flick3.content-height;
                offset-y: flick3.content-y;
            }
        }

        // ── 网络：端口表 + 上下行趋势 ───────────────────────────────────
if root.head-tab == 0 && root.current-tab == 4 && root.panel-ready : Rectangle {
            vertical-stretch: 1;
            flick4 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）
                // 默认按父级 100% 高布局，内容会被"摊开"到整个面板高度 —— 卡片被
                // 拉伸、标题行跑到正中。钉住首选高度后按自然高度从上往下排。
                height: self.preferred-height;
                x: 0;
                y: 0;
                padding: root.content-pad;
                spacing: 6px;

                SectionTitle { text: root.lang-en ? "Interfaces" : "网络端口"; }
                if root.net-rows.length == 0 : EmptyHint { lang-en: root.lang-en; }
                for n in root.net-rows : NetIfaceRow {
                    name: n.name;
                    down: n.down;
                    up: n.up;
                }

                SectionTitle { text: root.lang-en ? "Session NIC" : "会话网卡"; }
                if root.net-history.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.net-history.length > 0 : LineChart {
                    values: root.net-history;
                    chart-h: 40px;
                }

                SectionTitle { text: root.lang-en ? "Local NIC" : "本机网卡"; }
                if root.net-history-bot.length == 0 : EmptyHint { lang-en: root.lang-en; }
                if root.net-history-bot.length > 0 : LineChart {
                    values: root.net-history-bot;
                    chart-h: 40px;
                }
            }
        }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick4.height;
                content-h: flick4.content-height;
                offset-y: flick4.content-y;
            }
        }

        // ── 传输（真数据；条目多时由内部滚动承担）───────────────────────
if root.current-tab == 5 : Rectangle {
            vertical-stretch: 1;
            flick5 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                padding: root.content-pad;
            spacing: 8px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "\u{E2C6}";
                    font-family: "Material Icons";
                    font-size: 13px * Theme.ui-scale;
                    color: root.transfers-active ? Theme.accent : Theme.fg-3;
                    vertical-alignment: center;
                }
                Text {
                    text: root.lang-en
                        ? "Transfers · \{root.transfers.length}"
                        : "传输记录 · \{root.transfers.length}";
                    font-size: 12px * Theme.ui-scale;
                    color: Theme.fg-2;
                    vertical-alignment: center;
                }
            }

            if root.transfers.length == 0 : Text {
                text: root.lang-en ? "No transfers yet" : "暂无传输记录";
                font-size: 11px * Theme.ui-scale;
                color: Theme.fg-3;
            }

            for t in root.transfers : Rectangle {
                height: 40px;
                border-radius: 6px;
                background: Theme.sur-2;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: t.is-upload ? "\u{E5DB}" : "\u{E5D8}";
                        font-family: "Material Icons";
                        font-size: 13px * Theme.ui-scale;
                        color: t.state == 0 ? Theme.accent : Theme.fg-3;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;

                        Text {
                            text: t.name;
                            font-size: 11px * Theme.ui-scale;
                            color: Theme.fg-1;
                            overflow: elide;
                        }
                        Text {
                            text: t.detail;
                            font-size: 10px * Theme.ui-scale;
                            color: Theme.fg-3;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.sur-3;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * t.percent;
                                height: parent.width > 0 ? 3px : 0px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                        }
                    }
                }
            }
        }

        // ── 文件（活动标签的 SFTP 列表 —— per-tab 状态搬家①后接真数据）──
        // 隧道数据已提升到 `active-tunnels`，但隧道 UI 按需求暂缓（见文件头）。
        // 注意：这个 VerticalLayout **不写** `alignment: start` —— Slint 里
        // alignment != stretch 时 stretch 因子会被忽略（子项一律用 preferred 高度），
        // 下面的列表区就撑不开了。默认 stretch + 单个 `vertical-stretch: 1` 的
        // 列表容器 = 上面的行保持原高、剩余高度全给列表（同 page_hosts 的写法）。
            }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick5.height;
                content-h: flick5.content-height;
                offset-y: flick5.content-y;
            }
        }
if root.current-tab == 6 : Rectangle {
            vertical-stretch: 1;
            flick6 := Flickable {
                width: 100%;
                height: 100%;
            vertical-stretch: 1;

            VerticalLayout {
                padding: root.content-pad;
            spacing: 6px;

            // ── 工具条：面包屑（根 / … / 末两段可点）+ 刷新 / 上传 / 新建目录 ──
            // 中间层用「…」省略（crumbs 由 Rust 切好；长度 >3 时只显示首段与末两段）。
            HorizontalLayout {
                spacing: 2px;
                height: 22px;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    alignment: start;

                    for c[i] in root.sftp-crumbs : HorizontalLayout {
                        spacing: 1px;
                        alignment: start;

  // 中间层省略号：点它 = 上一级（里的「…」就是上级入口）。
                        // 放在 i==1 这个槽位，省得在静态元素与 for 之间插队。
                        HorizontalLayout {
                            visible: root.sftp-crumbs.length > 3 && i == 1;
                            spacing: 1px;
                            alignment: start;

                            Text {
                                text: "…";
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                            }
                            up-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sftp-navigate("..");
                                }
                            }
                        }

  // 面包屑本身：根段用文件夹图标代替「/」；
                        // 长度 > 3 时只留首段与末两段。
                        HorizontalLayout {
                            visible: root.sftp-crumbs.length <= 3 || i == 0
                                || i >= root.sftp-crumbs.length - 2;
                            spacing: 1px;
                            alignment: start;

                            Text {
                                text: i == 0 ? "\u{E2C7}" : "/" + c.name;
                                font-family: i == 0 ? "Material Icons" : Theme.ui-font-family;
                                font-size: 10px * Theme.ui-scale;
                                color: i == root.sftp-crumbs.length - 1 ? Theme.fg-1 : Theme.fg-3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            ct-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.sftp-navigate(c.path);
                                }
                            }
                        }
                    }
                }
                IconBtn {
                    glyph: "\u{E5D5}";   // refresh
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-refresh(root.sftp-path);
                    }
                }
                IconBtn {
                    glyph: "\u{E5D8}";   // 上传：把本地文件放进当前目录
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-upload(root.sftp-path, false);
                    }
                }
                IconBtn {
                    glyph: "\u{E145}";   // 新建目录
                    enabled: root.sftp-available;
                    clicked => {
                        root.sftp-new-folder(root.sftp-path);
                    }
                }
            }

            // ── 搜索行（过滤在 Rust 侧做：Slint 的字符串没有 contains）────────
            Rectangle {
                height: 22px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.sur-2;

                Text {
                    x: 6px;
                    y: 0;
                    text: "\u{E8B6}";   // search
                    font-family: "Material Icons";
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    height: parent.height;
                    vertical-alignment: center;
                }
                // 占位提示用一层 Text（TextInput 没有 placeholder 属性，同 rail 的搜索框）
                Text {
                    x: 22px;
                    width: parent.width - 28px;
                    height: parent.height;
                    visible: search-input.text == "";
                    text: root.lang-en ? "Search" : "搜索";
                    font-size: 10px * Theme.ui-scale;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                search-input := TextInput {
                    x: 22px;
                    width: parent.width - 28px;
                    height: parent.height;
                    text <=> root.search;
                    single-line: true;
                    font-size: 10px * Theme.ui-scale;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                    edited => {
                        root.search-changed(root.search);
                    }
                }
            }

            // ── 列头：名称 / 大小 / 时间（点名称或大小排序，方向来自 Rust 镜像）──
            HorizontalLayout {
                height: 18px;
                padding-left: 4px;
                padding-right: 4px;
                spacing: 4px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Name" : "名称") + root.sort-suffix-name;
                        font-size: 9px * Theme.ui-scale;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                    }
                    ht-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("name");
                        }
                    }
                }
                Rectangle {
                    width: 54px;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Size" : "大小") + root.sort-suffix-size;
                        font-size: 9px * Theme.ui-scale;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: parent.width;
                    }
                    st-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("size");
                        }
                    }
                }
                Rectangle {
                    width: 50px;
                    height: 18px;
                    background: transparent;

                    Text {
                        text: (root.lang-en ? "Time" : "时间") + root.sort-suffix-modified;
                        font-size: 9px * Theme.ui-scale;
                        color: Theme.fg-3;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: parent.width;
                    }
                    mt-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.sftp-sort-request("modified");
                        }
                    }
                }
            }

            // ── 两个开关（真回调；设置页也有同样两项，这里留个就近入口）──────
            HorizontalLayout {
                height: 22px;
                spacing: 6px;

                Text {
                    text: root.lang-en ? "Auto-sync" : "目录自动同步";
                    font-size: 9px * Theme.ui-scale;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    on: root.sftp-follow-cd;
                    toggled => {
                        root.set-flag-follow-cd(!root.sftp-follow-cd);
                    }
                }
                Text {
                    text: root.lang-en ? "Ask to save" : "下载前询问";
                    font-size: 9px * Theme.ui-scale;
                    color: Theme.fg-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Switch {
                    on: root.always-ask;
                    toggled => {
                        root.set-flag-always-ask(!root.always-ask);
                    }
                }
            }

            // 目录自动同步 = sftp-follow-cd（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Auto-sync directory" : "SFTP 目录自动同步";
                        font-size: 12px * Theme.ui-scale;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Panel follows terminal cd" : "启用后，打开 SFTP 面板时将自动同步当前工作目录";
                        font-size: 10px * Theme.ui-scale;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.sftp-follow-cd;
                        toggled => {
                            root.set-flag-follow-cd(!root.sftp-follow-cd);
                        }
                    }
                }
            }

            // 下载前始终询问 = download-always-ask（真回调 ✓）
            HorizontalLayout {
                spacing: 10px;
                height: 44px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.lang-en ? "Always ask where to save" : "下载前始终询问位置";
                        font-size: 12px * Theme.ui-scale;
                        font-weight: 600;
                        color: Theme.fg-1;
                    }
                    Text {
                        text: root.lang-en ? "Ask for a destination on every download" : "每次下载都选择目标目录";
                        font-size: 10px * Theme.ui-scale;
                        color: Theme.fg-3;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;

                    Switch {
                        on: root.always-ask;
                        toggled => {
                            root.set-flag-always-ask(!root.always-ask);
                        }
                    }
                }
            }

            // 列表区：独吞剩余高度（加载 / 空态 / 列表三种内容共用同一个容器，
            // 这样上面的行不会被拉伸，见本标签开头的 alignment 注记）。
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // 加载中（还没有内容可显示时）
                if root.file-view == 1 : Text {
                    text: root.lang-en ? "Loading directory…" : "正在加载目录…";
                    width: parent.width;
                    height: parent.height;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                // 空目录 / 还没同步过（cd 跟随关闭时点右上刷新）
                if root.file-view == 2 : Text {
                    text: root.lang-en
                        ? "Empty — or press refresh to load the current directory."
                        : "目录为空 —— 也可能是还没同步，点右上角刷新。";
                    width: parent.width;
                    height: parent.height;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                // 条目列表：目录点进入，文件点下载（走既有 SFTP 回调）
                if root.file-view == 3 : Flickable {
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）默认按父级
                        // 100% 高布局，内容会被"摊开"到整个视口（卡片被拉伸）。
                        height: self.preferred-height;
                        x: 0;
                        y: 0;
                        spacing: 1px;
                        alignment: start;

                        for e in root.sftp-entries : Rectangle {
                            height: 24px;
                            border-radius: 5px;
                            background: e-ta.has-hover ? Theme.sur-3 : transparent;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 4px;

                                Text {
                                    text: e.is-dir ? "\u{E2C7}" : "\u{E24D}"; // folder / insert_drive_file
                                    font-family: "Material Icons";
                                    font-size: 12px * Theme.ui-scale;
                                    color: e.is-dir ? Theme.accent : Theme.fg-3;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: e.name;
                                    font-size: 10px * Theme.ui-scale;
                                    color: Theme.fg-1;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                // 与列头对齐的两列（大小 / 时间）；目录两列都留空
                                Text {
                                    text: e.is-dir ? "" : e.size;
                                    width: 54px;
                                    font-size: 9px * Theme.ui-scale;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                                Text {
                                    text: e.is-dir ? "" : e.modified;
                                    width: 50px;
                                    font-size: 9px * Theme.ui-scale;
                                    color: Theme.fg-3;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                            }

                            e-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (e.is-dir) {
                                        root.sftp-navigate(e.full-path);
                                    } else {
                                        root.sftp-download(e.full-path);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 状态行（"SFTP 连接中…" / 出错原因 / 传输提示）
            if root.sftp-status != "" : Text {
                text: root.sftp-status;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-3;
                overflow: elide;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

            }

            PanelScrollBar {
                x: parent.width - 6px;
                y: 0;
                height: parent.height;
                view-h: flick6.height;
                content-h: flick6.content-height;
                offset-y: flick6.content-y;
            }
        }
        // ── footer：打开文件视图的圆按钮 + PATH / DIR / FILE / TOTAL ────
  // 设计里那个圆按钮就是"展开 SFTP 文件目录"的入口；计数由 Rust 数好传进来。
        HorizontalLayout {
            height: 26px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;

            Rectangle {
                width: 20px;
                height: 20px;
                y: 3px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line-strong;
                background: fv-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                Text {
                    text: "\u{E2C7}";   // folder：切到文件视图
                    font-family: "Material Icons";
                    font-size: 11px * Theme.ui-scale;
                    color: root.current-tab == 6 ? Theme.accent : Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                fv-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.current-tab = 6;
                    }
                }
            }
            StatChip {
                label: "PATH";
                value: root.file-path-label;
                horizontal-stretch: 1;
            }
            StatChip {
                label: "DIR";
                value: "\{root.sftp-dir-count}";
            }
            StatChip {
                label: "FILE";
                value: "\{root.sftp-file-count}";
            }
            StatChip {
                label: "TOTAL";
                value: root.sftp-total;
            }
        }
    }
}
