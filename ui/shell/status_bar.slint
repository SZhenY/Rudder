// 底部状态栏（按 ex/终端-会话并分屏.png）。
//
// 只放**有真实功能**的条目（不放假按钮）：
// 左 —— 连接状态圆点（conn-state 0 灰 / 1 绿 / 2 黄）+ 主机名；
//       「广播输入」（sync-input，把输入广播到所有会话，Rust 侧原子标志）；
//       「执行」（翻转命令栏显隐，show-cmd-bar + 落盘）；
//       「高亮」（output-highlight-enabled，**走真回调落盘**）；
//       「重连」（仅断开态可点：复用"断开后按 Enter 重连"那条成熟路径）；
//       「历史命令 N」。
// 右 —— 传输统计卡：TOTAL N + 活动指示（has-active-transfers）。
// 参考图里还有「隧道 / 录制」与 UTF-8 选择器：隧道 UI 暂缓、录制与运行期改编码
// 项目都没有对应功能，一律先不做（见 CHANGELOG 记录）。

import { Theme } from "../theme.slint";

component Pill inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> togglable: false;
    in property <bool> on: false;
    // 不可用（例如「重连」只在断开态可点）：变暗、不响应，而不是点了没反应。
    in property <bool> enabled: true;
    callback clicked();

    height: 20px;
    border-radius: 5px;
    background: (root.enabled && ta.has-hover) ? Theme.sur-3
        : (root.togglable && root.on ? Theme.rail-item-active : transparent);

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 4px;
        alignment: center;

        if root.glyph != "" : Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 12px;
            color: root.enabled ? Theme.fg-2 : Theme.fg-3.with-alpha(0.5);
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: 11px;
            color: root.enabled ? Theme.fg-2 : Theme.fg-3.with-alpha(0.5);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component StatusBar inherits Rectangle {
    in property <int> conn-state;          // 0 灰 / 1 绿 / 2 黄
    in property <string> conn-host;
    in property <string> connection-text;
    in-out property <bool> highlight-enabled: true;
    in property <int> history-count;
    in property <int> transfer-count;
    in property <bool> transfers-active: false;
    in property <bool> lang-en: false;
    // 广播输入（sync-input；命令栏已随终端页重做删除，不再有显隐开关）
    in property <bool> sync-input: false;
    // 历史命令浮层是否打开（浮层本身在终端舞台里渲染）
    in property <bool> history-open: false;
    callback toggle-highlight();
    callback toggle-sync-input();
    callback open-history();
    // 重连：仅断开态（conn-state == 2）可用 —— 复用"断开后按 Enter 重连"的实现。
    callback reconnect();

    height: 28px;
    background: Theme.rail-bg;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: start;

        // 连接状态：圆点 + 主机名（或未连接文案）
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            border-radius: 4px;
            background: root.conn-state == 1 ? Theme.accent
                : root.conn-state == 2 ? #e5b567
                : Theme.fg-3;
        }
        Text {
            text: root.conn-host == "" ? root.connection-text : root.conn-host;
            font-size: 11px;
            color: Theme.fg-2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // 广播输入：把输入同时发到所有会话（Rust 侧 sync-input 原子标志）
        Pill {
            text: root.lang-en ? "Broadcast" : "广播输入";
            togglable: true;
            on: root.sync-input;
            clicked => {
                root.toggle-sync-input();
            }
        }
        Pill {
            glyph: "\u{E8F5}"; // highlight
            text: root.lang-en ? "Highlight" : "高亮";
            togglable: true;
            on: root.highlight-enabled;
            clicked => {
                root.toggle-highlight();
            }
        }
        // 重连：只在断开态可点（复用"断开后按 Enter 重连"）
        Pill {
            glyph: "\u{E5D5}"; // refresh
            text: root.lang-en ? "Reconnect" : "重连";
            enabled: root.conn-state == 2;
            clicked => {
                root.reconnect();
            }
        }
        // 历史命令：打开/收起历史浮层（终端页重做③；命令栏的原入口已删除）
        Pill {
            glyph: "\u{E88B}"; // history
            text: root.lang-en ? "History \{root.history-count}" : "历史命令 \{root.history-count}";
            togglable: true;
            on: root.history-open;
            clicked => {
                root.open-history();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // 传输统计卡（参考图右侧 PATH/DIR/FILE/TOTAL 的 v1：只放有数据的 TOTAL）
        Rectangle {
            height: 20px;
            y: (parent.height - 20px) / 2;
            width: total-text.preferred-width + 22px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.line;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: start;

                Text {
                    text: "\u{E2C6}"; // swap_vert
                    font-family: "Material Icons";
                    font-size: 12px;
                    color: root.transfers-active ? Theme.accent : Theme.fg-3;
                    vertical-alignment: center;
                }
                Text {
                    total-text := Text {
                        text: "TOTAL \{root.transfer-count}";
                        font-size: 10px;
                        color: Theme.fg-2;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
