// 新标题栏（UI 重构，按 ex/ 参考稿）。
//
// 只在无边框平台（Windows/Linux）实例化：整条 38px 都是可拖拽区（拖动移动窗口、
// 双击最大化），右上角是最小化 / 最大化 / 关闭。沉浸式 —— 不画应用图标与标题
// 文字（`show-title: false`），背景与左侧栏同色（sur-1），让标题栏读作侧栏的
// 向上延伸而不是独立的一条。
//
// macOS 不实例化：红绿灯与顶部拖拽都由系统负责（内容用 titlebar-inset 让位）。
//
// 窗口动作（win-drag / win-minimize / win-maximize-toggle / win-close）仍由
// `src/app/window_chrome.rs` 接线，与旧标题栏完全同一套 —— 这里只是换皮。

import { Theme } from "../theme.slint";
import { WindowTitleBar } from "../components/window_shell.slint";

export component AppTitleBar inherits WindowTitleBar {
    in property <bool> window-maximized: false;

    callback win-close();
    callback win-drag();
    callback win-maximize-toggle();
    callback win-minimize();

    title: "";
    icon-size: 0px;
    show-title: false;
    show-min-max: true;
    bar-height: 38px;
    bg: Theme.sur-1;
    maximized: window-maximized;
    armed-drag: true;      // 拖过阈值才交给系统，双击最大化才派发得到
    drag() => { root.win-drag(); }
    minimize() => { root.win-minimize(); }
    maximize-toggle() => { root.win-maximize-toggle(); }
    close() => { root.win-close(); }
}

/// 系统标题栏平台（macOS）的顶部栏：红绿灯由系统画在左上角，这里补「应用图标 +
/// 程序名」与底部一条分隔线（参考图：标题栏与内容之间有一条线，标题栏显示程序名）。
///
/// 为什么不是"内容直接顶到窗口顶"：那样顶部只剩一圈背景，和下面各页面割裂；
/// 参考图的做法是给它一个真正的标题栏内容。
export component AppTitleBarSystem inherits Rectangle {
    height: 28px;
    background: Theme.sur-1;

    HorizontalLayout {
        // 给系统红绿灯让位（macOS 画在 x≈12..70）
        padding-left: 78px;
        padding-right: Theme.sp-3;
        spacing: 6px;

        VerticalLayout {
            alignment: center;

            Image {
                source: @image-url("../../assets/icon.png");
                width: 14px;
                height: 14px;
            }
        }
        VerticalLayout {
            alignment: center;

            Text {
                text: "Rudder";
                font-size: 12px;
                font-weight: 600;
                color: Theme.fg-2;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    // 底部 1px 分隔线：标题栏与内容的分界（用户参考图）
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }
}
