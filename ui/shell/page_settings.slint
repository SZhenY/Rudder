// 设置页（按 ex/设置-*.png 版式：左分类带副标题；右侧开关行 = 左标签/右滑块、
// 行间无分隔线；大输入项控件在下方；语言是双 pill。全部真回调，无假控件。）

import { Theme, AnimationSettings } from "../theme.slint";
import { OutputRuleItem } from "../settings/types.slint";

struct CapsuleOpt {
    value: string,
    label: string,
}

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.sur-3;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;

    knob := Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;

        animate x {
            duration: 120ms;
        }
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// 胶囊选择行（老设置窗的段控迁移）：opts = [{value, label}]，调用方按语言给文案
//（Slint 的 for 里不能按值反查下标，所以值与文案成对传）。点击写回 picked。
component CapsuleRow inherits HorizontalLayout {
    in property <[CapsuleOpt]> opts;
    in property <string> value;
    callback picked(string);

    for o in root.opts : Rectangle {
        property <bool> on: root.value == o.value;
        width: cap.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        border-width: 1px;
        border-color: on ? Theme.accent : Theme.line;
        background: on ? Theme.accent.with-alpha(0.16)
                       : (pta.has-hover ? Theme.sur-3 : transparent);

        cap := Text {
            text: o.label;
            font-size: 11px;
            color: on ? Theme.accent : Theme.fg-2;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        pta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(o.value); }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> desc: "";
    in property <bool> on: false;
    callback toggled();

    height: root.desc == "" ? 44px : 56px;

    HorizontalLayout {
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 600;
                color: Theme.fg-1;
            }
            if root.desc != "" : Text {
                text: root.desc;
                font-size: 11px;
                color: Theme.fg-3;
            }
        }
        VerticalLayout {
            alignment: center;

            Switch {
                on: root.on;
                toggled => {
                    root.toggled();
                }
            }
        }
    }
}

component SelectBox inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px;
            color: Theme.fg-1;
            vertical-alignment: center;
        }
        Text {
            text: "\u{E5CF}";
            font-family: "Material Icons";
            font-size: 15px;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 大输入项区块：标题 + 说明 + 控件在下方（参考图 字体/滚回 的样式）
component FieldBlock inherits Rectangle {
    in property <string> title;
    in property <string> desc: "";
    height: block.preferred-height;

    block := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 600;
            color: Theme.fg-1;
        }
        if root.desc != "" : Text {
            text: root.desc;
            font-size: 11px;
            color: Theme.fg-3;
            wrap: word-wrap;
        }
        @children
    }
}

component CategoryItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> sub;
    in property <bool> active: false;
    callback clicked();

    height: 46px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.rail-item-active
        : (ta.has-hover ? Theme.rail-item-hover : transparent);

    HorizontalLayout {
        padding-left: Theme.sp-2;
        spacing: Theme.sp-2;
        alignment: start;

        Text {
            width: 18px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 16px;
            color: root.active ? Theme.accent : Theme.fg-2;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.label;
                font-size: 13px;
                color: root.active ? Theme.accent : Theme.fg-1;
                font-weight: root.active ? 600 : 400;
            }
            Text {
                text: root.sub;
                font-size: 10px;
                color: Theme.fg-3;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 磨砂透明度滑块（0–70%）：拖动实时改 `Theme.panel-alpha`（面板 / 终端同一块玻璃），
// 松手才落盘。
component FrostSlider inherits Rectangle {
    in property <float> value: 0;         // 当前值（默认 0..70 = 磨砂百分比）
    in property <float> min: 0;
    in property <float> max: 70;
    in property <float> step: 1;
    callback changed(float);
    callback released(float);

    height: 22px;
    width: 170px;
    property <float> span: root.max - root.min;
    property <float> frac: clamp((root.value - root.min) / root.span, 0.0, 1.0);
    pure function snap(raw: float) -> float {
        return clamp(round((raw - root.min) / root.step) * root.step + root.min,
                     root.min, root.max);
    }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.sur-3;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.frac;
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: (parent.width - self.width) * root.frac;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.fg-1;
        border-width: 1px;
        border-color: Theme.line;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.changed(root.snap(self.mouse-x / self.width * root.span + root.min));
            root.released(root.snap(self.mouse-x / self.width * root.span + root.min));
        }
        moved => {
            if (self.pressed) {
                root.changed(root.snap(self.mouse-x / self.width * root.span + root.min));
            }
        }
        pointer-event(e) => {
            // 拖动结束时落盘（只写一次，不在拖动过程中反复写配置）
            if (e.kind == PointerEventKind.up) {
                root.released(root.snap(self.mouse-x / self.width * root.span + root.min));
            }
        }
    }
}

component KeyRow inherits Rectangle {
    in property <string> keys;
    in property <string> desc;
    height: 26px;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: ktext.preferred-width + 16px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.sur-2;

            HorizontalLayout {
                alignment: center;
                ktext := Text {
                    text: root.keys;
                    font-size: 11px;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.desc;
            font-size: 12px;
            color: Theme.fg-2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component PageSettings inherits Rectangle {
    in-out property <bool> lang-en: false;
    property <bool> dark: Theme.dark;
    in property <string> scrollback: "5000";
    in property <bool> flag-osc;
    in property <bool> update-check;
    in property <bool> large-scrollback;
    in property <bool> convert-eol;
    in property <bool> json-format-output;
    in property <bool> hide-partitions;
    in property <bool> always-ask;
    in property <bool> follow-cd;
    in property <bool> collapse-sftp;
    in property <string> app-version;
    // ── 输出高亮（v0.8.0 终端设置页迁移）──────────────────────────────
    in property <bool> output-highlight-enabled: false;
    in property <string> output-highlight-preset: "log-levels";
    in property <string> output-highlight-rule-status: "";
    in property <[OutputRuleItem]> output-highlight-rules;
    // 表单临时状态（页面本地，不进配置）
    in-out property <string> new-rule-pattern: "";
    in-out property <bool> new-rule-regex: false;
    in-out property <bool> new-rule-case: false;
    in-out property <bool> new-rule-whole: false;
    in-out property <string> new-rule-color: "yellow";
    callback set-output-highlight(bool, string);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    // ── 老设置窗口迁移进来的项（v0.8.0 设置面板 → 新页补全）──────────────
    in property <string> appearance-mode: "system";   // system / dark / light
    in property <string> renderer-mode: "femtovg-wgpu"; // femtovg-wgpu(GPU) / software（重启生效）
    in property <string> update-channel: "stable";    // stable / beta
    in property <string> term-cursor-style: "block";  // block / bar / underline
    in property <string> term-cursor-choice: "";      // "" = 跟随主题
    in property <string> term-cursor-color-hex: "";
    in property <bool> sync-upload-enabled: false;
    callback set-appearance-mode(string);
    callback set-animations-enabled(bool);
    callback set-ui-scale(int);
    callback set-renderer-mode(string);
    callback set-term-cursor-style(string);
    callback set-term-cursor-preset(string);
    callback set-term-cursor-color(string);
    callback set-update-channel(string);
    callback set-sync-upload-enabled(bool);
    in property <[string]> ui-fonts;
    in property <int> ui-font-index;
    in property <[string]> term-fonts;
    in property <int> term-font-index;
    callback upload-ui-font();
    property <bool> font-menu-open: false;
    property <bool> tfont-menu-open: false;
    in property <string> accent-hex;
    in property <[string]> wallpaper-labels;
    // 磨砂透明度：**直接双向绑到主题全局** `panel-alpha` —— 拖动即实时生效（面板与
    // 终端共用这一层），不需要经过 Rust 预览回调；只在松手时落盘。
    property <float> frost-alpha <=> Theme.panel-alpha;
    callback persist-frost-alpha(float);
    in property <[string]> update-freq-labels;
    in property <int> update-freq-index;
    in-out property <string> mount-filter-text;
    callback set-update-freq(int);
    callback set-mount-filter-text(string);
    in property <int> wallpaper-index;
    callback set-accent-color(string);
    callback set-wallpaper-label(string);
    callback pick-wallpaper();
    callback open-log-dir();
    in property <[string]> about-libs;
    in-out property <bool> webdav-enabled;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-certs;
    in property <string> webdav-status;
    callback save-webdav(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    callback set-language(string);
    callback term-ui-font(string);
    in property <string> ui-font-now;
    callback toggle-theme();
    callback term-font(string);
    callback term-font-size(int);
    callback term-font-bold(bool);
    callback term-scrollback(string);
    callback set-flag-update-check(bool);
    callback set-flag-large-scrollback(bool);
    callback set-flag-osc52(bool);
    callback set-flag-convert-eol(bool);
    callback set-flag-json-output(bool);
    callback set-flag-hide-partitions(bool);
    callback set-flag-always-ask(bool);
    callback set-flag-follow-cd(bool);
    callback set-flag-collapse-sftp(bool);

    // 0 基础 · 1 终端 · 2 文件 · 3 布局 · 4 快捷键
    property <int> current-cat: 0;
    // 系统标题栏让位高度（macOS 红绿灯；自绘标题栏的平台传 0）。
    in property <length> top-inset: 0px;

    // 底色由外层页面容器提供（`Theme.bg-root` 磨砂，见 app_shell）：这里透明，
    // 否则两层磨砂叠加，本页会比别的页面更暗。
    background: transparent;

    HorizontalLayout {
        // ── 左列：标题 + 分类（带副标题，参考图）────────────
        Rectangle {
            width: 200px;
            background: Theme.sur-1;

            VerticalLayout {
                padding-top: 16px + root.top-inset;
                padding-bottom: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "\u{E8B8}";
                        font-family: "Material Icons";
                        font-size: 17px;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "设置";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.lang-en ? "Search and locate your settings" : "搜索并快速定位你的配置项";
                    font-size: 10px;
                    color: Theme.fg-3;
                }

                Rectangle {
                    height: 10px;
                }

                CategoryItem {
                    glyph: "\u{E8B8}";
                    label: root.lang-en ? "General" : "基础";
                    sub: root.lang-en ? "Language, theme, updates" : "语言、主题、更新与功能入口";
                    active: root.current-cat == 0;
                    clicked => {
                        root.current-cat = 0;
                    }
                }
                CategoryItem {
                    glyph: "\u{EB8E}";
                    label: root.lang-en ? "Terminal" : "终端";
                    sub: root.lang-en ? "Fonts, cursor and scrollback" : "终端、字体与渲染";
                    active: root.current-cat == 1;
                    clicked => {
                        root.current-cat = 1;
                    }
                }
                CategoryItem {
                    glyph: "\u{E2C7}";
                    label: root.lang-en ? "Files" : "文件";
                    sub: root.lang-en ? "SFTP, partitions and transfers" : "SFTP、分区与传输行为";
                    active: root.current-cat == 2;
                    clicked => {
                        root.current-cat = 2;
                    }
                }
                CategoryItem {
                    glyph: "\u{E312}";
                    label: root.lang-en ? "Shortcuts" : "快捷键";
                    sub: root.lang-en ? "Global and terminal shortcuts" : "全局快捷键与终端快捷键";
                    active: root.current-cat == 4;
                    clicked => {
                        root.current-cat = 4;
                    }
                }
                CategoryItem {
                    glyph: "\u{E2EB}"; // cloud
                    label: root.lang-en ? "Cloud Sync" : "云同步";
                    sub: root.lang-en ? "WebDAV backup and restore" : "官方云 · WebDAV、加密与恢复";
                    active: root.current-cat == 6;
                    clicked => {
                        root.current-cat = 6;
                    }
                }
                CategoryItem {
                    glyph: "\u{E88E}";
                    label: root.lang-en ? "About" : "关于";
                    sub: root.lang-en ? "Version, logs and feedback" : "版本、日志与反馈";
                    active: root.current-cat == 5;
                    clicked => {
                        root.current-cat = 5;
                    }
                }
            }
        }

        // ── 右侧：页头 + 设置区 ─────────────────────────
        Rectangle {
            horizontal-stretch: 1;

            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 0;
                alignment: start;

                Text {
                    height: 34px;
                    text: root.current-cat == 0 ? "基础设置"
                        : root.current-cat == 1 ? "终端设置"
                        : root.current-cat == 2 ? "文件设置"
                        : root.current-cat == 5 ? "关于"
                        : root.current-cat == 6 ? "云同步"
                        : "快捷键";
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                Flickable {
                    VerticalLayout {
                        // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）默认按父级
                        // 100% 高布局，内容会被"摊开"到整个视口（卡片被拉伸）。
                        height: self.preferred-height;
                        x: 0;
                        y: 0;
                        padding-top: 8px + root.top-inset;
                        spacing: 0;
                        alignment: start;

                        // ═══ 基础 ═══
                        if root.current-cat == 0 : VerticalLayout {
                            spacing: 4px;

                            FieldBlock {
                                title: root.lang-en ? "Language" : "界面语言";
                                desc: root.lang-en ? "Applies immediately across the window" : "选择应用的显示语言";

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Rectangle {
                                        width: 52px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: !root.lang-en ? Theme.accent : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "中文";
                                                font-size: 11px;
                                                color: !root.lang-en ? white : Theme.fg-2;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.set-language("zh");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 64px;
                                        height: 26px;
                                        border-radius: 6px;
                                        background: root.lang-en ? Theme.accent : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "English";
                                                font-size: 11px;
                                                color: root.lang-en ? white : Theme.fg-2;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.set-language("en");
                                            }
                                        }
                                    }
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Dark Theme" : "深色主题";
                                desc: root.lang-en ? "Toggle between dark and light, whole window" : "在深色与浅色之间切换，整窗配色同步";
                                on: root.dark;
                                toggled => {
                                    root.toggle-theme();
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "UI Font" : "界面字体";
                                desc: root.lang-en ? "Window-wide UI font; import external fonts into the list" : "整窗 UI 字体；外部字体经「导入」加入清单（终端字体在终端分组）";

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    SelectBox {
                                        width: 240px;
                                        text: root.ui-fonts.length > 0 && root.ui-font-index < root.ui-fonts.length
                                            ? root.ui-fonts[root.ui-font-index]
                                            : (root.lang-en ? "Auto" : "自动");
                                        clicked => { font-popup.show(); }
                                    }

                                    font-popup := PopupWindow {
Rectangle {
                                        width: 240px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-1;

                                        VerticalLayout {
                                            spacing: 0;
                                            alignment: start;

                                            for lbl[i] in root.ui-fonts : Rectangle {
                                                height: 30px;
                                                background: root.ui-font-index == i
                                                    ? Theme.rail-item-active
                                                    : (f-ta.has-hover ? Theme.rail-item-hover : transparent);

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    alignment: start;

                                                    Text {
                                                        Text {
                                                            text: lbl;
                                                            font-size: 12px;
                                                            color: root.ui-font-index == i ? Theme.accent : Theme.fg-1;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                f-ta := TouchArea {
                                                    clicked => {
                                                        root.term-ui-font(lbl);
                                                        font-popup.close();
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                height: 1px;
                                                background: Theme.line;
                                            }
                                            Rectangle {
                                                height: 30px;
                                                background: imp-ta.has-hover ? Theme.rail-item-hover : transparent;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    alignment: start;

                                                    Text {
                                                        text: "\u{E2C6}"; // import
                                                        font-family: "Material Icons";
                                                        font-size: 13px;
                                                        color: Theme.fg-2;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.lang-en ? "Import External Font…" : "导入外部字体…";
                                                        font-size: 12px;
                                                        color: Theme.fg-1;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                imp-ta := TouchArea {
                                                    clicked => {
                                                        root.upload-ui-font();
                                                        font-popup.close();
                                                    }
                                                }
                                            }
                                        }
                                    
}
}
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Accent Color" : "主题色";
                                desc: "当前：\{root.accent-hex}";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #4a90e2;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#4a90e2" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#4a90e2");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #5856d6;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#5856d6" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#5856d6");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #34c759;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#34c759" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#34c759");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #ff9500;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#ff9500" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#ff9500");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #ff3b30;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#ff3b30" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#ff3b30");
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #af52de;
                                        border-width: 2px;
                                        border-color: root.accent-hex == "#af52de" ? Theme.fg-1 : transparent;

                                        TouchArea {
                                            clicked => {
                                                root.set-accent-color("#af52de");
                                            }
                                        }
                                    }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Wallpaper" : "壁纸";
                                desc: root.lang-en ? "Panels frost over the current wallpaper" : "面板磨砂取自当前壁纸；导入的自定义壁纸也会进入清单";

                                HorizontalLayout {
                                    alignment: start;

                                    SelectBox {
                                        width: 240px;
                                        text: root.wallpaper-labels.length > 0 && root.wallpaper-index < root.wallpaper-labels.length
                                            ? root.wallpaper-labels[root.wallpaper-index]
                                            : (root.lang-en ? "Default" : "默认");
                                        clicked => {
                                            wp-popup.show();
                                        }
                                    }
                                }

                                wp-popup := PopupWindow {
                                    Rectangle {
                                        width: 260px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-1;

                                        VerticalLayout {
                                            spacing: 0;
                                            alignment: start;

                                            for wlab[i] in root.wallpaper-labels : Rectangle {
                                                height: 30px;
                                                background: root.wallpaper-index == i
                                                    ? Theme.rail-item-active
                                                    : (wp-ta.has-hover ? Theme.rail-item-hover : transparent);

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    alignment: start;

                                                    Text {
                                                        text: wlab;
                                                        font-size: 12px;
                                                        color: root.wallpaper-index == i ? Theme.accent : Theme.fg-1;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                wp-ta := TouchArea {
                                                    clicked => {
                                                        root.set-wallpaper-label(wlab);
                                                        wp-popup.close();
                                                    }
                                                }
                                            }

                                            Rectangle {
                                                height: 1px;
                                                background: Theme.line;
                                            }
                                            Rectangle {
                                                height: 30px;
                                                background: wimp-ta.has-hover ? Theme.rail-item-hover : transparent;

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    alignment: start;

                                                    Text {
                                                        text: "\u{E2C6} 导入自定义壁纸…";
                                                        font-size: 12px;
                                                        color: Theme.fg-1;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                wimp-ta := TouchArea {
                                                    clicked => {
                                                        root.pick-wallpaper();
                                                        wp-popup.close();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Frosted-glass opacity" : "面板 / 终端磨砂透明度";
                                desc: root.lang-en
                                    ? "How much the wallpaper shows through the panels and the terminal (0–70%)."
                                    : "壁纸透过面板 / 终端背景的程度（0–70%,越往右越透;没设壁纸时不生效）";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    FrostSlider {
                                        value: (1.0 - root.frost-alpha) * 100;
                                        changed(v) => {
                                            root.frost-alpha = 1.0 - v / 100;
                                        }
                                        released(v) => {
                                            root.persist-frost-alpha(1.0 - v / 100);
                                        }
                                    }
                                    Text {
                                        text: "\{round((1.0 - root.frost-alpha) * 100)}%";
                                        font-size: 12px;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                        width: 34px;
                                    }
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Check for Updates" : "自动检查更新";
                                desc: root.lang-en ? "Check on startup (manual check anytime)" : "启动时检查新版本（可随时手动检查）";
                                on: root.update-check;
                                toggled => {
                                    root.set-flag-update-check(!root.update-check);
                                }
                            }
                            // ── 外观模式（v0.8.0 设置窗迁移）────────────────────────────────
                            FieldBlock {
                                title: root.lang-en ? "Appearance Mode" : "外观模式";
                                desc: root.lang-en ? "Light, dark, or follow the system" : "浅色、深色或跟随系统切换";
                            
                                CapsuleRow {
                                    opts: [
                                        {value: "system", label: root.lang-en ? "System" : "跟随系统"},
                                        {value: "dark", label: root.lang-en ? "Dark" : "深色"},
                                        {value: "light", label: root.lang-en ? "Light" : "浅色"},
                                    ];
                                    value: root.appearance-mode;
                                    picked(v) => { root.set-appearance-mode(v); }
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Animations" : "界面动画";
                                desc: root.lang-en ? "Sidebar and panel transition animations" : "侧栏与面板的过渡动画开关";
                                on: AnimationSettings.enabled;
                                toggled => {
                                    root.set-animations-enabled(!AnimationSettings.enabled);
                                }
                            }
                            // ── 渲染器（v0.8.0 设置窗迁移；重启生效）────────────────────────
                            FieldBlock {
                                title: root.lang-en ? "Renderer" : "渲染器";
                                desc: root.lang-en ? "Software rendering is the most compatible; takes effect after restart" : "软件渲染兼容性最好；切换后重启生效";
                            
                                CapsuleRow {
                                    opts: [
                                        // 老设置窗的两档制：GPU = femtovg-wgpu（配置值），旧 femtovg/skia 已归一化
                                        {value: "femtovg-wgpu", label: "GPU"},
                                        {value: "software", label: root.lang-en ? "Software" : "软件渲染"},
                                    ];
                                    value: root.renderer-mode;
                                    picked(v) => { root.set-renderer-mode(v); }
                                }
                            }
                            // ── 界面缩放（v0.8.0 设置窗迁移）────────────────────────────────
                            FieldBlock {
                                title: root.lang-en ? "UI Scale" : "界面缩放";
                                desc: root.lang-en ? "Scales fonts and controls (80% – 200%)" : "整体缩放界面字体与控件（80% – 200%）";
                            
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                            
                                    FrostSlider {
                                        min: 80;
                                        max: 200;
                                        step: 10;
                                        value: Theme.ui-scale * 100;
                                        changed(v) => { root.set-ui-scale(round(v)); }
                                        released(v) => { root.set-ui-scale(round(v)); }
                                    }
                                    Text {
                                        text: "\{round(Theme.ui-scale * 100)}%";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            // ── 更新渠道（v0.8.0 设置窗迁移）────────────────────────────────
                            FieldBlock {
                                title: root.lang-en ? "Update Channel" : "更新渠道";
                                desc: root.lang-en ? "Beta receives new features earlier" : "测试版更早拿到新功能与修复";
                            
                                CapsuleRow {
                                    opts: [
                                        {value: "stable", label: root.lang-en ? "Stable" : "稳定版"},
                                        {value: "beta", label: root.lang-en ? "Beta" : "测试版"},
                                    ];
                                    value: root.update-channel;
                                    picked(v) => { root.set-update-channel(v); }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Check Interval" : "检查频率";
                                desc: "自动检查更新的间隔";

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for fl[i] in root.update-freq-labels : Rectangle {
                                        width: ftext.preferred-width + 20px;
                                        height: 26px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.update-freq-index == i ? Theme.accent : Theme.line;
                                        background: root.update-freq-index == i ? Theme.rail-item-active : Theme.sur-2;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            ftext := Text {
                                                text: fl;
                                                font-size: 11px;
                                                color: root.update-freq-index == i ? Theme.accent : Theme.fg-2;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.set-update-freq(i);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ═══ 终端 ═══
                        if root.current-cat == 1 : VerticalLayout {
                            spacing: 4px;

                            FieldBlock {
                                title: root.lang-en ? "Terminal Font" : "终端字体";
                                desc: root.lang-en ? "Installed monospace families, applies instantly" : "已安装的等宽字体，随改随生效并持久化";

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        SelectBox {
                                            width: 240px;
                                            text: root.term-fonts.length > 0 && root.term-font-index < root.term-fonts.length
                                                ? root.term-fonts[root.term-font-index]
                                                : Theme.term-font-family;
                                            clicked => { tfont-popup.show(); }
                                        }
                                        Switch {
                                            on: Theme.term-font-bold;
                                            toggled => {
                                                root.term-font-bold(!Theme.term-font-bold);
                                            }
                                        }
                                        Text {
                                            text: root.lang-en ? "Bold" : "粗体";
                                            font-size: 11px;
                                            color: Theme.fg-3;
                                            vertical-alignment: center;
                                        }
                                    }

                                    tfont-popup := PopupWindow {
Rectangle {
                                        width: 240px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-1;

                                        VerticalLayout {
                                            spacing: 0;
                                            alignment: start;

                                            for lbl[i] in root.term-fonts : Rectangle {
                                                height: 30px;
                                                background: root.term-font-index == i
                                                    ? Theme.rail-item-active
                                                    : (tf-ta.has-hover ? Theme.rail-item-hover : transparent);

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 10px;
                                                    alignment: start;

                                                    Text {
                                                        text: lbl;
                                                        font-size: 12px;
                                                        color: root.term-font-index == i ? Theme.accent : Theme.fg-1;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                tf-ta := TouchArea {
                                                    clicked => {
                                                        root.term-font(lbl);
                                                        tfont-popup.close();
                                                    }
                                                }
                                            }
                                        }
                                    
}
}
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Font Size" : "字号";
                                desc: root.lang-en ? "8–32px, default 13" : "8–32px，默认 13";

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for sz in [12, 13, 14, 16, 18] : Rectangle {
                                        width: 44px;
                                        height: 26px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.term-font-size == sz * 1px ? Theme.accent : Theme.line;
                                        background: Theme.term-font-size == sz * 1px ? Theme.rail-item-active : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: sz;
                                                font-size: 11px;
                                                color: Theme.term-font-size == sz * 1px ? Theme.accent : Theme.fg-2;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.term-font-size(sz);
                                            }
                                        }
                                    }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Scrollback Lines" : "滚回行数";
                                desc: root.lang-en ? "History lines kept in the terminal" : "终端可回看的历史行数（大容量模式内存占用更高）";

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    for n in ["1000", "5000", "10000", "50000"] : Rectangle {
                                        width: 64px;
                                        height: 26px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.scrollback == n ? Theme.accent : Theme.line;
                                        background: root.scrollback == n ? Theme.rail-item-active : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: n;
                                                font-size: 11px;
                                                color: root.scrollback == n ? Theme.accent : Theme.fg-2;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.term-scrollback(n);
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 120px;
                                        height: 26px;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-2;

                                        TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text: root.scrollback;
                                            font-size: 11px;
                                            color: Theme.fg-1;
                                            vertical-alignment: center;
                                            single-line: true;
                                            accepted => {
                                                root.term-scrollback(self.text);
                                            }
                                        }
                                    }
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Large Scrollback" : "大容量滚回模式";
                                desc: root.lang-en ? "Double the history buffer for long sessions" : "历史缓存翻倍，适合长跑日志会话";
                                on: root.large-scrollback;
                                toggled => {
                                    root.set-flag-large-scrollback(!root.large-scrollback);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "OSC52 Clipboard" : "OSC52 剪贴板同步";
                                desc: root.lang-en ? "Let remote programs read/write the local clipboard" : "允许远端程序经转义序列读写本机剪贴板";
                                on: root.flag-osc;
                                toggled => {
                                    root.set-flag-osc52(!root.flag-osc);
                                }
                            }

                        // ── 光标（v0.8.0 设置窗迁移）──────────────────────────
                        FieldBlock {
                            title: root.lang-en ? "Cursor Style" : "光标样式";
                            desc: "";
                            CapsuleRow {
                                opts: [
                                    {value: "block", label: root.lang-en ? "Block" : "方块"},
                                    {value: "bar", label: root.lang-en ? "Bar" : "竖线"},
                                    {value: "underline", label: root.lang-en ? "Underline" : "下划线"},
                                ];
                                value: root.term-cursor-style;
                                picked(v) => { root.set-term-cursor-style(v); }
                            }
                        }
                        FieldBlock {
                            title: root.lang-en ? "Cursor Color" : "光标颜色";
                            desc: root.lang-en ? "Pick a preset or type a hex color; empty = follow the theme" : "选预设色块或输入十六进制色值；留空跟随主题";
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                for c in [
                                    {hex: "", sw: Theme.term-fg},
                                    {hex: "#D4D4D4", sw: #D4D4D4},
                                    {hex: "#FF5252", sw: #FF5252},
                                    {hex: "#69F0AE", sw: #69F0AE},
                                    {hex: "#40C4FF", sw: #40C4FF},
                                ] : Rectangle {
                                    property <bool> on: root.term-cursor-choice == c.hex;
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: c.sw;
                                    border-width: 2px;
                                    border-color: on ? Theme.accent : Theme.line;

                                    ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.set-term-cursor-preset(c.hex); }
                                    }
                                }
                                Rectangle {
                                    width: 110px;
                                    height: 26px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.sur-2;

                                    color-input := TextInput {
                                        text: root.term-cursor-color-hex;
                                        font-size: 11px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        // accepted 无参 —— 用自身 text 提交（回车生效）
                                        accepted => { root.set-term-cursor-color(color-input.text); }
                                    }
                                }
                            }
                        }

                        // ── 输出高亮（v0.8.0 终端设置页迁移）──────────────────
                        ToggleRow {
                            label: root.lang-en ? "Output Highlighting" : "输出高亮";
                            desc: root.lang-en ? "Colourise log levels, URLs, IPs and more" : "给日志等级、URL、IP 等上色";
                            on: root.output-highlight-enabled;
                            toggled => {
                                root.set-output-highlight(!root.output-highlight-enabled, root.output-highlight-preset);
                            }
                        }
                        FieldBlock {
                            title: root.lang-en ? "Highlight Preset" : "高亮预设";
                            desc: root.lang-en ? "Log levels is conservative; DevOps recognises deployment states; Built-in colours numbers, URLs, IPs, UUIDs and dates" : "日志等级较保守；运维识别部署状态；内置多彩覆盖数字、URL、IP、UUID、日期等";
                            CapsuleRow {
                                opts: [
                                    {value: "log-levels", label: root.lang-en ? "Log levels" : "日志等级"},
                                    {value: "devops", label: "DevOps"},
                                    {value: "builtin", label: root.lang-en ? "Built-in" : "内置多彩"},
                                ];
                                value: root.output-highlight-preset;
                                picked(v) => { root.set-output-highlight(root.output-highlight-enabled, v); }
                            }
                        }
                        FieldBlock {
                            title: root.lang-en ? "Custom Rules" : "自定义规则";
                            desc: root.lang-en ? "Custom rules run before the preset and never overwrite ANSI colours" : "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色";

                            if root.output-highlight-rule-status != "" : Text {
                                text: root.output-highlight-rule-status;
                                font-size: 10px;
                                color: Theme.danger;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    width: 220px;
                                    height: 30px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.sur-2;

                                    pat-input := TextInput {
                                        text: root.new-rule-pattern;
                                        font-size: 11px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        accepted => {
                                            if root.new-rule-pattern != "" {
                                                if root.add-output-highlight-rule(
                                                    root.new-rule-pattern, root.new-rule-regex,
                                                    root.new-rule-case, root.new-rule-whole,
                                                    root.new-rule-color) {
                                                    root.new-rule-pattern = "";
                                                }
                                            }
                                        }
                                    }
                                }
                                CapsuleRow {
                                    opts: [
                                        {value: "kw", label: root.lang-en ? "Keyword" : "关键词"},
                                        {value: "re", label: root.lang-en ? "Regex" : "正则"},
                                    ];
                                    value: root.new-rule-regex ? "re" : "kw";
                                    picked(v) => { root.new-rule-regex = (v == "re"); }
                                }
                                CapsuleRow {
                                    opts: [
                                        {value: "red", label: root.lang-en ? "Red" : "红"},
                                        {value: "yellow", label: root.lang-en ? "Yellow" : "黄"},
                                        {value: "green", label: root.lang-en ? "Green" : "绿"},
                                        {value: "cyan", label: root.lang-en ? "Cyan" : "青"},
                                        {value: "magenta", label: root.lang-en ? "Magenta" : "紫"},
                                        {value: "gray", label: root.lang-en ? "Gray" : "灰"},
                                    ];
                                    value: root.new-rule-color;
                                    picked(v) => { root.new-rule-color = v; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Switch { on: root.new-rule-case; toggled => { root.new-rule-case = !root.new-rule-case; } }
                                    Text {
                                        text: root.lang-en ? "Case sensitive" : "区分大小写";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Switch { on: root.new-rule-whole; toggled => { root.new-rule-whole = !root.new-rule-whole; } }
                                    Text {
                                        text: root.lang-en ? "Whole line" : "仅整行";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    min-width: 76px;
                                    max-width: 120px;
                                    height: 28px;
                                    border-radius: 7px;
                                    background: root.new-rule-pattern == "" ? Theme.sur-3 : Theme.accent;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: root.lang-en ? "Add Rule" : "添加规则";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.new-rule-pattern == "" ? Theme.fg-3 : Theme.bg-root;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    add-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.new-rule-pattern != "" {
                                                if root.add-output-highlight-rule(
                                                    root.new-rule-pattern, root.new-rule-regex,
                                                    root.new-rule-case, root.new-rule-whole,
                                                    root.new-rule-color) {
                                                    root.new-rule-pattern = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 0;

                                for rule[index] in root.output-highlight-rules : Rectangle {
                                    height: 44px;

                                    HorizontalLayout {
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height - 1px;
                                        spacing: 9px;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: rule.color == "yellow" ? Theme.warning
                                                : rule.color == "green" ? Theme.success
                                                : rule.color == "cyan" ? Theme.accent
                                                : rule.color == "magenta" ? #d670d6
                                                : rule.color == "gray" ? Theme.fg-3
                                                : Theme.danger;
                                            vertical-stretch: 0;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;

                                            Text {
                                                text: rule.pattern;
                                                color: rule.enabled ? Theme.fg-1 : Theme.fg-3;
                                                font-family: Theme.term-font-family;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: (rule.regex ? "Regex" : (root.lang-en ? "Keyword" : "关键词"))
                                                    + (rule.case-sensitive ? " · Aa" : "")
                                                    + (rule.whole-line ? (root.lang-en ? " · whole line" : " · 整行") : "");
                                                color: Theme.fg-3;
                                                font-size: 10px;
                                            }
                                        }
                                        Switch {
                                            on: rule.enabled;
                                            toggled => { root.set-output-highlight-rule-enabled(index, !rule.enabled); }
                                        }
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 5px;
                                            background: del-ta.has-hover ? Theme.sur-3 : transparent;

                                            del-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.remove-output-highlight-rule(index); }
                                            }
                                            Text {
                                                text: "\u{E872}";
                                                font-family: "Material Icons";
                                                font-size: 15px;
                                                color: Theme.fg-3;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        y: parent.height - 1px;
                                        width: parent.width;
                                        height: 1px;
                                        background: Theme.line;
                                    }
                                }
                            }
                        }
                        }

                        // ═══ 文件 ═══
                        if root.current-cat == 2 : VerticalLayout {
                            spacing: 4px;

                            ToggleRow {
                                label: root.lang-en ? "EOL Conversion (LF ↔ CRLF)" : "换行转换 (LF ↔ CRLF)";
                                desc: root.lang-en ? "Convert EOL when uploading/editing text" : "上传/编辑文本时按目标系统转换换行符";
                                on: root.convert-eol;
                                toggled => {
                                    root.set-flag-convert-eol(!root.convert-eol);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "JSON Output" : "命令输出 JSON 格式化";
                                on: root.json-format-output;
                                toggled => {
                                    root.set-flag-json-output(!root.json-format-output);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Hide Special Partitions" : "隐藏特殊分区";
                                desc: root.lang-en ? "Hide tmpfs / overlay virtual partitions" : "文件面板不显示 tmpfs / overlay 等虚拟分区";
                                on: root.hide-partitions;
                                toggled => {
                                    root.set-flag-hide-partitions(!root.hide-partitions);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Always Ask Where to Save" : "下载前始终询问位置";
                                on: root.always-ask;
                                toggled => {
                                    root.set-flag-always-ask(!root.always-ask);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Follow Remote cwd" : "面板跟随远端 cwd";
                                desc: root.lang-en ? "SFTP panel follows terminal cd" : "终端 cd 时 SFTP 面板自动切到同目录";
                                on: root.follow-cd;
                                toggled => {
                                    root.set-flag-follow-cd(!root.follow-cd);
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Collapse SFTP Panel" : "默认折叠 SFTP 面板";
                                on: root.collapse-sftp;
                                toggled => {
                                    root.set-flag-collapse-sftp(!root.collapse-sftp);
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Mount Filter" : "挂载过滤";
                                desc: root.lang-en ? "Show only partitions whose path contains the keyword (empty = all), Enter to apply" : "只显示路径含该关键字的分区（留空显示全部），回车生效";

                                Rectangle {
                                    width: 300px;
                                    height: 30px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.sur-2;

                                    TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        text <=> root.mount-filter-text;
                                        font-size: 12px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            root.set-mount-filter-text(root.mount-filter-text);
                                        }
                                    }
                                }
                            }
                        }

                        // ═══ 快捷键 ═══
                        if root.current-cat == 4 : VerticalLayout {
                            spacing: 5px;
                            padding-top: 12px;

                            Text {
                                text: root.lang-en ? "Tabs" : "标签页";
                                font-size: 10px;
                                color: Theme.fg-3;
                            }
                            KeyRow {
                                keys: "Ctrl+Tab";
                                desc: root.lang-en ? "Next tab" : "下一个标签页";
                            }
                            KeyRow {
                                keys: "Ctrl+Shift+Tab";
                                desc: root.lang-en ? "Previous tab" : "上一个标签页";
                            }
                            Text {
                                text: root.lang-en ? "Terminal" : "终端";
                                font-size: 10px;
                                color: Theme.fg-3;
                            }
                            KeyRow {
                                keys: "Ctrl+Shift+C";
                                desc: root.lang-en ? "Copy selection" : "复制选中内容";
                            }
                            KeyRow {
                                keys: "Ctrl+V";
                                desc: root.lang-en ? "Paste" : "粘贴";
                            }
                            KeyRow {
                                keys: "Ctrl+F";
                                desc: root.lang-en ? "Find in terminal" : "查找";
                            }
                            KeyRow {
                                keys: "Ctrl+Shift+R";
                                desc: root.lang-en ? "Jump to history search" : "跳到命令历史搜索";
                            }
                            KeyRow {
                                keys: root.lang-en ? "Drag" : "鼠标拖动";
                                desc: root.lang-en ? "Select text" : "选择文本";
                            }
                            KeyRow {
                                keys: root.lang-en ? "Wheel / Scrollbar" : "滚轮 / 滚动条";
                                desc: root.lang-en ? "Scroll history" : "滚动历史";
                            }
                            Text {
                                text: root.lang-en ? "Command Box" : "命令输入框";
                                font-size: 10px;
                                color: Theme.fg-3;
                            }
                            KeyRow {
                                keys: "Enter";
                                desc: root.lang-en ? "Send command" : "发送命令";
                            }
                            KeyRow {
                                keys: "↑ / ↓";
                                desc: root.lang-en ? "Previous / next in history" : "上一条 / 下一条历史";
                            }
                            KeyRow {
                                keys: "Ctrl+R";
                                desc: root.lang-en ? "Search history (↑↓ select, Enter run, Esc close)" : "搜索命令历史（↑↓ 选择，回车执行，Esc 关闭）";
                            }
                            KeyRow {
                                keys: "Esc";
                                desc: root.lang-en ? "Close history / focus terminal" : "关闭历史 / 聚焦终端";
                            }
                            KeyRow {
                                keys: "Ctrl+A";
                                desc: root.lang-en ? "Move to start of line" : "移到行首";
                            }
                            KeyRow {
                                keys: "Ctrl+E";
                                desc: root.lang-en ? "Move to end of line" : "移到行尾";
                            }
                            KeyRow {
                                keys: "Ctrl+K";
                                desc: root.lang-en ? "Delete to end of line" : "删除到行尾";
                            }
                            KeyRow {
                                keys: "Ctrl+U";
                                desc: root.lang-en ? "Delete to start of line" : "删除到行首";
                            }
                        }

                        // ═══ 云同步（WebDAV，参考图：同步目标 + 表单 + 底部操作）═══
                        if root.current-cat == 6 : VerticalLayout {
                            spacing: 4px;

                            ToggleRow {
                                label: root.lang-en ? "Session File Sync" : "文件上传同步";
                                desc: root.lang-en ? "Uploads go to the same path on every session" : "会话同步开启时，上传发往各会话的相同路径";
                                on: root.sync-upload-enabled;
                                toggled => {
                                    root.set-sync-upload-enabled(!root.sync-upload-enabled);
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "WebDAV Sync" : "WebDAV 同步";
                                desc: root.webdav-status == "" ? (root.lang-en ? "Back up config, sessions and notes to your NAS or WebDAV" : "把配置、会话、笔记等备份到自己的 NAS 或企业 WebDAV 服务") : root.webdav-status;

                                Switch {
                                    on: root.webdav-enabled;
                                    toggled => {
                                        root.webdav-enabled = !root.webdav-enabled;
                                    }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "WebDAV URL" : "WebDAV 地址";

                                Rectangle {
                                    width: 420px;
                                    height: 30px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.sur-2;

                                    TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        text <=> root.webdav-url;
                                        font-size: 12px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                FieldBlock {
                                    title: root.lang-en ? "Username" : "用户名";
                                    width: 200px;

                                    Rectangle {
                                        width: 200px;
                                        height: 30px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-2;

                                        TextInput {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            text <=> root.webdav-username;
                                            font-size: 12px;
                                            color: Theme.fg-1;
                                            vertical-alignment: center;
                                            single-line: true;
                                        }
                                    }
                                }
                                FieldBlock {
                                    title: root.lang-en ? "Password / App Password" : "密码 / 应用密码";
                                    width: 200px;

                                    Rectangle {
                                        width: 200px;
                                        height: 30px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: Theme.sur-2;

                                        TextInput {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            height: 100%;
                                            text <=> root.webdav-password;
                                            font-size: 12px;
                                            color: Theme.fg-1;
                                            vertical-alignment: center;
                                            single-line: true;
                                            input-type: password;
                                        }
                                    }
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Remote Directory" : "远程目录";

                                Rectangle {
                                    width: 420px;
                                    height: 30px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.sur-2;

                                    TextInput {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: 100%;
                                        text <=> root.webdav-remote-path;
                                        font-size: 12px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                }
                            }
                            ToggleRow {
                                label: root.lang-en ? "Allow Self-signed Certs" : "允许自签名无效证书";
                                desc: root.lang-en ? "Test the connection again after saving" : "与保存后请再测试连接";
                                on: root.webdav-certs;
                                toggled => {
                                    root.webdav-certs = !root.webdav-certs;
                                }
                            }
                            FieldBlock {
                                title: root.lang-en ? "Actions" : "操作";
                                desc: root.lang-en ? "Upload / restore after saving" : "保存配置后可上传 / 下载备份";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Rectangle {
                                        width: 88px;
                                        height: 28px;
                                        border-radius: 7px;
                                        background: Theme.accent;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Save" : "保存配置";
                                                font-size: 12px;
                                                color: white;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.save-webdav(root.webdav-enabled, root.webdav-url,
                                                    root.webdav-username, root.webdav-password,
                                                    root.webdav-remote-path, root.webdav-certs);
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 74px;
                                        height: 28px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: up-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Upload" : "上传备份";
                                                font-size: 12px;
                                                color: Theme.fg-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                        up-ta := TouchArea {
                                            clicked => {
                                                root.webdav-upload();
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 74px;
                                        height: 28px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: dl-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Restore" : "下载恢复";
                                                font-size: 12px;
                                                color: Theme.fg-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                        dl-ta := TouchArea {
                                            clicked => {
                                                root.webdav-download();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ═══ 关于 ═══
                        if root.current-cat == 5 : VerticalLayout {
                            spacing: 12px;
                            padding-top: 8px;

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-1;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: start;

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 10px;
                                        background: Theme.accent-soft;

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "R";
                                            font-size: 20px;
                                            font-weight: 800;
                                            color: Theme.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Rudder";
                                            font-size: 15px;
                                            font-weight: 700;
                                            color: Theme.fg-1;
                                        }
                                        Text {
                                            text: root.lang-en ? "Version v\{root.app-version}" : "当前版本 v\{root.app-version}";
                                            font-size: 11px;
                                            color: Theme.fg-3;
                                        }
                                        Text {
                                            text: root.lang-en ? "A lightweight Rust + Slint SSH client · Forked from yituorou/meatshell" : "轻量的 Rust + Slint SSH 客户端 · Forked from yituorou/meatshell";
                                            font-size: 11px;
                                            color: Theme.fg-3;
                                        }
                                        Text {
                                            text: "MIT / Apache-2.0 · github.com/SZhenY/Rudder";
                                            font-size: 11px;
                                            color: Theme.fg-3;
                                        }
                                    }
                                }
                            }

                            // 日志与诊断卡（参考图有此卡；打开日志目录回调已接）
                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-1;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: start;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: root.lang-en ? "Logs & Diagnostics" : "日志与诊断";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.fg-1;
                                        }
                                        Text {
                                            text: "排查问题时把日志目录整个发给我们（运行日志与错误都写在这里）";
                                            font-size: 11px;
                                            color: Theme.fg-3;
                                        }
                                    }
                                    Rectangle {
                                        width: 110px;
                                        height: 28px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: log-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Open Log Folder" : "打开日志目录";
                                                font-size: 12px;
                                                color: Theme.fg-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                        log-ta := TouchArea {
                                            clicked => {
                                                root.open-log-dir();
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-1;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: "开源组件";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.fg-1;
                                    }
                                    Text {
                                        text: root.lang-en ? "Open-source libraries (injected by Rust at runtime)" : "本应用依赖以下开源库（运行时由 Rust 注入清单）";
                                        font-size: 11px;
                                        color: Theme.fg-3;
                                    }
                                    for lib in root.about-libs : Text {
                                        text: lib;
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                }
                            }

                            Text {
                                text: "Rudder — a lightweight Rust + Slint SSH client";
                                font-size: 11px;
                                color: Theme.fg-3;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
