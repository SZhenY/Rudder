// 设置页（版式：左分类带副标题；右侧开关行 = 左标签/右控件、
// 行间无分隔线；大输入项控件在下方；语言是双 pill。全部真回调，无假控件。）

import { Theme, AnimationSettings } from "../theme.slint";
import { OutputRuleItem, AccentPreset } from "../settings/types.slint";
import { LineEdit, Slider, ScrollView } from "std-widgets.slint";
import { FontPickerPopup, ColorPalettePopup, ColorSwatchRow } from "../pickers.slint";

struct CapsuleOpt {
    value: string,
    label: string,
}

component Switch inherits Rectangle {
    in property <bool> on: false;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.sur-3;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.line;

    knob := Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;

        // 开关滑块：小控件的空间位移用**回弹弹簧**（M3 Expressive：短距离运动留回弹）
        animate x {
            duration: AnimationSettings.medium1();
            easing: AnimationSettings.s-bouncy();
            enabled: AnimationSettings.enabled;
        }
    }

    ta := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

// 胶囊选择行（老设置窗的段控迁移）：opts = [{value, label}]，调用方按语言给文案
//（Slint 的 for 里不能按值反查下标，所以值与文案成对传）。点击写回 picked。
component CapsuleRow inherits HorizontalLayout {
    in property <[CapsuleOpt]> opts;
    in property <string> value;
    callback picked(string);

    for o in root.opts : Rectangle {
        property <bool> on: root.value == o.value;
        width: cap.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        border-width: 1px;
        border-color: on ? Theme.accent : (pta.has-hover ? Theme.accent-ring : Theme.line);
        background: on ? Theme.accent.with-alpha(0.16)
                       : (pta.pressed ? Theme.accent-press
                       : (pta.has-hover ? Theme.sur-3 : transparent));
        animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
        animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

        cap := Text {
            text: o.label;
            font-size: 11px * Theme.ui-scale;
            color: on ? Theme.accent : Theme.fg-2;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        pta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(o.value); }
        }
    }
}

// ── 版式骨架（分区标题 + 卡片；卡内是"左标签 / 右控件"的设置行）──────
//
// 分区标题：小号弱化字，给一屏设置做出层次。
component SectionTitle inherits Text {
    height: 26px;
    font-size: 11px * Theme.ui-scale;
    font-weight: 700;
    color: Theme.fg-3;
    vertical-alignment: center;
}

// 卡片：一组相关设置的容器（描边 + 圆角 + 卡片底色 `sur-2`）。
// 内部一列、横向留白，行与行之间由行自己的 `show-divider` 画分隔线。
component Card inherits Rectangle {
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.line;
    // ⚠ 圆角必须由**卡片自己**画（background = 磨砂面，天然带圆角），行全部透明。
    // 旧实现（透明卡 + 不透明行 + clip 圆角裁剪）依赖 femtovg 的圆角 clip —— 它只支持
    // 矩形裁剪（combine_clip 里 debug_assert!(radius.is_zero())），圆角走离屏图层路径，
    // 行的方形填充会盖掉圆角（用户截图：卡片变直角）。卡片自绘后无任何裁剪依赖。
    background: Theme.sur-2;

    VerticalLayout {
        // ⚠ 普通(Rectangle)父级里的 Layout 必须显式铺满（本页挤左的根因，见文件头）。
        width: 100%;
        height: 100%;
        spacing: 0;

        @children
    }

    // 玻璃顶缘高光：顶部 3px 白@5% 渐隐，模拟玻璃厚度（clip 已开，圆角内裁剪）。
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: Theme.spec-glow-height;
        background: Theme.spec-glow;
    }
}

// [- value +] 步进器（的字号 / 缩放都是这个控件）。
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);

    width: 112px;
    height: 26px;
    border-radius: Theme.radius-btn;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;
    clip: true;

    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: minus-ta.has-hover ? Theme.rail-item-hover : transparent;
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(max(root.minimum, root.value - root.step)); }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "\u{E15B}";
                font-family: "Material Icons";
                font-size: 14px * Theme.ui-scale;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        Text {
            horizontal-stretch: 1;
            text: root.value + root.unit;
            font-size: 12px * Theme.ui-scale;
            color: Theme.fg-1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle { width: 1px; background: Theme.line; }
        Rectangle {
            width: 30px;
            background: plus-ta.has-hover ? Theme.rail-item-hover : transparent;
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(min(root.maximum, root.value + root.step)); }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "\u{E145}";
                font-family: "Material Icons";
                font-size: 14px * Theme.ui-scale;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// 光标样式三选：带真实光标形状预览。
component CursorStyleButton inherits Rectangle {
    in property <string> label;
    in property <string> cursor-kind;
    in property <bool> selected;
    callback clicked();

    width: 74px;
    height: 30px;
    border-radius: Theme.radius-btn;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : (cs-ta.has-hover ? Theme.accent-ring : Theme.line);
    background: root.selected ? Theme.accent-soft
        : (cs-ta.pressed ? Theme.accent-press
        : (cs-ta.has-hover ? Theme.rail-item-hover : Theme.sur-2));
    animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    cs-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 18px;
                background: Theme.term-bg;
                Rectangle {
                    x: 2px;
                    y: root.cursor-kind == "underline" ? parent.height - 3px : 2px;
                    width: root.cursor-kind == "bar" ? 2px : 10px;
                    height: root.cursor-kind == "underline" ? 2px : 14px;
                    background: Theme.term-fg;
                }
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.fg-1 : Theme.fg-2;
            font-size: 11px * Theme.ui-scale;
            vertical-alignment: center;
        }
    }
}

// 上传按钮：挑字体 / 壁纸 → 复制进 config 目录并立刻可选（下拉框右侧的图标）。
component UploadButton inherits Rectangle {
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-btn;
    border-width: 1px;
    border-color: ub-ta.has-hover ? Theme.accent-ring : Theme.line;
    background: ub-ta.pressed ? Theme.accent-press : (ub-ta.has-hover ? Theme.accent-soft : Theme.sur-2);
    animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    ub-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%;
        height: 100%;
        text: "\u{E2C6}";   // folder-open
        font-family: "Material Icons";
        font-size: 16px * Theme.ui-scale;
        color: Theme.fg-2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}


// 页头右上「还原本页默认」：第一下上膛、第二下才执行（就是右上角这个按钮）。
// armed 归组件自己 —— 共用一份状态会出现"在 A 页上膛、切到 B 页直接执行"的误触。
component ResetButton inherits Rectangle {
    in property <string> page;
    in property <string> label: "还原本页默认";
    in property <string> label-armed: "确认还原？";
    callback reset(string);

    in property <string> cancel-label: "取消";
    property <bool> armed: false;

    height: 26px;
    width: main-seg.width + (root.armed ? 62px : 0px); // 取消段固定宽（if 内 id 不可外引）

    HorizontalLayout {
        spacing: 6px;

        // 主段：未上膛 = 「还原本页默认」（hover 主题色环 / 按下 accent 底）；
        // 上膛 = danger 红底「确认还原？」（保持醒目）。
        main-seg := Rectangle {
            width: main-text.preferred-width + 20px;
            border-radius: Theme.radius-btn;
            border-width: 1px;
            border-color: root.armed ? Theme.danger : (mta.has-hover ? Theme.accent-ring : Theme.line);
            background: root.armed ? Theme.danger
                : (mta.pressed ? Theme.accent-press
                : (mta.has-hover ? Theme.sur-3 : Theme.sur-2));
            animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
            animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

            main-text := Text {
                width: 100%;
                height: 100%;
                text: root.armed ? root.label-armed : root.label;
                font-size: 11px * Theme.ui-scale;
                color: root.armed ? white : Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            mta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.armed) {
                        root.armed = false;
                        root.reset(root.page);
                    } else {
                        root.armed = true;
                    }
                }
            }
        }

        // 取消段：上膛时出现，点击解除上膛（两段式确认可反悔）。
        if root.armed : Rectangle {
            width: 56px;
            border-radius: Theme.radius-btn;
            border-width: 1px;
            border-color: cta.has-hover ? Theme.accent-ring : Theme.line;
            background: cta.pressed ? Theme.accent-press : (cta.has-hover ? Theme.sur-3 : Theme.sur-2);
            animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
            animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

            cancel-text := Text {
                width: 100%;
                height: 100%;
                text: root.cancel-label;
                font-size: 11px * Theme.ui-scale;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            cta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.armed = false; }
            }
        }
    }
}


// 版式里的"设置行"：左侧标签/说明，右侧控件槽（@children），整行铺满内容宽。
// 用于胶囊组、开关、语言 pill 等紧凑控件；大输入块仍走 FieldBlock（控件在下方铺满）。

// 主题色选择器：预设色块 + 当前配色名 + 「自定义…」（点开 HSV 调色盘）。
//
// 色表由 Rust 提供（已按当前深浅档解析好），界面不存第二份色表；
// 调色盘里拖动只预览，**松手才提交一次**（与磨砂滑杆同一套路），免得每帧写盘。
component AccentPicker inherits Rectangle {
    in property <bool> lang-en;
    in-out property <string> value;            // 输入框里的 hex（回显当前生效色）
    in property <color> preview-color;         // 当前生效色
    in property <[AccentPreset]> presets;
    in property <string> choice;               // 配置原值："" = 出厂默认 / 预设 id / hex
    in property <string> accent-name;
    callback pick-preset(string);
    callback apply-color(string) -> bool;
    callback apply-color-rgb(int, int, int) -> bool;
    /// 把 hex 解析成颜色（供调色盘输入框回车时同步 HSV），委托给窗口级回调。
    callback resolve-hex(string) -> color;









    HorizontalLayout {
        spacing: 6px;
        // ⚠ `alignment` 管的是**主轴**（水平），垂直方向必须用 `cross-axis-alignment`
        // —— 上一版误以为 `alignment: center` 能让元素垂直居中，其实它只管水平。
        // 这一行三种控件高度不同：预设色圆 24px、当前配色名（12px 字号）、
        // 自定义按钮 26px，不做交叉轴居中就会顶边齐平、底边参差（用户截图圈的就是这个）。
        cross-axis-alignment: center;
        // 主轴：色圆靠左、当前配色名占中间、按钮靠右（名字有 horizontal-stretch，
        // 会吃掉剩余宽度）。取 center 而非 start 是为了让名字真正居中在中间。
        alignment: center;

        for p in root.presets : Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            border-width: root.choice == p.id ? 2px : 1px;
            border-color: root.choice == p.id ? Theme.accent : Theme.line;
            // 第一块（id=""）=「跟随壁纸」：显示当前生效色（壁纸对比色），而不是出厂蓝。
            background: p.id == "" ? root.preview-color : p.color;
            swatch-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick-preset(p.id); }
            }
        }
        Text {
            text: root.accent-name;
            color: Theme.fg-2;
            font-size: 12px * Theme.ui-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // 自定义：当前色块 + HEX 回显 + 点开调色盘
        Rectangle {
            // 宽度跟着文本走：HEX 固定 7 个字符，但 `ui-scale` 会放大字号，
            // 写死 84px 在大字号下会被截断（`#E8834A` → `#E8834A…`）。
            // 32px = 色块 14 + 间距 6 + 左右 padding 各 6。
            //
            // ⚠ 这个版本的 Text **没有 `implicit-width`**，1.18 用 `preferred-width`
            // （且它已经是 length，不能再 `* 1px` —— 那会变成 px²）。
            width: max(78px, hex-text.preferred-width + 32px);
            height: 26px;
            border-radius: Theme.radius-btn;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.sur-2;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;
                // 垂直居中同样要 cross-axis-alignment；`alignment: center` 只管水平。
                cross-axis-alignment: center;
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: root.preview-color;
                }
                hex-text := Text {
                    // 直接显示当前生效色的 HEX，而不是"自定义…"：这一格本身就是
                    // 打开调色盘的入口，写着占位文字等于没告诉用户当前是什么色。
                    text: root.value;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                }
            }
            // 悬停提示：HEX 本身不会告诉用户"这一格可以点"，补一个气泡。
            // 模式照抄 `widgets.slint` 里 IconBtn 的 tooltip（项目没有
            // TooltipWindow 这个组件，是内联实现的）。
            if custom-ta.has-hover : Rectangle {
                y: parent.height + 5px;
                x: parent.width - self.width;   // 右边缘与按钮对齐
                width: hint-txt.preferred-width + 16px;
                height: 22px;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000070;
                hint-txt := Text {
                    text: root.lang-en ? "Pick a custom color" : "点此挑自定义颜色";
                    color: Theme.text-primary;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            custom-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { palette.open(); }
            }
        }
    }


    // 当前生效色的 HEX 回显（调色盘按钮上那一格）。
    //
    // 为什么不用 `accent-name`：那个字段是**显示名** —— 命中预设时给预设名、
    // 自定义时才给 hex；而这一格要回答"现在到底是哪个色"，必须从**颜色本身**
    // 反推，且与来源无关（预设 / 自定义 / 壁纸派生都对）。
    //
    // ⚠ 写法受三个限制约束：这个 Slint 版本**没有类型转换函数**（无 `int()`）、
    //   **没有 `substring`**、且 `%` 是百分号单位（取模得用返回 float 的
    //   `Math.mod`，接不进整数运算），所以低半字节用「减去整数倍」代替取模。
    //   调色盘那条提交路径走 RGB 回调，不依赖这里的换算。
    //
    // ⚠ 参数必须是 int：写成 float 就变成浮点除法（`1.0/16.0 = 0.0625`），
    //   低位会被截成 0，`1` 会输出成 `00`。
    pure function hex-ch(v: int) -> string {
        return v < 10 ? "" + v
            : v < 11 ? "A" : v < 12 ? "B" : v < 13 ? "C"
            : v < 14 ? "D" : v < 15 ? "E" : "F";
    }
    pure function hex-pair(v: int) -> string {
        return root.hex-ch(v / 16) + root.hex-ch(v - (v / 16) * 16);
    }
    /// `red`/`green`/`blue` 在 Slint 里是**属性访问**（编译器注册为 field_access），
    /// 不是方法 —— 写成 `c.red()` 会报 "not a function"。这点和 Rust 侧相反。
    pure function color-to-hex(c: color) -> string {
        return "#" + root.hex-pair(c.red) + root.hex-pair(c.green) + root.hex-pair(c.blue);
    }

    palette := ColorPalettePopup {
        current: root.preview-color;
        hex <=> root.value;
        lang-en: root.lang-en;
        apply-color(t) => { return root.apply-color(t); }
        resolve-hex(t) => { return root.resolve-hex(t); }
        apply-rgb(r, g, b) => { return root.apply-color-rgb(r, g, b); }
    }
}


component OptionRow inherits Rectangle {
    // 行透明：磨砂底由 Card 统一绘制（原生圆角），行不再自带填充。
    in property <string> label;
    in property <string> desc: "";

    VerticalLayout {
        width: 100%;
        spacing: 0;

        HorizontalLayout {
            spacing: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            padding-left: 12px;
            padding-right: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                Text {
                    text: root.label;
                    font-size: 13px * Theme.ui-scale;
                    font-weight: 600;
                    color: Theme.fg-1;
                }
                if root.desc != "" : Text {
                    text: root.desc;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;

                @children
            }
        }
    }
}

/// 分类页淡入容器。
///
/// 两个 Slint 事实决定了写法：
/// 1. **布局元素没有 `opacity`** —— 分类块原本是 `VerticalLayout`，要淡入必须包一层
///    `Rectangle`，并把间距/上边距转发给内层布局（否则这些属性丢失）。
///    ⚠ 转发属性不能叫 `spacing` / `padding-top` —— `Rectangle` 已带同名属性
///    （"Cannot override property 'padding-top'"，与之前 `color` 那个坑同源）。
/// 2. **`init` 里改值会触发 animate**（已实测）—— 分类块是 `if` 创建的，所以新建时
///    `appear` 从 0 动画到 1 就是天然的内容入场淡入。
component CatFade inherits Rectangle {
    in property <length> cat-spacing: 0;
    in property <length> cat-padding-top: 0px;

    property <float> appear: 0;
    animate appear {
        duration: AnimationSettings.enter-page();
        easing: AnimationSettings.e-enter();
        enabled: AnimationSettings.enabled;
    }
    init => { appear = 1; }
    opacity: root.appear;
    // ⚠ Rectangle 不传播子布局 layout info —— 高度显式绑内层首选高，
    // 否则 CatFade 在卡片列里高度 = 0（内容溢出渲染，布局塌缩）。
    height: body.preferred-height;

    body := VerticalLayout {
        // ⚠ 高度取**首选**（内容高）：写 100% 会把 CatFade 的 preferred-height
        // 拖成循环约束（= 0），分类块在卡片列里塌缩。宽度仍需显式铺满。
        width: 100%;
        height: self.preferred-height;
        spacing: root.cat-spacing;
        padding-top: root.cat-padding-top;
        @children
    }
}

component ToggleRow inherits Rectangle {
    // 行透明：磨砂底由 Card 统一绘制（原生圆角），行不再自带填充。
    in property <string> label;
    in property <string> desc: "";
    in property <bool> on: false;
    callback toggled();

    height: root.desc == "" ? 44px : 56px;

    VerticalLayout {
        width: 100%;
        spacing: 0;

        HorizontalLayout {
            spacing: 12px;
            padding-left: 12px;
            padding-right: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.label;
                    font-size: 13px * Theme.ui-scale;
                    font-weight: 600;
                    color: Theme.fg-1;
                }
                if root.desc != "" : Text {
                    text: root.desc;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-3;
                }
            }
            VerticalLayout {
                alignment: center;

                Switch {
                    on: root.on;
                    toggled => {
                        root.toggled();
                    }
                }
            }
        }
    }
}

component SelectBox inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius-btn;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 12px * Theme.ui-scale;
            color: Theme.fg-1;
            vertical-alignment: center;
        }
        Text {
            text: "\u{E5CF}";
            font-family: "Material Icons";
            font-size: 15px * Theme.ui-scale;
            color: Theme.fg-3;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// 大输入项区块：标题 + 说明 + 控件在下方（字体/滚回 的样式）
component FieldBlock inherits Rectangle {
    // 行透明：磨砂底由 Card 统一绘制（原生圆角），行不再自带填充。
    in property <string> title;
    in property <string> desc: "";
    height: block.preferred-height;

    block := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Text {
            text: root.title;
            font-size: 13px * Theme.ui-scale;
            font-weight: 600;
            color: Theme.fg-1;
        }
        if root.desc != "" : Text {
            text: root.desc;
            font-size: 11px * Theme.ui-scale;
            color: Theme.fg-3;
            wrap: word-wrap;
        }
        @children
    }
}

component CategoryItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> sub;
    in property <bool> active: false;
    callback clicked();

    height: 46px;
    border-radius: Theme.radius-md;
    // 交互态三件套（与 RailButton 同语言）：hover = 主题色细环 @40%；按下 = @12% 底；
    // 选中 = rail-item-active 药丸（左侧另有滑动指示条，见 nav-col）。
    border-width: 1px;
    border-color: !root.active && ta.has-hover ? Theme.accent-ring : transparent;
    background: root.active ? Theme.rail-item-active
        : (ta.pressed ? Theme.accent-press
        : (ta.has-hover ? Theme.rail-item-hover : transparent));
    animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
    animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

    HorizontalLayout {
        padding-left: Theme.sp-2;
        spacing: Theme.sp-2;
        alignment: start;

        Text {
            width: 18px;
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 16px * Theme.ui-scale;
            color: root.active ? Theme.accent : Theme.fg-2;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.label;
                font-size: 13px * Theme.ui-scale;
                color: root.active ? Theme.accent : Theme.fg-1;
                font-weight: root.active ? 600 : 400;
            }
            Text {
                text: root.sub;
                font-size: 10px * Theme.ui-scale;
                color: Theme.fg-3;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component KeyRow inherits Rectangle {
    // 行透明：磨砂底由 Card 统一绘制（原生圆角），行不再自带填充。
    in property <string> keys;
    in property <string> desc;
    height: 26px;

    HorizontalLayout {
        spacing: 10px;
        padding-left: 12px;
        padding-right: 12px;
        alignment: start;

        Rectangle {
            width: ktext.preferred-width + 16px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.sur-2;

            HorizontalLayout {
                alignment: center;
                ktext := Text {
                    text: root.keys;
                    font-size: 11px * Theme.ui-scale;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.desc;
            font-size: 12px * Theme.ui-scale;
            color: Theme.fg-2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component PageSettings inherits Rectangle {
    in-out property <bool> lang-en: false;
    property <bool> dark: Theme.dark;
    in property <string> scrollback: "5000";
    in property <bool> flag-osc;
    in property <bool> update-check;
    in property <bool> large-scrollback;
    in property <bool> convert-eol;
    in property <bool> json-format-output;
    in property <bool> hide-partitions;
    in property <bool> always-ask;
    in property <bool> follow-cd;
    in property <bool> collapse-sftp;
    in property <string> app-version;
    // ── 输出高亮（v0.8.0 终端设置页迁移）──────────────────────────────
    in property <bool> output-highlight-enabled: false;
    in property <string> output-highlight-preset: "log";
    in property <string> output-highlight-rule-status: "";
    in property <[OutputRuleItem]> output-highlight-rules;
    // 表单临时状态（页面本地，不进配置）
    in-out property <string> new-rule-pattern: "";
    in-out property <bool> new-rule-regex: false;
    in-out property <bool> new-rule-case: false;
    in-out property <bool> new-rule-whole: false;
    in-out property <string> new-rule-color: "yellow";
    callback set-output-highlight(bool, string);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    // ── 老设置窗口迁移进来的项（v0.8.0 设置面板 → 新页补全）──────────────
    in property <string> renderer-mode: "femtovg-wgpu"; // femtovg-wgpu(GPU) / software（重启生效）
    in property <string> update-channel: "stable";    // stable / beta
    in property <string> term-cursor-style: "block";  // block / bar / underline
    in property <string> term-cursor-choice: "";      // "" = 跟随主题
    in property <string> term-cursor-color-hex: "";
    /// 光标当前**精确色值**（Rust 侧 `set_term_cursor_color` 写入）。
    ///
    /// 与 `term-cursor-color-hex` 的分工：那个是给输入框回显用的字符串，这个给
    /// 色块 / 调色盘画色块用 —— 界面侧没有可靠的 hex 解析（见 AccentPicker 的
    /// 换算注释），拿字符串画色块不准。
    in property <color> term-cursor-color: Theme.term-fg;
    in property <bool> sync-upload-enabled: false;
    callback set-animations-enabled(bool);
    callback set-ui-scale(int);
    callback set-renderer-mode(string);
    callback set-term-cursor-style(string);
    callback set-term-cursor-preset(string);
    callback set-term-cursor-color(string);
    callback set-term-cursor-color-rgb(int, int, int) -> bool;
    callback resolve-hex(string) -> color;
    callback set-update-channel(string);
    callback set-sync-upload-enabled(bool);
    in property <[string]> ui-fonts;
    in property <int> ui-font-index;
    in property <[string]> term-fonts;
    in property <int> term-font-index;
    callback upload-ui-font();
    property <bool> font-menu-open: false;
    property <bool> tfont-menu-open: false;
    in-out property <string> accent-hex;   // 取色盘要就地改这个值；状态仍由 Rust 持有
    /// 预设色表由 Rust 提供（含"当前深浅档已解析好的颜色"）；第一条是出厂默认蓝。
    in property <[AccentPreset]> accent-presets;
    /// 配置里的原值（"" = 出厂默认 / 预设 id / "#RRGGBB"），用于判断选中态。
    in property <string> accent-choice;
    /// 当前配色的显示名（默认蓝 / 预设名 / 自定义 hex）。
    in property <string> accent-name;
    /// 上次检查时间（Rust 侧已本地化；空串 = 还没查过）。
    in property <string> update-last-check;
    // 检查的**实时状态**（旧设置窗 UpdatePage 就有，新设置页漏了）：
    // 空串 = 空闲；非空 = 「正在检查…」/「已是最新版本」/「发现新版本 vX」等。
    // 「上次检查时间」行的说明位优先显示它，没有才退回静态时间。
    in property <string> update-check-status;
    in property <bool> update-checking;
    in property <[string]> wallpaper-labels;
    // 磨砂透明度：直接读写主题全局 `panel-alpha`。
    // ⚠ 不能用 `property <=> Theme.xxx` 双向绑 —— 对 global 的双向绑定是**只读**的，
    // 滑杆会动但主题纹丝不动（本页此前"调不动透明度"就是这个原因）；松手时才落盘。
    callback persist-frost-alpha(float);
    in property <[string]> update-freq-labels;
    in property <int> update-freq-index;
    in-out property <string> mount-filter-text;
    callback set-update-freq(int);
    callback set-mount-filter-text(string);
    in property <int> wallpaper-index;
    callback set-accent-color(string);
    callback set-accent-rgb(int, int, int) -> bool;   // 取色盘提交（Slint 无 hex 格式化）
    callback check-update-now();
    callback reset-page(string);                      // 还原本页默认（Rust 已注册 AppWindow）
    callback set-wallpaper-label(string);
    callback pick-wallpaper();
    callback open-log-dir();
    in property <[string]> about-libs;
    in-out property <bool> webdav-enabled;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-certs;
    in property <string> webdav-status;
    callback save-webdav(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    callback set-language(string);
    callback pick-ui-font(string, int); // 选中界面字体（「跟随系统」存空串；int = 列表下标）
    in property <string> ui-font-now;
    callback toggle-theme();
    callback term-font(string, int); // 选中终端字体（int = 列表下标）
    callback term-font-size(int);
    callback term-font-bold(bool);
    callback term-scrollback(string);
    callback set-flag-update-check(bool);
    callback set-flag-large-scrollback(bool);
    callback set-flag-osc52(bool);
    callback set-flag-convert-eol(bool);
    callback set-flag-json-output(bool);
    callback set-flag-hide-partitions(bool);
    callback set-flag-always-ask(bool);
    callback set-flag-follow-cd(bool);
    callback set-flag-collapse-sftp(bool);

    // 滚回行数：上限随「大容量滚回」变化，非法输入不应用（Rust 侧同样会拒绝）。
    property <bool> scrollback-valid: true;
    property <int> scrollback-max: root.large-scrollback ? 1000000 : 100000;
    pure function scrollback-ok(t: string) -> bool {
        return t.to-float() >= 100 && t.to-float() <= root.scrollback-max;
    }
    // ── 滑杆 vs 滚动容器手势仲裁 ──────────────────────────────
    // Slint 的 Flickable 会在按下后 500ms 内、纵向漂移 >8px 时抢走手势
    // （DISTANCE_THRESHOLD=8 / DURATION_THRESHOLD=500ms，源码常量不可配）——
    // 横向拖磨砂滑杆时手一抖整页就被拖走、滑杆中断。对策：拖动期间把页面
    // 钉在 content-y 快照上（检测到抢夺立即拉回），松手/停顿 500ms 后放行。
    property <bool> frost-dragging: false;
    property <length> frost-pin-y: 0px;
    property <int> frost-idle: 0;
    // ── 接力拖动层：滑杆被 Flickable 抢走手势时接管，鼠标横向位移继续驱动数值 ──
    property <bool> frost-overlay: false;
    property <length> frost-travel: 600px; // 滑杆把手行程（width−把手宽），由滑杆自身回写
    property <float> frost-drag-value: 70;
    property <length> frost-overlay-last-x: 0px;
    property <bool> frost-overlay-init: false;
    property <int> frost-overlay-idle: 0;
    overlay-timer := Timer {
        interval: 300ms;
        running: root.frost-overlay;
        triggered => {
            // 300ms 鼠标无位移 = 已松手 → 结束接力并落盘
            root.frost-overlay-idle += 1;
            if (root.frost-overlay-idle >= 1) {
                root.frost-overlay = false;
                root.frost-overlay-init = false;
                root.frost-overlay-idle = 0;
                root.frost-dragging = false;
                root.persist-frost-alpha(1.0 - root.frost-drag-value / 100);
            }
        }
    }
    watchdog := Timer {
        interval: 250ms;
        running: root.frost-dragging;
        triggered => {
            root.frost-idle += 1;
            // 500ms 内滑杆值没有再变化 = 拖动已结束（正常松手或被抢断）→ 放行滚动
            if (root.frost-idle >= 2) {
                root.frost-dragging = false;
                root.frost-idle = 0;
            }
        }
    }

    // 0 基础 · 1 终端 · 2 文件 · 3 布局 · 4 快捷键
    property <int> current-cat: 0;

    // ═══ 分类页「淡出 → 换页 → 淡入」状态机 ═══════════════════════════════
    // current-cat = 用户点选（导航高亮/指示条**立即**响应）；cat-shown = 实际渲染。
    // 换分类时：容器 opacity 淡出（e-exit 150ms）→ Timer 到点换 cat-shown（新内容的
    // CatFade 自己 init 淡入）→ 容器瞬回 1。cat-opacity 是**无 animate** 的桥接属性：
    // 淡出期跟 cat-out 进度走，换页瞬间跳回 1 不会闪（新内容此刻是透明的）。
    property <int> cat-shown: 0;
    property <bool> cat-swapping: false;
    property <float> cat-out: 0;
    animate cat-out {
        duration: AnimationSettings.exit-page();
        easing: AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }
    property <float> cat-opacity: root.cat-swapping ? (1 - root.cat-out) : 1;
    changed current-cat => {
        if (root.current-cat != root.cat-shown) {
            root.cat-swapping = true;
            root.cat-out = 1;
            cat-swap-timer.running = true;
        }
    }
    // 弹层（PopupWindow）淡入驱动：is-open 变化时置 appear，内容根用它做透明度。
    // ⚠ 不能在弹层内容里引用 `popup.is-open` —— 会触发编译器 const_propagation 断言
    // panic（1.18.0 的坑），所以用 changed 回调把状态搬到组件根属性上。
    property <float> wp-appear: 0;
    property <float> font-appear: 0;
    property <float> tfont-appear: 0;
    // ⚠ animate 必须写在**弹层外**（组件根）—— 放进 PopupWindow 内容里会触发
    // 编译器 const_propagation 断言 panic（1.18.0）。内容只读属性值，动画在根上跑。
    animate wp-appear { duration: AnimationSettings.enter-container(); easing: AnimationSettings.e-enter(); enabled: AnimationSettings.enabled; }
    animate font-appear { duration: AnimationSettings.enter-container(); easing: AnimationSettings.e-enter(); enabled: AnimationSettings.enabled; }
    animate tfont-appear { duration: AnimationSettings.enter-container(); easing: AnimationSettings.e-enter(); enabled: AnimationSettings.enabled; }

    cat-swap-timer := Timer {
        // 关动画时 0ms 间隔会让 Timer 空转，钳到一帧
        interval: 150ms;
        triggered => {
            self.running = false;
            root.cat-shown = root.current-cat;
            root.cat-swapping = false;
            root.cat-out = 0;
        }
    }

    // 系统标题栏让位高度（macOS 红绿灯；自绘标题栏的平台传 0）。
    in property <length> top-inset: 0px;

    // 底色由外层页面容器提供（`Theme.bg-root` 磨砂，见 app_shell）：这里透明，
    // 否则两层磨砂叠加，本页会比别的页面更暗。
    background: transparent;

    HorizontalLayout {
        // ⚠ 普通(Rectangle)父级里的 Layout 按**首选尺寸**布局并贴左 —— 不显式铺满
        // 就是"内容挤在左半边、右侧整块空白"的根因（与右侧内容列同一类坑）。
        width: 100%;
        height: 100%;
  // ── 左列：标题 + 分类────────────
        nav-col := Rectangle {
            width: 200px;
            background: Theme.sur-1;

            nav-list := VerticalLayout {
                padding-top: 16px + root.top-inset;
                padding-bottom: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                // ⚠ VerticalLayout 的 alignment 是**主轴（垂直）**分布 —— start = 子项
                // 顶部对齐。删了它子项会被垂直摊开（用户截图：分类跑到底部）。
                alignment: start;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "\u{E8B8}";
                        font-family: "Material Icons";
                        font-size: 17px * Theme.ui-scale;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.lang-en ? "Settings" : "设置";
                        font-size: 15px * Theme.ui-scale;
                        font-weight: 700;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                }

                it0 := CategoryItem {
                    glyph: "\u{E8B8}";
                    label: root.lang-en ? "General" : "基础";
                    sub: root.lang-en ? "Language, theme, updates" : "语言、主题、更新与功能入口";
                    active: root.current-cat == 0;
                    clicked => {
                        root.current-cat = 0;
                    }
                }
                it1 := CategoryItem {
                    glyph: "\u{EB8E}";
                    label: root.lang-en ? "Terminal" : "终端";
                    sub: root.lang-en ? "Fonts, cursor and scrollback" : "终端、字体与渲染";
                    active: root.current-cat == 1;
                    clicked => {
                        root.current-cat = 1;
                    }
                }
                it2 := CategoryItem {
                    glyph: "\u{E2C7}";
                    label: root.lang-en ? "Files" : "文件";
                    sub: root.lang-en ? "SFTP, partitions and transfers" : "SFTP、分区与传输行为";
                    active: root.current-cat == 2;
                    clicked => {
                        root.current-cat = 2;
                    }
                }
                it3 := CategoryItem {
                    glyph: "\u{E312}";
                    label: root.lang-en ? "Shortcuts" : "快捷键";
                    sub: root.lang-en ? "Global and terminal shortcuts" : "全局快捷键与终端快捷键";
                    active: root.current-cat == 4;
                    clicked => {
                        root.current-cat = 4;
                    }
                }
                it4 := CategoryItem {
                    glyph: "\u{E2EB}"; // cloud
                    label: root.lang-en ? "Cloud Sync" : "云同步";
                    sub: root.lang-en ? "WebDAV backup and restore" : "官方云 · WebDAV、加密与恢复";
                    active: root.current-cat == 6;
                    clicked => {
                        root.current-cat = 6;
                    }
                }
                it5 := CategoryItem {
                    glyph: "\u{E88E}";
                    label: root.lang-en ? "About" : "关于";
                    sub: root.lang-en ? "Version, logs and feedback" : "版本、日志与反馈";
                    active: root.current-cat == 5;
                    clicked => {
                        root.current-cat = 5;
                    }
                }
            }
            // 选中指示条：单个 3px accent 竖条，切换分类时 150ms 滑到选中行
            // （行高一致 46px；y = 列表布局 y + 选中行 y；搜索过滤隐藏选中行时一并隐藏）。
            Rectangle {
                width: 3px;
                height: it0.height;
                border-radius: 1.5px;
                background: Theme.accent;
                x: 0;
                y: nav-list.y + (root.current-cat == 0 ? it0.y
                    : root.current-cat == 1 ? it1.y
                    : root.current-cat == 2 ? it2.y
                    : root.current-cat == 4 ? it3.y
                    : root.current-cat == 6 ? it4.y
                    : it5.y);
                // 滑动指示条：空间运动 → 弹簧（跟手；连点切换时保留速度不重启）
                animate y {
                    duration: AnimationSettings.enter-container();
                    easing: AnimationSettings.s-soft();
                    enabled: AnimationSettings.enabled;
                }
            }
        }

        // ── 右侧：页头 + 设置区 ─────────────────────────
        content-rect := Rectangle {
            horizontal-stretch: 1;
            // ⚠ 必须**显式**、且**不能反过来依赖自己这一列**：实测（Timer + debug 探针量宽）
            // 布局里单元格的拉伸会被自身 LayoutInfo 的 max 夹住 —— 只写 horizontal-stretch
            // 时本列拿不到剩余宽度（1274 − 200 = 1074 被夹成 453，右侧整块空白）。
            width: root.width - nav-col.width;

            content-col := VerticalLayout {
                width: 100%;
                height: parent.height;
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 0;

HorizontalLayout {
                    Text {
                        height: 34px;
                        text: root.current-cat == 0 ? "基础设置"
                            : root.current-cat == 1 ? "终端设置"
                            : root.current-cat == 2 ? "文件设置"
                            : root.current-cat == 5 ? "关于"
                            : root.current-cat == 6 ? "云同步"
                            : "快捷键";
                        font-size: 17px * Theme.ui-scale;
                        font-weight: 700;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // 只有 Rust 侧有还原分支的三页才有按钮（terminal / appearance / transfer）。
                    if root.cat-shown == 0 : ResetButton {
                        page: "appearance";
                        reset(p) => { root.reset-page(p); }
                    }
                    if root.cat-shown == 1 : ResetButton {
                        page: "terminal";
                        reset(p) => { root.reset-page(p); }
                    }
                    if root.cat-shown == 2 : ResetButton {
                        page: "transfer";
                        reset(p) => { root.reset-page(p); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }

                flick := Flickable {
                    vertical-stretch: 1;
                    // ⚠ content-height 自动推导走子元素 layout info —— Rectangle 包装层
                    // 不传播（= 视口高，滚轮失灵），必须显式绑内层布局的内容高。
                    content-height: flick-inner.preferred-height;
                    // 拖滑杆期间页面被抢 → 钉回拖动开始的位置（页面不再被整页拖走），
                    // 并弹出接力层接管拖动（接力层在 Flickable 之外，不会再被抢）。
                    changed content-y => {
                        if (root.frost-dragging || root.frost-overlay) {
                            flick.content-y = root.frost-pin-y;
                        }
                        if (root.frost-dragging && !root.frost-overlay) {
                            root.frost-drag-value = (1.0 - Theme.panel-alpha) * 100;
                            root.frost-overlay-init = false;
                            root.frost-overlay = true;
                        }
                    }
                    // 同 content-rect：百分比是不会自指的写法（`parent.width` 会与本列互相依赖），
                    // 量出来的结果是从 405 变成整宽 —— 上面那处注释有完整的实测数据。
                    width: 100%;
                    flick-col := Rectangle {
                        // ⚠ Flickable 会把**未钉位**的子元素按视口垂直居中（实测 y =
                        // (视口高 − 内容高)/2，整页下坠）—— 子元素必须显式 x/y = 0 钉住。
                        x: 0;
                        y: 0;
                        width: 100%;
                        // ⚠ Rectangle **不向父级传播**子布局的 layout info（实测 preferred
                        // = 0，内容整体下坠）—— 高度必须显式绑内层布局的首选高。
                        height: flick-inner.preferred-height;
                        // 淡出/淡入的载体（VerticalLayout 没有 opacity）
                        opacity: root.cat-opacity;
                        flick-inner := VerticalLayout {
                            // 高度取首选：Flickable 的子元素默认按视口高布局，卡片会被拉伸。
                            width: 100%;
                            height: self.preferred-height;
                            x: 0;
                            y: 0;
                            padding-top: 8px + root.top-inset;
                            spacing: 0;

                        // ═══ 基础 ═══
                        if root.cat-shown == 0 : CatFade {
                            cat-spacing: 4px;
                            SectionTitle { text: root.lang-en ? "Language & theme" : "语言与主题"; }
                            Card {
                                OptionRow {
                                    label: root.lang-en ? "Language" : "界面语言";
                                    desc: root.lang-en ? "Applies immediately across the window" : "选择应用的显示语言";

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        Rectangle {
                                            width: 52px;
                                            height: 26px;
                                            border-radius: Theme.radius-btn;
                                            background: !root.lang-en ? Theme.accent : Theme.sur-2;

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "中文";
                                                    font-size: 11px * Theme.ui-scale;
                                                    color: !root.lang-en ? white : Theme.fg-2;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-language("zh");
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 64px;
                                            height: 26px;
                                            border-radius: Theme.radius-btn;
                                            background: root.lang-en ? Theme.accent : Theme.sur-2;

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "English";
                                                    font-size: 11px * Theme.ui-scale;
                                                    color: root.lang-en ? white : Theme.fg-2;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-language("en");
                                                }
                                            }
                                        }
                                    }
                                }
}
                            SectionTitle { text: root.lang-en ? "Theme & wallpaper" : "主题与壁纸"; }
                            Card {
                                OptionRow {
                                label: root.lang-en ? "Accent colour" : "主题色";
                                desc: root.lang-en
                                    ? "Buttons, tabs, selections and highlights follow this colour. Switching wallpaper returns it to \"follow wallpaper\"."
                                    : "按钮、标签页、选中态与高亮都跟随这个颜色。切换壁纸会回到「跟随壁纸」。";

AccentPicker {
                                    lang-en: root.lang-en;
                                    value <=> root.accent-hex;
                                    preview-color: Theme.accent-seed;
                                    presets: root.accent-presets;
                                    choice: root.accent-choice;
                                    accent-name: root.accent-name;
                                    pick-preset(id) => { root.set-accent-color(id); }
                                    apply-color(v) => { root.set-accent-color(v); return true; }
                                    apply-color-rgb(r, g, b) => { return root.set-accent-rgb(r, g, b); }
                                }
                            }
                                FieldBlock {
                                    title: root.lang-en ? "Wallpaper" : "壁纸";
                                    desc: root.lang-en ? "Panels frost over the current wallpaper" : "面板磨砂取自当前壁纸；导入的自定义壁纸也会进入清单";

                                HorizontalLayout {
                                    spacing: 8px;
                                    SelectBox {
  // 全宽（壁纸下拉铺满内容列）
                                        horizontal-stretch: 1;
                                        text: root.wallpaper-labels.length > 0 && root.wallpaper-index < root.wallpaper-labels.length
                                            ? root.wallpaper-labels[root.wallpaper-index]
                                            : (root.lang-en ? "Default" : "默认");
                                        clicked => {
                                            root.wp-appear = 0;   // 复位（此刻弹层未显示，动画不可见）
                                            wp-popup.show();
                                            root.wp-appear = 1;   // show 之后置 1 → 淡入
                                        }
                                    }
                                    UploadButton {
                                        clicked => { root.pick-wallpaper(); }
                                    }
                                    }

                                    wp-popup := PopupWindow {
                                        // ⚠ 同 FontPickerPopup：默认值 `close-on-click`
                                        // 会让点列表项时弹层先消失、clicked 不触发，
                                        // 表现为「只有特定位置才选得中」。
                                        close-policy: close-on-click-outside;
                                        Rectangle {
                                            width: 260px;
                                            border-radius: 8px;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            background: Theme.sur-1;
                                            // 展开淡入：appear 由 changed is-open 驱动
                                            opacity: root.wp-appear;

                                            VerticalLayout {
                                                spacing: 0;
                                                alignment: start;

                                                for wlab[i] in root.wallpaper-labels : Rectangle {
                                                height: 30px;
                                                border-radius: 8px;
                                                background: root.wallpaper-index == i
                                                    ? Theme.rail-item-active
                                                    : (wp-ta.has-hover ? Theme.rail-item-hover : transparent);

                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    alignment: start;

                                                    Text {
                                                        text: wlab;
                                                        font-size: 12px * Theme.ui-scale;
                                                        color: root.wallpaper-index == i ? Theme.accent : Theme.fg-1;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                wp-ta := TouchArea {
                                                    clicked => {
                                                        root.set-wallpaper-label(wlab);
                                                        root.wp-appear = 0;   // 复位（弹层随即消失）
                                                        wp-popup.close();
                                                    }
                                                }
                                            }
                                            }
                                        }
                                    }
                                }
                                FieldBlock {
                                    title: root.lang-en ? "Frosted-glass opacity" : "面板 / 终端磨砂透明度";
                                    desc: root.lang-en
                                        ? "Frost strength for panels, the sidebar, the status bar and the terminal: 0% is fully opaque, the larger the number the more the wallpaper shows through."
                                        : "面板 / 侧栏 / 状态栏 / 终端的磨砂程度：0% 为完全不透明，数值越大越透（同一套实现，一处改动四处生效）";

                                    HorizontalLayout {
                                        spacing: 8px;

                                        // 官方 Slider 铺满内容列（拖动实时预览，松手落盘）
                                        frost-slider := Slider {
                                            minimum: 0;
                                            maximum: 70;
                                            changed width => { root.frost-travel = self.width - 20px; }
                                            value: (1.0 - Theme.panel-alpha) * 100;
                                            changed(v) => {
                                                root.frost-idle = 0;
                                                root.frost-pin-y = flick.content-y;
                                                root.frost-dragging = true;
                                                Theme.panel-alpha = 1.0 - v / 100;
                                            }
                                            released(v) => {
                                                root.frost-dragging = false;
                                                root.persist-frost-alpha(1.0 - v / 100);
                                            }
                                        }
                                        Text {
                                            text: "\{round((1.0 - Theme.panel-alpha) * 100)}%";
                                            font-size: 12px * Theme.ui-scale;
                                            color: Theme.fg-2;
                                            vertical-alignment: center;
                                            width: 34px;
                                        }
                                    }
                                }
                            }
                                // ── 渲染器（v0.8.0 设置窗迁移；重启生效）────────────────────────
                            SectionTitle { text: root.lang-en ? "Font & scale" : "字体与缩放"; }
                            Card {
                                FieldBlock {
                                    title: root.lang-en ? "UI Font" : "界面字体";
                                    desc: root.lang-en ? "Window-wide UI font; import external fonts into the list" : "整窗 UI 字体；外部字体经「导入」加入清单（终端字体在终端分组）";

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            SelectBox {
                                                horizontal-stretch: 1;
                                                text: root.ui-fonts.length > 0 && root.ui-font-index < root.ui-fonts.length
                                                    ? root.ui-fonts[root.ui-font-index]
                                                    : (root.lang-en ? "Auto" : "自动");
                                                clicked => {
                                                    font-popup.open();
                                                }
                                            }
                                            UploadButton {
                                                clicked => { root.upload-ui-font(); }
                                            }
                                        }

                                        // 内联实现已提取为共享组件 FontPickerPopup（ui/pickers.slint）：
                                        // 原先界面字体 / 终端字体各有一份，逐行 diff 有 70% 重复。
                                        // 淡入淡出也收进了组件（open / dismiss），调用方只需这三行。
                                        font-popup := FontPickerPopup {
                                            fonts: root.ui-fonts;
                                            current-index: root.ui-font-index;
                                            pick(label, i) => { root.pick-ui-font(label, i); }
                                        }
                                    }
                                }
                                OptionRow {
    label: root.lang-en ? "UI Scale" : "界面缩放";
    desc: root.lang-en ? "Scales fonts and controls (80% – 200%)" : "整体缩放界面字体与控件（80% – 200%）";

    Stepper {
        value: round(Theme.ui-scale * 100);
        minimum: 80;
        maximum: 200;
        step: 10;
        unit: "%";
        changed(v) => { root.set-ui-scale(v); }
    }
}

ToggleRow {
    label: root.lang-en ? "Animations" : "界面动画";
    desc: root.lang-en ? "Hover states, sliding indicator and wallpaper crossfade" : "悬停态、滑动指示条与壁纸淡化的过渡动画开关";
    on: AnimationSettings.enabled;
    toggled => {
        root.set-animations-enabled(!AnimationSettings.enabled);
    }
}
                            }
                            SectionTitle { text: root.lang-en ? "Rendering" : "渲染"; }
                            Card {
                                OptionRow {
                                    label: root.lang-en ? "Renderer" : "渲染器";
                                    desc: root.lang-en ? "Software rendering is the most compatible; takes effect after restart" : "软件渲染兼容性最好；切换后重启生效";
                            
                                    CapsuleRow {
                                        // 三档语义值（auto / wgpu / software），与
                                        // `ConfigStore::renderer_mode_choice` 一一对应。
                                        // ⚠ 这里**不能**写后端名（`femtovg-wgpu`）：胶囊按
                                        // 字符串精确匹配下标高亮，而后端名三平台各不相同
                                        // （macOS 归一化成 femtovg-wgpu、Windows 认 wgpu），
                                        // 写后端名会导致切换不生效、且没有高亮。
                                        opts: [
                                            {value: "auto", label: root.lang-en ? "Auto" : "自动"},
                                            {value: "wgpu", label: "GPU"},
                                            {value: "software", label: root.lang-en ? "Software" : "软件渲染"},
                                        ];
                                        value: root.renderer-mode;
                                        picked(v) => {
                                            debug("RENDERER-MODE picked=", v);
                                            root.set-renderer-mode(v);
                                        }
                                    }
                                }
                            }
                            SectionTitle { text: root.lang-en ? "Updates" : "更新"; }
                            Card {
                                ToggleRow {
                                    label: root.lang-en ? "Check for Updates" : "自动检查更新";
                                    desc: root.lang-en ? "Check on startup (manual check anytime)" : "启动时检查新版本（可随时手动检查）";
                                    on: root.update-check;
                                    toggled => {
                                        root.set-flag-update-check(!root.update-check);
                                    }
                                }
                                OptionRow {
                                    label: root.lang-en ? "Update Channel" : "更新渠道";
                                    desc: root.lang-en ? "Beta receives new features earlier" : "测试版更早拿到新功能与修复";
                            
                                    CapsuleRow {
                                        opts: [
                                            {value: "stable", label: root.lang-en ? "Stable" : "稳定版"},
                                            {value: "beta", label: root.lang-en ? "Beta" : "测试版"},
                                            {value: "all", label: root.lang-en ? "All channels" : "全通道"},
                                        ];
                                        value: root.update-channel;
                                        picked(v) => { root.set-update-channel(v); }
                                    }
                                }
                                OptionRow {
                                    label: root.lang-en ? "Check Interval" : "检查频率";
                                    desc: "自动检查更新的间隔";

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        for fl[i] in root.update-freq-labels : Rectangle {
                                            width: ftext.preferred-width + 20px;
                                            height: 26px;
                                            border-radius: Theme.radius-btn;
                                            border-width: 1px;
                                            border-color: root.update-freq-index == i ? Theme.accent : Theme.line;
                                            background: root.update-freq-index == i ? Theme.rail-item-active : Theme.sur-2;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                alignment: center;
                                                ftext := Text {
                                                    text: fl;
                                                    font-size: 11px * Theme.ui-scale;
                                                    color: root.update-freq-index == i ? Theme.accent : Theme.fg-2;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.set-update-freq(i);
                                                }
                                            }
                                        }
                                    }
                                }
                                OptionRow {
                                    label: root.lang-en ? "Last checked" : "上次检查时间";
                                    // 实时状态优先（检查中 / 已是最新 / 发现新版本），
                                    // 没有结果才退回静态的上次检查时间。
                                    desc: root.update-check-status != ""
                                        ? root.update-check-status
                                        : root.update-last-check;

                                    Rectangle {
                                        // 检查中按钮变宽（放得下「检查中…」），与旧设置窗一致
                                        width: root.update-checking ? 92px : 80px;
                                        height: 28px;
                                        border-radius: Theme.radius-btn;
                                        background: upd-ck-ta.has-hover && !root.update-checking
                                            ? Theme.rail-item-hover
                                            : Theme.sur-2;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        upd-ck-ta := TouchArea {
                                            // 检查中禁用：避免连点起多个后台检查线程
                                            enabled: !root.update-checking;
                                            mouse-cursor: root.update-checking ? default : pointer;
                                            clicked => { root.check-update-now(); }
                                        }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.update-checking
                                                ? (root.lang-en ? "Checking…" : "检查中…")
                                                : (root.lang-en ? "Check now" : "立即检查");
                                            font-size: 11px * Theme.ui-scale;
                                            color: root.update-checking ? Theme.fg-3 : Theme.fg-1;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                        }
                        }

                        // ═══ 终端 ═══
                        if root.cat-shown == 1 : CatFade {
                            cat-spacing: 4px;

                            SectionTitle { text: root.lang-en ? "Font & display" : "字体与显示"; }
                            Card {
                                FieldBlock {
                                    title: root.lang-en ? "Terminal Font" : "终端字体";
                                    desc: root.lang-en ? "Installed monospace families, applies instantly" : "已安装的等宽字体，随改随生效并持久化";

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            SelectBox {
                                                horizontal-stretch: 1;
                                                text: root.term-fonts.length > 0 && root.term-font-index < root.term-fonts.length
                                                    ? root.term-fonts[root.term-font-index]
                                                    : Theme.term-font-family;
                                                clicked => {
                                                    tfont-popup.open();
                                                }
                                            }
                                            UploadButton {
                                                clicked => { root.upload-ui-font(); }
                                            }
                                            Switch {
                                                on: Theme.term-font-bold;
                                                toggled => {
                                                    root.term-font-bold(!Theme.term-font-bold);
                                                }
                                            }
                                            Text {
                                                text: root.lang-en ? "Bold" : "粗体";
                                                font-size: 11px * Theme.ui-scale;
                                                color: Theme.fg-3;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // 内联实现已提取为共享组件 FontPickerPopup（ui/pickers.slint）：
                                        // 原先界面字体 / 终端字体各有一份，逐行 diff 有 70% 重复。
                                        // 淡入淡出也收进了组件（open / dismiss），调用方只需这三行。
                                        tfont-popup := FontPickerPopup {
                                            fonts: root.term-fonts;
                                            current-index: root.term-font-index;
                                            pick(label, i) => { root.term-font(label, i); }
                                        }
                                    }
                                }
                                    OptionRow {
                                        label: root.lang-en ? "Font Size" : "字号";
                                        desc: root.lang-en ? "8–32px, default 13" : "8–32px，默认 13";

                                        Stepper {
                                            value: round(Theme.term-font-size / 1px);
                                            minimum: 8;
                                            maximum: 32;
                                            unit: "px";
                                            changed(v) => { root.term-font-size(v); }
                                        }
                                    }

                                    // 字体预览：与终端同字体 / 同字号 / 同粗体 / 同前景色，改设置立刻可见。
                                    Rectangle {
                                        height: 52px;
                                        background: Theme.term-bg;
                                        border-radius: Theme.radius-btn;
                                        border-width: 1px;
                                        border-color: Theme.line;

                                        Text {
                                            x: 12px;
                                            text: "Rudder ~$ echo preview 0123";
                                            font-family: Theme.term-font-family;
                                            font-size: Theme.term-font-size;
                                            font-weight: Theme.term-font-bold ? 700 : 400;
                                            color: Theme.term-fg;
                                            vertical-alignment: center;
                                            height: parent.height;
                                        }
                                    }
                            }
                            SectionTitle { text: root.lang-en ? "Scrollback & clipboard" : "滚回与剪贴板"; }
                            Card {
                                OptionRow {
                                    label: root.lang-en ? "Scrollback Lines" : "滚回行数";
                                    desc: root.lang-en
                                        ? "History lines kept in the terminal (100 – 1,000,000)."
                                        : "终端可回看的历史行数（100 – 100 万）。";

                                    LineEdit {
                                        width: 160px;
                                        text: root.scrollback;
                                        accepted(t) => {
                                            root.scrollback-valid = root.scrollback-ok(t);
                                            if (root.scrollback-valid) { root.term-scrollback(t); }
                                        }
                                    }
                                }
                                Rectangle {
                                    background: Theme.sur-2;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 2px;
                                        padding-bottom: 8px;
                                        Text {
                                            horizontal-stretch: 1;
    text: root.scrollback-valid
        ? (root.large-scrollback
            ? (root.lang-en ? "Up to 1,000,000 lines (large buffer enabled)." : "上限 100 万行（已开启大缓冲区）。")
            : (root.lang-en ? "Up to 100,000 lines. Enable the large buffer below to go higher." : "上限 10 万行；需要更多请开启下方的「大容量滚回模式」。"))
        : (root.lang-en ? "Out of range — the value was not applied." : "超出范围，未应用。");
    font-size: 11px * Theme.ui-scale;
    color: root.scrollback-valid ? Theme.fg-3 : Theme.danger;
    wrap: word-wrap;
    line-height-factor: 1.3;
    }
    }
}
                                ToggleRow {
                                    label: root.lang-en ? "Large Scrollback" : "大容量滚回模式";
                                desc: root.lang-en
                                    ? "Doubles the history buffer (up to 1,000,000 lines). Memory grows per tab: 100k ≈ 458 MB, 1M ≈ 4.8 GB at 200 columns."
                                    : "历史缓存翻倍（最多 100 万行）。内存按标签页独立计算：200 列时 10 万行约 458 MB，100 万行约 4.8 GB。";
                                    on: root.large-scrollback;
                                    toggled => {
                                        root.set-flag-large-scrollback(!root.large-scrollback);
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "OSC52 Clipboard" : "OSC52 剪贴板同步";
                                    desc: root.lang-en ? "Let remote programs read/write the local clipboard" : "允许远端程序经转义序列读写本机剪贴板";
                                    on: root.flag-osc;
                                    toggled => {
                                        root.set-flag-osc52(!root.flag-osc);
                                    }
                                }

                            // ── 光标（v0.8.0 设置窗迁移）──────────────────────────
                        }
                            SectionTitle { text: root.lang-en ? "Cursor" : "光标"; }
                            Card {
                            OptionRow {
                                label: root.lang-en ? "Cursor Style" : "光标样式";
                                desc: "";
                                HorizontalLayout {
                                    spacing: 6px;
                                    CursorStyleButton {
                                        label: root.lang-en ? "Block" : "方块";
                                        cursor-kind: "block";
                                        selected: root.term-cursor-style == "block";
                                        clicked => { root.set-term-cursor-style("block"); }
                                    }
                                    CursorStyleButton {
                                        label: root.lang-en ? "Bar" : "竖线";
                                        cursor-kind: "bar";
                                        selected: root.term-cursor-style == "bar";
                                        clicked => { root.set-term-cursor-style("bar"); }
                                    }
                                    CursorStyleButton {
                                        label: root.lang-en ? "Line" : "下划线";
                                        cursor-kind: "underline";
                                        selected: root.term-cursor-style == "underline";
                                        clicked => { root.set-term-cursor-style("underline"); }
                                    }
                                }
                            }
                            OptionRow {
                                label: root.lang-en ? "Cursor Color" : "光标颜色";
                                desc: root.lang-en ? "Pick a preset or type a hex color; empty = follow the theme" : "选预设色块或输入十六进制色值；留空跟随主题";
                                // 预设圆 + HEX 输入 + 调色盘入口 → 共享组件 ColorSwatchRow
                                // （ui/pickers.slint）。原先这三样是手写在这里的，改样式要动两处。
                                cursor-row := ColorSwatchRow {
                                    presets: [
                                        // ⚠ 第一项是「跟随主题」：色块必须画**跟随后会变成的
                                        // 那个色**，而不是某个"看起来像默认值"的颜色。跟随时
                                        // 光标色 = 强调色（Rust `get_accent_solid()`，见
                                        // settings/terminal.rs），所以这里用 `accent-solid`；
                                        // 之前错填 `term-fg`，深色主题下是浅灰，跟实际
                                        // 生效的强调色对不上（用户截图：第一个圆是红的）。
                                        { hex: "", swatch: Theme.accent-solid },
                                        { hex: "#D4D4D4", swatch: #D4D4D4 },
                                        { hex: "#FF5252", swatch: #FF5252 },
                                        { hex: "#69F0AE", swatch: #69F0AE },
                                        { hex: "#40C4FF", swatch: #40C4FF },
                                    ];
                                    current: root.term-cursor-choice;
                                    current-color: root.term-cursor-color;
                                    hex: root.term-cursor-color-hex;
                                    lang-en: root.lang-en;
                                    pick(h) => { root.set-term-cursor-preset(h); }
                                    request-palette() => { cursor-palette.open(); }
                                }
                                // 光标颜色的 HSV 调色盘：与主题色共用同一个组件。
                                cursor-palette := ColorPalettePopup {
                                    current: root.term-cursor-color;
                                    hex: root.term-cursor-color-hex;
                                    lang-en: root.lang-en;
                                    apply-color(t) => { root.set-term-cursor-color(t); return true; }
                                    resolve-hex(t) => { return root.resolve-hex(t); }
                                    apply-rgb(r, g, b) => { return root.set-term-cursor-color-rgb(r, g, b); }
                                }
                            }

                            // ── 输出高亮（v0.8.0 终端设置页迁移）──────────────────
                        }
                            SectionTitle { text: root.lang-en ? "Output highlighting" : "输出高亮"; }
                            Card {
                            ToggleRow {
                                label: root.lang-en ? "Output Highlighting" : "输出高亮";
                                desc: root.lang-en ? "Colourise log levels, URLs, IPs and more" : "给日志等级、URL、IP 等上色";
                                on: root.output-highlight-enabled;
                                toggled => {
                                    root.set-output-highlight(!root.output-highlight-enabled, root.output-highlight-preset);
                                }
                            }
                            OptionRow {
                                label: root.lang-en ? "Highlight Preset" : "高亮预设";
                                desc: root.lang-en ? "Log levels is conservative; DevOps recognises deployment states; Built-in colours numbers, URLs, IPs, UUIDs and dates" : "日志等级较保守；运维识别部署状态；内置多彩覆盖数字、URL、IP、UUID、日期等";
                                CapsuleRow {
                                    opts: [
                                        {value: "log", label: root.lang-en ? "Log levels" : "日志等级"},
                                        {value: "devops", label: "DevOps"},
                                        {value: "builtin", label: root.lang-en ? "Built-in" : "内置多彩"},
                                    ];
                                    value: root.output-highlight-preset;
                                    picked(v) => { root.set-output-highlight(root.output-highlight-enabled, v); }
                                }
                            }

// 高亮预览：按当前预设给样例上色，开关关闭时回到终端原色。
Rectangle {
// 预览行由**多个片段**拼成 —— 片段颜色即高亮规则的真实着色：级别词、
    // URL、IP:端口、路径各走各自的语义色；「输出高亮」关掉时全部退回终
    // 端前景色（所见即所得，而不是另画一套示意图）。
    height: root.output-highlight-preset == "devops" ? 116px : 92px;
    background: Theme.term-bg;
    border-radius: Theme.radius-btn;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 12px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 0;
            Text {
                text: "16:30:00 ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "INFO ";
                color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "listening on ";
                color: Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "0.0.0.0:8080";
                color: root.output-highlight-enabled ? Theme.success : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 0;
            Text {
                text: "16:30:01 ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "DEBUG ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "cache miss ";
                color: Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "http://api.dev:8080/v1?id=42";
                color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 0;
            Text {
                text: "16:30:02 ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "WARN ";
                color: root.output-highlight-enabled ? Theme.warning : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "disk nearly full ";
                color: Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "/var/log";
                color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 0;
            Text {
                text: "16:30:03 ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "ERROR ";
                color: root.output-highlight-enabled ? Theme.danger : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "connection failed ";
                color: Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "192.168.1.100";
                color: root.output-highlight-enabled ? Theme.success : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
        }
        if root.output-highlight-preset == "devops" : HorizontalLayout {
            spacing: 0;
            Text {
                text: "16:30:04 ";
                color: root.output-highlight-enabled ? Theme.fg-3 : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "SUCCESS ";
                color: root.output-highlight-enabled ? Theme.success : Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
            Text {
                text: "deployment completed";
                color: Theme.term-fg;
                font-family: Theme.term-font-family; font-size: 12px * Theme.ui-scale;
                vertical-alignment: center;
            }
        }
    }
}
                            FieldBlock {
                                title: root.lang-en ? "Custom Rules" : "自定义规则";
                                desc: root.lang-en ? "Custom rules run before the preset and never overwrite ANSI colours" : "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色";

                                if root.output-highlight-rule-status != "" : Text {
                                    text: root.output-highlight-rule-status;
                                    font-size: 10px * Theme.ui-scale;
                                    color: Theme.danger;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 6px;

                                    pat-edit := LineEdit {
                                        width: 220px;
                                        placeholder-text: root.lang-en ? "connection refused" : "connection refused";
                                        text <=> root.new-rule-pattern;
                                        accepted(t) => {
                                            if root.add-output-highlight-rule(
                                                t, root.new-rule-regex, root.new-rule-case,
                                                root.new-rule-whole, root.new-rule-color) {
                                                root.new-rule-pattern = "";
                                            }
                                        }
                                    }
                                    CapsuleRow {
                                        opts: [
                                            {value: "kw", label: root.lang-en ? "Keyword" : "关键词"},
                                            {value: "re", label: root.lang-en ? "Regex" : "正则"},
                                        ];
                                        value: root.new-rule-regex ? "re" : "kw";
                                        picked(v) => { root.new-rule-regex = (v == "re"); }
                                    }
                                    CapsuleRow {
                                        opts: [
                                            {value: "red", label: root.lang-en ? "Red" : "红"},
                                            {value: "yellow", label: root.lang-en ? "Yellow" : "黄"},
                                            {value: "green", label: root.lang-en ? "Green" : "绿"},
                                            {value: "cyan", label: root.lang-en ? "Cyan" : "青"},
                                            {value: "magenta", label: root.lang-en ? "Magenta" : "紫"},
                                            {value: "gray", label: root.lang-en ? "Gray" : "灰"},
                                        ];
                                        value: root.new-rule-color;
                                        picked(v) => { root.new-rule-color = v; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Switch { on: root.new-rule-case; toggled => { root.new-rule-case = !root.new-rule-case; } }
                                        Text {
                                            text: root.lang-en ? "Case sensitive" : "区分大小写";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Switch { on: root.new-rule-whole; toggled => { root.new-rule-whole = !root.new-rule-whole; } }
                                        Text {
                                            text: root.lang-en ? "Whole line" : "仅整行";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-2;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        min-width: 76px;
                                        max-width: 120px;
                                        height: 28px;
                                        border-radius: Theme.radius-btn;
                                        background: root.new-rule-pattern == "" ? Theme.sur-3 : Theme.accent;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: root.lang-en ? "Add Rule" : "添加规则";
                                            font-size: 11px * Theme.ui-scale;
                                            font-weight: 600;
                                            color: root.new-rule-pattern == "" ? Theme.fg-3 : Theme.bg-root;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        add-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if root.new-rule-pattern != "" {
                                                    if root.add-output-highlight-rule(
                                                        root.new-rule-pattern, root.new-rule-regex,
                                                        root.new-rule-case, root.new-rule-whole,
                                                        root.new-rule-color) {
                                                        root.new-rule-pattern = "";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 0;

                                    for rule[index] in root.output-highlight-rules : Rectangle {
                                        height: 44px;

                                        HorizontalLayout {
                                            y: 0;
                                            width: parent.width;
                                            height: parent.height - 1px;
                                            spacing: 9px;

                                            Rectangle {
                                                width: 8px;
                                                height: 8px;
                                                border-radius: 4px;
                                                background: rule.color == "yellow" ? Theme.warning
                                                    : rule.color == "green" ? Theme.success
                                                    : rule.color == "cyan" ? Theme.accent
                                                    : rule.color == "magenta" ? #d670d6
                                                    : rule.color == "gray" ? Theme.fg-3
                                                    : Theme.danger;
                                                vertical-stretch: 0;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;

                                                Text {
                                                    text: rule.pattern;
                                                    color: rule.enabled ? Theme.fg-1 : Theme.fg-3;
                                                    font-family: Theme.term-font-family;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: (rule.regex ? "Regex" : (root.lang-en ? "Keyword" : "关键词"))
                                                        + (rule.case-sensitive ? " · Aa" : "")
                                                        + (rule.whole-line ? (root.lang-en ? " · whole line" : " · 整行") : "");
                                                    color: Theme.fg-3;
                                                    font-size: 10px * Theme.ui-scale;
                                                }
                                            }
                                            Switch {
                                                on: rule.enabled;
                                                toggled => { root.set-output-highlight-rule-enabled(index, !rule.enabled); }
                                            }
                                            Rectangle {
                                                width: 28px;
                                                height: 28px;
                                                border-radius: 5px;
                                                background: del-ta.has-hover ? Theme.sur-3 : transparent;

                                                del-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.remove-output-highlight-rule(index); }
                                                }
                                                Text {
                                                    text: "\u{E872}";
                                                    font-family: "Material Icons";
                                                    font-size: 15px * Theme.ui-scale;
                                                    color: Theme.fg-3;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            y: parent.height - 1px;
                                            width: parent.width;
                                            height: 1px;
                                            background: Theme.line;
                                        }
                                    }
                                }
                            }
                        }
                        }

                        // ═══ 文件 ═══
                        if root.cat-shown == 2 : CatFade {
                            cat-spacing: 4px;

                            SectionTitle { text: root.lang-en ? "Transfers" : "传输行为"; }
                            Card {
                                ToggleRow {
                                    label: root.lang-en ? "EOL Conversion (LF ↔ CRLF)" : "换行转换 (LF ↔ CRLF)";
                                    desc: root.lang-en ? "Convert EOL when uploading/editing text" : "上传/编辑文本时按目标系统转换换行符";
                                    on: root.convert-eol;
                                    toggled => {
                                        root.set-flag-convert-eol(!root.convert-eol);
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "JSON Output" : "命令输出 JSON 格式化";
                                    on: root.json-format-output;
                                    toggled => {
                                        root.set-flag-json-output(!root.json-format-output);
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "Always Ask Where to Save" : "下载前始终询问位置";
                                    on: root.always-ask;
                                    toggled => {
                                        root.set-flag-always-ask(!root.always-ask);
                                    }
                                }
                            }
                            SectionTitle { text: root.lang-en ? "SFTP panel" : "SFTP 面板"; }
                            Card {
                                ToggleRow {
                                    label: root.lang-en ? "Hide Special Partitions" : "隐藏特殊分区";
                                    desc: root.lang-en ? "Hide tmpfs / overlay virtual partitions" : "文件面板不显示 tmpfs / overlay 等虚拟分区";
                                    on: root.hide-partitions;
                                    toggled => {
                                        root.set-flag-hide-partitions(!root.hide-partitions);
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "Follow Remote cwd" : "面板跟随远端 cwd";
                                    desc: root.lang-en ? "SFTP panel follows terminal cd" : "终端 cd 时 SFTP 面板自动切到同目录";
                                    on: root.follow-cd;
                                    toggled => {
                                        root.set-flag-follow-cd(!root.follow-cd);
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "Collapse SFTP Panel" : "默认折叠 SFTP 面板";
                                    on: root.collapse-sftp;
                                    toggled => {
                                        root.set-flag-collapse-sftp(!root.collapse-sftp);
                                    }
                                }
                                FieldBlock {
                                    title: root.lang-en ? "Mount Filter" : "挂载过滤";
                                    desc: root.lang-en ? "Only these mount points are shown (space / comma / semicolon separated). Leave empty to show all." : "仅显示这些挂载点（空格 / 逗号 / 分号分隔）。留空表示显示全部。";

                                    LineEdit {
                                        placeholder-text: root.lang-en ? "/home /mnt/data (empty = all)" : "/home /mnt/data（留空显示全部）";
                                        text <=> root.mount-filter-text;
                                        accepted(t) => { root.set-mount-filter-text(t); }
                                    }
                                }
                        }
                        }

                        // ═══ 快捷键 ═══
                        if root.cat-shown == 4 : CatFade {
                            cat-spacing: 5px;
                            cat-padding-top: 12px;

                            SectionTitle {
                                text: root.lang-en ? "Tabs" : "标签页";
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-3;
                            }
                            Card {
                                KeyRow {
                                    keys: "Ctrl+Tab";
                                    desc: root.lang-en ? "Next tab" : "下一个标签页";
                                }
                                KeyRow {
                                    keys: "Ctrl+Shift+Tab";
                                    desc: root.lang-en ? "Previous tab" : "上一个标签页";
                                }
                            }
                            SectionTitle {
                                text: root.lang-en ? "Terminal" : "终端";
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-3;
                            }
                            Card {
                                KeyRow {
                                    keys: "Ctrl+Shift+C";
                                    desc: root.lang-en ? "Copy selection" : "复制选中内容";
                                }
                                KeyRow {
                                    keys: "Ctrl+V";
                                    desc: root.lang-en ? "Paste" : "粘贴";
                                }
                                KeyRow {
                                    keys: "Ctrl+F";
                                    desc: root.lang-en ? "Find in terminal" : "查找";
                                }
                                KeyRow {
                                    keys: "Ctrl+Shift+R";
                                    desc: root.lang-en ? "Jump to history search" : "跳到命令历史搜索";
                                }
                                KeyRow {
                                    keys: root.lang-en ? "Drag" : "鼠标拖动";
                                    desc: root.lang-en ? "Select text" : "选择文本";
                                }
                                KeyRow {
                                    keys: root.lang-en ? "Wheel / Scrollbar" : "滚轮 / 滚动条";
                                    desc: root.lang-en ? "Scroll history" : "滚动历史";
                                }
                            }
                            SectionTitle {
                                text: root.lang-en ? "Command Box" : "命令输入框";
                                font-size: 10px * Theme.ui-scale;
                                color: Theme.fg-3;
                            }
                            Card {
                                KeyRow {
                                    keys: "Enter";
                                    desc: root.lang-en ? "Send command" : "发送命令";
                                }
                                KeyRow {
                                    keys: "↑ / ↓";
                                    desc: root.lang-en ? "Previous / next in history" : "上一条 / 下一条历史";
                                }
                                KeyRow {
                                    keys: "Ctrl+R";
                                    desc: root.lang-en ? "Search history (↑↓ select, Enter run, Esc close)" : "搜索命令历史（↑↓ 选择，回车执行，Esc 关闭）";
                                }
                                KeyRow {
                                    keys: "Esc";
                                    desc: root.lang-en ? "Close history / focus terminal" : "关闭历史 / 聚焦终端";
                                }
                                KeyRow {
                                    keys: "Ctrl+A";
                                    desc: root.lang-en ? "Move to start of line" : "移到行首";
                                }
                                KeyRow {
                                    keys: "Ctrl+E";
                                    desc: root.lang-en ? "Move to end of line" : "移到行尾";
                                }
                                KeyRow {
                                    keys: "Ctrl+K";
                                    desc: root.lang-en ? "Delete to end of line" : "删除到行尾";
                                }
                                KeyRow {
                                    keys: "Ctrl+U";
                                    desc: root.lang-en ? "Delete to start of line" : "删除到行首";
                                }
                            }
                        }

  // ═══ 云同步═══
                        if root.cat-shown == 6 : CatFade {
                            cat-spacing: 4px;

                            SectionTitle { text: root.lang-en ? "Sync target" : "同步目标"; }
                            Card {
                                ToggleRow {
                                    label: root.lang-en ? "Session File Sync" : "文件上传同步";
                                    desc: root.lang-en ? "Uploads go to the same path on every session" : "会话同步开启时，上传发往各会话的相同路径";
                                    on: root.sync-upload-enabled;
                                    toggled => {
                                        root.set-sync-upload-enabled(!root.sync-upload-enabled);
                                    }
                                }
                                OptionRow {
                                    label: root.lang-en ? "WebDAV Sync" : "WebDAV 同步";
                                    desc: root.webdav-status == "" ? (root.lang-en ? "Back up config, sessions and notes to your NAS or WebDAV" : "把配置、会话、笔记等备份到自己的 NAS 或企业 WebDAV 服务") : root.webdav-status;

                                    Switch {
                                        on: root.webdav-enabled;
                                        toggled => {
                                            root.webdav-enabled = !root.webdav-enabled;
                                        }
                                    }
                                }
                                FieldBlock {
                                    title: root.lang-en ? "WebDAV URL" : "WebDAV 地址";

                                    LineEdit {
                                        placeholder-text: "https://nas:5006/all/ 或 …/rudder-connections.json";
                                        text <=> root.webdav-url;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 0;

                                    FieldBlock {
                                        title: root.lang-en ? "Username" : "用户名";
                                        horizontal-stretch: 1;

                                        LineEdit {
                                            placeholder-text: root.lang-en ? "Optional" : "可选";
                                            text <=> root.webdav-username;
                                        }
                                    }
                                    Rectangle { width: 12px; background: Theme.sur-2; }
                                    FieldBlock {
                                        title: root.lang-en ? "Password / App Password" : "密码 / 应用密码";
                                        horizontal-stretch: 1;

                                        LineEdit {
                                            placeholder-text: root.lang-en ? "Leave blank to keep the saved one" : "留空表示不修改";
                                            text <=> root.webdav-password;
                                            input-type: password;
                                        }
                                    }
                                }
                                FieldBlock {
                                    title: root.lang-en ? "Remote Directory" : "远程目录";

                                    LineEdit {
                                        placeholder-text: "rudder-connections.json";
                                        text <=> root.webdav-remote-path;
                                    }
                                }
                                ToggleRow {
                                    label: root.lang-en ? "Allow Self-signed Certs" : "允许自签名无效证书";
                                    desc: root.lang-en ? "Test the connection again after saving" : "与保存后请再测试连接";
                                    on: root.webdav-certs;
                                    toggled => {
                                        root.webdav-certs = !root.webdav-certs;
                                    }
                                }
                            }
                            SectionTitle { text: root.lang-en ? "Actions" : "操作"; }
                            Card {
                                OptionRow {
                                    label: root.lang-en ? "Actions" : "操作";
                                    desc: root.lang-en ? "Upload / restore after saving" : "保存配置后可上传 / 下载备份";

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Rectangle {
                                            width: 88px;
                                            height: 28px;
                                            border-radius: Theme.radius-btn;
                                            background: Theme.accent;

                                            // hover 提亮 / 按下压暗（覆盖层，兼容渐变刷）
                                            Rectangle {
                                                width: 100%;
                                                height: 100%;
                                                background: sv-ta.pressed ? #000000 : #ffffff;
                                                opacity: sv-ta.pressed ? 0.14 : (sv-ta.has-hover ? 0.10 : 0);
                                                animate opacity { duration: AnimationSettings.short2(); }
                                            }

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.lang-en ? "Save" : "保存配置";
                                                    font-size: 12px * Theme.ui-scale;
                                                    color: white;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            sv-ta := TouchArea {
                                                clicked => {
                                                    root.save-webdav(root.webdav-enabled, root.webdav-url,
                                                        root.webdav-username, root.webdav-password,
                                                        root.webdav-remote-path, root.webdav-certs);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 74px;
                                            height: 28px;
                                            border-radius: Theme.radius-btn;
                                            border-width: 1px;
                                            border-color: up-ta.has-hover ? Theme.accent-ring : Theme.line;
                                            background: up-ta.pressed ? Theme.accent-press : (up-ta.has-hover ? Theme.sur-3 : Theme.sur-2);
                                            animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
                                            animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.lang-en ? "Upload" : "上传备份";
                                                    font-size: 12px * Theme.ui-scale;
                                                    color: Theme.fg-1;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            up-ta := TouchArea {
                                                clicked => {
                                                    root.webdav-upload();
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 74px;
                                            height: 28px;
                                            border-radius: Theme.radius-btn;
                                            border-width: 1px;
                                            border-color: dl-ta.has-hover ? Theme.accent-ring : Theme.line;
                                            background: dl-ta.pressed ? Theme.accent-press : (dl-ta.has-hover ? Theme.sur-3 : Theme.sur-2);
                                            animate background { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }
                                            animate border-color { duration: AnimationSettings.short2(); easing: AnimationSettings.e-standard-decelerate(); }

                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: root.lang-en ? "Restore" : "下载恢复";
                                                    font-size: 12px * Theme.ui-scale;
                                                    color: Theme.fg-1;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            dl-ta := TouchArea {
                                                clicked => {
                                                    root.webdav-download();
                                                }
                                            }
                                        }
                                    }
                                }
                        }
                        }

                        // ═══ 关于 ═══
                        if root.cat-shown == 5 : CatFade {
                            cat-spacing: 12px;
                            cat-padding-top: 8px;

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-2;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: start;

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 10px;
                                        background: Theme.accent-soft;

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "R";
                                            font-size: 20px * Theme.ui-scale;
                                            font-weight: 800;
                                            color: Theme.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: "Rudder";
                                            font-size: 15px * Theme.ui-scale;
                                            font-weight: 700;
                                            color: Theme.fg-1;
                                        }
                            SectionTitle { text: root.lang-en ? "Application" : "应用"; }
                                        Text {
                                            text: root.lang-en ? "Version v\{root.app-version}" : "当前版本 v\{root.app-version}";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-3;
                                        }
                                        Text {
                                            text: root.lang-en ? "A lightweight Rust + Slint SSH client · Forked from yituorou/meatshell" : "轻量的 Rust + Slint SSH 客户端 · Forked from yituorou/meatshell";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-3;
                                        }
                                        Text {
                                            text: "MIT / Apache-2.0 · github.com/SZhenY/Rudder";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-3;
                                        }
                                    }
                                }
                            }

  // 日志与诊断卡（有此卡；打开日志目录回调已接）
                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-2;

                                HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: start;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                            SectionTitle { text: root.lang-en ? "Diagnostics" : "诊断"; }
                                        Text {
                                            text: root.lang-en ? "Logs & Diagnostics" : "日志与诊断";
                                            font-size: 13px * Theme.ui-scale;
                                            font-weight: 600;
                                            color: Theme.fg-1;
                                        }
                                        Text {
                                            text: "排查问题时把日志目录整个发给我们（运行日志与错误都写在这里）";
                                            font-size: 11px * Theme.ui-scale;
                                            color: Theme.fg-3;
                                        }
                                    }
                                    Rectangle {
                                        width: 110px;
                                        height: 28px;
                                        border-radius: Theme.radius-btn;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        background: log-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Open Log Folder" : "打开日志目录";
                                                font-size: 12px * Theme.ui-scale;
                                                color: Theme.fg-1;
                                                vertical-alignment: center;
                                            }
                                        }
                                        log-ta := TouchArea {
                                            clicked => {
                                                root.open-log-dir();
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.sur-2;

                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 8px;
                                    alignment: start;

                            SectionTitle { text: root.lang-en ? "Open source" : "开源组件"; }
                                    Text {
                                        text: "开源组件";
                                        font-size: 13px * Theme.ui-scale;
                                        font-weight: 600;
                                        color: Theme.fg-1;
                                    }
                                    Text {
                                        text: root.lang-en ? "Open-source libraries (injected by Rust at runtime)" : "本应用依赖以下开源库（运行时由 Rust 注入清单）";
                                        font-size: 11px * Theme.ui-scale;
                                        color: Theme.fg-3;
                                    }
                                    for lib in root.about-libs : Text {
                                        text: lib;
                                        font-size: 11px * Theme.ui-scale;
                                        color: Theme.fg-2;
                                    }
                                }
                            }

                            Text {
                                text: "Rudder — a lightweight Rust + Slint SSH client";
                                font-size: 11px * Theme.ui-scale;
                                color: Theme.fg-3;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                    }
            }
        }
    }

    // ── 接力拖动层：滑杆手势被 Flickable 抢走时出现，全页跟踪鼠标继续调值 ──
    // 位于 Flickable 之外（不受其手势仲裁），鼠标停 300ms 视为松手，自动落盘隐藏。
    if root.frost-overlay : TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: ew-resize;

        changed mouse-x => {
            root.frost-overlay-idle = 0;
            if (root.frost-overlay-init) {
                // 横向位移 → 数值：滑杆全行程映射（把手宽 ~20px 扣除）
                root.frost-drag-value = clamp(
                    root.frost-drag-value
                        + (self.mouse-x - root.frost-overlay-last-x)
                          / root.frost-travel * 70,
                    0, 70);
                Theme.panel-alpha = 1.0 - root.frost-drag-value / 100;
            } else {
                root.frost-overlay-init = true;
            }
            root.frost-overlay-last-x = self.mouse-x;
        }
        changed mouse-y => { root.frost-overlay-idle = 0; }
    }
}
