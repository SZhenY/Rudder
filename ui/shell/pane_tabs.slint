// 分屏标签条（新设计，按 ex/终端，会话中.png 的顶栏）。
//
// 每个分屏顶部一条：标签药丸（终端图标 + 标题 + 关闭 ×，双击重命名）+ ➕；
// 右侧 快捷指令 / 分屏 / 全屏。替代旧 `tabs.slint` 的 TabBar 组件
// （`TabInfo` 类型仍由 tabs.slint 导出，全仓在用，文件保留）。
//
// 拖拽排序 / 跨分屏合并 / 重复标签暂未迁移（旧 TabBar 的能力），后续按需补。

import { Theme } from "../theme.slint";
import { TabInfo } from "../tabs.slint";

component TabPill inherits Rectangle {
    in property <TabInfo> tab;
    in property <bool> active: false;
    callback selected();
    callback closed();
    callback rename-requested();

    height: 30px;
    border-radius: 8px;
    background: root.active
        ? Theme.rail-item-active
        : (ta.has-hover ? Theme.rail-item-hover : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        alignment: start;

        Text {
            width: 16px;
            text: "\u{EB8E}"; // terminal
            font-family: "Material Icons";
            font-size: 13px;
            color: root.active ? Theme.accent : Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.tab.title;
            font-size: 12px;
            color: root.active ? Theme.rail-fg : Theme.fg-2;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 5px;
            background: close-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E5CD}"; // close
                font-family: "Material Icons";
                font-size: 12px;
                color: Theme.fg-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-ta := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.selected();
        }
        // 双击重命名（旧 TabBar 的行为）。
        double-clicked => {
            root.rename-requested();
        }
    }
}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label: "";
    callback clicked();

    height: 26px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.sur-3 : transparent;

    HorizontalLayout {
        padding-left: root.label == "" ? 0px : 8px;
        padding-right: root.label == "" ? 0px : 8px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 15px;
            color: Theme.fg-2;
            vertical-alignment: center;
        }
        if root.label != "" : Text {
            text: root.label;
            font-size: 11px;
            color: Theme.fg-2;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component PaneTabs inherits Rectangle {
    in property <int> pane-id;
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    // 顶部右侧工具图标占位宽度（旧 #122 语义保留：标签不从图标下面穿过）。
    in property <length> reserve-right: 0px;
    callback tab-selected(string);
    callback tab-closed(string);
    callback tab-rename-requested(string);
    callback new-tab();
    callback split-active();
    callback toggle-quick();
    callback toggle-full();

    height: 40px;
    background: transparent;

    HorizontalLayout {
        padding-left: Theme.sp-2;
        padding-right: root.reserve-right + Theme.sp-2;
        spacing: Theme.sp-1;
        alignment: start;

        // 标签药丸
        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            for t in root.tabs : TabPill {
                tab: t;
                active: t.id == root.active-id;
                selected => {
                    root.tab-selected(t.id);
                }
                closed => {
                    root.tab-closed(t.id);
                }
                rename-requested => {
                    root.tab-rename-requested(t.id);
                }
            }
        }

        // ➕ 新标签
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - 26px) / 2;
            border-radius: 7px;
            background: plus-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E145}"; // add
                font-family: "Material Icons";
                font-size: 16px;
                color: Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            plus-ta := TouchArea {
                clicked => {
                    root.new-tab();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        // 右侧：快捷指令 / 分屏 / 全屏（参考图顶右一组）
        IconBtn {
            glyph: "\u{E3E7}"; // flash_on
            label: "快捷指令";
            clicked => {
                root.toggle-quick();
            }
        }
        IconBtn {
            glyph: "\u{E8EC}"; // view_column
            clicked => {
                root.split-active();
            }
        }
        IconBtn {
            glyph: "\u{E5D0}"; // fullscreen
            clicked => {
                root.toggle-full();
            }
        }
    }
}
