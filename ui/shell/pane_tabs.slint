// 分屏标签条（新设计，按 ex/终端-会话并分屏.png 的顶栏）。
//
// 每个分屏顶部一条：标签药丸（终端图标 + 标题 + 关闭 ×，双击重命名）+ ➕；
// 右侧 分屏 / 全屏（快捷指令侧栏按需求移除）。替代旧 `tabs.slint` 的 TabBar 组件
// （`TabInfo` 类型仍由 tabs.slint 导出，全仓在用，文件保留）。
//
// 拖拽排序 / 跨分屏合并 / 重复标签暂未迁移（旧 TabBar 的能力），后续按需补。

import { Theme } from "../theme.slint";
import { TabInfo } from "../tabs.slint";

component TabPill inherits Rectangle {
    in property <TabInfo> tab;
    in property <bool> active: false;
    in property <bool> lang-en: false;
    callback selected();
    callback closed();
    callback rename-requested();

    height: 30px;
    border-radius: 8px;
    background: root.active
        ? Theme.rail-item-active
        : (ta.has-hover ? Theme.rail-item-hover : transparent);

    // 先声明 = 在下层：关闭钮的 close-ta 声明在布局里、绘制在其上，才能点到。
    // （此前 ta 在布局之后 = 整颗药丸被它盖住，关闭永远收不到点击。）
    ta := TouchArea {
        clicked => {
            root.selected();
        }
        // 双击重命名（旧 TabBar 的行为）。
        double-clicked => {
            root.rename-requested();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        alignment: start;

        Text {
            width: 16px;
            // 欢迎标签页用「+」图标（它还没有会话）
            text: root.tab.kind == "welcome" ? "\u{E145}" : "\u{EB8E}"; // add / terminal
            font-family: "Material Icons";
            font-size: 13px;
            color: root.active ? Theme.accent : Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            // 欢迎标签页（点「+」新建的）没有会话名，给它一个本地化的标题。
            text: root.tab.kind == "welcome"
                ? (root.lang-en ? "New session" : "新建会话")
                : root.tab.title;
            font-size: 12px;
            color: root.active ? Theme.rail-fg : Theme.fg-2;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: close-ta.has-hover ? Theme.sur-3 : transparent;

            Text {
                text: "\u{E5CD}"; // close
                font-family: "Material Icons";
                font-size: 12px;
                color: Theme.fg-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-ta := TouchArea {
                clicked => {
                    root.closed();
                }
            }
        }
    }

}

component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label: "";
    // 对应功能处于打开状态时保持高亮（工具面板、快捷指令下拉）
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    border-radius: 7px;
    background: ta.has-hover || root.active ? Theme.sur-3 : transparent;

    HorizontalLayout {
        padding-left: root.label == "" ? 0px : 8px;
        padding-right: root.label == "" ? 0px : 8px;
        spacing: 4px;
        alignment: center;

        Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 15px;
            color: Theme.fg-2;
            vertical-alignment: center;
        }
        if root.label != "" : Text {
            text: root.label;
            font-size: 11px;
            color: Theme.fg-2;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component PaneTabs inherits Rectangle {
    in property <int> pane-id;
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    // 顶部右侧工具图标占位宽度（旧 #122 语义保留：标签不从图标下面穿过）。
    in property <length> reserve-right: 0px;
    // 快捷指令下拉的条目数只用于按钮是否高亮；列表本身由终端舞台渲染
    // （声明在 pane 之后才画在终端画面之上，不会被画面盖住）。
    in property <int> quick-count: 0;
    in property <bool> panel-open: false;
    in property <bool> quick-open: false;
    in property <bool> lang-en: false;
    callback tab-selected(string);
    callback tab-closed(string);
    callback tab-rename-requested(string);
    callback new-tab();
    callback split-active();
    callback toggle-panel();
    callback toggle-quick();
    callback toggle-full();

    height: 40px;
    background: transparent;

    // 整行显式垂直居中：Slint 布局在交叉轴上默认贴顶 —— 之前药丸被顶在标签栏
    // 最上面、➕ 与右侧图标各自贴顶，看起来"没有居中在标签栏里"（用户截图）。
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            padding-left: Theme.sp-2;
            padding-right: root.reserve-right + Theme.sp-2;
            spacing: Theme.sp-1;
            alignment: start;

            // 标签药丸
            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                for t in root.tabs : TabPill {
                    tab: t;
                    active: t.id == root.active-id;
                    lang-en: root.lang-en;
                    selected => {
                        root.tab-selected(t.id);
                    }
                    closed => {
                        root.tab-closed(t.id);
                    }
                    rename-requested => {
                        root.tab-rename-requested(t.id);
                    }
                }
            }

            // ➕ 新标签
            Rectangle {
                width: 26px;
                height: 26px;
                y: (parent.height - 26px) / 2;
                border-radius: 7px;
                background: plus-ta.has-hover ? Theme.sur-3 : transparent;

                Text {
                    text: "\u{E145}"; // add
                    font-family: "Material Icons";
                    font-size: 16px;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                plus-ta := TouchArea {
                    clicked => {
                        root.new-tab();
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            // 右侧：快捷指令 / 工具面板 / 分屏 / 全屏（快捷指令侧栏按需求移除，
            // 但下拉入口按参考图补了回来：点开就是当前快捷命令列表）。
            IconBtn {
                glyph: "\u{E5CE}"; // expand_more：这是个下拉入口
                label: root.lang-en ? "Snippets" : "快捷指令";
                active: root.quick-open;
                clicked => {
                    root.toggle-quick();
                }
            }
            IconBtn {
                glyph: "\u{E8B3}"; // view_sidebar
                label: root.lang-en ? "Tools" : "工具";
                active: root.panel-open;
                clicked => {
                    root.toggle-panel();
                }
            }
            IconBtn {
                glyph: "\u{E8EC}"; // view_column
                clicked => {
                    root.split-active();
                }
            }
            IconBtn {
                glyph: "\u{E5D0}"; // fullscreen
                clicked => {
                    root.toggle-full();
                }
            }
        }
    }
}
