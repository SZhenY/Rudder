// 指令集页（新界面）：列出快捷指令、点「运行」发到当前活动标签，
// 右上角「管理」打开既有的指令管理弹窗。
//
// 数据与动作全部走 AppWindow 既有接口（quick-commands / run-command /
// quick-cmd-manage-open），Rust 侧零改动。

import { Theme } from "../theme.slint";
import { QuickCmd } from "../terminal_parts.slint";

export component PageSnippets inherits Rectangle {
    // 系统标题栏让位高度（macOS 红绿灯；自绘标题栏的平台传 0）。
    in property <length> top-inset: 0px;
    in property <[QuickCmd]> quick-commands;
    callback run(string /* command */);
    callback manage();

    // 底色由外层页面容器提供（`Theme.bg-root` 磨砂，见 app_shell）：这里透明，
    // 否则两层磨砂叠加，本页会比别的页面更暗。
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // 顶部：标题 + 管理
        Rectangle {
            height: 52px + root.top-inset;
            background: Theme.sur-1;

            HorizontalLayout {
                padding-top: root.top-inset;
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                spacing: Theme.sp-2;
                alignment: space-between;

                Text {
                    text: "指令集";
                    font-size: 16px * Theme.ui-scale;
                    color: Theme.fg-1;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: Theme.radius-md;
                    background: manage-ta.has-hover ? Theme.sur-3 : Theme.rail-item-hover;

                    Text {
                        text: "管理指令";
                        font-size: 12px * Theme.ui-scale;
                        color: Theme.fg-1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    manage-ta := TouchArea {
                        clicked => {
                            root.manage();
                        }
                    }
                }
            }
        }

        if root.quick-commands.length == 0 : Text {
            text: "还没有指令 —— 点右上角「管理指令」添加";
            font-size: 13px * Theme.ui-scale;
            color: Theme.fg-3;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        if root.quick-commands.length > 0 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                // ⚠ 内容列高度 = 自己的首选高度：Flickable 的子元素（不在布局里）默认按父级
                // 100% 高布局，内容会被"摊开"到整个视口（卡片被拉伸）。
                height: self.preferred-height;
                x: 0;
                y: 0;
                padding: Theme.sp-2;
                spacing: Theme.sp-1;
                alignment: start;

                for c in root.quick-commands : VerticalLayout {
                    // 组头（与旧列表同一约定：group-header 非空表示这是组的第一行）
                    if c.group-header != "" : Text {
                        text: c.group-header;
                        font-size: 12px * Theme.ui-scale;
                        color: Theme.fg-2;
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-md;
                        background: row-ta.has-hover ? Theme.sur-3 : Theme.sur-2;

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: Theme.sp-3;
                            alignment: start;

                            Text {
                                width: 140px;
                                text: c.name;
                                font-size: 13px * Theme.ui-scale;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: c.command-preview;
                                font-size: 12px * Theme.ui-scale;
                                color: Theme.fg-3;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 64px;
                                height: 28px;
                                border-radius: Theme.radius-sm;
                                background: run-ta.has-hover ? Theme.accent-soft : Theme.sur-3;

                                Text {
                                    text: "运行";
                                    font-size: 12px * Theme.ui-scale;
                                    color: Theme.fg-1;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                run-ta := TouchArea {
                                    clicked => {
                                        root.run(c.command);
                                    }
                                }
                            }
                        }

                        row-ta := TouchArea {}
                    }
                }
            }
        }
    }
}
