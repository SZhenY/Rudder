// 新外壳（UI 重构）：左侧栏 + 页面 + 底部状态栏。
//
// 用 `--ui=shell` 启动；旧的 `AppWindow`（app.slint）在收尾时整体删除。

import { Theme } from "../theme.slint";
import { Rail } from "rail.slint";
import { PageHosts } from "page_hosts.slint";
import { SessionInfo } from "../welcome_rows.slint";

export component AppShell inherits Window {
    title: "Rudder";
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.window-base;

    // 0 主机 · 1 终端 · 2 指令集 · 3 Docker · 4 设置
    in-out property <int> page: 0;
    in-out property <bool> rail-collapsed: false;
    in property <[SessionInfo]> sessions;
    callback connect-session(string /* id */);
    callback new-session();

    VerticalLayout {
        HorizontalLayout {
            Rail {
                current-page: root.page;
                collapsed: root.rail-collapsed;
                // 切换页面：早先漏了这条接线，点侧栏只有"当前页属性"变了、没人改 root.page，
                // 于是除初始页以外都点不动。
                page-changed(p) => {
                    root.page = p;
                }
                search-requested() => {
                    // 全局搜索（⌘K）后续接入
                }
            }

            // 内容区
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-root;

                if root.page == 0 : PageHosts {
                    sessions: root.sessions;
                    connect-session(id) => {
                        root.connect-session(id);
                    }
                    new-session() => {
                        root.new-session();
                    }
                }

                if root.page != 0 : Text {
                    text: root.page == 1
                        ? "终端"
                        : root.page == 2
                        ? "指令集"
                        : root.page == 3
                        ? "Docker"
                        : "设置";
                    font-size: 20px;
                    color: Theme.rail-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // 底部状态栏（下一步接入真实条目）
        Rectangle {
            height: 28px;
            background: Theme.rail-bg;

            Text {
                text: "底部状态栏：隧道 / 高亮 / 重连 / 历史命令 / 传输统计";
                font-size: 11px;
                color: Theme.rail-fg;
                vertical-alignment: center;
                x: 12px;
            }
        }
    }
}
