// 主机管理页（新界面）。
//
// 列表行直接复用 `welcome_rows.slint` 里的 `SessionRow`（旧侧栏用的就是它，接口完整：
// connect / edit / duplicate / move-to-group / remove）。这一版先做到"能列出主机、
// 能点连接"，分组导航、标签筛选、凭证管理在后续迭代里补。

import { Theme } from "../theme.slint";
import { SessionInfo, SessionRow } from "../welcome_rows.slint";

export component PageHosts inherits Rectangle {
    in property <[SessionInfo]> sessions;
    callback new-session();
    callback connect-session(string /* id */);

    background: Theme.bg-root;

    VerticalLayout {
        spacing: 0px;

        // 顶部：标题 + 新建
        Rectangle {
            height: 52px;
            background: Theme.rail-bg;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: space-between;

                Text {
                    text: "主机管理";
                    font-size: 16px;
                    color: Theme.rail-fg;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 8px;
                    background: new-ta.has-hover ? Theme.rail-item-active : Theme.rail-item-hover;

                    Text {
                        text: "+ 新建主机";
                        font-size: 12px;
                        color: Theme.rail-fg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    new-ta := TouchArea {
                        clicked => {
                            root.new-session();
                        }
                    }
                }
            }
        }

        // 列表
        if root.sessions.length == 0 : Text {
            text: "还没有主机 —— 点右上角「新建主机」，或稍后从导入 / 云同步带入";
            font-size: 13px;
            color: Theme.rail-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }

        if root.sessions.length > 0 : Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;

                for s in root.sessions : SessionRow {
                    session: s;
                    compact: false;
                    connect => {
                        root.connect-session(s.id);
                    }
                }
            }
        }
    }
}
