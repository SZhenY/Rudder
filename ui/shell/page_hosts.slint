// 主机管理页（按 ex/主机.png 参考稿）。
//
// 三栏：左侧栏（外壳提供）→ 本页的「分组导航」列 → 主内容（顶栏 + 主机卡片）。
// 数据仍走 AppWindow 既有的 sessions 模型与 connect-session 回调，Rust 零改动。

import { Theme } from "../theme.slint";
import { SessionInfo } from "../session_types.slint";
import { ConfirmDialog } from "../confirm_dialog.slint";

// 卡片菜单里的一行（参考图 主机-卡片-菜单.png：图标 + 文案，删除是红色）。
component MenuRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: ta.has-hover ? (root.danger ? Theme.danger.with-alpha(0.14) : Theme.sur-3) : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 14px;
            color: root.danger ? Theme.danger : Theme.fg-3;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: root.danger ? Theme.danger : Theme.fg-1;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component HostCard inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> lang-en: false;
    // 「⋯」菜单是否展开（卡片内浮层，见卡片末尾）
    property <bool> menu-open: false;
    callback connect();
    callback edit();
    callback duplicate();
    callback remove();

    // 主机卡片：图标块 + 名称/SSH 徽标 + 连接信息 + 快速连接
    width: 340px;
    height: 168px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.line;
    // 悬停在卡片或右上角「⋯」上都算"卡片悬停"（否则鼠标移到按钮上时底色会闪）。
    background: (card-ta.has-hover || menu-ta.has-hover) ? Theme.sur-3 : Theme.sur-2;
    clip: true;

    // 整卡点击 = 快速连接。**先声明 = 画在下层**：右上角的 ✎
    // 声明在后面才点得到（同 pane_tabs 里关闭钮的教训）。
    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.connect();
        }
    }

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.sp-3;
            alignment: start;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: Theme.sur-3;

                Text {
                    text: "\u{EB8E}"; // terminal
                    font-family: "Material Icons";
                    font-size: 20px;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    alignment: start;

                    Text {
                        text: root.session.name;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 38px;
                        height: 18px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.line-strong;

                        Text {
                            text: "SSH";
                            font-size: 9px;
                            color: Theme.fg-3;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.session.user != "" ? "\{root.session.user}@\{root.session.host}:\{root.session.port}" : "\{root.session.host}:\{root.session.port}";
                    font-size: 11px;
                    color: Theme.fg-3;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.sp-1;
            alignment: start;

            Rectangle {
                width: 110px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: Theme.sur-3;

                Text {
                    text: root.session.group == ""
                        ? (root.lang-en ? "Default" : "默认分组")
                        : root.session.group;
                    font-size: 10px;
                    color: Theme.fg-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 备注 / 标签两行（参考图 主机.png 卡片下半部分）：备注是真数据，
            // 空时显示「暂无备注」；标签体系还没进配置，先按参考图显示「无标签」
            //（与左侧「标签筛选」里的占位 chip 同一约定）。
            Text {
                text: root.session.note == ""
                    ? (root.lang-en ? "No note" : "暂无备注")
                    : root.session.note;
                font-size: 10px;
                color: Theme.fg-3;
                overflow: elide;
            }
            Text {
                text: root.lang-en ? "No tags" : "无标签";
                font-size: 10px;
                color: Theme.fg-3;
            }
        }

        // 快速连接：平时低调（sur-3 + 次文字色），鼠标悬停在卡片上（或按钮上）才
        // "亮起"（accent 底 + accent 文字）—— 参考图 主机-卡片-菜单.png 的注记。
        Rectangle {
            height: 30px;
            border-radius: Theme.radius-md;
            background: (card-ta.has-hover || quick-ta.has-hover) ? Theme.accent-soft : Theme.sur-3;

            Text {
                text: root.lang-en ? "Quick Connect" : "快速连接";
                font-size: 12px;
                color: (card-ta.has-hover || quick-ta.has-hover) ? Theme.accent : Theme.fg-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            quick-ta := TouchArea {
                clicked => {
                    root.connect();
                }
            }
        }
    }

    // 卡片右上角「⋯」菜单按钮（参考图 主机-卡片-菜单.png）。
    // 悬停时"亮起"，但**始终可点**：`enabled` 绝不挂在 hover 上 —— 鼠标从卡片移到
    // 按钮上时若把它禁用，它自己的 hover 就永远来不了（之前 ✎ 踩过的死锁）。
    Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: 26px;
        height: 26px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.line;
        // 只在该卡片被悬停（或菜单已展开）时出现 —— 参考图注记："鼠标悬停在卡片上的
        // 时候才显示菜单按钮"。`enabled` 仍然不挂 hover（鼠标移上来那一刻它自己
        // 就有 hover 了，所以不会出现"点不到"的死锁）。
        opacity: (card-ta.has-hover || menu-ta.has-hover || root.menu-open) ? 1 : 0;
        background: root.menu-open ? Theme.sur-3 : Theme.sur-1;

        Text {
            text: "\u{E5D3}"; // more_horiz
            font-family: "Material Icons";
            font-size: 15px;
            color: Theme.fg-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        menu-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.menu-open = !root.menu-open;
            }
        }
    }

    // 点卡片其它地方收起菜单。声明在面板之前 = 在面板下层；`enabled` 只在菜单打开
    // 时生效，平时点卡片照旧走"快速连接"。
    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        enabled: root.menu-open;
        clicked => {
            root.menu-open = false;
        }
    }

    // 展开的菜单：**卡片内浮层**，不是 PopupWindow —— 卡片在 Flickable 里，弹层在
    // 这个上下文里没验证过（对话框的协议下拉就翻过车），内浮层 100% 可控。
    Rectangle {
        visible: root.menu-open;
        x: parent.width - self.width - 8px;
        y: 40px;
        width: 156px;
        height: 3 * 30px + 8px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.sur-1;
        drop-shadow-blur: Theme.shadow-popup-blur;
        drop-shadow-color: Theme.shadow-popup-color;

        VerticalLayout {
            padding: 4px;
            spacing: 1px;
            alignment: start;

            MenuRow {
                glyph: "\u{E3C9}"; // edit
                label: root.lang-en ? "Edit" : "编辑";
                clicked => { root.menu-open = false; root.edit(); }
            }
            MenuRow {
                glyph: "\u{E14D}"; // content_copy —— 克隆
                label: root.lang-en ? "Duplicate" : "克隆";
                clicked => { root.menu-open = false; root.duplicate(); }
            }
            MenuRow {
                glyph: "\u{E872}"; // delete
                label: root.lang-en ? "Delete" : "删除";
                danger: true;
                clicked => { root.menu-open = false; root.remove(); }
            }
        }
    }
}

export component PageHosts inherits Rectangle {
    // 卡片网格的间距 / 每张卡最小宽度（列数在网格容器里按可用宽度算，见下）。
    property <length> card-min-w: 260px;
    property <length> grid-gap: Theme.sp-3;

    in property <bool> lang-en: false;
    in property <[SessionInfo]> sessions;
    callback new-session();
    callback connect-session(string /* id */);
    // 编辑主机：卡片右上角的 ✎（Rust 侧 on_edit_session 会填好草稿并打开对话框）
    callback edit-session(string /* id */);
    // 克隆 / 删除主机（删除在本页先弹确认框，确认后回调窗口 → Rust）
    callback duplicate-session(string /* id */);
    callback remove-session(string /* id */, string /* name；确认框里显示 */);
    // 待删除的会话（非空 = 确认框打开）
    property <string> pending-remove-id;
    property <string> pending-remove-name;

    // 底色由外层页面容器提供（`Theme.bg-root` 磨砂，见 app_shell）：这里透明，
    // 否则两层磨砂叠加，本页会比别的页面更暗。
    background: transparent;

    HorizontalLayout {
        // ── 第二列：分组导航 ────────────────────────────────────────────
        // 面板底色（sur-1）：与内容区（sur-0）拉开层次，右侧另有一条分隔线。
        Rectangle {
            width: 190px;
            background: Theme.sur-1;

            // 注意：**不写** `alignment: start` —— Slint 里 alignment 不是 stretch 时
            // 会忽略子项的拉伸因子，下面那个 `vertical-stretch: 1` 的占位就失效，
            // 「标签筛选 / 管理分组 & 标签」会挤在顶部、下面留一大片空白。
            VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-3;

                Text {
                    text: root.lang-en ? "Groups" : "分组导航";
                    font-size: 12px;
                    color: Theme.fg-3;
                }

                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-md;
                    background: all-ta.has-hover ? Theme.sur-3 : Theme.accent-soft;

                    HorizontalLayout {
                        padding-left: Theme.sp-2;
                        spacing: Theme.sp-2;
                        alignment: start;

                        Text {
                            width: 18px;
                            text: "\u{E2C8}"; // list_alt
                            font-family: "Material Icons";
                            font-size: 15px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.lang-en ? "All Hosts" : "全部主机";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    all-ta := TouchArea {}
                }

                Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: grp-ta.has-hover ? Theme.sur-3 : transparent;

                    HorizontalLayout {
                        padding-left: Theme.sp-2;
                        padding-right: Theme.sp-2;
                        spacing: Theme.sp-2;
                        alignment: space-between;

                        Text {
                            text: root.lang-en ? "Default Group" : "默认分组";
                            font-size: 12px;
                            color: Theme.fg-2;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "0";
                            font-size: 11px;
                            color: Theme.fg-3;
                            vertical-alignment: center;
                        }
                    }

                    grp-ta := TouchArea {}
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: root.lang-en ? "Tag Filters" : "标签筛选";
                    font-size: 12px;
                    color: Theme.fg-3;
                }
                HorizontalLayout {
                    spacing: Theme.sp-1;
                    alignment: start;

                    // 标签体系尚未进配置（现在只有"分组"），先放三枚示例 chip 占位
                    for chip in [
                        { label: "开发", c: Theme.accent },
                        { label: "测试", c: Theme.ok },
                        { label: "生产", c: Theme.danger },
                    ] : Rectangle {
                        width: 44px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: chip.c;

                        Text {
                            text: chip.label;
                            font-size: 10px;
                            color: chip.c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-md;
                    background: Theme.sur-3;

                    Text {
                        text: root.lang-en ? "Manage Groups & Tags" : "管理分组 & 标签";
                        font-size: 12px;
                        color: Theme.fg-2;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 分隔线
        Rectangle {
            width: 1px;
            background: Theme.line;
        }

        // ── 主内容：顶栏 + 卡片 ──────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            Rectangle {
                height: 52px;
                background: Theme.sur-1;

                HorizontalLayout {
                    padding-left: Theme.sp-4;
                    padding-right: Theme.sp-4;
                    spacing: Theme.sp-2;
                    alignment: space-between;

                    Text {
                        text: root.lang-en ? "Host Management" : "主机管理";
                        font-size: 15px;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Slint 的布局在交叉轴上默认**不是**居中：固定 30px 高的按钮会贴着顶边，
                    // 于是和左边「主机管理」那几个字对不齐（用户截图里的红框）。套一层
                    // `VerticalLayout{alignment: center}` 显式居中。
                    // 宽度由文案决定（中英长度不同），避免固定 96px 时溢出/挤边。
                    // 参考图里是实心强调色按钮 —— 与右侧工具面板的主按钮一致。
                    VerticalLayout {
                        alignment: center;


                        Rectangle {
                            width: new-label.preferred-width + 28px;
                            height: 30px;
                            border-radius: Theme.radius-md;
                            background: new-ta.has-hover ? Theme.accent.with-alpha(0.88) : Theme.accent;

                            new-label := Text {
                                x: 14px;
                                width: parent.width - 28px;
                                text: root.lang-en ? "+ New Host" : "+ 新建主机";
                                font-size: 12px;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            new-ta := TouchArea {
                                clicked => {
                                    root.new-session();
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            if root.sessions.length == 0 : Text {
                text: root.lang-en ? "No hosts yet — click \u{201c}New Host\u{201d} top-right, or import / cloud-sync" : "还没有主机 —— 点右上角「新建主机」，或用导入 / 云同步带入";
                font-size: 13px;
                color: Theme.fg-3;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }

            if root.sessions.length > 0 : host-flick := Flickable {
                vertical-stretch: 1;

                // 卡片网格（参考图是网格，不是一行一张）：列数按可用宽度算，每行
                // 由 HorizontalLayout 平均分格、卡片随之伸缩；最后一行的空位不补。
                grid := VerticalLayout {
                    padding: Theme.sp-4;
                    spacing: root.grid-gap;
                    alignment: start;

                    // 列数 = 可用宽度能放下几张卡（下限 1），行数 = 卡片数 / 列数向上取整。
                    // 宽度取本页宽度减去固定的「分组导航」列（190px）与内边距 32px ——
                    // 不能取 Flickable 自己的 width：那会跟内容的首选尺寸成绑定环。
                    // 注意：Slint 里长度相除会得到带单位的结果（px⁻¹），所以先 ` / 1px`
                    // 换成纯数字再算。
                    property <float> gap-px: 12;
                    property <float> min-px: 260;
                    property <float> cols-f: max(1, floor((root.width / 1px - 190 - 32 + self.gap-px)
                        / (self.min-px + self.gap-px)));
                    property <int> cols: round(self.cols-f);
                    property <int> rows: round(ceil(root.sessions.length * 1.0 / self.cols));

                    for r in grid.rows : HorizontalLayout {
                        spacing: root.grid-gap;
                        alignment: start;

                        for c in min(grid.cols, root.sessions.length - r * grid.cols) : HostCard {
                            horizontal-stretch: 1;
                            session: root.sessions[r * grid.cols + c];
                            lang-en: root.lang-en;
                            connect() => {
                                root.connect-session(root.sessions[r * grid.cols + c].id);
                            }
                            edit() => {
                                root.edit-session(root.sessions[r * grid.cols + c].id);
                            }
                            duplicate() => {
                                root.duplicate-session(root.sessions[r * grid.cols + c].id);
                            }
                            remove() => {
                                // 先弹确认（删除是破坏性动作），确认后才落回调链。
                                root.pending-remove-id = root.sessions[r * grid.cols + c].id;
                                root.pending-remove-name = root.sessions[r * grid.cols + c].name;
                            }
                        }
                    }
                }
            }
        }
    }
    // 删除确认（参考图里删除是菜单里的一项；破坏性动作前先确认，确认后才走回调链）。
    // 这个确认框是本页私有的：确认框组件通用，但"删除主机"要经过本页 → 窗口 → Rust。
    ConfirmDialog {
        is-open: root.pending-remove-id != "";
        title: root.lang-en ? "Delete host" : "删除主机";
        message: root.lang-en
            ? "Delete \u{201c}\{root.pending-remove-name}\u{201d}? Its saved settings (host, key path, forwards) are removed; the session list is refreshed."
            : "确定删除「\{root.pending-remove-name}」？该主机的保存配置（地址 / 密钥路径 / 端口转发等）会被移除，列表随后刷新。";
        confirm-label: root.lang-en ? "Delete" : "删除";
        confirm() => {
            root.remove-session(root.pending-remove-id, root.pending-remove-name);
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
        cancel() => {
            root.pending-remove-id = "";
            root.pending-remove-name = "";
        }
    }
}
