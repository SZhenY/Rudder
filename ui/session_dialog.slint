// 新建 / 编辑主机（SSH / 串口 / Telnet）对话框 —— 终端页重做同一轮，按
// ex/新建:编辑会话 1.png、2.png 重新设计：头部（标题 + 类型徽标 + 关闭）、
// 分区正文（基础信息 / 连接设置 / 认证方式 / 代理与跳板机 / 高级）、
// 底部操作条（测试连接 + 状态 + 取消 + 保存）。
//
// 约束：**界面重做，接口与行为一字不改** —— `draft-*` 属性、`submit` /
// `test-connection` / `cancel` / forwards / triggers 那批回调、纯函数 `build-draft()`
// 的 28 字段载荷都保持原样，窗口侧（app_shell）与 Rust 侧零改动。
//
// 参考图里有、项目暂无对应后端字段的区块不放假控件：操作系统 / 版本型号 / 标签、
// 无认证、密码 + MFA、密码 + 短信验证码、CA 证书、凭证库。真实可用的选项就是
// 密码 / 密钥 / 键盘交互三种认证 + 代理 + 跳板机。

import { Theme } from "theme.slint";
import { Btn, Seg, Input, Area, Select, OptionCard, Switch, ToggleRow, Section } from "form_widgets.slint";
import { PortFwd, TriggerDraft, SessionDraft } from "session_types.slint";
// PortFwd / TriggerDraft / SessionDraft 从这里搬走了，但对外仍是本文件的导出。
export { PortFwd, TriggerDraft, SessionDraft }

// 端口转发行（#56 / #277）：新设计的小卡片，字段与旧 `PortForwardRow` 逐项对应，
// 每次改动都把整行回传（`update-forward(index, PortFwd)`）。
component FwdRow inherits Rectangle {
    in property <bool> lang-en: false;
    in property <PortFwd> forward;
    in property <int> index;
    callback updated(int, PortFwd);
    callback remove(int);

    property <string> kind: forward.kind;
    property <string> name: forward.name;
    property <string> bind-addr: forward.bind-addr;
    property <string> bind-port: forward.bind-port;
    property <string> host: forward.host;
    property <string> host-port: forward.host-port;

    function notify-updated() {
        root.updated(root.index, {
            kind: root.kind,
            name: root.name,
            bind-addr: root.bind-addr,
            bind-port: root.bind-port,
            host: root.host,
            host-port: root.host-port,
        });
    }

    height: fwd-col.preferred-height;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    fwd-col := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 6px;
            Seg { label: "-L"; active: root.kind == "local"; clicked => { root.kind = "local"; root.notify-updated(); } }
            Seg { label: "-R"; active: root.kind == "remote"; clicked => { root.kind = "remote"; root.notify-updated(); } }
            Seg { label: "-D"; active: root.kind == "dynamic"; clicked => { root.kind = "dynamic"; root.notify-updated(); } }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                glyph: "\u{E872}"; // delete
                variant: "danger";
                clicked => { root.remove(root.index); }
            }
        }
        Input {
            placeholder: root.lang-en ? "Name (optional)" : "名称（可选）";
            text <=> root.name;
            edited(v) => { root.name = v; root.notify-updated(); }
        }
        HorizontalLayout {
            spacing: 6px;
            Input {
                horizontal-stretch: 2;
                placeholder: "127.0.0.1";
                text <=> root.bind-addr;
                edited(v) => { root.bind-addr = v; root.notify-updated(); }
            }
            Input {
                horizontal-stretch: 1;
                placeholder: root.lang-en ? "Listen port" : "监听端口";
                text <=> root.bind-port;
                edited(v) => { root.bind-port = v; root.notify-updated(); }
            }
        }
        // 非回环绑定会把端口暴露到局域网（kind == dynamic 时还是个无认证的 SOCKS
        // 代理）—— 就地提示（#F-001）。
        if root.bind-addr != "" && root.bind-addr != "127.0.0.1" && root.bind-addr != "localhost" : Text {
            text: root.lang-en ? "⚠ Non-loopback address exposes this port on the local network. Only use on trusted networks." : "⚠ 非回环地址会把该端口暴露到局域网，只在可信网络里使用。";
            color: Theme.danger;
            font-size: 10px;
            wrap: word-wrap;
            line-height-factor: 1.3;
            max-lines: 3;
        }
        if root.kind != "dynamic" : HorizontalLayout {
            spacing: 6px;
            Input {
                horizontal-stretch: 2;
                placeholder: root.lang-en ? "Target host" : "目标主机";
                text <=> root.host;
                edited(v) => { root.host = v; root.notify-updated(); }
            }
            Input {
                horizontal-stretch: 1;
                placeholder: root.lang-en ? "Target port" : "目标端口";
                text <=> root.host-port;
                edited(v) => { root.host-port = v; root.notify-updated(); }
            }
        }
    }
}

// 登录触发器行（#212）：期望输出 → 自动回送。响应框保持"空 = 保留已存值"的语义。
component TrigRow inherits Rectangle {
    in property <bool> lang-en: false;
    in property <TriggerDraft> trigger;
    in property <int> index;
    callback updated(int, TriggerDraft);
    callback remove(int);

    property <string> expect: trigger.expect;
    property <string> response: trigger.response;
    property <bool> append-enter: trigger.append-enter;
    property <bool> repeat: trigger.repeat;

    function notify-updated() {
        root.updated(root.index, {
            expect: root.expect,
            response: root.response,
            append-enter: root.append-enter,
            repeat: root.repeat,
        });
    }

    height: trig-col.preferred-height;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.sur-2;

    trig-col := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            spacing: 6px;
            Input {
                horizontal-stretch: 1;
                placeholder: root.lang-en ? "Expected output" : "期望输出";
                text <=> root.expect;
                edited(v) => { root.expect = v; root.notify-updated(); }
            }
            Btn {
                glyph: "\u{E872}"; // delete
                variant: "danger";
                clicked => { root.remove(root.index); }
            }
        }
        Input {
            placeholder: root.lang-en ? "Response (leave blank to keep saved value)" : "响应（留空 = 保留已存值）";
            text <=> root.response;
            edited(v) => { root.response = v; root.notify-updated(); }
        }
        HorizontalLayout {
            spacing: 10px;
            Seg {
                label: root.lang-en ? "Send Enter" : "追加回车";
                active: root.append-enter;
                clicked => { root.append-enter = !root.append-enter; root.notify-updated(); }
            }
            Seg {
                label: root.lang-en ? "Repeat" : "重复";
                active: root.repeat;
                clicked => { root.repeat = !root.repeat; root.notify-updated(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// 主机分组：可输入（新建分组）+ ▾ 从已有分组里挑（#179，行为同旧 `GroupCombo`）。
component GroupInput inherits Rectangle {
    in property <bool> lang-en: false;
    in-out property <string> text;
    in property <[string]> options;

    height: 30px;

    HorizontalLayout {
        spacing: 6px;

        Input {
            horizontal-stretch: 1;
            text <=> root.text;
            placeholder: root.lang-en ? "e.g. Production / Database" : "如 生产 / 数据库";
        }
        Btn {
            glyph: "\u{E5CF}"; // arrow_drop_down
            clicked => { grp-popup.show(); }
        }
    }

    grp-popup := PopupWindow {
        x: 0px;
        y: root.height + 3px;
        width: root.width;
        height: root.options.length == 0 ? 38px : min(root.options.length * 30px + 8px, 240px);

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.sur-1;
            drop-shadow-blur: Theme.shadow-popup-blur;
            drop-shadow-color: Theme.shadow-popup-color;
            clip: true;

            if root.options.length == 0 : Text {
                width: parent.width;
                height: parent.height;
                text: root.lang-en ? "No groups yet — type one above" : "还没有分组 —— 在上面输入即可新建";
                font-size: 11px;
                color: Theme.fg-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Flickable {
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    alignment: start;

                    for g[i] in root.options : Rectangle {
                        height: 30px;
                        border-radius: 6px;
                        background: g-ta.has-hover ? Theme.sur-3 : transparent;

                        g-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                grp-popup.close();
                                root.text = g;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: g;
                                font-size: 12px;
                                color: Theme.fg-1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SessionDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    // 中英文切换：新外壳按 `lang-en ? EN : 中文` 的约定走（旧 `@tr()` 依赖 lang/
    // 里的翻译表，本轮新增的字符串没有词条，会露出英文 —— 中英混排就是这么来的）。
    in property <bool> lang-en: false;
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-kind: "ssh";
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user;
    // Set when Create/Save is pressed with an empty host (SSH/Telnet) (#110).
    private property <bool> host-missing: false;
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-password;
    in-out property <string> draft-key-path;
    in-out property <string> draft-key-inline;
    in-out property <bool> draft-key-inline-mode: false;
    in-out property <string> draft-proxy-type: "none";  // "none" | "socks5" | "http"
    in-out property <string> draft-proxy-hostport;
    in-out property <string> draft-group;
    in property <[string]> session-groups;   // existing groups for the dropdown (#179)
    // SSH jump host picker (#211): parallel label/id lists (index 0 = "none")
    // plus the selected index. The id is resolved on submit via `jump-ids`.
    in property <[string]> jump-choices;
    in property <[string]> jump-ids;
    in-out property <int> draft-jump-index: 0;
    in-out property <string> draft-serial-port;
    in-out property <string> draft-baud: "115200";
    in-out property <string> draft-data-bits: "8";
    in-out property <string> draft-stop-bits: "1";
    in-out property <string> draft-parity: "none";
    in-out property <string> draft-flow: "none";
    in-out property <string> draft-encoding: "UTF-8";
    in-out property <bool> draft-disable-shell-integration: false;
    in-out property <string> draft-note;
    in-out property <string> test-status;

    // Port forwards / tunnels (#56). Every row is an editable form (#277).
    in property <[PortFwd]> forwards;
    // Expect/send login triggers (#212). SSH only — they match terminal output.
    in property <[TriggerDraft]> triggers;
    property <bool> show-advanced: false;   // collapse proxy + forwarding (#56)

    callback submit(SessionDraft);
    callback test-connection(SessionDraft);
    callback cancel();
    callback add-forward();
    callback update-forward(int /* index */, PortFwd);
    callback delete-forward(int /* index */);
    callback add-trigger();
    callback update-trigger(int /* index */, TriggerDraft);
    callback delete-trigger(int /* index */);
    callback pick-key-file();   // open a native file picker for the private key

    // 底部两个按钮（测试连接 / 提交）用的是**同一份 28 字段载荷**，此前各写一遍 ——
    // 改字段必须改两处，漏一处就是静默丢字段。抽成函数后只有这一处定义。
    // `pure` = 只读属性、无副作用（Slint 只允许在绑定里调用纯函数）。
    pure function build-draft() -> SessionDraft {
        return {
                id: root.draft-id,
                name: root.draft-name,
                kind: root.draft-kind,
                host: root.draft-host,
                port: root.draft-port.to-float(),
                user: root.draft-user,
                auth: root.draft-auth,
                password: root.draft-password,
                private-key-path: root.draft-key-path,
                private-key-inline: root.draft-key-inline,
                private-key-inline-mode: root.draft-key-inline-mode,
                proxy: (root.draft-proxy-type == "none" || root.draft-proxy-hostport == "") ? ""
                : root.draft-proxy-type == "http" ? "http://" + root.draft-proxy-hostport
                : "socks5://" + root.draft-proxy-hostport,
                group: root.draft-group,
                serial-port: root.draft-serial-port,
                baud-rate: root.draft-baud.to-float(),
                data-bits: root.draft-data-bits.to-float(),
                stop-bits: root.draft-stop-bits.to-float(),
                parity: root.draft-parity,
                flow-control: root.draft-flow,
                encoding: root.draft-encoding,
                disable-shell-integration: root.draft-disable-shell-integration,
                note: root.draft-note,
                jump-session-id: (root.draft-jump-index > 0 && root.draft-jump-index < root.jump-ids.length)
                ? root.jump-ids[root.draft-jump-index] : "",
        };
    }

    // 头部类型徽标的文案（draft-kind 是字符串：ssh / serial / telnet）。
    property <string> kind-label: root.draft-kind == "serial" ? "SERIAL" : (root.draft-kind == "telnet" ? "TELNET" : "SSH");
    property <bool> proxy-on: root.draft-proxy-type != "none";
    property <bool> jump-on: root.draft-jump-index > 0;

    visible: is-open;
    background: #000000a0;

    // Clear the host-required flag each time the dialog opens (#110).
    changed is-open => {
        if (self.is-open) {
            self.host-missing = false;
        }
    }

    // Swallow clicks on the backdrop（原行为：点遮罩不关对话框）
    TouchArea {
        width: 100%;
        height: 100%;
    }

    card := Rectangle {
        width: min(560px, parent.width - 48px);
        // Height follows the content, but never exceeds the window — past that
        // the body scrolls (the dialog grows with the advanced section / many
        // port forwards) (#56).
        height: min(body.preferred-height + 56px, parent.height - 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.sur-1;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-color: Theme.shadow-dialog-color;

        VerticalLayout {
            spacing: 0px;

            // ── 头部：标题 + 类型徽标 + 关闭 ───────────────────────────────
            Rectangle {
                height: 48px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: root.is-editing ? root.lang-en ? "Edit host" : "编辑主机" : root.lang-en ? "New host" : "新建主机";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.fg-1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: kind-chip.preferred-width + 16px;
                        height: 18px;
                        border-radius: 9px;
                        background: Theme.accent-soft;

                        kind-chip := Text {
                            text: root.kind-label;
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Btn {
                        glyph: "\u{E5CD}"; // close
                        clicked => { root.cancel(); }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // ── 正文（可滚动）─────────────────────────────────────────────
            body := Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 16px;
                    alignment: start;

                    // ── 基础信息 ───────────────────────────────────────────
                    Section {
                        title: root.lang-en ? "Basics" : "基础信息";

                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: root.lang-en ? "Alias" : "主机别名";
                                font-size: 11px;
                                color: Theme.fg-2;
                            }
                            Input {
                                text <=> root.draft-name;
                                placeholder: root.lang-en ? "Optional — the IP is used when blank" : "可选 —— 留空就用 IP 当名字";
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: root.lang-en ? "Group" : "主机分组";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                    GroupInput {
                                        text <=> root.draft-group;
                                        options: root.session-groups;
                                        lang-en: root.lang-en;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: root.lang-en ? "Note (Description)" : "备注（Description）";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                    Input {
                                        text <=> root.draft-note;
                                        placeholder: root.lang-en ? "What this host is for" : "简要描述这台主机的用途";
                                    }
                                }
                            }
                        }
                    }

                    // ── 连接设置 ───────────────────────────────────────────
                    Section {
                        title: root.lang-en ? "Connection" : "连接设置";

                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: root.lang-en ? "Protocol" : "协议";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                    // 三分段（同旧对话框的做法）：点一下就切，不依赖弹层浮窗。
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Seg {
                                            label: "SSH";
                                            active: root.draft-kind == "ssh";
                                            clicked => {
                                                // 切协议时给默认端口让位，但不动用户改过的端口（#303）。
                                                if (root.draft-kind != "ssh" && root.draft-port == "23") {
                                                    root.draft-port = "22";
                                                }
                                                root.draft-kind = "ssh";
                                            }
                                        }
                                        Seg {
                                            label: root.lang-en ? "Serial" : "串口";
                                            active: root.draft-kind == "serial";
                                            clicked => { root.draft-kind = "serial"; }
                                        }
                                        Seg {
                                            label: "Telnet";
                                            active: root.draft-kind == "telnet";
                                            clicked => {
                                                if (root.draft-kind != "telnet" && root.draft-port == "22") {
                                                    root.draft-port = "23";
                                                }
                                                root.draft-kind = "telnet";
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }

                                if root.draft-kind != "serial" : VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: root.lang-en ? "Host / IP" : "主机地址 / IP";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                    Input {
                                        text <=> root.draft-host;
                                        placeholder: "192.168.1.10";
                                        invalid: root.host-missing && root.draft-host == "";
                                    }
                                }
                                if root.draft-kind != "serial" : VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: root.lang-en ? "Port" : "端口";
                                        font-size: 11px;
                                        color: Theme.fg-2;
                                    }
                                    Input {
                                        text <=> root.draft-port;
                                        placeholder: root.draft-kind == "telnet" ? "23" : "22";
                                    }
                                }
                            }

                            // Inline error when a host-less SSH/Telnet session is submitted (#110).
                            if root.host-missing && root.draft-host == "" && root.draft-kind != "serial" : Text {
                                text: root.lang-en ? "Please enter a host / IP address." : "请填写主机地址 / IP。";
                                color: Theme.danger;
                                font-size: 11px;
                            }

                            // 串口参数（kind == serial）
                            if root.draft-kind == "serial" : VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.lang-en ? "Serial port" : "串口设备";
                                    font-size: 11px;
                                    color: Theme.fg-2;
                                }
                                Input {
                                    text <=> root.draft-serial-port;
                                    placeholder: "/dev/tty.usbserial-XXXX";
                                    invalid: root.host-missing && root.draft-serial-port == "";
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 2;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Baud rate" : "波特率"; font-size: 11px; color: Theme.fg-2; }
                                        Input { text <=> root.draft-baud; placeholder: "115200"; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Data bits" : "数据位"; font-size: 11px; color: Theme.fg-2; }
                                        Select {
                                            text: root.draft-data-bits;
                                            options: ["5", "6", "7", "8"];
                                            current: root.draft-data-bits == "5" ? 0 : (root.draft-data-bits == "6" ? 1 : (root.draft-data-bits == "7" ? 2 : 3));
                                            picked(i) => { root.draft-data-bits = ["5", "6", "7", "8"][i]; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Stop bits" : "停止位"; font-size: 11px; color: Theme.fg-2; }
                                        Select {
                                            text: root.draft-stop-bits;
                                            options: ["1", "2"];
                                            current: root.draft-stop-bits == "2" ? 1 : 0;
                                            picked(i) => { root.draft-stop-bits = ["1", "2"][i]; }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Parity" : "校验"; font-size: 11px; color: Theme.fg-2; }
                                        Select {
                                            text: root.draft-parity;
                                            options: ["none", "odd", "even"];
                                            current: root.draft-parity == "odd" ? 1 : (root.draft-parity == "even" ? 2 : 0);
                                            picked(i) => { root.draft-parity = ["none", "odd", "even"][i]; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Flow control" : "流控"; font-size: 11px; color: Theme.fg-2; }
                                        Select {
                                            text: root.draft-flow;
                                            options: ["none", "hardware", "software"];
                                            current: root.draft-flow == "hardware" ? 1 : (root.draft-flow == "software" ? 2 : 0);
                                            picked(i) => { root.draft-flow = ["none", "hardware", "software"][i]; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;

                                        Text { text: root.lang-en ? "Encoding" : "编码"; font-size: 11px; color: Theme.fg-2; }
                                        Input { text <=> root.draft-encoding; placeholder: "UTF-8"; }
                                    }
                                }
                            }
                        }
                    }

                    // ── 认证方式（SSH）─────────────────────────────────────
                    if root.draft-kind == "ssh" : Section {
                        title: root.lang-en ? "Authentication" : "认证方式";

                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 10px;
                                OptionCard {
                                    glyph: "\u{E897}"; // lock
                                    title: root.lang-en ? "Password" : "密码";
                                    desc: root.lang-en ? "Ask for the password on connect" : "连接时输入密码";
                                    selected: root.draft-auth == "password";
                                    clicked => { root.draft-auth = "password"; }
                                }
                                OptionCard {
                                    glyph: "\u{E0DA}"; // vpn_key
                                    title: root.lang-en ? "Private key" : "私钥";
                                    desc: root.lang-en ? "Use a key file or paste the key" : "用密钥文件或直接粘贴";
                                    selected: root.draft-auth == "key";
                                    clicked => { root.draft-auth = "key"; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                OptionCard {
                                    glyph: "\u{E8D4}"; // verified_user
                                    title: root.lang-en ? "Keyboard-interactive" : "键盘交互";
                                    desc: root.lang-en ? "Server prompts during login (MFA / OTP asks again)" : "登录时由服务器提问（MFA / OTP 会再问一次）";
                                    selected: root.draft-auth == "keyboard-interactive";
                                    clicked => { root.draft-auth = "keyboard-interactive"; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Text {
                                text: root.lang-en ? "Username" : "用户名";
                                font-size: 11px;
                                color: Theme.fg-2;
                            }
                            Input {
                                text <=> root.draft-user;
                                placeholder: root.lang-en ? "Prompted on connect if blank" : "留空则连接时询问";
                            }

                            if root.draft-auth == "password" || root.draft-auth == "keyboard-interactive" : VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.draft-auth == "keyboard-interactive" ? root.lang-en ? "Password / first answer" : "密码 / 第一个应答" : root.lang-en ? "Password" : "密码";
                                    font-size: 11px;
                                    color: Theme.fg-2;
                                }
                                Input {
                                    password: true;
                                    text <=> root.draft-password;
                                    placeholder: root.is-editing ? root.lang-en ? "Leave blank to keep the current password" : "留空则保留原密码" : "••••••••";
                                }
                            }

                            if root.draft-auth == "key" : VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Seg {
                                        label: root.lang-en ? "Private key file" : "私钥文件";
                                        active: !root.draft-key-inline-mode;
                                        clicked => { root.draft-key-inline-mode = false; }
                                    }
                                    Seg {
                                        label: root.lang-en ? "Paste private key" : "粘贴私钥内容";
                                        active: root.draft-key-inline-mode;
                                        clicked => { root.draft-key-inline-mode = true; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }

                                if !root.draft-key-inline-mode : VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Input {
                                            horizontal-stretch: 1;
                                            text <=> root.draft-key-path;
                                            placeholder: "/home/you/.ssh/id_ed25519";
                                        }
                                        Btn {
                                            text: root.lang-en ? "Browse…" : "浏览…";
                                            clicked => { root.pick-key-file(); }
                                        }
                                    }
                                    Text {
                                        text: root.lang-en ? "Pick the private key itself (not the .pub public key)" : "请选私钥本身（不是 .pub 公钥）";
                                        font-size: 10px;
                                        color: Theme.fg-3;
                                    }
                                }

                                if root.draft-key-inline-mode : VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Area {
                                        height: 118px;
                                        text <=> root.draft-key-inline;
                                        placeholder: "-----BEGIN OPENSSH PRIVATE KEY-----";
                                    }
                                }
                            }
                        }
                    }

                    // ── 代理与跳板机（SSH）─────────────────────────────────
                    if root.draft-kind == "ssh" : Section {
                        title: root.lang-en ? "Proxy & jump host" : "代理与跳板机";

                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;

                            ToggleRow {
                                label: root.lang-en ? "Proxy" : "启用代理";
                                desc: root.lang-en ? "Connect through a SOCKS5 / HTTP proxy" : "通过 SOCKS5 / HTTP 代理连接";
                                on: root.proxy-on;
                                toggled => {
                                    root.draft-proxy-type = root.proxy-on ? "none" : "socks5";
                                }
                            }
                            if root.proxy-on : HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;
                                    alignment: start;

                                    Text { text: root.lang-en ? "Type" : "类型"; font-size: 11px; color: Theme.fg-2; }
                                    Select {
                                        text: root.draft-proxy-type == "http" ? "HTTP" : "SOCKS5";
                                        options: ["SOCKS5", "HTTP"];
                                        current: root.draft-proxy-type == "http" ? 1 : 0;
                                        picked(i) => { root.draft-proxy-type = i == 1 ? "http" : "socks5"; }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 8px;
                                    alignment: start;

                                    Text { text: root.lang-en ? "Address" : "地址"; font-size: 11px; color: Theme.fg-2; }
                                    Input {
                                        text <=> root.draft-proxy-hostport;
                                        placeholder: "127.0.0.1:1080";
                                    }
                                }
                            }

                            ToggleRow {
                                label: root.lang-en ? "Jump host" : "启用跳板机";
                                desc: root.lang-en ? "Hop through another saved SSH session" : "经由另一台已保存的 SSH 会话中转";
                                on: root.jump-on;
                                toggled => {
                                    root.draft-jump-index = root.jump-on ? 0 : (root.jump-choices.length > 1 ? 1 : 0);
                                }
                            }
                            if root.jump-on : VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text { text: root.lang-en ? "Pick a host" : "选择主机"; font-size: 11px; color: Theme.fg-2; }
                                Select {
                                    text: root.draft-jump-index < root.jump-choices.length
                                        ? root.jump-choices[root.draft-jump-index]
                                        : "";
                                    options: root.jump-choices;
                                    current: root.draft-jump-index;
                                    picked(i) => { root.draft-jump-index = i; }
                                }
                            }
                        }
                    }

                    // ── 高级：shell 集成开关 + 端口转发 / 登录触发器 ────────
                    Section {
                        title: root.lang-en ? "Advanced" : "高级";

                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;

                            ToggleRow {
                                label: root.lang-en ? "Disable shell integration" : "禁用 shell 集成";
                                desc: root.lang-en ? "Windows / pwsh servers: skips the POSIX cwd-follow hook and monitor" : "Windows / pwsh 服务器：跳过依赖 POSIX 的目录跟随与监控";
                                on: root.draft-disable-shell-integration;
                                toggled => {
                                    root.draft-disable-shell-integration = !root.draft-disable-shell-integration;
                                }
                            }

                            // 折叠区（旧对话框的「Advanced」行为）：端口转发 + 登录触发器
                            Rectangle {
                                height: 32px;
                                border-radius: 7px;
                                background: adv-ta.has-hover ? Theme.sur-3 : transparent;

                                adv-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-advanced = !root.show-advanced; }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    Text {
                                        text: root.show-advanced ? "\u{E5CF}" : "\u{E5CE}"; // 展开箭头
                                        font-family: "Material Icons";
                                        font-size: 16px;
                                        color: Theme.fg-2;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.draft-kind == "ssh"
                                            ? root.lang-en ? "Port forwarding & login triggers" : "端口转发与登录触发器"
                                            : root.lang-en ? "Port forwarding" : "端口转发";
                                        font-size: 12px;
                                        color: Theme.fg-1;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    if root.forwards.length + root.triggers.length > 0 : Text {
                                        text: "\{root.forwards.length + root.triggers.length}";
                                        font-size: 10px;
                                        color: Theme.fg-3;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    if root.show-advanced : VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: root.lang-en ? "Port forwarding" : "端口转发";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.fg-2;
                        }
                        for f[i] in root.forwards : FwdRow {
                            forward: f;
                            index: i;
                            lang-en: root.lang-en;
                            updated(index, value) => { root.update-forward(index, value); }
                            remove(index) => { root.delete-forward(index); }
                        }
                        HorizontalLayout {
                            alignment: end;
                            Btn {
                                text: root.lang-en ? "Add" : "添加";
                                clicked => { root.add-forward(); }
                            }
                        }
                        Text {
                            text: root.lang-en ? "-L: local port → target reached from the server; -R: server port → target reached from here; -D: local SOCKS5 proxy" : "-L：本地端口 → 由服务器侧连接目标；-R：服务器端口 → 由本机连接目标；-D：本地 SOCKS5 动态代理";
                            font-size: 10px;
                            color: Theme.fg-3;
                            wrap: word-wrap;
                        }

                        if root.draft-kind == "ssh" : VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            Text {
                                text: root.lang-en ? "Login triggers" : "登录触发器";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.fg-2;
                            }
                            for trigger[i] in root.triggers : TrigRow {
                                trigger: trigger;
                                index: i;
                                lang-en: root.lang-en;
                                updated(index, value) => { root.update-trigger(index, value); }
                                remove(index) => { root.delete-trigger(index); }
                            }
                            HorizontalLayout {
                                alignment: end;
                                Btn {
                                    text: root.lang-en ? "Add trigger" : "添加触发器";
                                    clicked => { root.add-trigger(); }
                                }
                            }
                            Text {
                                text: root.lang-en ? "When expected text appears, send the response automatically. Responses are stored encrypted." : "出现期望文本时自动回送响应；响应内容加密保存。";
                                font-size: 10px;
                                color: Theme.fg-3;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // ── 底部操作条 ────────────────────────────────────────────────
            Rectangle {
                height: 52px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;

                    Btn {
                        glyph: "\u{E1AF}"; // network_check
                        text: root.lang-en ? "Test connection" : "测试连接";
                        clicked => {
                            if (root.draft-kind != "serial" && root.draft-host == "") {
                                root.host-missing = true;
                                return;
                            }
                            if (root.draft-kind == "serial" && root.draft-serial-port == "") {
                                root.test-status = root.lang-en ? "Please enter a serial port." : "请填写串口设备。";
                                return;
                            }
                            root.host-missing = false;
                            root.test-status = root.lang-en ? "Testing..." : "测试中…";
                            root.test-connection(root.build-draft());
                        }
                    }
                    Text {
                        text: root.test-status;
                        color: root.test-status == @tr("Connection OK") ? Theme.ok : Theme.fg-3;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Btn {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.cancel(); }
                    }
                    Btn {
                        text: root.is-editing ? root.lang-en ? "Save host" : "保存主机" : root.lang-en ? "Create host" : "创建主机";
                        variant: "primary";
                        clicked => {
                            // SSH/Telnet need a host; block submit and flag it (#110).
                            if (root.draft-kind != "serial" && root.draft-host == "") {
                                root.host-missing = true;
                                return;
                            }
                            root.host-missing = false;
                            root.submit(root.build-draft());
                        }
                    }
                }
            }
        }
    }
}
