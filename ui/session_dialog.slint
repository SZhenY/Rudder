import { Theme } from "theme.slint";
import { CloseButton } from "components/buttons.slint";
import { SessionDraft, PortFwd, TriggerDraft } from "session_types.slint";
import { SessionForm } from "session_dialog/form.slint";
// PortFwd / TriggerDraft / SessionDraft 从这里搬走了，但对外仍是本文件的导出。
export { PortFwd, TriggerDraft, SessionDraft }



// Modal dialog for creating / editing a session (SSH / Serial / Telnet).
// The dialog is purely presentational — it stores values in mutable
// properties and emits `submit` / `cancel` callbacks up to the main window.
export component SessionDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-kind: "ssh";
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user;
    // Set when Create/Save is pressed with an empty host (SSH/Telnet) (#110).
    private property <bool> host-missing: false;
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-password;
    in-out property <string> draft-key-path;
    in-out property <string> draft-key-inline;
    in-out property <bool> draft-key-inline-mode: false;
    in-out property <string> draft-proxy-type: "none";  // "none" | "socks5" | "http"
    in-out property <string> draft-proxy-hostport;
    in-out property <string> draft-proxy-user;
    in-out property <string> draft-proxy-password;
    in-out property <string> draft-group;
    in property <[string]> session-groups;   // existing groups for the dropdown (#179)
    // SSH jump host picker (#211): parallel label/id lists (index 0 = "none")
    // plus the selected index. The id is resolved on submit via `jump-ids`.
    in property <[string]> jump-choices;
    in property <[string]> jump-ids;
    in-out property <int> draft-jump-index: 0;
    in-out property <string> draft-serial-port;
    in-out property <string> draft-baud: "115200";
    in-out property <string> draft-data-bits: "8";
    in-out property <string> draft-stop-bits: "1";
    in-out property <string> draft-parity: "none";
    in-out property <string> draft-flow: "none";
    in-out property <string> draft-encoding: "UTF-8";
    in-out property <bool> draft-disable-shell-integration: false;
    in-out property <string> draft-note;
    in-out property <string> test-status;

    // Port forwards / tunnels (#56). Every row is an editable form (#277).
    in property <[PortFwd]> forwards;
    // Expect/send login triggers (#212). SSH only — they match terminal output.
    in property <[TriggerDraft]> triggers;
    property <bool> show-advanced: false;   // collapse proxy + forwarding (#56)

    callback submit(SessionDraft);
    callback test-connection(SessionDraft);
    callback cancel();
    callback add-forward();
    callback update-forward(int /* index */, PortFwd);
    callback delete-forward(int /* index */);
    callback add-trigger();
    callback update-trigger(int /* index */, TriggerDraft);
    callback delete-trigger(int /* index */);
    callback pick-key-file();   // open a native file picker for the private key

    // 底部两个按钮（测试连接 / 提交）用的是**同一份 28 字段载荷**，此前各写一遍 ——
    // 改字段必须改两处，漏一处就是静默丢字段。抽成函数后只有这一处定义。
    // `pure` = 只读属性、无副作用（Slint 只允许在绑定里调用纯函数）。

    visible: is-open;
    background: #00000080;

    // Clear the host-required flag each time the dialog opens (#110).
    changed is-open => {
        if (self.is-open) {
            self.host-missing = false;
        }
    }

    // Swallow clicks on the backdrop
    TouchArea {
        width: 100%; height: 100%;
    }

    Rectangle {
        width: 440px;
        // Height follows the content, but never exceeds the window — past that
        // the body scrolls (the dialog grows with the advanced section / many
        // port forwards) (#56).
        height: min(form.preferred-height + 53px, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-panel;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-raised-blur;
        drop-shadow-color: Theme.shadow-raised-color;

        // Prevent backdrop click from propagating when user clicks inside the card
        TouchArea {
            width: 100%; height: 100%;
        }

        VerticalLayout {
            spacing: 0px;

        Rectangle {
            width: 100%;
            height: 52px;
            background: Theme.bg-panel-alt;
            border-radius: Theme.radius-lg;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 10px;
                spacing: 10px;

                Text {
                    text: is-editing ? @tr("Edit session") : @tr("New session");
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                CloseButton {
                    size: 32px;
                    glyph-size: 18px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.cancel(); }
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 1px;
            background: Theme.border-subtle;
        }

        Flickable {
            width: 100%;
            vertical-stretch: 1;
            content-width: self.width;
            content-height: form.preferred-height;
            form := SessionForm {
                is-editing <=> root.is-editing;
                draft-id <=> root.draft-id;
                draft-name <=> root.draft-name;
                draft-kind <=> root.draft-kind;
                draft-host <=> root.draft-host;
                draft-port <=> root.draft-port;
                draft-user <=> root.draft-user;
                draft-auth <=> root.draft-auth;
                draft-password <=> root.draft-password;
                draft-key-path <=> root.draft-key-path;
                draft-key-inline <=> root.draft-key-inline;
                draft-key-inline-mode <=> root.draft-key-inline-mode;
                draft-proxy-type <=> root.draft-proxy-type;
                draft-proxy-hostport <=> root.draft-proxy-hostport;
                draft-proxy-user <=> root.draft-proxy-user;
                draft-proxy-password <=> root.draft-proxy-password;
                draft-group <=> root.draft-group;
                draft-jump-index <=> root.draft-jump-index;
                draft-serial-port <=> root.draft-serial-port;
                draft-baud <=> root.draft-baud;
                draft-data-bits <=> root.draft-data-bits;
                draft-stop-bits <=> root.draft-stop-bits;
                draft-parity <=> root.draft-parity;
                draft-flow <=> root.draft-flow;
                draft-encoding <=> root.draft-encoding;
                draft-disable-shell-integration <=> root.draft-disable-shell-integration;
                draft-note <=> root.draft-note;
                test-status <=> root.test-status;
                host-missing <=> root.host-missing;
                session-groups: root.session-groups;
                jump-choices: root.jump-choices;
                jump-ids: root.jump-ids;
                forwards: root.forwards;
                triggers: root.triggers;
                submit(d) => { root.submit(d); }
                test-connection(d) => { root.test-connection(d); }
                cancel() => { root.cancel(); }
                add-forward() => { root.add-forward(); }
                update-forward(i, f) => { root.update-forward(i, f); }
                delete-forward(i) => { root.delete-forward(i); }
                add-trigger() => { root.add-trigger(); }
                update-trigger(i, t) => { root.update-trigger(i, t); }
                delete-trigger(i) => { root.delete-trigger(i); }
                pick-key-file() => { root.pick-key-file(); }
            }
        }
        }
    }
}
