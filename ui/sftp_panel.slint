import { Theme, AnimationSettings } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabInfo } from "tabs.slint";
import { Divider, VDivider } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { SftpMenuItem } from "sftp_parts.slint";
import { ResourceView } from "resource_view.slint";
import { DiskInfo } from "sidebar_blocks.slint";


// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

export struct SftpEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    size: string,
    size-bytes: float,
    modified: string,
    modified-ts: float,
    mode: int,        // POSIX permission bits, for the chmod dialog (#84)
    // 「类型 / 权限」两列（上游 ed7f231）：都由完整 mode 位在 Rust 侧算出，不需要额外往返。
    entry-type: string,      // dir / file / link / socket / fifo / char / block / ?
    permissions: string,     // ls -l 风格的 9 位（rwxr-xr-x）
    selected: bool,   // multi-select checkbox state (#100)
}

export struct SftpTreeNode {
    path: string,
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
}

export struct TunnelInfo {
    id: string,
    name: string,
    kind: string,
    bind: string,
    target: string,
    status: string,
    active: bool,
}

// PanelTab — 三个页签的共用组件。

component PanelTab inherits Rectangle {
    in property <string> mode;
    in property <string> panel-mode;
    in property <bool> narrow;
    in property <length> tab-width;
    in property <string> glyph;
    in property <string> label;
    callback activate();

    width: root.narrow ? 28px : root.tab-width;
    height: 22px;
    border-radius: Theme.radius-sm;
    background: root.panel-mode == root.mode ? Theme.accent : (tab-ta.has-hover ? Theme.state-hover : transparent);
    animate background {
        duration: root.panel-mode == root.mode ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
        easing: root.panel-mode == root.mode ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }
    tab-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
    Text {
        text: root.narrow ? root.glyph : root.label;
        font-family: root.narrow ? "Material Icons" : Theme.ui-font-family;
        color: root.panel-mode == root.mode ? #ffffff : Theme.text-secondary;
        font-size: Theme.fs-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---------------------------------------------------------------------------
// SftpPanel — left directory tree + right file listing
// ---------------------------------------------------------------------------

export component SftpPanel inherits Rectangle {
    // --- Properties --------------------------------------------------------
    in property <string>  current-path: "/";
    in property <[SftpEntry]>    entries;
    in property <string>  status: @tr("SFTP not connected");
    in property <bool>    loading: false;
    in property <[SftpTreeNode]> tree-nodes: [];
    in property <string> current-tab-id;
    in property <[TabInfo]> transfer-targets: [];
    in property <string> sort-key: "";
    in property <int> sort-dir: 0; // 0 default / 1 asc / -1 desc
    in property <[TunnelInfo]> tunnels: [];
    property <string> tunnel-kind: "local";
    property <string> tunnel-name: "";
    property <string> tunnel-bind: "127.0.0.1";
    property <string> tunnel-bind-port: "1080";
    property <string> tunnel-host: "127.0.0.1";
    property <string> tunnel-host-port: "80";
    // --- 运行状态页签的数据（原侧栏，由 AppWindow 逐层透传）-----------------
    in property <string> connection-state: @tr("Not connected");
    in property <string> conn-host;
    in property <int> conn-state;
    in property <string> resource-title: @tr("Local resources");
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    in property <[DiskInfo]> disks;
    in property <bool> system-info-available;
    in property <bool> proc-available;
    in property <bool> collapsed: false;   // when true only the toolbar shows
    in property <bool> show-tree: true;    // 右侧固定竖排时不显示目录树
    in property <bool> compact: false;     // 收起进度 > 0.99 时只留一条干净的折叠带
    /// 折叠进度（0 = 展开，1 = 收起）。面板整体随它淡出，与宽度同一条时间轴。
    in property <float> fade: 0;
    // 列宽自适应：面板固定在右侧、宽度可调。窄到文件名开始省略时依次丢掉
    // Size / Modified 列；`show-tree` 为 true 表示宽布局，所有列都显示。
    // 预留宽度：复选框 + 内边距 + 间距 36px，Size 列 76px，Modified 列 120px。
    property <length> list-w: root.show-tree ? root.width - 161px : root.width;
    property <length> name-min: 180px;     // narrower than this → start dropping columns
    property <bool> show-size-col: root.show-tree || (root.list-w - 36px - 76px - 120px > root.name-min);
    property <bool> show-modified-col: root.show-tree || (root.list-w - 36px - 120px > root.name-min);
    // 「类型 / 权限」两列（上游 ed7f231）：只在真的有余量时出现 —— 右侧面板本来就窄，
    // 宁可不显示也不要挤掉文件名（这两列是参考信息，不是操作必需）。预留：Type 56px +
    // Permissions 92px（含 spacing）。
    property <bool> show-fileinfo-cols: root.show-tree
        || (root.show-size-col && root.show-modified-col
            && root.list-w - 36px - 76px - 120px - 56px - 92px > root.name-min);
    property <int> selected-row: -1;       // clicked/highlighted file-list row (#70)
    in property <int> selected-count;      // number of checked entries (#100)
    // Panel-level right-click context menu (#84). One menu for the whole list:
    // an empty `menu-target` means the click landed on whitespace, which greys
    // out the item-specific actions (download/rename/…) but keeps new/refresh.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;          // "" = whitespace
    property <string> menu-target-name;
    property <bool>   menu-target-is-dir;
    property <int>    menu-target-mode;     // permission bits for the chmod dialog
    in-out property <string> panel-mode: "status";
    // The full toolbar needs roughly 480px once a useful path field is included.
    // Below that, switch deliberately to a two-row compact layout instead of
    // allowing fixed-size controls to squeeze the path and each other (#285).
    property <bool> narrow-toolbar: !root.show-tree && root.width < 480px;

    // --- Callbacks ---------------------------------------------------------
    callback toggle-collapsed();    // minimise / restore the panel
    callback navigate(string);
    callback download(string);
    callback upload-clicked(string /* remote dir */, bool /* folder */);
    callback refresh(string);
    callback tree-expand(string);   // toggle expand/collapse + navigate
    callback delete(string);        // remove a remote file/dir
    callback toggle-select(int);    // toggle a row's multi-select checkbox (#100)
    callback download-selected();   // download all checked entries (#100)
    callback delete-selected();     // delete all checked entries (#100)
    callback copy-to-target(string /* path */, string /* target tab */);
    callback copy-selected-to-target(string /* target tab */);
    callback view(string);          // open read-only in the built-in viewer
    callback edit(string);          // open writable in the built-in editor
    callback open-external(string);     // open with the OS default app (#81)
    callback edit-external(string);     // open externally + watch/re-upload (#81)
    callback sort-request(string /* name|size|modified */);
    callback clear-sort();
    // 运行状态页签的交互，全部转给 AppWindow 现有的回调。
    callback select-net-iface(string);
    callback show-system-info();
    callback show-processes();
    callback copy-host(string);
    callback tunnel-add(string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */);
    callback tunnel-stop(string /* id */);
    // Context-menu extensions (#69). The *-request callbacks open dialogs in
    // the app shell; copy-path goes straight to the system clipboard.
    callback rename-request(string /* path */, string /* current name */);
    callback chmod-request(string /* path */, string /* name */, int /* mode */);
    callback copy-path(string);
    callback new-folder(string /* parent dir */);
    callback new-file(string /* parent dir */);
    // -----------------------------------------------------------------------
    background: Theme.bg-panel;
    clip: true;
    // 面板整体随折叠进度淡出，与宽度同轴。
    // `visible` 在淡出结束后关掉渲染（`opacity: 0` 仍会吃点击）。
    opacity: 1 - root.fade;
    visible: root.fade < 0.999;

    // Keep the editable path bar in sync when the directory changes elsewhere
    // (tree click, file double-click, terminal cd) (#54).
    changed current-path => {
        path-input.text = root.current-path;
        compact-path-input.text = root.current-path;
        root.selected-row = -1;
    }

    // 收起态整块隐藏：横向工具栏会被压成不可用的竖条。用 `visible`（不是 `if`）
    // 让 path-input 这类 id 仍可被回调访问；折叠条由父级浮在上层。
    VerticalLayout {
        visible: !root.compact;
        spacing: 0;

        // --- Toolbar (full width) ------------------------------------------
        Rectangle {
            height: root.narrow-toolbar && root.panel-mode == "files" ? 62px : 34px;
            background: Theme.bg-panel-alt;

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                height: 34px;
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                PanelTab {
                    mode: "status";
                    panel-mode: root.panel-mode;
                    narrow: root.narrow-toolbar;
                    tab-width: 64px;
                    glyph: "\u{E871}";
                    label: @tr("Status");
                    activate() => { root.panel-mode = "status"; }
                }
                PanelTab {
                    mode: "files";
                    panel-mode: root.panel-mode;
                    narrow: root.narrow-toolbar;
                    tab-width: 48px;
                    glyph: "\u{E2C7}";
                    label: "SFTP";
                    activate() => { root.panel-mode = "files"; }
                }
                PanelTab {
                    mode: "tunnels";
                    panel-mode: root.panel-mode;
                    narrow: root.narrow-toolbar;
                    tab-width: 58px;
                    glyph: "\u{E0B6}";
                    label: @tr("Tunnels");
                    activate() => { root.panel-mode = "tunnels"; }
                }

                // 窄工具栏：状态、SFTP、隧道三个页签在左，操作按钮靠右；路径占第二行。
                if root.narrow-toolbar : Rectangle { horizontal-stretch: 1; }

                // Editable path bar: type or paste a path and press Enter to
                // jump there; copy / paste-jump buttons sit right after it (#54).
                Rectangle {
                    visible: root.panel-mode == "files" && !root.narrow-toolbar;
                    horizontal-stretch: 1;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: Theme.bg-root;
                    border-width: 1px;
                    border-color: path-input.has-focus ? Theme.accent : Theme.border-subtle;
                    path-input := TextInput {
                        input-method-hints: Theme.plain-input-hints;
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        text: root.current-path;
                        color: Theme.text-primary;
                        // CJK-capable font so typed Chinese isn't tofu (#54).
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { root.navigate(self.text); }
                    }
                }

                // Copy the current path to the clipboard.
                // 用 `if` 而不是 `visible`：Slint 里 `visible: false` **不释放布局空间**，
                // 这三个按钮会在窄模式下白占 3×24 + 3×4 = 84px，把最右的收起按钮挤出面板
                // （255px 时第一行最少要 276px）。功能都在 ⋮ 菜单里，销毁无损失。
                if root.panel-mode == "files" && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: copy-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: copy-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: copy-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    copy-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            path-input.select-all();
                            path-input.copy();
                            path-input.clear-selection();
                        }
                    }
                    IconText { text: "\u{E14D}";
                           centered: true;
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
}
                }

                // Paste a path from the clipboard and jump straight to it.
                if root.panel-mode == "files" && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: pj-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: pj-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: pj-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    pj-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            path-input.select-all();
                            path-input.paste();
                            root.navigate(path-input.text);
                        }
                    }
                    IconText { text: "\u{E14F}";
                           centered: true;
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
}
                }

                // Parent navigation stays a fixed toolbar action in the compact
                // layout too: it is the primary way to move around, and burying
                // it in the ⋮ menu forces an extra click on every step up.
                up-btn := Rectangle {
                    visible: root.panel-mode == "files";
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: up-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: up-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: up-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    up-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.navigate(".."); }
                    }
                    Text { text: "↑"; color: Theme.text-secondary; font-size: Theme.fs-md;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                // Upload: a small menu offers file vs folder (#85). The remote
                // SFTP upload handles both — only the local picker differs.
                ul-btn := Rectangle {
                    visible: root.panel-mode == "files";
                    width: root.narrow-toolbar ? 24px : 52px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ul-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    animate background {
                        duration: ul-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: ul-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    ul-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ul-menu.show(); }
                    }
                    Text { text: root.narrow-toolbar ? "↑" : @tr("Upload"); color: #ffffff; font-size: Theme.fs-sm;
                           horizontal-alignment: center; vertical-alignment: center; }
                    ul-menu := PopupWindow {
                        x: 0; y: parent.height + 2px;
                        width: 124px;
                        height: 2 * 27px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: Theme.shadow-popup-blur;
                            drop-shadow-color: Theme.shadow-popup-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Upload file");
                                    clicked => { root.upload-clicked(root.current-path, false); }
                                }
                                SftpMenuItem {
                                    label: @tr("Upload folder");
                                    clicked => { root.upload-clicked(root.current-path, true); }
                                }
                            }
                        }
                    }
                }

                // Secondary path actions move into an overflow menu in compact
                // mode so they never compete with the path field for width.
                if root.narrow-toolbar && root.panel-mode == "files" : Rectangle {
                    width: 24px;
                    height: 22px;
                    border-radius: Theme.radius-sm;
                    background: compact-more-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: compact-more-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: compact-more-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    compact-more-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { compact-more-menu.show(); }
                    }
                    IconText {
                        centered: true;
                        text: "\u{E5D4}";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-md;
                    }
                    compact-more-menu := PopupWindow {
                        x: parent.width - self.width;
                        y: parent.height + 2px;
                        width: 142px;
                        height: 4 * 27px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: Theme.shadow-popup-blur;
                            drop-shadow-color: Theme.shadow-popup-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Up one level");
                                    clicked => { root.navigate(".."); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    clicked => {
                                        compact-path-input.select-all();
                                        compact-path-input.copy();
                                        compact-path-input.clear-selection();
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Paste and go");
                                    clicked => {
                                        compact-path-input.select-all();
                                        compact-path-input.paste();
                                        root.navigate(compact-path-input.text);
                                    }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    clicked => { root.refresh(root.current-path); }
                                }
                            }
                        }
                    }
                }

                // Batch actions on checked entries — only when something's checked (#100).
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : Text {
                    text: "✓" + root.selected-count;
                    color: Theme.accent;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: dls-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: dls-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: dls-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    dls-ta := TouchArea { mouse-cursor: pointer; clicked => { root.download-selected(); } }
                    IconText { text: "\u{E2C4}";color: Theme.text-secondary;
                           centered: true;
                           font-size: Theme.fs-md;}
                }
                if root.panel-mode == "files" && root.selected-count > 0 && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: dels-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                    animate background {
                        duration: dels-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: dels-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    dels-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-selected(); } }
                    IconText { text: "\u{E872}";color: Theme.danger;
                           centered: true;
                           font-size: Theme.fs-md;}
                }

                if root.panel-mode == "files" && !root.narrow-toolbar : Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: ref-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: ref-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: ref-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    ref-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh(root.current-path); }
                    }
                    IconText { text: "\u{E5D5}";
                           centered: true;
                           color: Theme.text-secondary; font-size: Theme.fs-sm;
}
                }

                // Minimise / restore the SFTP panel (#41).
                Rectangle {
                    width: 24px; height: 22px;
                    border-radius: Theme.radius-sm;
                    background: min-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: min-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: min-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    min-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-collapsed(); }
                    }
                    // expand_less (▲, restore) when collapsed, expand_more (▼) otherwise.
                    IconText { text: root.collapsed ? "\u{E5CE}" : "\u{E5CF}";
                           centered: true;
                           color: Theme.text-secondary; font-size: Theme.fs-md;
}
                }
                }

                // 窄工具栏下把路径导航挪到第二行，避免把第一行挤变形。
                // 用 layout spacing 留固定间距，不受首行对齐 / 内边距影响。
                HorizontalLayout {
                    visible: root.narrow-toolbar && root.panel-mode == "files";
                    height: self.visible ? 22px : 0px;
                    padding-left: 6px;
                    padding-right: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-root;
                        border-width: 1px;
                        border-color: compact-path-input.has-focus ? Theme.accent : Theme.border-subtle;
                        compact-path-input := TextInput {
                            input-method-hints: Theme.plain-input-hints;
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: root.current-path;
                            color: Theme.text-primary;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.navigate(self.text); }
                        }
                    }
                }
            }
        }

        // --- Main area: tree (left) + file list (right) --------------------
        if root.panel-mode == "files" : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // ── Left: directory tree (hidden when the panel is narrow) ──────
            if root.show-tree : VerticalLayout {
                width: 160px;
                spacing: 0;

                // Tree header
                Rectangle {
                    height: 20px;
                    background: Theme.bg-root;
                    Text {
                        x: 8px;
                        text: @tr("Directory tree");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Divider {}

                // Tree list with scrollbar
                ScrollView {
                    vertical-stretch: 1;

                    tree-list := VerticalLayout {
                        spacing: 0;

                        for node[i] in root.tree-nodes : Rectangle {
                            height: 22px;
                            background: node-ta.has-hover
                                ? Theme.state-hover
                                : (node.path == root.current-path
                                    ? Theme.accent-solid.with-alpha(0.19)
                                    : (mod(i, 2) == 0 ? transparent : #ffffff08));

                            node-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.tree-expand(node.path); }
                            }

                            HorizontalLayout {
                                spacing: 0;
                                padding-top: 1px;
                                // 树深度缩进：原来靠首个子元素 `Rectangle { width: depth * 12px }`
                                // 占位（该布局 spacing 为 0，故 padding-left 与之逐字等价）
                                padding-left: node.depth * 12px;


                                // Expand/collapse arrow
                                Text {
                                    width: 14px;
                                    text: node.has-children
                                        ? (node.expanded ? "▼" : "▶")
                                        : " ";
                                    color: Theme.text-muted;
                                    font-size: 9px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Folder name
                                Text {
                                    text: node.depth == 0 ? "/" : node.name;
                                    color: node.path == root.current-path
                                        ? Theme.accent
                                        : Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Vertical separator (only when the tree is shown)
            if root.show-tree : VDivider {}

            // ── Right: file listing ─────────────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;

                // Column headers
                Rectangle {
                    height: 20px;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        // 8px 内边距 + 16px「与下方复选框对齐」的列 + 8px 原 spacing ——
                        // 原来是空 `Rectangle { width: 16px; }` 占位（删掉它会连带删掉
                        // 它后面那份额外 spacing，故折进 padding-left）。
                        padding-left: 32px; padding-right: 8px; spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            header-name-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("name"); }
                            }
                            Text {
                                text: @tr("Name") + (root.sort-key == "name" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "name" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-size-col : Rectangle {
                            width: 72px;
                            header-size-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("size"); }
                            }
                            Text {
                                text: @tr("Size") + (root.sort-key == "size" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "size" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-modified-col : Rectangle {
                            width: 116px;
                            header-modified-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sort-request("modified"); }
                            }
                            Text {
                                text: @tr("Modified") + (root.sort-key == "modified" ? (root.sort-dir > 0 ? " ↑" : " ↓") : "");
                                color: root.sort-key == "modified" ? Theme.accent : Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        // 类型 / 权限（上游 ed7f231）：**纯展示**，不做排序（我们的排序键仍是
                        // 名称 / 大小 / 时间）。
                        if root.show-fileinfo-cols : Rectangle {
                            width: 52px;
                            Text {
                                text: @tr("Type");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-fileinfo-cols : Rectangle {
                            width: 84px;
                            Text {
                                text: @tr("Permissions");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                                width: parent.width;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Divider {}

                // File list. The area fills the panel height so right-click works
                // on the whitespace below the rows too (#84); the single menu
                // below greys out item actions when nothing was hit.
                file-area := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        content-width: self.visible-width;
                        content-height: max(self.visible-height, file-list.preferred-height);

                        file-list := VerticalLayout {
                            spacing: 0;

                            if root.loading : Rectangle {
                                height: 40px;
                                Text { text: @tr("Loading..."); color: Theme.text-muted; font-size: Theme.fs-sm;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }

                            if !root.loading && root.entries.length == 0 : Rectangle {
                                height: 40px;
                                Text { text: @tr("Empty directory"); color: Theme.text-muted; font-size: Theme.fs-sm;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }

                            for entry[i] in root.entries : row := Rectangle {
                                height: 24px;
                                // 跟随「配色」分区的主题色（原来是写死的蓝，换色后这里是死角）。
                                background: entry.selected
                                    ? Theme.accent-solid.with-alpha(0.21)
                                    : (i == root.selected-row
                                        ? Theme.accent-solid.with-alpha(0.25)
                                        : (row-ta.has-hover
                                            ? Theme.accent-solid.with-alpha(0.15)
                                            : (mod(i, 2) == 0 ? transparent : #ffffff08)));

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.selected-row = i; }
                                    double-clicked => {
                                        if (entry.is-dir) {
                                            root.navigate(entry.full-path);
                                        } else {
                                            root.download(entry.full-path);
                                        }
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = i;
                                            root.menu-target = entry.full-path;
                                            root.menu-target-name = entry.name;
                                            root.menu-target-is-dir = entry.is-dir;
                                            root.menu-target-mode = entry.mode;
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    // Multi-select checkbox (#100). Its own TouchArea
                                    // sits above the row, so toggling doesn't trigger
                                    // navigate/select.
                                    Rectangle {
                                        width: 16px;
                                        y: (parent.height - self.height) / 2;
                                        height: 16px;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                        background: entry.selected ? Theme.accent : transparent;
                                        cb-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-select(i); }
                                        }
                                        if entry.selected : IconText {
                                            centered: true;
                                            text: "\u{E5CA}"; // check
                                            color: #ffffff;
                                            font-size: 13px;
                                            width: parent.width; height: parent.height;
                                        }
                                    }
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        IconText {
                                            text: entry.is-dir ? "\u{E2C7}" : "\u{E24D}"; // folder / insert_drive_file
                                            color: Theme.accent;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: entry.name;
                                            color: Theme.accent;
                                            font-size: Theme.fs-sm;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.show-size-col : Text {
                                        text: entry.is-dir ? "" : entry.size;
                                        color: Theme.text-secondary; font-size: Theme.fs-xs;
                                        width: 72px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    if root.show-modified-col : Text {
                                        text: entry.modified;
                                        color: Theme.text-muted; font-size: Theme.fs-xs;
                                        width: 116px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    // 类型 / 权限（上游 ed7f231）：等宽字体让 9 位权限对齐。
                                    if root.show-fileinfo-cols : Text {
                                        text: entry.entry-type;
                                        color: Theme.text-muted; font-size: Theme.fs-xs;
                                        width: 52px; horizontal-alignment: left; vertical-alignment: center;
                                    }
                                    if root.show-fileinfo-cols : Text {
                                        text: entry.permissions;
                                        color: Theme.text-muted; font-size: Theme.fs-xs;
                                        font-family: Theme.font-mono;
                                        width: 84px; horizontal-alignment: left; vertical-alignment: center;
                                    }
                                }
                            }

                            // Whitespace below the rows: right-click here opens the
                            // menu with no target (item actions greyed out) (#84).
                            ws := Rectangle {
                                vertical-stretch: 1;
                                min-height: 24px;
                                ws-ta := TouchArea {
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.selected-row = -1;
                                            root.menu-target = "";
                                            root.menu-x = self.absolute-position.x + self.mouse-x - file-area.absolute-position.x;
                                            root.menu-y = self.absolute-position.y + self.mouse-y - file-area.absolute-position.y;
                                            file-menu.show();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // One context menu for the whole list (#84). Item actions are
                    // enabled only when an item was right-clicked (menu-target set);
                    // new/refresh are always available.
                    copy-target-menu := PopupWindow {
                        x: root.menu-x + 148px;
                        y: root.menu-y;
                        width: 148px;
                        height: max(1, root.transfer-targets.length) * 27px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: Theme.shadow-popup-blur;
                            drop-shadow-color: Theme.shadow-popup-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                for target in root.transfer-targets : SftpMenuItem {
                                    label: target.title;
                                    enabled: target.kind == "terminal" && target.connected && target.id != root.current-tab-id;
                                    clicked => {
                                        if (root.selected-count >= 2) {
                                            root.copy-selected-to-target(target.id);
                                        } else if (root.menu-target != "") {
                                            root.copy-to-target(root.menu-target, target.id);
                                        } else {
                                            root.copy-selected-to-target(target.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    file-menu := PopupWindow {
                        x: root.menu-x;
                        y: root.menu-y;
                        width: 148px;
                        height: 14 * 27px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: Theme.shadow-popup-blur;
                            drop-shadow-color: Theme.shadow-popup-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                SftpMenuItem {
                                    label: @tr("Download");
                                    enabled: root.menu-target != "";
                                    clicked => { root.download(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("View");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.view(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Open externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.open-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Edit externally");
                                    enabled: root.menu-target != "" && !root.menu-target-is-dir;
                                    clicked => { root.edit-external(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Rename");
                                    enabled: root.menu-target != "";
                                    clicked => { root.rename-request(root.menu-target, root.menu-target-name); }
                                }
                                SftpMenuItem {
                                    label: @tr("Permissions");
                                    enabled: root.menu-target != "";
                                    clicked => { root.chmod-request(root.menu-target, root.menu-target-name, root.menu-target-mode); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy path");
                                    enabled: root.menu-target != "";
                                    clicked => { root.copy-path(root.menu-target); }
                                }
                                SftpMenuItem {
                                    label: @tr("Copy to session...");
                                    enabled: (root.menu-target != "" || root.selected-count > 0) && root.transfer-targets.length > 1;
                                    clicked => { copy-target-menu.show(); }
                                }
                                SftpMenuItem {
                                    label: @tr("Delete");
                                    tint: #d86c6c;
                                    enabled: root.menu-target != "";
                                    clicked => { root.delete(root.menu-target); }
                                }
                                Divider {}
                                SftpMenuItem {
                                    label: @tr("New folder");
                                    clicked => { root.new-folder(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("New file");
                                    clicked => { root.new-file(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Refresh");
                                    clicked => { root.refresh(root.current-path); }
                                }
                                SftpMenuItem {
                                    label: @tr("Clear sort");
                                    enabled: root.sort-dir != 0;
                                    clicked => { root.clear-sort(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.panel-mode == "status" : ResourceView {
            vertical-stretch: 1;
            connection-state: root.connection-state;
            conn-host: root.conn-host;
            conn-state: root.conn-state;
            resource-title: root.resource-title;
            cpu-percent: root.cpu-percent;
            mem-percent: root.mem-percent;
            swap-percent: root.swap-percent;
            mem-detail: root.mem-detail;
            swap-detail: root.swap-detail;
            net-top-up: root.net-top-up;
            net-top-down: root.net-top-down;
            net-top-history: root.net-top-history;
            net-bot-up: root.net-bot-up;
            net-bot-down: root.net-bot-down;
            net-bot-history: root.net-bot-history;
            net-ifaces: root.net-ifaces;
            net-selected: root.net-selected;
            net-show-selector: root.net-show-selector;
            disks: root.disks;
            system-info-available: root.system-info-available;
            proc-available: root.proc-available;
            select-net-iface(i) => { root.select-net-iface(i); }
            show-system-info() => { root.show-system-info(); }
            show-processes() => { root.show-processes(); }
            copy-host(h) => { root.copy-host(h); }
        }

        if root.panel-mode == "tunnels" : Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;

            ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: self.visible-width;
                content-height: max(self.visible-height, tunnel-body.preferred-height);

                tunnel-body := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "local" ? Theme.accent : (tl-ta.has-hover ? Theme.state-hover : Theme.bg-root);
                            animate background {
                                duration: root.tunnel-kind == "local" ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: root.tunnel-kind == "local" ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            tl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "local"; } }
                            Text { text: "-L"; color: root.tunnel-kind == "local" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 54px; height: 24px; border-radius: Theme.radius-sm;
                            background: root.tunnel-kind == "dynamic" ? Theme.accent : (td-ta.has-hover ? Theme.state-hover : Theme.bg-root);
                            animate background {
                                duration: root.tunnel-kind == "dynamic" ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: root.tunnel-kind == "dynamic" ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            td-ta := TouchArea { mouse-cursor: pointer; clicked => { root.tunnel-kind = "dynamic"; } }
                            Text { text: "-D"; color: root.tunnel-kind == "dynamic" ? #ffffff : Theme.text-primary; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 72px; height: 24px; border-radius: Theme.radius-sm;
                            background: add-tunnel-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            animate background {
                                duration: add-tunnel-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                easing: add-tunnel-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                enabled: AnimationSettings.enabled;
                            }
                            add-tunnel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.tunnel-bind-port != "" && (root.tunnel-kind == "dynamic" || (root.tunnel-host != "" && root.tunnel-host-port != ""))) {
                                        root.tunnel-add(root.tunnel-name, root.tunnel-kind, root.tunnel-bind, root.tunnel-bind-port, root.tunnel-host, root.tunnel-host-port);
                                    }
                                }
                            }
                            Text { text: @tr("Add"); color: #ffffff; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-name; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                        }
                        Rectangle {
                            width: 76px; height: 24px; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-bind-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                        }
                    }

                    if root.tunnel-kind == "local" : HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 24px; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                        }
                        Rectangle {
                            width: 76px; height: 24px; border-radius: Theme.radius-sm;
                            background: Theme.bg-root; border-width: 1px; border-color: Theme.border-subtle;
                            TextInput { x: 7px; width: parent.width - 14px; height: parent.height; text <=> root.tunnel-host-port; color: Theme.text-primary; font-family: Theme.ui-font-family; font-size: Theme.fs-sm; single-line: true; vertical-alignment: center; input-method-hints: Theme.plain-input-hints; }
                        }
                    }

                    Divider {}

                    if root.tunnels.length == 0 : Rectangle {
                        height: 36px;
                        Text { text: @tr("No tunnels"); color: Theme.text-muted; font-size: Theme.fs-sm; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    for tun in root.tunnels : Rectangle {
                        height: 44px;
                        border-radius: Theme.radius-sm;
                        background: tunnel-row-ta.has-hover ? Theme.state-hover : Theme.bg-root.with-alpha(0.42);
                        animate background {
                            duration: tunnel-row-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                            easing: tunnel-row-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                            enabled: AnimationSettings.enabled;
                        }
                        tunnel-row-ta := TouchArea {}
                        VerticalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: tun.active ? "●" : "○"; color: tun.active ? #28c76f : Theme.text-muted; width: 14px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                                Text { text: tun.kind == "dynamic" ? "-D" : (tun.kind == "remote" ? "-R" : "-L"); color: Theme.text-muted; width: 28px; font-size: Theme.fs-sm; vertical-alignment: center; horizontal-alignment: center; }
                                Text { text: tun.name; color: Theme.text-primary; horizontal-stretch: 1; font-size: Theme.fs-sm; overflow: elide; vertical-alignment: center; }
                                Rectangle {
                                    width: 48px; height: 22px; border-radius: Theme.radius-sm;
                                    background: (tun.active && tun.kind != "remote") ? (stop-ta.has-hover ? Theme.danger.with-alpha(0.24) : transparent) : transparent;
                                    animate background {
                                        duration: (tun.active && tun.kind != "remote") ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                                        easing: (tun.active && tun.kind != "remote") ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                                        enabled: AnimationSettings.enabled;
                                    }
                                    stop-ta := TouchArea {
                                        mouse-cursor: (tun.active && tun.kind != "remote") ? pointer : default;
                                        clicked => { if (tun.active && tun.kind != "remote") { root.tunnel-stop(tun.id); } }
                                    }
                                    Text { text: @tr("Stop"); color: (tun.active && tun.kind != "remote") ? Theme.danger : Theme.text-muted; font-size: Theme.fs-xs; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: tun.bind + (tun.target != "" ? " → " + tun.target : ""); color: Theme.text-secondary; horizontal-stretch: 1; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; }
                                Text { text: tun.status; color: tun.active ? Theme.accent : Theme.text-muted; width: 62px; font-size: Theme.fs-xs; overflow: elide; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                    }
                }
            }
        }

        // --- Status bar (full width) --------------------------------------
        // 状态页与隧道页没有文件操作可报，整条让给内容区（用 if 而非 visible，避免布局仍留 18px）。
        if root.panel-mode == "files" : Rectangle {
            height: 18px;
            background: Theme.bg-panel-alt;
            Text {
                x: 8px;
                text: root.status;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                height: parent.height;
                overflow: elide;
                width: parent.width - 16px;
            }
        }
    }
}
