// 通用"表面"元素（分隔线 / 字段标题 / 说明文字）。
//
// 抽出来的理由：这三类在全项目里各手写了 28 / 15 / 9 遍，样式一字不差 ——
// 改一次颜色要翻 10 个文件。抽成组件后只改这里。
//
// 约定（与 ui-component-api.md 的设计冻结一致）：
// * 只含样式、不含业务状态；属性一律 `in`，事件一律 callback 上抛；
// * 不引入新的视觉：默认值与本组件替换掉的旧内联写法**逐字对应**。

import { Theme } from "../theme.slint";

/// 横向 1px 分隔线：替换散落各处的「高 1px 的空 Rectangle + border-subtle 底色」（原 19 处）。
/// 只设 height，宽度交给 `Rectangle` 的默认填充行为。
///
/// 注意两点实测结论：
/// * 属性不能叫 `color` —— `Rectangle` 在 1.17 已带同名属性（"Cannot override property 'color'"）；
/// * 不能用 `vertical` 开关把两个方向合成一个组件 —— 三目两侧 `1px`（length）与 `100%`
///   （percent）类型不同，编译不过。所以横向/纵向各一个组件，各自只设一个维度。
export component Divider inherits Rectangle {
    in property <brush> line-color: Theme.border-subtle;

    height: 1px;
    background: root.line-color;
}

/// 纵向 1px 分隔线（原 6 处）：只设 width，高度默认填充。
export component VDivider inherits Rectangle {
    in property <brush> line-color: Theme.border-subtle;

    width: 1px;
    background: root.line-color;
}

/// 段落小标题（设置项 / 表单分组的说明性标签）：替换
/// `Text { color: Theme.text-secondary; font-size: Theme.fs-sm; }` 的写法。
/// 文本直接写继承来的 `text`：`FieldLabel { text: @tr("Connection type"); }`
export component FieldLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.fs-sm;
}

/// 灰色小字说明（表单项下方那行帮助文字）：替换
/// `Text { color: Theme.text-muted; font-size: Theme.fs-xs; wrap: word-wrap; }`。
export component HelpText inherits Text {
    color: Theme.text-muted;
    font-size: Theme.fs-xs;
    wrap: word-wrap;
}

/// 模态对话框外壳：全窗半透明遮罩 + 居中卡片。
///
/// 此前 9 处各写一遍「遮罩 Rectangle + 居中卡片 + 阴影 + 一张吞掉内部点击的 TouchArea」。
///
/// ⚠️ 两点约束（都来自实测）：
/// * 组件只能有**一个** `@children`（`object_tree.rs` 的编译期限制）—— 所以**底部按钮
///   由调用方写在 children 里**，组件不提供第二个"footer 槽"。
/// * 组件的根元素**不能**引用 `parent`（这是 Slint 的限制）—— 所以卡片不是靠
///   `x: (root.width - w) / 2` 定位（那样会取到窗口），而是让组件铺满宿主、内部用
///   `parent.width` 居中。
export component ModalCard inherits Rectangle {
    in property <length> card-width: 340px;
    in property <length> card-height: 196px;
    // true = 高度随内容（原来的 `min(body.preferred-height + 53px, …)` 写法）
    in property <bool> auto-height: false;
    in property <length> radius: Theme.radius-sm;
    in property <brush> card-background: Theme.bg-panel;
    in property <brush> backdrop: #00000080;
    // 卡片内边距与行距：多数对话框是 18 / 12，快捷键那一处是 18 / 5。
    // ⚠️ 不能叫 `padding` —— `Rectangle` 已带同名属性（"Cannot override property
    // 'padding'"），与之前 `color` 那个坑同源。
    in property <length> body-padding: 18px;
    in property <length> spacing: 12px;
    // 点击遮罩时触发（调用方负责关闭；不接就不响应）。
    callback dismissed();
    // 遮罩是否拦截输入。用 `if` 包起来调用时恒为 true 即可；
    // 但**常驻**（靠 visible 切换）的调用必须跟随"是否打开" ——
    // 否则关闭状态下这层全窗口 TouchArea 会把整个界面的点击吞掉。
    in property <bool> active: true;

    width: 100%;
    height: 100%;
    background: root.backdrop;
    // 遮罩本身吞掉点击：点击遮罩即 dismissed，卡片内部的点击被 card 自己吞掉。
    backdrop-ta := TouchArea {
        enabled: root.active;
        clicked => { root.dismissed(); }
    }

    card := Rectangle {
        width: root.card-width;
        height: root.auto-height
            ? min(card-body.preferred-height, parent.height - 40px)
            : root.card-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: root.card-background;
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-color: Theme.shadow-dialog-color;
        TouchArea {}   // 吞掉卡片内部的点击，避免冒泡到遮罩

        card-body := VerticalLayout {
            padding: root.body-padding;
            spacing: root.spacing;
            @children
        }
    }
}

/// 分组留白：把「后一个分组」包起来，用容器的 padding-top 与上一组隔开。
///
/// 为什么需要它 —— 两个事实：
/// 1. Slint 布局没有 margin，夹在两个兄弟元素之间的空隙**只能由容器表达**
///    （官方 .slint 里没有"空 `Rectangle` 当间距"的写法，462 个文件 0 例）；
/// 2. 设置分区内部是"设置行紧贴 + 自身分隔线"，容器的 `spacing` 必须保持 0，
///    只有**分组之间**才有空隙 —— 单一 `spacing` 无法同时表达这两件事。
///
/// 所以：分组留白用一个只做 padding 的容器包住下一组，间距取 `Theme.gap-*` 档位
/// （`gap-xs/sm/md/lg` = 4/8/12/16 × ui-scale）。
///
/// ```slint
/// SettingSwitch { label: "A"; }
/// GroupGap { gap: Theme.gap-md; SettingSwitch { label: "B"; } }
/// ```
export component GroupGap {
    /// 与上一组之间的间距。
    in property <length> gap: Theme.gap-md;
    VerticalLayout {
        padding-top: root.gap;
        spacing: 0;
        @children
    }
}
