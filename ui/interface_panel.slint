// Interface settings content (#23 follow-up).
//
// Embedded panel (not a window): it lives inside AppWindow's modal overlay, so
// the settings can't be dragged out of the parent and block input while open —
// while keeping the clean, minimal "label-left · control-right" design.
// Typography is fixed (literal px in the chrome) so it stays compact regardless
// of the global UI scale; only the font-preview reflects the real terminal size.

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { OutputRuleItem, WslProfileInfo } from "settings/types.slint";

import { NavItem } from "settings/chrome.slint";
import { ResetBar } from "settings/reset_bar.slint";
import { TerminalPage } from "settings/pages/terminal.slint";
import { AppearancePage } from "settings/pages/appearance.slint";
import { LayoutPage } from "settings/pages/layout.slint";
import { SyncPage } from "settings/pages/sync.slint";
import { WslPage } from "settings/pages/wsl.slint";
import { TransferPage } from "settings/pages/transfer.slint";
import { UpdatePage } from "settings/pages/update.slint";

// The settings content (nav + pages). Embedded in AppWindow's modal overlay.
export component InterfacePanel inherits Rectangle {
    in property <bool> lang-en;
    in property <bool> is-windows;
    in-out property <string> renderer-mode: "software";
    in property <[string]> term-fonts;
    in property <string> term-font-family;
    in-out property <int> term-font-index: 0;   // picker selection; labels carry a source prefix
    in property <[string]> ui-fonts;        // all font families for UI picker
    in-out property <int> ui-font-index: 0;     // UI font picker selection
    callback set-ui-font(string);            // persist UI font choice
    in property <length> term-font-size;
    in-out property <bool> term-font-bold;
    in-out property <string> term-cursor-style: "block";
    in-out property <string> term-cursor-color-hex: "#D4D4D4";
    in property <color> term-cursor-color: #D4D4D4;
    in-out property <bool> output-highlight-enabled;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    in property <float> ui-scale;
    in-out property <bool> sftp-follow-cd;
    in-out property <bool> collapse-sidebar-default;
    in-out property <bool> collapse-sftp-default;
    in-out property <bool> sync-upload-enabled;
    in-out property <bool> webdav-enabled;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs;
    in-out property <string> webdav-status;
    in-out property <bool> download-always-ask;
    in-out property <bool> welcome-as-sidebar;
    in-out property <bool> quick-commands-as-sidebar;
    in-out property <bool> show-cmd-bar;
    in-out property <bool> update-check-enabled;
    // Manual "check now" button next to the startup toggle (#self-update).
    in property <string> update-check-status;
    in property <bool> update-checking;
    callback check-update-now();
    in-out property <float> wallpaper-overlay;   // frosted-panel opacity 0.30-1.00
    // Active wallpaper id: "" / "builtin:light" / "builtin:dark" / a file path.
    in property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row
    in property <[WslProfileInfo]> wsl-profiles;
    private property <string> wsl-new-name: "WSL";
    private property <string> wsl-new-distribution;
    in-out property <string> wsl-new-directory: "~";

    property <string> ifd-page: "terminal";
    property <string> new-rule-pattern;
    property <bool> new-rule-regex;
    property <bool> new-rule-case-sensitive;
    property <bool> new-rule-whole-line;
    property <string> new-rule-color: "red";
    // 注：`renderer-restart-required` 与 `wp-is-custom` 已随外观页搬进
    // `ui/settings/pages/appearance.slint` —— 它们只被那一页使用，属于页面私有状态。

    callback set-term-font(string);
    callback set-term-font-size(int);
    callback set-term-font-bold(bool);
    callback set-term-cursor-style(string);
    callback set-term-cursor-color(string) -> bool;
    in-out property <string> scrollback-lines: "5000";
    in-out property <bool> large-scrollback;
    property <bool> scrollback-valid: true;
    callback set-scrollback-lines(string) -> bool;
    callback set-large-scrollback(bool);
    in-out property <bool> convert-eol: false;
    callback set-convert-eol(bool);
    in-out property <bool> osc52-clipboard: true;
    callback set-osc52-clipboard(bool);
    callback set-output-highlight(bool, string);
    callback set-json-format-output(bool);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-ui-scale(int);
    callback set-panel-font(int);   // settings-panel font scale, percent
    callback set-renderer-mode(string);
    callback set-sftp-follow-cd(bool);
    callback set-collapse-sidebar-default(bool);
    callback set-collapse-sftp-default(bool);
    callback set-sync-upload-enabled(bool);
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    callback set-download-always-ask(bool);
    callback set-welcome-as-sidebar(bool);
    callback set-quick-commands-as-sidebar(bool);
    callback set-show-cmd-bar(bool);
    callback set-update-check-enabled(bool);   // startup new-version check (#184)
    callback persist-wallpaper-overlay(float);   // save the overlay opacity
    callback set-wallpaper(string);    // none / builtin selection
    in-out property <bool> hide-special-partitions: true;
    callback set-hide-special-partitions(bool);
    in-out property <string> mount-filter: "";
    callback set-mount-filter(string);
    callback pick-wallpaper-file();    // open the OS file dialog (Rust)
    callback add-wsl-profile(string, string, string);
    callback remove-wsl-profile(string);
    callback pick-wsl-directory();
    callback reset-page(string);   // 一键还原本页默认（page-id）
    // 两段式还原确认的 armed 状态**不在这里**：它属于各自的 ResetBar 实例。
    // 曾放在这里（单个 `reset-armed`）导致跨页串味：终端页上膛后切到外观页，
    // 按钮直接显示「确认还原？」，一点就还原了另一页。
    // 动画开关此前只写 Slint 全局、从不持久化；现在同时通知 Rust 存入 config。
    callback set-animations-enabled(bool);

    HorizontalLayout {
        // --- Left nav ------------------------------------------------------
        Rectangle {
            width: 168px;
            // Transparent so the whole dialog is one frosted layer (the card's
            // bg-panel); a 1px divider keeps the nav/content separation (items 6/7).
            background: transparent;
            Rectangle {
                x: parent.width - 1px; width: 1px; height: parent.height;
                background: Theme.border-subtle;
            }
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                alignment: start;
                NavItem {
                    icon: "\u{E8B9}"; label: root.lang-en ? "Terminal" : "终端";
                    active: root.ifd-page == "terminal";
                    clicked => { root.ifd-page = "terminal"; }
                }
                NavItem {
                    icon: "\u{E410}"; label: root.lang-en ? "Appearance" : "外观";
                    active: root.ifd-page == "appearance";
                    clicked => { root.ifd-page = "appearance"; }
                }
                NavItem {
                    icon: "\u{E2C7}"; label: root.lang-en ? "Transfer" : "传输";
                    active: root.ifd-page == "transfer";
                    clicked => { root.ifd-page = "transfer"; }
                }
                NavItem {
                    icon: "\u{E5CB}"; label: root.lang-en ? "Layout" : "布局";
                    active: root.ifd-page == "layout";
                    clicked => { root.ifd-page = "layout"; }
                }
                if root.is-windows : NavItem {
                    icon: "\u{E30A}"; label: "WSL";
                    active: root.ifd-page == "wsl";
                    clicked => { root.ifd-page = "wsl"; }
                }
                NavItem {
                    icon: "\u{E627}"; label: root.lang-en ? "Sync" : "同步";
                    active: root.ifd-page == "sync";
                    clicked => { root.ifd-page = "sync"; }
                }
                NavItem {
                    icon: "\u{E923}"; label: root.lang-en ? "Update check" : "新版本提示";
                    active: root.ifd-page == "update";
                    clicked => { root.ifd-page = "update"; }
                }
            }
        }
        // --- Right content -------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            // Transparent: the card's single bg-panel frost shows through, so the
            // settings panel matches the welcome/resource panels and tracks the
            // wallpaper-opacity slider (items 6/7).
            background: transparent;

            settings-scroll := ScrollView {
                vertical-stretch: 1;
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                // ⚠️ **不要给 `content-height` 赋值**。
                //
                // Slint 自己计算的默认值就是精确的内容高度（实测：终端页 1199px
                // = 最后一项「还原本页默认」的底边；外观页 860px），内容不足一屏时
                // 取可视高度、不滚动 —— 正是"有多少设置项就有多大"。
                //
                // 而 `settings-pages.preferred-height` 拿到的却是**被拉伸后**的
                // 高度（终端页实测 2533px），把它绑到这里等于在末尾凭空多出
                // 1334px 可以滚进去的空白。改 `max(visible, preferred)` 同样错：
                // 那个 preferred 本身就虚高。
                //

                settings-pages := VerticalLayout {
                            width: settings-scroll.visible-width;

                    // --- Font page ---------------------------------------------
                    if root.ifd-page == "terminal" : TerminalPage {
                        convert-eol <=> root.convert-eol;
                        json-format-output <=> root.json-format-output;
                        lang-en: root.lang-en;
                        osc52-clipboard <=> root.osc52-clipboard;
                        output-highlight-enabled <=> root.output-highlight-enabled;
                        output-highlight-preset <=> root.output-highlight-preset;
                        output-highlight-rule-status <=> root.output-highlight-rule-status;
                        output-highlight-rules: root.output-highlight-rules;
                        scrollback-lines <=> root.scrollback-lines;
                        large-scrollback <=> root.large-scrollback;
                        term-cursor-color: root.term-cursor-color;
                        term-cursor-color-hex <=> root.term-cursor-color-hex;
                        term-cursor-style <=> root.term-cursor-style;
                        term-font-bold <=> root.term-font-bold;
                        term-font-index <=> root.term-font-index;
                        term-font-size: root.term-font-size;
                        term-fonts: root.term-fonts;
                        add-output-highlight-rule(a0, a1, a2, a3, a4) => { return root.add-output-highlight-rule(a0, a1, a2, a3, a4); }
                        remove-output-highlight-rule(a0) => { root.remove-output-highlight-rule(a0); }
                        reset-page(a0) => { root.reset-page(a0); }
                        set-convert-eol(a0) => { root.set-convert-eol(a0); }
                        set-json-format-output(a0) => { root.set-json-format-output(a0); }
                        set-osc52-clipboard(a0) => { root.set-osc52-clipboard(a0); }
                        set-output-highlight(a0, a1) => { root.set-output-highlight(a0, a1); }
                        set-output-highlight-rule-enabled(a0, a1) => { root.set-output-highlight-rule-enabled(a0, a1); }
                        set-scrollback-lines(a0) => { return root.set-scrollback-lines(a0); }
                        set-large-scrollback(a0) => { root.set-large-scrollback(a0); }
                        set-term-cursor-color(a0) => { return root.set-term-cursor-color(a0); }
                        set-term-cursor-style(a0) => { root.set-term-cursor-style(a0); }
                        set-term-font(a0) => { root.set-term-font(a0); }
                        set-term-font-bold(a0) => { root.set-term-font-bold(a0); }
                        set-term-font-size(a0) => { root.set-term-font-size(a0); }
                    }
                    if root.ifd-page == "appearance" : AppearancePage {
                            current-wallpaper: root.current-wallpaper;
                            custom-wallpaper-name: root.custom-wallpaper-name;
                            hide-special-partitions <=> root.hide-special-partitions;
                            lang-en: root.lang-en;
                            mount-filter <=> root.mount-filter;
                            renderer-mode <=> root.renderer-mode;
                            ui-font-index <=> root.ui-font-index;
                            ui-fonts: root.ui-fonts;
                            ui-scale: root.ui-scale;
                            wallpaper-overlay <=> root.wallpaper-overlay;
                            persist-wallpaper-overlay(a0) => { root.persist-wallpaper-overlay(a0); }
                            pick-wallpaper-file() => { root.pick-wallpaper-file(); }
                            reset-page(a0) => { root.reset-page(a0); }
                            set-animations-enabled(a0) => { root.set-animations-enabled(a0); }
                            set-hide-special-partitions(a0) => { root.set-hide-special-partitions(a0); }
                            set-mount-filter(a0) => { root.set-mount-filter(a0); }
                            set-panel-font(a0) => { root.set-panel-font(a0); }
                            set-renderer-mode(a0) => { root.set-renderer-mode(a0); }
                            set-ui-font(a0) => { root.set-ui-font(a0); }
                            set-ui-scale(a0) => { root.set-ui-scale(a0); }
                            set-wallpaper(a0) => { root.set-wallpaper(a0); }
                    }

                    if root.ifd-page == "layout" : LayoutPage {
                            show-cmd-bar <=> root.show-cmd-bar;
                            collapse-sftp-default <=> root.collapse-sftp-default;
                            collapse-sidebar-default <=> root.collapse-sidebar-default;
                            lang-en: root.lang-en;
                            quick-commands-as-sidebar <=> root.quick-commands-as-sidebar;
                            welcome-as-sidebar <=> root.welcome-as-sidebar;
                            reset-page(a0) => { root.reset-page(a0); }
                            set-show-cmd-bar(a0) => { root.set-show-cmd-bar(a0); }
                            set-collapse-sftp-default(a0) => { root.set-collapse-sftp-default(a0); }
                            set-collapse-sidebar-default(a0) => { root.set-collapse-sidebar-default(a0); }
                            set-quick-commands-as-sidebar(a0) => { root.set-quick-commands-as-sidebar(a0); }
                            set-welcome-as-sidebar(a0) => { root.set-welcome-as-sidebar(a0); }
                    }

                    if root.ifd-page == "transfer" : TransferPage {
                            download-always-ask <=> root.download-always-ask;
                            lang-en: root.lang-en;
                            sftp-follow-cd <=> root.sftp-follow-cd;
                            reset-page(a0) => { root.reset-page(a0); }
                            set-download-always-ask(a0) => { root.set-download-always-ask(a0); }
                            set-sftp-follow-cd(a0) => { root.set-sftp-follow-cd(a0); }
                    }

                    if root.ifd-page == "wsl" : WslPage {
                            lang-en: root.lang-en;
                            wsl-new-directory <=> root.wsl-new-directory;
                            wsl-new-distribution <=> root.wsl-new-distribution;
                            wsl-new-name <=> root.wsl-new-name;
                            wsl-profiles: root.wsl-profiles;
                            add-wsl-profile(a0, a1, a2) => { root.add-wsl-profile(a0, a1, a2); }
                            pick-wsl-directory() => { root.pick-wsl-directory(); }
                            remove-wsl-profile(a0) => { root.remove-wsl-profile(a0); }
                    }

                    if root.ifd-page == "sync" : SyncPage {
                            lang-en: root.lang-en;
                            sync-upload-enabled <=> root.sync-upload-enabled;
                            webdav-accept-invalid-certs <=> root.webdav-accept-invalid-certs;
                            webdav-enabled <=> root.webdav-enabled;
                            webdav-password <=> root.webdav-password;
                            webdav-remote-path <=> root.webdav-remote-path;
                            webdav-status <=> root.webdav-status;
                            webdav-url <=> root.webdav-url;
                            webdav-username <=> root.webdav-username;
                            save-webdav-settings(a0, a1, a2, a3, a4, a5) => { root.save-webdav-settings(a0, a1, a2, a3, a4, a5); }
                            set-sync-upload-enabled(a0) => { root.set-sync-upload-enabled(a0); }
                            webdav-download() => { root.webdav-download(); }
                            webdav-upload() => { root.webdav-upload(); }
                    }

                    if root.ifd-page == "update" : UpdatePage {
                            lang-en: root.lang-en;
                            update-check-enabled <=> root.update-check-enabled;
                            update-check-status: root.update-check-status;
                            update-checking: root.update-checking;
                            check-update-now() => { root.check-update-now(); }
                            set-update-check-enabled(a0) => { root.set-update-check-enabled(a0); }
                    }

                }

            }
        }
    }
}

