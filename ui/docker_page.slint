//! Docker 页外壳：顶部主机标签 + 左侧六项二级导航 + 内容区。
//!
//! 数据仍由 `src/app/impls/docker/` 通过现有 SSH exec 拉取；本文件只负责排版
//! 与页面路由。六个功能页全部绝对定位在 `stage` 里用 `visible` 切换 ——
//! Slint 的 `visible:false` 不释放布局空间，做成布局子项会留白；绝对定位既
//! 没有留白，也能保住容器 ListView 的实例与滚动位置（避免 #323/#343 那类
//! 在事件派发栈上销毁子树的闪退）。

import { Theme, AnimationSettings } from "theme.slint";
import { IconText } from "components/text.slint";
import { StateSurface } from "components/interactive.slint";
import {
    DockerHostTab, DockerContainer,
    DockerImage, DockerComposeRow, DockerNetworkRow, RegistryRepoRow,
} from "docker_parts/types.slint";
import { DockerHostTabs } from "docker_parts/host_tabs.slint";
import { DockerSideNav } from "docker_parts/side_nav.slint";
import { DockerOverviewPage } from "docker_parts/overview.slint";
import { DockerContainersPage } from "docker_parts/containers.slint";
import { DockerComposePage } from "docker_parts/compose_page.slint";
import { DockerImagesPage } from "docker_parts/images_page.slint";
import { DockerNetworksPage } from "docker_parts/networks_page.slint";
import { DockerRegistryPage } from "docker_parts/registry_page.slint";
import { DockerHostWelcome } from "docker_parts/host_welcome.slint";
import { DockerCredentialsDialog } from "docker_parts/credentials.slint";
import { SessionInfo } from "welcome_rows.slint";

// `app.slint` 仍从本文件取类型，保持原有 import 不变。
export {
    DockerHostTab, DockerContainer, DockerOverviewStats,
    DockerImage, DockerComposeRow, DockerNetworkRow, RegistryRepoRow,
} from "docker_parts/types.slint";

export component DockerPage inherits Rectangle {
    in property <[DockerContainer]> containers;
    in property <[DockerHostTab]> hosts;
    in property <string> active-host;
    /// idle / loading / ok / empty / error / disconnected / no-session
    in property <string> page-status: "idle";
    in property <string> error-text;
    in property <string> summary;
    in property <bool> page-visible: false;
    in property <string> pending-id;
    in property <string> action-text;
    in property <bool> action-error: false;
    in-out property <string> filter-text;

    /// 当前二级页：overview / containers / compose / images / registries / networks。
    in-out property <string> section: "overview";
    changed section => { root.section-changed(root.section); }

    // ---- 四个功能页的数据（Rust 侧填充，Slint 只读渲染）----------------
    in property <[DockerImage]> image-list;
    /// idle / loading / ok / empty / error
    in property <string> image-status: "idle";
    in property <string> image-error;

    in property <[DockerComposeRow]> compose-list;
    in property <string> compose-status: "idle";
    in property <string> compose-error;

    in property <[DockerNetworkRow]> network-list;
    in property <string> network-status: "idle";
    in property <string> network-error;

    in property <[RegistryRepoRow]> registry-list;
    in property <string> registry-status: "idle";
    in property <string> registry-error;
    in property <string> registry-page-label;
    in property <bool> registry-prev-enabled: false;
    in property <bool> registry-next-enabled: false;
    /// 用户是否已经发起过搜索（未搜索时显示引导文案）。
    in property <bool> registry-searched: false;

    // 概览页统计；-1 = 尚未采集（界面显示破折号）。
    in property <int> running: -1;
    in property <int> stopped: -1;
    in property <int> images: -1;
    in property <int> networks: -1;
    in property <int> compose-projects: -1;

    /// running / stopped / unknown
    in property <string> service-state: "unknown";
    in property <bool> service-pending: false;
    in property <string> service-location;
    in property <string> service-autostart;
    in property <string> version;

    in property <string> cpu-path;
    in property <string> mem-path;
    in property <string> net-up-path;
    in property <string> net-down-path;
    in property <bool> stats-ready: false;
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <string> net-top-up;
    in property <string> net-top-down;

    /// 欢迎页的已保存 SSH 会话（Rust 侧已过滤本地 shell / 串口 / Telnet）。
    in property <[SessionInfo]> sessions;
    in property <string> search-query;

    /// Docker 不可用阻塞弹窗；kind 为空表示不显示。
    in property <string> blocker-kind;
    in property <string> blocker-host;
    in property <string> blocker-title;
    in property <string> blocker-detail;
    in property <string> blocker-session;

    /// 当前主机的代表会话 id（概览页凭据入口用）。
    in property <string> active-session;
    /// 当前主机的 Docker 权限状态，Rust 侧已翻译。
    in property <string> permission-text;

    /// 提权凭据弹窗。
    in property <bool> cred-open: false;
    in property <string> cred-session;
    in property <string> cred-host;
    in property <string> cred-mode;
    in property <string> cred-user;
    in property <bool> cred-has-password: false;
    in property <bool> cred-testing: false;
    in property <string> cred-test-text;
    in property <bool> cred-test-ok: false;

    callback refresh();              // 定时器用：尊重新鲜度
    callback refresh-now();          // 按钮 / 重试用：强制刷新
    callback switch-host(string);
    callback close-host(string);
    callback select-welcome();
    callback open-saved-session(string);
    callback toggle-group(string);
    callback filter-changed(string);
    callback section-changed(string);
    callback compose-filter-changed(string);
    callback image-filter-changed(string);
    callback refresh-images();
    callback refresh-compose();
    callback refresh-networks();
    callback refresh-registry();
    callback registry-search(string);
    callback registry-page-prev();
    callback registry-page-next();
    callback action(string /* container id */, int /* 0=start 1=stop 2=restart 3=remove */);
    callback open-logs(string);
    callback open-terminal(string);
    /// 复制容器短 ID（12 位）。
    callback copy-id(string);
    /// 复制容器名。
    callback copy-name(string);
    /// 打开端口映射窗口。
    callback open-ports(string);
    callback toggle-service(bool);
    callback blocker-terminal();
    callback blocker-settings();
    callback blocker-retry();
    callback blocker-dismiss();
    callback configure-credentials(string /* session id */);
    callback save-credentials(string, string, string, string);
    callback test-credentials(string, string, string, string);
    callback clear-credentials(string);
    callback dismiss-credentials();

    private property <string> confirm-remove-id;
    property <bool> on-welcome: root.active-host == "";

    changed on-welcome => {
        if (root.on-welcome) {
            root.confirm-remove-id = "";
        }
    }

    background: Theme.bg-root;

    // 切页 / 切主机时把搜索框的焦点挪走，避免光标停在不可见页。
    blur-sink := FocusScope {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
    }

    function blur-search() {
        blur-sink.focus();
    }

    // 刷新由 Rust 侧 500ms 定时器统一驱动（曲线跟快照、容器列表 10s 节流），
    // Slint 侧不再持有轮询定时器，避免两套节奏。

    VerticalLayout {
        spacing: 0;

        DockerHostTabs {
            hosts: root.hosts;
            active-host: root.active-host;
            welcome-active: root.on-welcome;
            show-refresh: root.page-status != "no-session" && !root.on-welcome;
            switch-host(key) => { root.blur-search(); root.switch-host(key); }
            close-host(key) => { root.close-host(key); }
            select-welcome => { root.select-welcome(); }
            refresh-now => { root.refresh-now(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 0px;
            // 欢迎态下整块管理界面（二级导航 + 内容区）不渲染：覆盖层是半透明
            // 壁纸底色，靠它遮挡会透出下面的页面。`visible` 不销毁实例，
            // 关最后一个标签发生在点击回调里，也不会踩 #323/#343。
            visible: !root.on-welcome;

            DockerSideNav {
                current: root.section;
                selected(s) => {
                    root.blur-search();
                    root.section = s;
                }
            }

            stage := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                background: Theme.bg-root;

                DockerOverviewPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "overview";

                    running: root.running;
                    stopped: root.stopped;
                    images: root.images;
                    networks: root.networks;
                    compose-projects: root.compose-projects;
                    service-state: root.service-state;
                    service-pending: root.service-pending;
                    service-location: root.service-location;
                    service-autostart: root.service-autostart;
                    docker-version: root.version;
                    permission-text: root.permission-text;
                    configure-credentials => { root.configure-credentials(root.active-session); }
                    page-status: root.page-status;
                    cpu-path: root.cpu-path;
                    mem-path: root.mem-path;
                    net-up-path: root.net-up-path;
                    net-down-path: root.net-down-path;
                    stats-ready: root.stats-ready;
                    cpu-percent: root.cpu-percent;
                    mem-percent: root.mem-percent;
                    net-top-up: root.net-top-up;
                    net-top-down: root.net-top-down;
                    toggle-service(on) => { root.toggle-service(on); }
                }

                DockerContainersPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "containers";

                    containers: root.containers;
                    page-status: root.page-status;
                    error-text: root.error-text;
                    summary: root.summary;
                    pending-id: root.pending-id;
                    filter-text: root.filter-text;
                    refresh-now => { root.refresh-now(); }
                    filter-changed(text) => { root.filter-changed(text); }
                    action(id, kind) => { root.action(id, kind); }
                    open-logs(id) => { root.open-logs(id); }
                    open-terminal(id) => { root.open-terminal(id); }
                    copy-id(id) => { root.copy-id(id); }
                    copy-name(name) => { root.copy-name(name); }
                    open-ports(id) => { root.open-ports(id); }
                    request-remove(id) => { root.confirm-remove-id = id; }
                }

                DockerComposePage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "compose";
                    rows: root.compose-list;
                    status: root.compose-status;
                    error-text: root.compose-error;
                    filter-changed(text) => { root.compose-filter-changed(text); }
                    refresh() => { root.refresh-compose(); }
                    add() => {}
                    action(id) => {}
                }
                DockerImagesPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "images";
                    rows: root.image-list;
                    status: root.image-status;
                    error-text: root.image-error;
                    filter-changed(text) => { root.image-filter-changed(text); }
                    refresh() => { root.refresh-images(); }
                    add() => {}
                    action(id) => {}
                }
                DockerNetworksPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "networks";
                    rows: root.network-list;
                    status: root.network-status;
                    error-text: root.network-error;
                    refresh() => { root.refresh-networks(); }
                    add() => {}
                    action(name) => {}
                    toggle(name) => {}
                }
                DockerRegistryPage {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.section == "registries";
                    rows: root.registry-list;
                    status: root.registry-status;
                    error-text: root.registry-error;
                    page-label: root.registry-page-label;
                    prev-enabled: root.registry-prev-enabled;
                    next-enabled: root.registry-next-enabled;
                    searched: root.registry-searched;
                    search(query) => { root.registry-search(query); }
                    refresh() => { root.refresh-registry(); }
                    settings() => {}
                    page-prev() => { root.registry-page-prev(); }
                    page-next() => { root.registry-page-next(); }
                }

                // --- 操作结果提示（浮层，相对内容区，不挤压列表）------------
                if root.action-text != "" : Rectangle {
                    x: parent.width - self.width - Theme.sp-20;
                    y: parent.height - self.height - Theme.sp-20;
                    width: min(420px * Theme.ui-zoom, parent.width - 40px * Theme.ui-zoom);
                    height: 32px * Theme.ui-zoom;
                    border-radius: Theme.radius-md;
                    background: Theme.bg-panel;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        padding-left: Theme.sp-10;
                        padding-right: Theme.sp-10;
                        spacing: Theme.sp-8;
                        IconText {
                            text: root.action-error ? "\u{E002}" : "\u{E5CA}";
                            color: root.action-error ? Theme.danger : Theme.success;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.action-text;
                            font-size: Theme.fs-xs;
                            color: root.action-error ? Theme.danger : Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // --- 欢迎页（覆盖层，跳过顶部标签栏）-------------------------------
    // 不用 `if` 销毁主体：关闭最后一个标签发生在点击回调里，销毁子树会踩
    // #323/#343 的闪退红线；这里只切换可见性并保留 stage 实例。
    DockerHostWelcome {
        x: 0px;
        y: Theme.tabbar-h;
        width: parent.width;
        height: parent.height - Theme.tabbar-h;
        visible: root.on-welcome;
        sessions: root.sessions;
        search-query: root.search-query;
        open-saved-session(id) => { root.open-saved-session(id); }
        toggle-group(group) => { root.toggle-group(group); }
        configure-credentials(id) => { root.configure-credentials(id); }
    }

    // --- 提权凭据弹窗（用户动作触发，可安全用 if）------------------------
    if root.cred-open : DockerCredentialsDialog {
        width: parent.width;
        height: parent.height;
        host-label: root.cred-host;
        mode: root.cred-mode;
        target-user: root.cred-user;
        has-password: root.cred-has-password;
        testing: root.cred-testing;
        test-text: root.cred-test-text;
        test-ok: root.cred-test-ok;
        save(mode, user, password) => {
            root.save-credentials(root.cred-session, mode, user, password);
        }
        test(mode, user, password) => {
            root.test-credentials(root.cred-session, mode, user, password);
        }
        clear => { root.clear-credentials(root.cred-session); }
        dismiss => { root.dismiss-credentials(); }
    }

    // --- 删除确认（整页模态：覆盖标签栏与二级导航）----------------------
    if root.confirm-remove-id != "" : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000066;
        TouchArea { clicked => { root.confirm-remove-id = ""; } }
        Rectangle {
            width: 360px * Theme.ui-zoom;
            height: 150px * Theme.ui-zoom;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            VerticalLayout {
                padding: Theme.sp-16; spacing: Theme.sp-10;
                Text { text: @tr("Remove container?"); font-size: Theme.fs-md; color: Theme.text-primary; font-weight: 600; }
                Text { text: @tr("Running containers are stopped first. Volumes are not removed."); font-size: Theme.fs-xs; color: Theme.text-secondary; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: Theme.sp-8; alignment: end;
                    StateSurface {
                        width: 80px * Theme.ui-zoom; height: 28px * Theme.ui-zoom; radius: Theme.radius-sm;
                        clicked => { root.confirm-remove-id = ""; }
                        Text { text: @tr("Cancel"); font-size: Theme.fs-xs; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    StateSurface {
                        width: 80px * Theme.ui-zoom; height: 28px * Theme.ui-zoom; radius: Theme.radius-sm;
                        clicked => { root.action(root.confirm-remove-id, 3); root.confirm-remove-id = ""; }
                        Text { text: @tr("Remove"); font-size: Theme.fs-xs; color: Theme.danger; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // --- Docker 不可用（未安装 / 无权限 / daemon 未运行 / 连接失败）------
    if root.blocker-kind != "" : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000066;
        TouchArea { clicked => { root.blocker-dismiss(); } }
        Rectangle {
            width: 440px * Theme.ui-zoom;
            height: 230px * Theme.ui-zoom;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: Theme.sp-20;
                spacing: Theme.sp-12;

                HorizontalLayout {
                    spacing: Theme.sp-10;
                    IconText {
                        text: "\u{E002}";
                        color: Theme.danger;
                        font-size: Theme.fs-lg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("Docker is unavailable");
                        font-size: Theme.fs-md;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    StateSurface {
                        width: 26px * Theme.ui-zoom;
                        height: 26px * Theme.ui-zoom;
                        radius: Theme.radius-sm;
                        clicked => { root.blocker-dismiss(); }
                        IconText { text: "\u{E5CD}"; color: Theme.text-secondary; font-size: Theme.fs-sm; centered: true; }
                    }
                }
                if root.blocker-title != "" : Text {
                    text: root.blocker-title;
                    font-size: Theme.fs-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.blocker-detail;
                    font-size: Theme.fs-xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    alignment: end;
                    StateSurface {
                        width: 100px * Theme.ui-zoom; height: 30px * Theme.ui-zoom; radius: Theme.radius-sm;
                        clicked => { root.blocker-terminal(); }
                        Text { text: @tr("Open terminal"); font-size: Theme.fs-xs; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    StateSurface {
                        width: 130px * Theme.ui-zoom; height: 30px * Theme.ui-zoom; radius: Theme.radius-sm;
                        clicked => { root.blocker-settings(); }
                        Text { text: @tr("Docker settings"); font-size: Theme.fs-xs; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    StateSurface {
                        width: 80px * Theme.ui-zoom; height: 30px * Theme.ui-zoom; radius: Theme.radius-sm;
                        clicked => { root.blocker-retry(); }
                        Text { text: @tr("Retry"); font-size: Theme.fs-xs; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
