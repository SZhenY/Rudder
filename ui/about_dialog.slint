//! **关于**弹窗：应用版本 + 开源库清单 + GitHub 链接。
//!
//! 常驻遮罩（`opacity` 淡入淡出，`visible` 跟随 `opacity > 0.001`），不是 `if` 包裹 ——
//! 所以调用点不做判断，只透传状态；关闭上抛 `close-requested()`。

import { AnimationSettings } from "theme.slint";
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { GroupGap } from "components/surfaces.slint";
import { Sidebar, DiskInfo } from "sidebar.slint";
import { TabBar, TabInfo } from "tabs.slint";
import { Welcome, SessionInfo } from "welcome.slint";
import { SessionDialog, SessionDraft, PortFwd, TriggerDraft } from "session_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { LabeledInput, PrimaryButton, GhostButton, ToolStrip, IconButton } from "widgets.slint";
import { TerminalView, TermSpan, TermMatch, QuickCmd, QuickDockPanel } from "terminal_view.slint";
import { SftpEntry, SftpTreeNode, TunnelInfo } from "sftp_panel.slint";
import { ProcWindow, ProcRow } from "proc_window.slint";
import { SystemInfoWindow, SysInfoRow, SysMetricRow, SysNetRow } from "system_info_window.slint";
import { InterfacePanel } from "interface_panel.slint";
import { OutputRuleItem, WslProfileInfo } from "settings/types.slint";
import { LineEdit, Button, ScrollView, CheckBox, Palette, ListView } from "std-widgets.slint";
import { Divider, VDivider, FieldLabel } from "components/surfaces.slint";
import { CloseButton } from "components/buttons.slint";
import { ModalCard } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { Label } from "components/text.slint";
import { WindowTitleBar } from "components/window_shell.slint";
import { UpdateBanner } from "update_banner.slint";
import { EditorFindResult, FileEditor } from "file_editor.slint";
import { QuickCmdManageDialog } from "quick_cmd_manage.slint";
import { GroupDialog } from "group_dialog.slint";
import { QuickGroupDialog } from "quick_group_dialog.slint";
import { SftpPromptDialog } from "sftp_prompt_dialog.slint";
import { ConfirmCloseDialog } from "confirm_close_dialog.slint";
import { ChmodDialog } from "chmod_dialog.slint";
import { DownloadManagerPopup, TransferInfo } from "download_manager.slint";
import { SettingsMenuPopup } from "settings_menu.slint";

export component AboutDialog inherits Rectangle {
    width: avail-width;
    height: avail-height;

    // ── 状态（窗口透传）──────────────────────────────────────────────
    in property <length> avail-width: 100000px;
    in property <length> avail-height: 100000px;
    in property <bool> about-open: false;
    in property <[string]> about-libs;
    in property <string> app-version;

    // ── 动作 ──────────────────────────────────────────────────────────
    callback close-requested();
    callback open-repo();

    // 淡入淡出：常驻 + opacity 过渡，visible 跟随 opacity——淡出动画
    // 走完才真正隐藏（复用 confirm_dialog 的样板）。
    visible: self.opacity > 0.001;
    opacity: about-open ? 1 : 0;
    animate opacity {
        duration: 180ms;
        easing: AnimationSettings.color();
        enabled: AnimationSettings.enabled;
    }
    background: #00000080;            // dim backdrop
    TouchArea {
        enabled: about-open;     // 隐藏期间禁命中
        clicked => { root.close-requested(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2
            + (about-open ? 0px : 12px);       // 进入上浮 / 退出下坠
        width: 540px;
        height: min(440px, parent.height - 40px);
        background: Theme.bg-panel;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.card-shadow-blur;
        drop-shadow-color: Theme.card-shadow-color;
        animate y {
            duration: 200ms;
            easing: AnimationSettings.layout();
            enabled: AnimationSettings.enabled;
        }

        // Swallow clicks inside the card
        TouchArea { enabled: about-open; }

        // Close (×) button
        CloseButton {
            x: parent.width - 30px; y: 8px;
            glyph-size: Theme.fs-sm;
            clicked => { root.close-requested(); }
        }

        VerticalLayout {
            padding: 24px;
            padding-bottom: 16px;
            spacing: 0px;

            // --- Top row: logo + info ---
            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 76px; height: 76px;
                    }
                }
                VerticalLayout {
                    spacing: 7px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start; spacing: 8px;
                        Text {
                            text: "Rudder";
                            color: Theme.text-primary;
                            font-size: 22px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {                       // 版本 pill 徽章
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-panel-alt;
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 7px;
                                Text {
                                    text: "v" + app-version;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: @tr("Rudder — a lightweight Rust + Slint SSH client");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Forked from yituorou/meatshell");
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: start; spacing: 6px;
                        Text {
                            text: @tr("Open source");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            border-radius: Theme.radius-sm;
                            background: repo-ta.has-hover ? Theme.bg-hover : transparent;
                            HorizontalLayout {
                                padding-left: 4px; padding-right: 4px;
                                Text {
                                    text: "github.com/SZhenY/Rudder";
                                    color: Theme.accent;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                            }
                            repo-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-repo(); }
                            }
                        }
                    }
                    Text {
                        text: "MIT / Apache-2.0";
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                    }
                }
            }

            // --- Divider + open-source library versions ---
            if about-libs.length > 0 : Rectangle {
                height: 1px;
                background: Theme.border-strong;
            }
            if about-libs.length > 0 : ListView {
                // ListView virtualizes: only visible rows are instantiated,
                // and it provides its own scrollbar. `vertical-stretch`
                // makes it fill the remaining space below the intro, so the
                // About card never overflows regardless of UI font size.
                vertical-stretch: 1;
                min-height: 0px;
                for lib[i] in about-libs : Rectangle {
                    min-height: 26px;      // 依赖行距：不再密集
                    Text {
                        text: lib;
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;   // fs-xs -> fs-sm
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
