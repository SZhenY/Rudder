//! macOS 下给原生交通灯让位的**留白条**。
//!
//! 双击最大化由应用侧接管：全尺寸内容视图下 AppKit 的 `zoom:` 不一定会触发，
//! 而 `win-maximize-toggle` 只挂在 Windows/Linux 的自绘标题栏上。
//! 拖动仍按「位移超过 6px 才交给系统」处理，避免按下即 drag 吃掉双击。

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";

export component TitlebarInsetStrip inherits Rectangle {
    // ── 状态（窗口 / 父布局透传）─────────────────────────────────────
    in property <length> titlebar-inset;   // 默认值原本引用窗口属性，改由调用点传入

    // ── 动作（由调用点转发，实现仍在 Rust / 窗口）──────────────────
    callback drag();
    callback zoom-toggle();

    height: titlebar-inset;
    background: Theme.bg-panel;

    tb := TouchArea {
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> armed: false;

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                press-x = self.mouse-x;
                press-y = self.mouse-y;
                armed = true;
            } else if (e.kind == PointerEventKind.up) {
                armed = false;
            }
        }
        moved => {
            if (self.pressed && armed
                && (abs(self.mouse-x - press-x) > 6px * Theme.ui-scale
                    || abs(self.mouse-y - press-y) > 6px * Theme.ui-scale)) {
                armed = false;
                root.drag();
            }
        }
        double-clicked => { root.zoom-toggle(); }
    }
}
