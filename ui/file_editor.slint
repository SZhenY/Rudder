//! 内置**文件查看 / 编辑**浮层（#70）：View 只读可复制；Edit 可写，Ctrl+S 或 Save 按钮
//! 上传，关闭时若未保存会先上传。遮罩点击不关闭（避免误丢编辑），滚轮事件被吞掉、
//! 不泄漏给下面的终端。
//!
//! 从 `app.slint` 拆出（P4 B 类）。接口分三档：
//! * **状态** —— Rust 真正读写的 9 项：3 个 `in`（只读）+ 6 个 `in-out`（组件内也会改，
//!   与 `TextInput` 双向绑定或记录脏标记/找词进度）；
//! * **动作** —— 6 个 callback，实现在 Rust（`sftp_callbacks.rs`），调用点转发；
//! * **私有状态** —— 13 项拖拽/缩放几何与焦点标记，窗口从不访问，随块搬入并标 `private`。
//! `EditorFindResult` 是找词回调的返回类型，随组件搬入原文件转出口。

import { AnimationSettings } from "theme.slint";
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/MaterialIcons-Regular.ttf";
import { Theme } from "theme.slint";
import { GroupGap } from "components/surfaces.slint";
import { Sidebar, DiskInfo } from "sidebar.slint";
import { TabBar, TabInfo } from "tabs.slint";
import { Welcome, SessionInfo } from "welcome.slint";
import { SessionDialog, SessionDraft, PortFwd, TriggerDraft } from "session_dialog.slint";
import { ConfirmDialog } from "confirm_dialog.slint";
import { LabeledInput, PrimaryButton, GhostButton, ToolStrip, IconButton } from "widgets.slint";
import { TerminalView, TermSpan, TermMatch, QuickCmd, QuickDockPanel } from "terminal_view.slint";
import { SftpEntry, SftpTreeNode, TunnelInfo } from "sftp_panel.slint";
import { ProcWindow, ProcRow } from "proc_window.slint";
import { SystemInfoWindow, SysInfoRow, SysMetricRow, SysNetRow } from "system_info_window.slint";
import { InterfacePanel } from "interface_panel.slint";
import { OutputRuleItem, WslProfileInfo } from "settings/types.slint";
import { LineEdit, Button, ScrollView, CheckBox, Palette, ListView } from "std-widgets.slint";
import { Divider, VDivider, FieldLabel } from "components/surfaces.slint";
import { CloseButton } from "components/buttons.slint";
import { ModalCard } from "components/surfaces.slint";
import { IconText } from "components/text.slint";
import { Label } from "components/text.slint";
import { WindowTitleBar } from "components/window_shell.slint";

// match count (so the bar can show "3" even when the query no longer matches).
export struct EditorFindResult {
    start: int,
    end: int,
    count: int,
}

export component FileEditor inherits Rectangle {
    // 显隐由调用点控制：**常驻**，不用 `if` 包着 —— 在事件派发栈上销毁
    // 正在处理事件的子树会闪退（#323/#343）。关闭时不绘制也不参与命中。
    in property <bool> open: false;
    visible: open;
    // ── 状态：Rust 侧读写，由窗口透传。带 `<=>` 的是**双向**（组件内也会改）──
    in property <string> editor-name: "";
    in property <bool> editor-readonly: false;
    in property <string> editor-line-numbers: "";
    in-out property <string> editor-content: "";       // 与输入框双向绑定
    in-out property <string> editor-find-query: "";
    in-out property <string> editor-replace-text: "";
    in-out property <bool> editor-dirty: false;        // 编辑过 → 关闭前先上传
    in-out property <int> editor-match-count: 0;
    in-out property <int> editor-find-position: -1;

    // ── 动作：实现在 Rust（`sftp_callbacks.rs`），调用点转发 ────────────────
    callback save-file();                     // Ctrl+S / Save button (edit only)
    callback close-editor();                  // X / Esc; uploads if dirty
    callback editor-recount(string);          // rebuild line numbers after an edit
    callback editor-count-matches(string /* content */, string /* query */) -> int;
    callback editor-find-step(string /* content */, string /* query */, int /* current */, bool /* reverse */) -> EditorFindResult;
    callback editor-replace-all(string /* query */, string /* replacement */);

    // ── 块内私有状态（窗口从不访问）：随块搬进来并标 `private`，不进公共面 ──
    private property <bool> editor-focus-pending: false;
    private property <length> ed-w: 760px;
    private property <length> ed-h: 560px;
    private property <length> ed-x: (root.width - ed-w) / 2;
    private property <length> ed-y: (root.height - ed-h) / 2;
    private property <bool> ed-dragging;
    private property <bool> ed-resizing;
    private property <length> ed-base-x;
    private property <length> ed-base-y;
    private property <length> ed-base-w;
    private property <length> ed-base-h;
    private property <length> ed-grab-x;
    private property <length> ed-grab-y;

    // Modal backdrop; clicking it does NOT close (avoids losing edits to a
    // stray click) — use the close button or Esc. Also swallow wheel events
    // so scrolling can't leak through to the terminal underneath (#70).
    background: #00000088;
    TouchArea {
        scroll-event(event) => { accept }
    }
    edit-fs := FocusScope {
        // Ctrl+S saves, Esc closes. These bubble up from the focused
        // TextInput because it doesn't consume them.
        key-pressed(e) => {
            // ⌘S on macOS, Ctrl+S elsewhere. (Slint maps `control` to Cmd on
            // macOS — see #158, so no platform branch is needed here.) On macOS
            // Cmd+letter arrives as the C0 control char (Cmd+S = "\u{13}"), not
            // "s" — confirmed on an M4 — so accept both forms (#158).
            if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{0013}")) {
                root.save-file();
                return accept;
            }
            if (e.text == Key.Escape) {
                root.close-editor();
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: ed-x;
            y: ed-y;
            width: ed-w;
            height: ed-h;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.shadow-raised-blur;
            drop-shadow-color: Theme.shadow-raised-color;
            clip: true;

            VerticalLayout {
                // Title bar — drag to move; the buttons stay on top.
                Rectangle {
                    height: 40px;
                    background: Theme.bg-panel-alt;
                    ed-title-drag := TouchArea {
                        mouse-cursor: move;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                ed-dragging = true;
                                ed-base-x = ed-x;
                                ed-base-y = ed-y;
                                ed-grab-x = self.absolute-position.x + self.mouse-x;
                                ed-grab-y = self.absolute-position.y + self.mouse-y;
                            } else if (e.kind == PointerEventKind.up) {
                                ed-dragging = false;
                            }
                        }
                        moved => {
                            if (ed-dragging) {
                                ed-x = ed-base-x + (self.absolute-position.x + self.mouse-x - ed-grab-x);
                                ed-y = ed-base-y + (self.absolute-position.y + self.mouse-y - ed-grab-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        // Centre the 28px buttons inside the 40px bar so the
                        // Save button isn't glued to the top edge (#70).
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        Label {
                            text: editor-name
                                + (editor-readonly
                                    ? "  ·  " + @tr("Read-only")
                                    : (editor-dirty ? "  ·  " + @tr("Modified") : ""));
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if !editor-readonly : Rectangle {
                            width: 76px; height: 28px;
                            border-radius: Theme.radius-sm;
                            background: ed-save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            ed-save-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.save-file(); }
                            }
                            Text { text: @tr("Save"); color: #ffffff; font-size: Theme.fs-sm;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        CloseButton {
                            size: 28px;
                            clicked => { root.close-editor(); }
                        }
                    }
                }
                Divider {}

                // Lightweight find/replace bar (#287). Replacement is
                // explicit; closing the editor never writes the file.
                Rectangle {
                    height: 38px;
                    background: Theme.bg-elevated;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        padding-top: 5px; padding-bottom: 5px; spacing: 6px;
                        Text { text: @tr("Find"); color: Theme.text-muted; vertical-alignment: center; }
                        TextInput {
                            input-method-hints: Theme.plain-input-hints;
                            horizontal-stretch: 1;
                            single-line: true;
                            text <=> editor-find-query;
                            edited => {
                                editor-find-position = -1;
                                editor-match-count = root.editor-count-matches(
                                    editor-content, editor-find-query);
                            }
                        }
                        Text {
                            width: 42px;
                            text: editor-find-query == "" ? "" : editor-match-count;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            width: 28px;
                            border-radius: Theme.radius-sm;
                            background: find-prev-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            find-prev-ta := TouchArea {
                                enabled: editor-match-count > 0;
                                clicked => {
                                    let found = root.editor-find-step(editor-content,
                                        editor-find-query, editor-find-position, true);
                                    editor-find-position = found.start;
                                    editor-match-count = found.count;
                                    edit-input.set-selection-offsets(found.start, found.end);
                                    edit-input.focus();
                                }
                            }
                            Text { text: "↑"; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 28px;
                            border-radius: Theme.radius-sm;
                            background: find-next-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            find-next-ta := TouchArea {
                                enabled: editor-match-count > 0;
                                clicked => {
                                    let found = root.editor-find-step(editor-content,
                                        editor-find-query, editor-find-position, false);
                                    editor-find-position = found.start;
                                    editor-match-count = found.count;
                                    edit-input.set-selection-offsets(found.start, found.end);
                                    edit-input.focus();
                                }
                            }
                            Text { text: "↓"; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: @tr("Replace"); color: Theme.text-muted; vertical-alignment: center; }
                        TextInput {
                            input-method-hints: Theme.plain-input-hints;
                            horizontal-stretch: 1;
                            single-line: true;
                            text <=> editor-replace-text;
                        }
                        Rectangle {
                            width: 88px;
                            border-radius: Theme.radius-sm;
                            background: replace-all-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            replace-all-ta := TouchArea {
                                enabled: !editor-readonly && editor-find-query != "";
                                clicked => {
                                    root.editor-replace-all(editor-find-query, editor-replace-text);
                                }
                            }
                            Text {
                                text: @tr("Replace all");
                                color: replace-all-ta.enabled ? Theme.text-primary : Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Divider {}

                // Text area: a line-number gutter on the left + the editor.
                // word-wrap is OFF so one logical line == one display line and
                // the numbers line up (long lines scroll horizontally); the
                // gutter is pinned horizontally but tracks the editor's
                // vertical scroll via ed-scroll.content-y (#81).
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle {
                            width: 48px;
                            background: Theme.bg-panel-alt;
                            clip: true;
                            Label {
                                x: 0;
                                y: ed-scroll.content-y + 8px;
                                width: parent.width - 6px;
                                text: editor-line-numbers;
                                horizontal-alignment: right;
                                font-size: Theme.fs-md;
                                color: Theme.text-muted;
                            }
                        }
                        VDivider {}
                        // Clip the editing area so text and selection
                        // painting cannot spill past the panel edge (#387).
                        editor-viewport := Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            ed-scroll := ScrollView {
                                content-width: max(self.visible-width, edit-input.preferred-width + 16px);
                                content-height: max(self.visible-height, edit-input.preferred-height + 16px);
                                edit-input := TextInput {
                                    input-method-hints: Theme.plain-input-hints;
                                    x: 8px;
                                    y: 8px;
                                    width: max(parent.visible-width - 16px, self.preferred-width);
                                    height: self.preferred-height;
                                    text <=> editor-content;
                                    read-only: editor-readonly;
                                    single-line: false;
                                    // Wrapping stays OFF: one logical line
                                    // == one display line, so the gutter
                                    // numbers line up (#81).
                                    wrap: no-wrap;
                                    color: Theme.text-primary;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.fs-md;
                                    edited => { editor-dirty = true; root.editor-recount(editor-content); }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom-right resize grip (#70).
            Rectangle {
                x: parent.width - 18px;
                y: parent.height - 18px;
                width: 18px;
                height: 18px;
                ed-resize-ta := TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            ed-resizing = true;
                            ed-base-w = ed-w;
                            ed-base-h = ed-h;
                            ed-grab-x = self.absolute-position.x + self.mouse-x;
                            ed-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            ed-resizing = false;
                        }
                    }
                    moved => {
                        if (ed-resizing) {
                            ed-w = max(420px, ed-base-w + (self.absolute-position.x + self.mouse-x - ed-grab-x));
                            ed-h = max(280px, ed-base-h + (self.absolute-position.y + self.mouse-y - ed-grab-y));
                        }
                    }
                }
                // 原来是一个 "◢" 字形 —— 部分系统 / 字体下会画成豆腐块（上游 0be0b43）。
                // 换成三条阶梯矩形，任何字体下都成立，右下角观感不变。
                Rectangle {
                    x: parent.width - 6px;
                    y: parent.height - 3px;
                    width: 3px;
                    height: 3px;
                    background: ed-resize-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                }
                Rectangle {
                    x: parent.width - 11px;
                    y: parent.height - 7px;
                    width: 3px;
                    height: 7px;
                    background: ed-resize-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                }
                Rectangle {
                    x: parent.width - 16px;
                    y: parent.height - 11px;
                    width: 3px;
                    height: 11px;
                    background: ed-resize-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                }
            }
        }
        // Defer focus to the next event-loop tick. Focusing straight from
        // init re-enters Slint's accessibility adapter while it is still
        // registering the editor's new item tree, which panics with
        // "RefCell already borrowed" on Windows (#386). Same pattern as
        // TerminalView's focus-defer-timer.
        init => { editor-focus-pending = true; }
        editor-focus-timer := Timer {
            interval: 0ms;
            running: editor-focus-pending;
            triggered => {
                if (editor-focus-pending) {
                    edit-input.focus();
                    editor-focus-pending = false;
                }
            }
        }
    }
}
