//! 终端视图的**附属部件**：快捷命令 chips 面板 + 右键菜单行 + `QuickCmd` 结构体。
//!
//! 从 `terminal_view.slint` 拆出（P4）：三块都只通过 `in property` / `callback`
//! 与 `TerminalView` 通信，属逐字搬运（`component` → `export component`；
//! `QuickCmd` 与 `QuickDockPanel` 随块搬走并在原文件转出口，外部导入点不变）。
import { Theme } from "theme.slint";
import { AnimationSettings } from "theme.slint";
import "fonts/MeatshellMono-Regular.ttf";
import "fonts/MeatshellMono-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-ExtraLight.ttf";
import "fonts/JetBrainsMono-Italic.ttf";
import { IconText } from "components/text.slint";
import { Label } from "components/text.slint";
import { Divider } from "components/surfaces.slint";

// One saved quick command (#55): a name shown on the chip + the text to send.
// Grouped like the welcome session list: group-header is non-empty on the first
// row of each group; collapsed hides the group's rows in the popup; orig-index
// points back to the entry's position in the stored list (delete target).
export struct QuickCmd {
    name: string,
    command: string,
    // 显示用的单行预览（换行折叠成 ` ⏎ `、超长截断）；`command` 才是真正发送的内容。
    command-preview: string,
    group: string,
    group-header: string,
    collapsed: bool,
    orig-index: int,
    // false → clicking only fills the input box (no trailing Return), so the
    // command can be tweaked before sending; true → send + execute (B站 suggestion).
    send-enter: bool,
}

// --- MenuItem --------------------------------------------------------------
// One row of the terminal right-click context menu (MDL2 icon + label).
export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.state-hover : transparent;
    animate background {
        duration: ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
        easing: ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
        enabled: AnimationSettings.enabled;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        IconText {
            text: root.icon;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// 固定在窗口右侧、宽度可调的快捷命令面板 (#215)；与底部命令栏弹窗共用同一套
// model 与动作。
export component QuickDockPanel inherits Rectangle {
    in property <[QuickCmd]> commands;
    callback activate(string, bool /* send-enter */);
    callback toggle-group(string);
    callback manage();
    callback close();

    // 与内容区同档（`bg-root`：alpha = panel-alpha − 0.44），让主窗口的壁纸透上来。
    // 原先是 `bg-panel`（alpha = panel-alpha），压在裸壁纸上是一块实色板，与页面割裂。
    background: Theme.bg-root;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 34px;
            background: Theme.bg-root;
            HorizontalLayout {
                padding-left: 8px; padding-right: 4px; spacing: 6px;
                IconText {
                    text: "\u{E25D}";
                    color: Theme.text-muted; font-size: Theme.fs-md;
                    vertical-alignment: center;
                }
                Text {
                    text: @tr("Quick commands");
                    color: Theme.text-primary; font-size: Theme.fs-sm;
                    font-weight: 700; vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 28px;
                    background: close-ta.has-hover ? Theme.state-hover : transparent;
                    animate background {
                        duration: close-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                        easing: close-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                        enabled: AnimationSettings.enabled;
                    }
                    border-radius: Theme.radius-sm;
                    close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                    IconText {
                        centered: true;
                        text: "\u{E5CC}";   // 面板固定在右侧，图标恒为「向右收起」
                        color: Theme.text-secondary; font-size: Theme.fs-md;

                    }
                }
            }
        }
        // 表头与外层同色后需要一条 1px 线分隔（原先靠底色差区分）。
        Divider {}

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, list.preferred-height);
            list := VerticalLayout {
                padding: 6px; spacing: 2px; alignment: start;
                if root.commands.length == 0 : Text {
                    height: 36px;
                    text: @tr("No quick commands yet");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                for q in root.commands : VerticalLayout {
                    spacing: 1px;
                    if q.group-header != "" : Rectangle {
                        height: 26px;
                        border-radius: Theme.radius-sm;
                        background: group-ta.has-hover ? Theme.state-hover : transparent;
                        animate background {
                            duration: group-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                            easing: group-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                            enabled: AnimationSettings.enabled;
                        }
                        group-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-group(q.group); }
                        }
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 5px;
                            IconText {
                                text: q.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                color: Theme.text-muted; font-size: Theme.fs-sm;
                                vertical-alignment: center;
                            }
                            Text {
                                text: q.group; color: Theme.text-muted;
                                font-size: Theme.fs-xs; font-weight: 700;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if !q.collapsed && q.orig-index >= 0 : Rectangle {
                        height: max(44px, item-col.preferred-height + 8px);
                        border-radius: Theme.radius-sm;
                        background: item-ta.has-hover ? Theme.state-hover : transparent;
                        animate background {
                            duration: item-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                            easing: item-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                            enabled: AnimationSettings.enabled;
                        }
                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.activate(q.command, q.send-enter); }
                        }
                        item-col := VerticalLayout {
                            padding-left: 9px; padding-right: 9px;
                            padding-top: 4px; padding-bottom: 4px; spacing: 1px;
                            Text {
                                text: q.name; color: Theme.text-primary;
                                font-size: Theme.fs-sm; wrap: word-wrap;
                                max-lines: 2;
                                vertical-alignment: center;
                            }
                            Label {
                                text: q.command-preview; color: Theme.text-muted;
                                font-size: Theme.fs-xs; overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 底栏与列表同色，同样需要一条 1px 线。
        Divider {}
        Rectangle {
            height: 32px;
            background: manage-ta.has-hover ? Theme.state-hover : Theme.bg-root;
            animate background {
                duration: manage-ta.has-hover ? AnimationSettings.enter-state() : AnimationSettings.exit-state();
                easing: manage-ta.has-hover ? AnimationSettings.e-enter() : AnimationSettings.e-exit();
                enabled: AnimationSettings.enabled;
            }
            manage-ta := TouchArea { mouse-cursor: pointer; clicked => { root.manage(); } }
            Text {
                text: @tr("Manage…"); color: Theme.accent; font-size: Theme.fs-sm;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}
