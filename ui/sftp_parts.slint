//! SFTP 面板的**附属部件**：文件列表右键菜单行。
//!
//! 从 `sftp_panel.slint` 拆出（P4），逐字搬运（`component` → `export component`）。
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabInfo } from "tabs.slint";
import { Divider, VDivider } from "components/surfaces.slint";
import { IconText } from "components/text.slint";

// One row of the file-list right-click context menu.
export component SftpMenuItem inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.text-primary;
    in property <bool> enabled: true;   // disabled items grey out + ignore clicks
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: (root.enabled && ta.has-hover) ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    Text {
        x: 10px;
        text: root.label;
        color: root.enabled ? root.tint : Theme.text-muted;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        height: parent.height;
    }
}
